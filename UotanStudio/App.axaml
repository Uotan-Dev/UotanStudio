<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UotanStudio"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:converters="using:UotanStudio.Converters"
             xmlns:viewmodels="using:UotanStudio.ViewModels"
             xmlns:devices="using:UotanStudio.ViewModels.Shell.Devices"
             xmlns:ui="using:UotanStudio.UiAbstractions"
             xmlns:dock="using:Dock.Avalonia.Controls"
             x:Class="UotanStudio.App"
             Name="UotanStudio"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UotanStudio/Themes/LightColors.axaml"/>
                <!-- 全局主题色：单独成档，换色只需改 Themes/AccentColors.axaml。 -->
                <!-- Global accent: kept in its own file so re-skinning only touches Themes/AccentColors.axaml. -->
                <ResourceInclude Source="avares://UotanStudio/Themes/AccentColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="MonospaceFontFamily">fonts:UotanStudio/JetBrainsMonoVF#JetBrains Mono</FontFamily>
            <converters:IntEqualConverter x:Key="IntEqualConverter" />
            <converters:AssetImageConverter x:Key="AssetImageConverter" />
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <converters:LogFilterDisplayConverter x:Key="LogFilterDisplayConverter" />
            <!-- 忙碌转圈下方的分层按组换行模板：主状态分组与遥测分组分两层独立排布，避免遥测数字波动导致主状态频繁换行跳动。 -->
            <DataTemplate x:Key="BusyMessageTemplate" x:DataType="ui:BusyMessageModel">
                <StackPanel Spacing="4" Margin="20,0" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding PrimaryGroups}" MaxWidth="360"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Stretch"
                                           ItemsAlignment="Center"
                                           ItemSpacing="8" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" MaxWidth="340"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding MetricGroups}" MaxWidth="360"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Stretch"
                                           ItemsAlignment="Center"
                                           ItemSpacing="8" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="12" Opacity="0.75"
                                           MaxWidth="340" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme />
        <semi:UrsaSemiTheme />
        <semi:SemiPopupAnimations />
        <semi:DockSemiTheme />
        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="fonts:UotanStudio/MiSansVF#MiSans VF" />
        </Style>
        <Style Selector="dock|DocumentControl">
            <Setter Property="ModifiedTemplate">
                <DataTemplate>
                    <TextBlock Text="&#x25CF;" FontSize="10" Width="12"
                               TextAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
        </Style>
        <semi:DataGridSemiTheme />
        <semi:AvaloniaEditSemiTheme />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <Style Selector="HostWindow[IsToolWindow=False]">
            <Setter Property="Title" Value="{DynamicResource Dock_Documents}" />
            <Setter Property="Icon" Value="/Assets/UotanToolbox.png" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="32" />
            <Setter Property="WindowDecorations" Value="Full" />
            <!-- 显式声明由 Avalonia 绘制标题与窗口按钮；下面的模板选择器只负责自定义图标与文字边距。 -->
            <!-- Declare the drawn title and buttons explicitly; the template selectors below only style the icon and text margins. -->
            <Setter Property="WindowDrawnDecorations.TitleBarDecorations" Value="All" />
        </Style>
        <Style Selector="HostWindow[IsToolWindow=False] WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="HostWindow[IsToolWindow=False] WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- 自绘标题栏的应用图标：所有 Window 与 HostWindow 共用，窗口不再各自声明一份。
             右侧留白按窗口能力区分：可最大化时留三个按钮（136），只有关闭按钮时留 48。
             各窗口如确有特殊排布，仍可在自己的 Window.Styles 里覆盖同名选择器。 -->
        <!-- Drawn-titlebar app icon shared by every Window and HostWindow; windows no longer declare it locally.
             The right inset follows the window capabilities: 136 for windows with all three buttons, 48 when only
             close is available. A window may still override the same selector in its own Window.Styles. -->
        <Style Selector="Window WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="Window WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,48,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Window[CanMaximize=True] WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="HostWindow WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="HostWindow WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu, ContextMenu MenuItem, MenuItem MenuItem">
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <Style Selector="Menu Separator, ContextMenu Separator">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <!-- Dock 标签页右键菜单（含统一图标）。 -->
        <!-- Dock tab context menus (with unified icons). -->
        <StyleInclude Source="avares://UotanStudio/Themes/DockTabMenus.axaml" />
        <!-- Dock 文档标签栏多行折行与上下滚动样式。 -->
        <!-- Dock document tab strip multi-row wrapping and vertical scrolling styles. -->
        <StyleInclude Source="avares://UotanStudio/Themes/DockTabStrip.axaml" />
        <!-- 按钮/分段单选的悬浮与选中态补丁（主色底 + 浅色文字）。 -->
        <!-- Hover/selection patch for buttons and segmented radios (accent fill with light text). -->
        <StyleInclude Source="avares://UotanStudio/Themes/AccentControls.axaml" />
    </Application.Styles>
</Application>
