<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UotanStudio"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:converters="using:UotanStudio.Converters"
             xmlns:viewmodels="using:UotanStudio.ViewModels"
             xmlns:devices="using:UotanStudio.ViewModels.Devices"
             xmlns:dock="using:Dock.Avalonia.Controls"
             x:Class="UotanStudio.App"
             Name="UotanStudio"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UotanStudio/Themes/LightColors.axaml"/>
                <!-- 全局主题色：单独成档，换色只需改 Themes/AccentColors.axaml。 -->
                <!-- Global accent: kept in its own file so re-skinning only touches Themes/AccentColors.axaml. -->
                <ResourceInclude Source="avares://UotanStudio/Themes/AccentColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:IntEqualConverter x:Key="IntEqualConverter" />
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <converters:LogFilterDisplayConverter x:Key="LogFilterDisplayConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme />
        <semi:UrsaSemiTheme />
        <semi:SemiPopupAnimations />
        <semi:DockSemiTheme />
        <Style Selector="dock|DocumentControl">
            <Setter Property="ModifiedTemplate">
                <DataTemplate>
                    <TextBlock Text="&#x25CF;" FontSize="10" Width="12"
                               TextAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
        </Style>
        <semi:DataGridSemiTheme />
        <semi:AvaloniaEditSemiTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <Style Selector="HostWindow[IsToolWindow=False]">
            <Setter Property="Title" Value="{DynamicResource Dock_Documents}" />
            <Setter Property="Icon" Value="/Assets/UotanToolbox.png" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="32" />
            <Setter Property="WindowDecorations" Value="Full" />
        </Style>
        <Style Selector="HostWindow[IsToolWindow=False] WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="HostWindow[IsToolWindow=False] WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu, ContextMenu MenuItem, MenuItem MenuItem">
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <Style Selector="Menu Separator, ContextMenu Separator">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <!-- 编辑器页面共用的顶部错误提示条样式（高度/位置/配色集中定义）。 -->
        <!-- Shared top error-banner styles for every editor page (height/placement/colour in one place). -->
        <StyleInclude Source="avares://UotanStudio/Themes/EditorErrorBanner.axaml" />
        <!-- Dock 标签页右键菜单（去掉多余项并统一图标）。 -->
        <!-- Dock tab context menus (unwanted entries removed, icons unified). -->
        <StyleInclude Source="avares://UotanStudio/Themes/DockTabMenus.axaml" />
        <!-- 按钮/分段单选的悬浮与选中态补丁（主色底 + 浅色文字）。 -->
        <!-- Hover/selection patch for buttons and segmented radios (accent fill with light text). -->
        <StyleInclude Source="avares://UotanStudio/Themes/AccentControls.axaml" />
    </Application.Styles>
</Application>
