<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:UotanStudio"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:converters="using:UotanStudio.Converters"
             xmlns:viewmodels="using:UotanStudio.ViewModels"
             xmlns:devices="using:UotanStudio.ViewModels.Devices"
             xmlns:pages="using:UotanStudio.Pages"
             xmlns:dockview="using:UotanStudio.Pages.DockView"
             x:Class="UotanStudio.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://UotanStudio/Themes/LightColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:IntEqualConverter x:Key="IntEqualConverter" />
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
        <DataTemplate DataType="viewmodels:FileViewModel">
          <dockview:FileView />
      </DataTemplate>
      <DataTemplate DataType="viewmodels:ImageViewModel">
          <dockview:ImageView />
      </DataTemplate>
      <DataTemplate DataType="viewmodels:ProjectExplorerViewModel">
          <dockview:ProjectExplorerView />
      </DataTemplate>
      <DataTemplate DataType="viewmodels:ProjectSettingViewModel">
          <dockview:ProjectSettingView />
      </DataTemplate>
      <DataTemplate DataType="viewmodels:PropertiesViewModel">
          <dockview:PropertiesView />
      </DataTemplate>
      <DataTemplate DataType="devices:DeviceViewModel">
          <pages:DeviceView />
      </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme />
        <semi:UrsaSemiTheme />
        <semi:SemiPopupAnimations />
        <semi:DockSemiTheme />
        <semi:DataGridSemiTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
    </Application.Styles>
</Application>