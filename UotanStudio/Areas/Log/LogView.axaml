<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.Areas.Log"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="UotanStudio.Areas.Log.LogView"
             x:DataType="vm:LogViewModel">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Height="40" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- 左侧: 开始 / 停止 / 暂停 / 继续 / 清空 / 导出 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding StartCaptureCommand}"
                            IsEnabled="{Binding !IsCapturing}"
                            ToolTip.Tip="{DynamicResource Log_Start}">
                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="Green" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding StopCaptureCommand}"
                            IsEnabled="{Binding IsCapturing}"
                            ToolTip.Tip="{DynamicResource Log_Stop}">
                        <avalonia:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="Red" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding PauseCaptureCommand}"
                            IsEnabled="{Binding IsCapturing}"
                            IsVisible="{Binding !IsPaused}"
                            ToolTip.Tip="{DynamicResource Log_Pause}">
                        <avalonia:MaterialIcon Kind="Pause" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ResumeCaptureCommand}"
                            IsEnabled="{Binding IsCapturing}"
                            IsVisible="{Binding IsPaused}"
                            ToolTip.Tip="{DynamicResource Log_Resume}">
                        <avalonia:MaterialIcon Kind="PlayPause" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="4,0" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ClearLogsCommand}"
                            ToolTip.Tip="{DynamicResource Log_Clear}">
                        <avalonia:MaterialIcon Kind="TrashOutline" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Click="OnExportClick"
                            ToolTip.Tip="{DynamicResource Log_Export}">
                        <avalonia:MaterialIcon Kind="DownloadOutline" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- 右侧: 自动滚动开关 + 级别过滤 + 文本过滤 -->
                <ToggleButton DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                              IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource Log_AutoScroll}">
                    <avalonia:MaterialIcon Kind="ArrowDownBold" Width="16" Height="16" />
                </ToggleButton>
                <TextBox DockPanel.Dock="Right" Width="100"
                         PlaceholderText="{DynamicResource Log_LevelFilterPlaceholder}"
                         Text="{Binding LevelFilter}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
                <TextBox DockPanel.Dock="Right" Width="220"
                         PlaceholderText="{DynamicResource Log_FilterPlaceholder}"
                         Text="{Binding Filter}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="24" Padding="8,2"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 日志列表：时间戳 / 级别 / 来源 / 文本 四列，等宽字体，级别着色 -->
        <ListBox Name="LogList" ItemsSource="{Binding FilteredEntries}" Margin="8">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                    <Grid ColumnDefinitions="86,56,150,*" Margin="2">
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="11"
                                   FontFamily="Consolas,monospace" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="11"
                                   FontWeight="SemiBold" FontFamily="Consolas,monospace"
                                   Foreground="{Binding LevelBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11"
                                   FontFamily="Consolas,monospace" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12"
                                   FontFamily="Consolas,monospace" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
