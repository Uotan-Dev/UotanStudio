<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Locale\**" />
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.Dock" />
    <PackageReference Include="NodifyM.Avalonia" />
    <PackageReference Include="FirmwareKit.CPIO" />
    <PackageReference Include="FirmwareKit.Payload" />
    <PackageReference Include="FirmwareKit.AVB" />
    <PackageReference Include="FirmwareKit.DT" />
    <PackageReference Include="FirmwareKit.DTOverlay" />
    <PackageReference Include="FirmwareKit.Sparse" />
    <PackageReference Include="FirmwareKit.Lp" />
    <PackageReference Include="FirmwareKit.NTPi" />
    <PackageReference Include="FirmwareKit.Oppo" />
    <PackageReference Include="FirmwareKit.Oppo.Core" />
    <PackageReference Include="FirmwareKit.OfpReader" />
    <PackageReference Include="FirmwareKit.OpsReader" />
  </ItemGroup>

</Project>
