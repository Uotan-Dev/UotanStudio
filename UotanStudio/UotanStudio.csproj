<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by the source-generated LibraryImport marshalling stubs in FileAssociationService. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Preserve the Desktop RID through this reference to Comm's native assets. -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- 仅显式包含非 XAML 资源（图标等）；.axaml 由 Avalonia 默认 glob（**/*.axaml）纳入，
         显式重复声明 Locale/Themes 会与默认项重复，导致 AVLN2002 重复 x:Class。 -->
    <AvaloniaResource Include="Assets\**" />
    <!-- Lingua 源生成器从 AdditionalFiles 读取 Locale/*.resx 并生成强类型 manager；这些 .resx
         必须从 SDK 默认 EmbeddedResource glob 移除，否则语言变体会生成 satellite assembly。 -->
    <AdditionalFiles Include="Locale\**\*.resx" />
    <EmbeddedResource Remove="Locale\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- MiSans 字体以 zstd 帧随包，启动时由 ZstdEmbeddedFontCollection 解码到内存；LogicalName 与
         MiSansFontData 中的常量一致，WithCulture=false 防止文件名被当成区域资源。 -->
    <EmbeddedResource Include="Fonts\*.ttf.zst">
      <LogicalName>UotanStudio.Fonts.%(Filename)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateBundledFonts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Fonts/MiSans-Regular.ttf.zst') or !Exists('$(MSBuildProjectDirectory)/Fonts/MiSans-Bold.ttf.zst')"
           Text="Missing bundled MiSans zstd frames under Fonts/. Run 'dotnet run tools/compress-embedded-assets.cs' to regenerate them." />
  </Target>


  <!--
    Emit the compiled version/channel/commit constants used by BuildInfo. Version.props feeds
    $(Version) and $(VersionChannel); SourceRevisionId is populated by the SDK's source-control
    targets (SourceLink) and stays empty in builds made from a tarball without Git metadata.
  -->
  <Target Name="GenerateUotanBuildInfo"
          BeforeTargets="CoreCompile"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_UotanCommitShort Condition="'$(SourceRevisionId)' != '' and $([System.String]::Copy('$(SourceRevisionId)').Length) &gt;= 7">$(SourceRevisionId.Substring(0, 7))</_UotanCommitShort>
      <_UotanCommitShort Condition="'$(_UotanCommitShort)' == ''">$(SourceRevisionId)</_UotanCommitShort>
      <_UotanBuildInfoFile>$(IntermediateOutputPath)UotanBuildInfo.g.cs</_UotanBuildInfoFile>
    </PropertyGroup>
    <Error Condition="'$(VersionChannel)' != 'release' and '$(VersionChannel)' != 'beta'"
           Text="VersionChannel must be release or beta (got '$(VersionChannel)')." />
    <WriteLinesToFile File="$(_UotanBuildInfoFile)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;namespace UotanStudio.Build%3B;;internal static class BuildInfoData;{;    internal const string Version = &quot;$(Version)&quot;%3B;    internal const string Channel = &quot;$(VersionChannel)&quot;%3B;    internal const string Commit = &quot;$(SourceRevisionId)&quot;%3B;    internal const string CommitShort = &quot;$(_UotanCommitShort)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(_UotanBuildInfoFile)" />
      <FileWrites Include="$(_UotanBuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio.Projects\UotanStudio.Projects.csproj" />
    <ProjectReference Include="..\UotanStudio.Comm\UotanStudio.Comm.csproj" />
    <ProjectReference Include="..\UotanStudio.Mirroring\UotanStudio.Mirroring.csproj" />
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
    <ProjectReference Include="..\UotanStudio.Delivery\UotanStudio.Delivery.csproj" />
    <ProjectReference Include="..\UotanStudio.Mcp\UotanStudio.Mcp.csproj" />
    <ProjectReference Include="..\UotanStudio.Media\UotanStudio.Media.csproj" />
    <ProjectReference Include="..\UotanStudio.Hash\UotanStudio.Hash.csproj" />
    <ProjectReference Include="..\UotanStudio.Net\UotanStudio.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" />
    <PackageReference Include="LuaCSharp" />
    <PackageReference Include="Porta.Pty" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Irihi.Iconica.TDesign" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.AvaloniaEdit" />
    <PackageReference Include="Semi.Avalonia.DataGrid" />
    <PackageReference Include="Semi.Avalonia.Dock" />
    <PackageReference Include="NodifyM.Avalonia" />
    <!-- Explicit-factory DI container; registrations are AOT/trimming safe. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- QR code rendering for the wireless-debugging pairing popup. -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

</Project>