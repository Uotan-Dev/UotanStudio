<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AdditionalFiles Include="Locale\**\*.resx" />
    <EmbeddedResource Remove="Locale\**\*.resx" />
    <TintGrammar Include="Views\Controls\Syntaxes\dts.tmLanguage.json"
                 LanguageId="dts" FileExtensions=".dts;.dtsi;.dtso" />
    <TintGrammar Include="Views\Controls\Syntaxes\toml.tmLanguage.json"
                 LanguageId="toml" FileExtensions=".toml" />
    <TintGrammar Include="Views\Controls\Syntaxes\asm-x86.tmLanguage.json"
                 LanguageId="asm" FileExtensions=".asm;.inc" />
  </ItemGroup>
  <Target Name="GenerateUotanBuildInfo" BeforeTargets="CoreCompile" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_UotanCommitShort Condition="'$(SourceRevisionId)' != '' and $([System.String]::Copy('$(SourceRevisionId)').Length) &gt;= 7">$(SourceRevisionId.Substring(0, 7))</_UotanCommitShort>
      <_UotanCommitShort Condition="'$(_UotanCommitShort)' == ''">$(SourceRevisionId)</_UotanCommitShort>
      <_UotanBuildInfoFile>$(IntermediateOutputPath)UotanBuildInfo.g.cs</_UotanBuildInfoFile>
    </PropertyGroup>
    <Error Condition="'$(VersionChannel)' != 'release' and '$(VersionChannel)' != 'beta'" Text="VersionChannel must be release or beta (got '$(VersionChannel)')." />
    <WriteLinesToFile File="$(_UotanBuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// &lt;auto-generated/&gt;;namespace UotanStudio.Build%3B;;internal static class BuildInfoData;{;    internal const string Version = &quot;$(Version)&quot;%3B;    internal const string Channel = &quot;$(VersionChannel)&quot;%3B;    internal const string Commit = &quot;$(SourceRevisionId)&quot;%3B;    internal const string CommitShort = &quot;$(_UotanCommitShort)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(_UotanBuildInfoFile)" />
      <FileWrites Include="$(_UotanBuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio.Assets\UotanStudio.Assets.csproj" />
    <ProjectReference Include="..\UotanStudio.Pipeline\UotanStudio.Pipeline.csproj" />
    <ProjectReference Include="..\UotanStudio.Comm\UotanStudio.Comm.csproj" />
    <ProjectReference Include="..\UotanStudio.Mirroring\UotanStudio.Mirroring.csproj" />
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
    <ProjectReference Include="..\UotanStudio.Mcp\UotanStudio.Mcp.csproj" />
    <ProjectReference Include="..\UotanStudio.Media\UotanStudio.Media.csproj" />
    <ProjectReference Include="..\UotanStudio.Hash\UotanStudio.Hash.csproj" />
    <ProjectReference Include="..\UotanStudio.Net\UotanStudio.Net.csproj" />
    <ProjectReference Include="..\UotanStudio.RegexInfer\UotanStudio.RegexInfer.csproj" />
    <ProjectReference Include="..\UotanStudio.DD\UotanStudio.DD.csproj" />
  </ItemGroup>

  <ItemGroup>
