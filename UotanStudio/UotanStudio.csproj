<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Locale\**" />
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- AvaloniaUI.DiagnosticsSupport: Avalonia 12+ DevTools 支持包，DEBUG-only 启用。
         Release/AOT 通过 IncludeAssets=None + PrivateAssets=All 排除，保持 IsAotCompatible。 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.Dock" />
    <PackageReference Include="NodifyM.Avalonia" />
    <!-- FirmwareKit 生态包（全量引入）：通信 / Fastboot / Fex / CPIO / Payload / AVB / DT / DTOverlay / Sparse / Lp / NTPi / Nb / Oppo 全家桶 / PartitionTab -->
    <PackageReference Include="FirmwareKit.Comm" />
    <PackageReference Include="FirmwareKit.Comm.Fastboot" />
    <PackageReference Include="FirmwareKit.Comm.Fex" />
    <PackageReference Include="FirmwareKit.CPIO" />
    <PackageReference Include="FirmwareKit.Payload" />
    <PackageReference Include="FirmwareKit.Payload.Reader" />
    <PackageReference Include="FirmwareKit.Payload.Creator" />
    <PackageReference Include="FirmwareKit.Payload.Modifier" />
    <PackageReference Include="FirmwareKit.AVB" />
    <PackageReference Include="FirmwareKit.DT" />
    <PackageReference Include="FirmwareKit.DTOverlay" />
    <PackageReference Include="FirmwareKit.Sparse" />
    <PackageReference Include="FirmwareKit.Lp" />
    <PackageReference Include="FirmwareKit.NTPi" />
    <PackageReference Include="FirmwareKit.Oppo" />
    <PackageReference Include="FirmwareKit.Oppo.Core" />
    <PackageReference Include="FirmwareKit.OfpReader" />
    <PackageReference Include="FirmwareKit.OpsReader" />
  </ItemGroup>

</Project>
