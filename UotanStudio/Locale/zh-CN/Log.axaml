<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 日志页面 -->
    <x:String x:Key="Log_Start">开始</x:String>
    <x:String x:Key="Log_Stop">停止</x:String>
    <x:String x:Key="Log_Pause">暂停</x:String>
    <x:String x:Key="Log_Resume">继续</x:String>
    <x:String x:Key="Log_Clear">清空</x:String>
    <x:String x:Key="Log_Export">导出...</x:String>
    <x:String x:Key="Log_AutoScroll">自动滚动</x:String>
    <x:String x:Key="Log_FilterPlaceholder">过滤日志...</x:String>
    <x:String x:Key="Log_LevelFilterPlaceholder">按级别过滤...</x:String>
    <x:String x:Key="Log_Level">级别</x:String>
    <x:String x:Key="Log_Source">来源</x:String>
    <x:String x:Key="Log_Message">消息</x:String>
    <x:String x:Key="Log_CaptureStarting">正在开始日志捕获...</x:String>
    <x:String x:Key="Log_CaptureStarted">日志捕获已开始。</x:String>
    <x:String x:Key="Log_CaptureStopped">日志捕获已停止。</x:String>
    <x:String x:Key="Log_Paused">日志捕获已暂停。</x:String>
    <x:String x:Key="Log_Resumed">日志捕获已继续。</x:String>
    <x:String x:Key="Log_NoLogs">暂无日志条目。</x:String>
    <x:String x:Key="Log_ExportSucceeded">日志已导出到 {0}</x:String>
    <x:String x:Key="Log_ExportFailed">导出日志失败。</x:String>
    <x:String x:Key="Log_ExportDialogTitle">导出日志</x:String>
    <x:String x:Key="Log_SelectDeviceFirst">请先选择一个设备。</x:String>

</ResourceDictionary>
