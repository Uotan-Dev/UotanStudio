    <x:String x:Key="Device_CompileVersion">编译版本</x:String>
    <x:String x:Key="Device_VndkVersion">VNDK 版本</x:String>
    <x:String x:Key="Device_PowerOnTime">开机时长</x:String>
    <x:String x:Key="Device_DiskType">存储类型</x:String>
    <x:String x:Key="Device_Userspace">Fastboot 模式</x:String>
    <x:String x:Key="Device_Battery">电池</x:String>
    <x:String x:Key="Device_Memory">内存</x:String>
    <x:String x:Key="Device_Storage">存储</x:String>
