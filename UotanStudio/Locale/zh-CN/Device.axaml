    <x:String x:Key="Device_SystemOverview">系统信息</x:String>
    <x:String x:Key="Device_ResourceOverview">资源使用</x:String>

    <!-- 刷写卡片 -->
    <x:String x:Key="Flash_Flash">刷写</x:String>
    <x:String x:Key="Flash_FlashCard">刷写分区</x:String>
    <x:String x:Key="Flash_Partition">分区</x:String>
    <x:String x:Key="Flash_PartitionHint">如 boot</x:String>
    <x:String x:Key="Flash_ImagePath">镜像路径</x:String>
    <x:String x:Key="Flash_ImagePathHint">镜像文件路径</x:String>
    <x:String x:Key="Flash_Flashing">正在刷写</x:String>
    <x:String x:Key="Flash_Done">刷写完成</x:String>
    <x:String x:Key="Flash_Failed">刷写失败</x:String>
    <x:String x:Key="Flash_Canceled">刷写已取消</x:String>

    <!-- 备份 / 还原 -->
    <x:String x:Key="Device_BackupPartition">备份分区</x:String>
    <x:String x:Key="Device_RestorePartition">还原分区</x:String>
    <x:String x:Key="Backup_SaveTitle">保存分区备份</x:String>
    <x:String x:Key="Backup_OpenTitle">选择分区镜像</x:String>
    <x:String x:Key="Backup_BackingUp">正在备份</x:String>
    <x:String x:Key="Backup_Restoring">正在还原</x:String>
    <x:String x:Key="Backup_Done">备份完成</x:String>
    <x:String x:Key="Backup_RestoreDone">还原完成</x:String>
    <x:String x:Key="Backup_Failed">备份失败</x:String>
    <x:String x:Key="Backup_RestoreFailed">还原失败</x:String>
    <x:String x:Key="Backup_SelectRawProgram">选择 rawprogram XML（分区几何）</x:String>

    <x:String x:Key="Device_HdcSend">发送文件（HDC）</x:String>
    <x:String x:Key="Device_HdcReceive">接收文件（HDC）</x:String>
    <x:String x:Key="Device_HdcInstall">安装应用（HDC）</x:String>
    <x:String x:Key="Device_HdcUninstall">卸载应用（HDC）</x:String>
    <x:String x:Key="Device_HdcRemotePath">设备文件路径</x:String>
    <x:String x:Key="Device_HdcBundleName">应用包名</x:String>
    <x:String x:Key="Device_HdcCancel">取消 HDC 任务</x:String>
