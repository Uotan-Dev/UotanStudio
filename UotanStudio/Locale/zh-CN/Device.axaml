<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.ZhCn.Device">

    <!-- 设备页面 -->
    <x:String x:Key="Device_Refresh">刷新</x:String>
    <x:String x:Key="Device_Connect">连接</x:String>
    <x:String x:Key="Device_Disconnect">断开</x:String>
    <x:String x:Key="Device_RemoteConnection">远程设备</x:String>
    <x:String x:Key="Device_RemoteProtocol">连接协议</x:String>
    <x:String x:Key="Device_RemoteAddress">设备地址:端口</x:String>
    <x:String x:Key="Device_RemoteConnect">连接远程设备</x:String>
    <x:String x:Key="Device_RemoteCancel">取消连接操作</x:String>
    <x:String x:Key="Device_RemoteInvalidAddress">设备地址须为主机名:端口、IPv4:端口或 [IPv6]:端口，端口范围为 1–65535；HDC 地址须少于 32 字节。</x:String>
    <x:String x:Key="Device_RemoteConnecting">正在连接 {0}...</x:String>
    <x:String x:Key="Device_RemoteDisconnecting">正在断开 {0}...</x:String>
    <x:String x:Key="Device_RemoteConnected">服务端已连接 {0}。</x:String>
    <x:String x:Key="Device_RemoteDisconnected">服务端已断开 {0}。</x:String>
    <x:String x:Key="Device_RemoteCanceled">已取消等待连接结果；设备状态以刷新结果为准。</x:String>
    <x:String x:Key="Device_RemoteFailed">无法完成 {0} 的连接操作，请查看日志。</x:String>
    <x:String x:Key="Device_RefreshFailed">设备刷新失败，请查看日志。</x:String>
    <x:String x:Key="Device_NoDevices">未检测到设备。</x:String>
    <x:String x:Key="Device_Select">选择设备</x:String>
    <x:String x:Key="Device_Scanning">正在扫描设备...</x:String>
    <x:String x:Key="Device_Reboot">重启</x:String>
    <x:String x:Key="Device_RebootSystem">重启到系统</x:String>
    <x:String x:Key="Device_RebootBootloader">重启到 Bootloader</x:String>
    <x:String x:Key="Device_RebootFastbootd">重启到 Fastbootd</x:String>
    <x:String x:Key="Device_RebootRecovery">重启到 Recovery</x:String>
    <x:String x:Key="Device_RebootEdl">重启到 EDL</x:String>
    <x:String x:Key="Device_DeviceCount"> 个设备已发现。</x:String>
    <x:String x:Key="Device_Detail">设备详情</x:String>
    <x:String x:Key="Device_Connecting">正在连接...</x:String>
    <x:String x:Key="Device_Reconnecting">正在重新连接...</x:String>
    <x:String x:Key="Device_GroupAdb">ADB 设备</x:String>
    <x:String x:Key="Device_GroupFastboot">Fastboot 设备</x:String>
    <x:String x:Key="Device_GroupEdl">EDL 设备</x:String>
    <x:String x:Key="Device_GroupRkdl">RKDL 设备</x:String>
    <x:String x:Key="Device_EmptyHint">点击刷新以扫描已连接的设备。</x:String>
    <x:String x:Key="Device_OpenAdbShell">打开设备 Shell</x:String>
    <x:String x:Key="Device_ScreenMirror">屏幕投屏 (scrcpy)</x:String>
    <x:String x:Key="Device_FastbootReadInfo">读取 Fastboot 设备信息</x:String>
    <x:String x:Key="Device_QuickFlash">快速刷写 boot 分区</x:String>

    <!-- 设备详情两栏布局 -->
    <x:String x:Key="Device_DetailPlaceholder">选择设备以查看详情</x:String>
