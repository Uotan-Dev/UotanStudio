    <x:String x:Key="ImageView_SynthesizeSuper">合成SUPER</x:String>
    <x:String x:Key="ImageView_SynthesizeDat">合成DAT</x:String>
    <x:String x:Key="ImageView_FlashSelected">刷入选中文件</x:String>
    <x:String x:Key="ImageView_FlashSelectedHint">将选中的可刷写镜像按顺序刷入当前设备</x:String>
    <x:String x:Key="ImageView_PackRom">打包ROM</x:String>
    <x:String x:Key="ImageView_ImportHint">将镜像导入项目 images/ 目录</x:String>
