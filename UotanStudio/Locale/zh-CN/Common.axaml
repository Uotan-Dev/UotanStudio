    <x:String x:Key="Tab_Log">日志</x:String>
    <x:String x:Key="Tab_Settings">设置</x:String>
    <x:String x:Key="Tab_Compare">对比</x:String>

    <!-- 视图定位器 -->
    <x:String x:Key="ViewLocator_NotFound">未找到: </x:String>

    <!-- ImageView -->
    <x:String x:Key="ImageView_UnpackMode">解包</x:String>
    <x:String x:Key="ImageView_PackMode">打包</x:String>
    <x:String x:Key="ImageView_Refresh">刷新</x:String>
    <x:String x:Key="ImageView_ExtractSelected">分解选中文件</x:String>
