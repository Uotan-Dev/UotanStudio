<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 选项卡 -->
    <x:String x:Key="Tab_Workspace">工作区</x:String>
    <x:String x:Key="Tab_Node">节点</x:String>
    <x:String x:Key="Tab_Log">日志</x:String>
    <x:String x:Key="Tab_Settings">设置</x:String>

    <!-- 视图定位器 -->
    <x:String x:Key="ViewLocator_NotFound">未找到: </x:String>

    <!-- ImageView -->
    <x:String x:Key="ImageView_ExtractSelected">分解选中文件</x:String>
    <x:String x:Key="ImageView_SynthesizeImg">合成img</x:String>
    <x:String x:Key="ImageView_SynthesizeBr">合成br</x:String>
    <x:String x:Key="ImageView_DeleteSelected">删除选中文件</x:String>
    <x:String x:Key="ImageView_SynthesizeSuper">合成Super</x:String>
    <x:String x:Key="ImageView_SynthesizeDat">合成dat</x:String>
    <x:String x:Key="ImageView_ImportHint">将镜像导入项目 images/ 目录</x:String>
    <x:String x:Key="ImageView_ExportHint">将选中镜像导出到外部路径</x:String>
    <x:String x:Key="ImageView_ExtractHint">将选中镜像分解到 intermediate/</x:String>
    <x:String x:Key="ImageView_SuperHint">由项目内 raw/sparse 镜像合成 super 镜像</x:String>
    <x:String x:Key="ImageView_DatHint">生成 .new.dat 与 .transfer.list（Android v4）</x:String>
    <x:String x:Key="ImageView_NoSelection">未选中镜像</x:String>
    <x:String x:Key="ImageView_NoProject">尚未打开工程</x:String>
    <x:String x:Key="ImageView_OperationDone">操作完成</x:String>

    <!-- Splash window -->
    <x:String x:Key="Splash_Subtitle">固件工具箱 · Firmware Toolbox</x:String>
    <x:String x:Key="Splash_Initializing">正在初始化...</x:String>
    <x:String x:Key="Splash_Scanning">正在扫描 USB 设备...</x:String>
    <x:String x:Key="Splash_FoundDevices">发现 {0} 台设备</x:String>
    <x:String x:Key="Splash_Preparing">正在准备主界面...</x:String>

    <!-- MainWindow -->
    <x:String x:Key="MainWindow_Title">UotanStudio</x:String>
    <x:String x:Key="Document_BuildProp">build.prop</x:String>
    <x:String x:Key="Document_InitRc">init.rc</x:String>

    <!-- ProjectExplorer -->
    <x:String x:Key="ProjectExplorer_Outer">外部</x:String>
    <x:String x:Key="ProjectExplorer_Inner">内部</x:String>
    <x:String x:Key="ProjectExplorer_Innermost">最内层</x:String>
    <x:String x:Key="Explorer_OpenAsText">以文本打开</x:String>
    <x:String x:Key="Explorer_OpenAsHex">以十六进制打开</x:String>
    <x:String x:Key="Explorer_OpenAsDtb">以设备树打开</x:String>
    <x:String x:Key="Explorer_OpenAsDex">以 DEX 打开</x:String>
    <x:String x:Key="Explorer_OpenAsAxml">以 Manifest 打开</x:String>
    <x:String x:Key="Explorer_OpenAsArsc">以 ARSC 打开</x:String>
    <x:String x:Key="Explorer_OpenAsApk">以 APK 打开</x:String>
    <x:String x:Key="Explorer_OpenAsFirmware">在固件信息中打开</x:String>
    <x:String x:Key="Explorer_OpenAsMenu">打开方式</x:String>
    <x:String x:Key="Dock_Dtb_Save">保存</x:String>
    <x:String x:Key="Dock_Dtb_Tree">设备树</x:String>
    <x:String x:Key="Dock_Dtb_Source">设备树源</x:String>
    <x:String x:Key="Dock_Dtb_CompileError">编译错误</x:String>
    <x:String x:Key="Dock_Dex_Save">重建并保存</x:String>
    <x:String x:Key="Dock_Dex_Disassembling">正在解析与反汇编，请稍候…</x:String>
    <x:String x:Key="Dock_Manifest_Save">重建并保存</x:String>
    <x:String x:Key="Dock_Manifest_Busy">正在解析 Manifest，请稍候…</x:String>
    <x:String x:Key="Dock_Arsc_Save">重建并保存</x:String>
    <x:String x:Key="Dock_Arsc_Busy">正在解析资源表，请稍候…</x:String>
    <x:String x:Key="Dock_Hex_Save">保存</x:String>
    <x:String x:Key="Dock_Hex_Busy">正在加载文件，请稍候…</x:String>
    <x:String x:Key="Dock_Apk_Busy">正在分析 APK，请稍候…</x:String>
    <x:String x:Key="FirmwareInfo_Title">固件信息</x:String>
    <x:String x:Key="FirmwareInfo_FormatName">格式名</x:String>
    <x:String x:Key="FirmwareInfo_Summary">摘要</x:String>
    <x:String x:Key="FirmwareInfo_Metadata">元数据</x:String>
    <x:String x:Key="FirmwareInfo_Entries">条目</x:String>
    <x:String x:Key="FirmwareInfo_Components">组件</x:String>
    <x:String x:Key="FirmwareInfo_Loading">正在读取固件信息，请稍候…</x:String>
    <x:String x:Key="FirmwareInfo_Error">读取失败</x:String>
    <x:String x:Key="FirmwareInfo_Unrecognized">无法识别该文件格式</x:String>

</ResourceDictionary>
