<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.ZhCn.Common">

    <!-- 选项卡 -->
    <x:String x:Key="Tab_Workspace">工作区</x:String>
