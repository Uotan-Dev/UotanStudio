    <!-- 关于对话框 -->
    <x:String x:Key="About_Version">版本</x:String>
    <x:String x:Key="About_Title">关于 UotanStudio</x:String>
    <x:String x:Key="About_Description">集固件解打包、开发板烧录与可视化编程于一体的一站式工具箱。</x:String>
    <x:String x:Key="About_Close">关闭</x:String>

    <x:String x:Key="Menu_CompareFiles">文件比较</x:String>
    <x:String x:Key="Menu_CompareFolders">文件夹比较</x:String>

    <x:String x:Key="Menu_KeyManager">密钥管理</x:String>
    <x:String x:Key="Menu_ApkSigner">应用签名器</x:String>
    <x:String x:Key="Keys_Subtitle">管理设备认证与 Payload 签名密钥，独立于当前工程。</x:String>
    <x:String x:Key="Keys_Search">搜索名称、用途或指纹</x:String>
    <x:String x:Key="Keys_Library">我的密钥</x:String>
    <x:String x:Key="Keys_Refresh">刷新</x:String>
    <x:String x:Key="Keys_Create">生成与导入</x:String>
    <x:String x:Key="Keys_Name">密钥名称</x:String>
    <x:String x:Key="Keys_Purpose">用途</x:String>
    <x:String x:Key="Keys_Bits">位数</x:String>
    <x:String x:Key="Keys_Formats">ADB：RSA 2048 · HDC：RSA 3072 · Payload：RSA 2048 / 4096。私钥保存在本机密钥库；不会自动替换设备认证密钥或签名镜像。</x:String>
    <x:String x:Key="Keys_Generate">生成密钥对</x:String>
    <x:String x:Key="Keys_GenerateCertificate">生成证书</x:String>
    <x:String x:Key="Keys_Import">导入私钥…</x:String>
    <x:String x:Key="Keys_Password">导入密码（如有）</x:String>
    <x:String x:Key="Keys_ApkKey">APK 密钥</x:String>
    <x:String x:Key="Keys_ApkCertificate">APK 证书</x:String>
    <x:String x:Key="Keys_KeystoreAlias">密钥库别名</x:String>
    <x:String x:Key="Keys_KeystorePassword">密钥库密码</x:String>
    <x:String x:Key="Keys_ValidityYears">有效期（年）</x:String>
    <x:String x:Key="Keys_CertificateHolder">证书持有者信息</x:String>
    <x:String x:Key="Keys_CommonName">姓名</x:String>
    <x:String x:Key="Keys_OrganizationUnit">组织单位</x:String>
    <x:String x:Key="Keys_Organization">组织</x:String>
    <x:String x:Key="Keys_Locality">城市或地区</x:String>
    <x:String x:Key="Keys_State">州或省份</x:String>
    <x:String x:Key="Keys_CountryCode">国家代码</x:String>
    <x:String x:Key="Keys_KeyConfiguration">密钥配置</x:String>
    <x:String x:Key="Keys_Algorithm">密钥算法</x:String>
    <x:String x:Key="Keys_KeySizeCurve">密钥大小 / 曲线</x:String>
    <x:String x:Key="Keys_Rsa">RSA</x:String>
    <x:String x:Key="Keys_Ec">EC</x:String>
    <x:String x:Key="Keys_Rsa2048">2048（RSA）</x:String>
    <x:String x:Key="Keys_Rsa4096">4096（RSA）</x:String>
    <x:String x:Key="Keys_OutputFormat">输出格式</x:String>
    <x:String x:Key="Keys_SelectOutputFormat">选择生成的证书格式</x:String>
    <x:String x:Key="Keys_FormatAll">全部格式（推荐）</x:String>
    <x:String x:Key="Keys_FormatJks">仅 JKS（.keystore）</x:String>
    <x:String x:Key="Keys_OutputDirectory">输出目录</x:String>
    <x:String x:Key="Keys_Browse">浏览</x:String>
    <x:String x:Key="Keys_FormatPkcs12">仅 PKCS12（.p12）</x:String>
    <x:String x:Key="Keys_FormatPem">仅 PEM（.key + .crt）</x:String>
    <x:String x:Key="Keys_FormatHint">生成 JKS、PKCS12 和 PEM 三种格式，兼容各种 Android 打包工具。</x:String>
    <x:String x:Key="Keys_Details">密钥详情</x:String>
    <x:String x:Key="Keys_Empty">生成、导入或选择一个密钥以查看详情。</x:String>
    <x:String x:Key="Keys_Rename">重命名</x:String>
    <x:String x:Key="Keys_CopyPublic">复制公钥</x:String>
    <x:String x:Key="Keys_ExportPublic">导出公钥…</x:String>
    <x:String x:Key="Keys_ExportPair">导出公私钥…</x:String>
    <x:String x:Key="Keys_ExportCertificate">导出证书…</x:String>
    <x:String x:Key="Keys_RemoveHint">确认从列表移除，文件保留在密钥库 .deleted 目录</x:String>
    <x:String x:Key="Keys_Remove">移除密钥</x:String>
    <x:String x:Key="Keys_New">新增密钥</x:String>
    <x:String x:Key="Keys_Delete">永久删除</x:String>
    <x:String x:Key="Keys_DeleteHint">确认永久删除所选密钥（不可恢复）</x:String>
    <x:String x:Key="Keys_DeleteConfirm">确定永久删除密钥“{0}”吗？此操作不可恢复，已导出的副本不受影响。</x:String>
    <x:String x:Key="Keys_PayloadSigning">Payload 发布签名密钥</x:String>
    <x:String x:Key="Keys_ChoosePayload">从密钥库选择 Payload 密钥</x:String>
    <x:String x:Key="Keys_ExternalPrivate">或选择外部 PEM / DER 私钥</x:String>
    <x:String x:Key="Keys_Unsigned">不签名</x:String>
    <x:String x:Key="Keys_PayloadSigningHint">选中密钥后同时签名元数据和 Payload。外部私钥须为未加密 RSA 2048/4096；加密 PEM 可先导入密钥库。</x:String>
    <x:String x:Key="Keys_SetCurrent">设为当前签名</x:String>
    <x:String x:Key="Keys_SetCurrentHint">写入运行时身份并重启后生效</x:String>
    <x:String x:Key="Keys_CurrentDefault">默认</x:String>
    <x:String x:Key="Keys_InUse">当前使用</x:String>
    <x:String x:Key="Keys_AlreadyDefault">已是当前默认签名</x:String>
    <x:String x:Key="Keys_RestartConfirmTitle">设置当前签名</x:String>
    <x:String x:Key="Keys_RestartConfirmMessage">将“{0}”设为当前 {1} 签名？程序将保存全部状态后重启，并重新打开关闭前的解决方案。</x:String>
    <x:String x:Key="Keys_DefaultSaveFailed">保存默认签名设置失败。</x:String>
    <x:String x:Key="Keys_DefaultAutoName">ADB 默认密钥</x:String>
    <x:String x:Key="Keys_DefaultAutoNameHdc">HDC 默认密钥</x:String>
