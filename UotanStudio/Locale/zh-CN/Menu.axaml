<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.ZhCn.Menu">

    <!-- 顶级菜单 -->
    <x:String x:Key="Menu_File">文件</x:String>
    <x:String x:Key="Menu_Edit">编辑</x:String>
    <x:String x:Key="Menu_View">视图</x:String>
    <x:String x:Key="Menu_Tools">工具</x:String>
    <x:String x:Key="Menu_Help">帮助</x:String>

    <!-- 文件菜单 -->
    <x:String x:Key="Menu_NewProject">新建项目</x:String>
    <x:String x:Key="NewProject_Name">项目名称</x:String>
    <x:String x:Key="NewProject_NamePlaceholder">输入项目名称</x:String>
    <x:String x:Key="NewProject_Location">项目位置</x:String>
    <x:String x:Key="NewProject_AddImages">添加ROM或镜像</x:String>
    <x:String x:Key="NewProject_ImagesPlaceholder">支持多选IMG或选择ZIP、Super.img、Payload.bin 等格式文件</x:String>
    <x:String x:Key="NewProject_UnpackImages">解包为镜像</x:String>
    <x:String x:Key="NewProject_UnpackFully">完全解包</x:String>
    <x:String x:Key="NewProject_ImageName">镜像名称</x:String>
    <x:String x:Key="NewProject_ImageFormat">镜像格式</x:String>
    <x:String x:Key="NewProject_Create">创建</x:String>
    <x:String x:Key="NewProject_Analyzing">正在读取原包内部结构…</x:String>
    <x:String x:Key="NewProject_NameInvalid">请输入有效且未被占用的项目名称</x:String>
    <x:String x:Key="NewProject_Creating">正在创建项目…</x:String>
    <x:String x:Key="NewProject_Copying">正在复制原始文件…</x:String>
    <x:String x:Key="NewProject_Extracting">正在提取和解包所选镜像…</x:String>
    <x:String x:Key="NewProject_NameRequired">请输入项目名称</x:String>
    <x:String x:Key="NewProject_LocationRequired">请选择或输入项目位置</x:String>
    <x:String x:Key="NewProject_LocationNotEmpty">目标文件夹必须为空或尚不存在</x:String>
    <x:String x:Key="NewProject_GroupSuperPartitions">super 分区 — {0}</x:String>
    <x:String x:Key="NewProject_GroupPayloadPartitions">payload 分区 — {0}</x:String>
    <x:String x:Key="NewProject_GroupZipImages">压缩包内镜像 — {0}</x:String>
    <x:String x:Key="NewProject_BrowseLocation">选择项目位置</x:String>
    <x:String x:Key="NewProject_BrowseImages">选择ROM或镜像文件</x:String>
    <x:String x:Key="NewProject_SelectFolder">选择目录</x:String>
    <x:String x:Key="NewProject_SelectImages">选择镜像</x:String>
    <x:String x:Key="NewProject_ClearImages">清除已选文件</x:String>
    <x:String x:Key="NewProject_ImageFiles">ROM与镜像文件</x:String>
    <x:String x:Key="NewProject_PickerFailed">无法选择文件或目录</x:String>
    <x:String x:Key="NewProject_CreateFailed">创建项目失败</x:String>
    <x:String x:Key="Menu_OpenProject">打开项目...</x:String>
    <x:String x:Key="Menu_OpenFolder">打开文件夹...</x:String>
    <x:String x:Key="Menu_OpenFile">打开文件...</x:String>
    <x:String x:Key="Menu_SelectCreationDirectory">选择新建位置</x:String>
    <x:String x:Key="Menu_OpenFailed">打开失败</x:String>
    <x:String x:Key="Menu_OpenRecent">最近打开</x:String>
    <x:String x:Key="Menu_Save">保存</x:String>
    <x:String x:Key="Menu_SaveAs">另存为...</x:String>
    <x:String x:Key="Menu_ImportImage">导入镜像...</x:String>
    <x:String x:Key="Menu_ExportImage">导出镜像...</x:String>
    <x:String x:Key="Menu_Export">导出...</x:String>
    <x:String x:Key="Menu_Exit">退出</x:String>

    <!-- macOS 应用菜单 -->
    <x:String x:Key="Menu_MacServices">服务</x:String>
    <x:String x:Key="Menu_MacHide">隐藏 UotanStudio</x:String>
    <x:String x:Key="Menu_MacHideOthers">隐藏其他</x:String>
    <x:String x:Key="Menu_MacShowAll">显示全部</x:String>
    <x:String x:Key="Menu_MacQuit">退出 UotanStudio</x:String>

    <!-- 编辑菜单 -->
    <x:String x:Key="Menu_Undo">撤销</x:String>
    <x:String x:Key="Menu_Redo">重做</x:String>
    <x:String x:Key="Menu_Cut">剪切</x:String>
    <x:String x:Key="Menu_Copy">复制</x:String>
    <x:String x:Key="Menu_Paste">粘贴</x:String>
    <x:String x:Key="Menu_Delete">删除</x:String>
    <x:String x:Key="Menu_SelectAll">全选</x:String>
    <x:String x:Key="Menu_Preferences">首选项...</x:String>

    <!-- 视图菜单 -->
    <x:String x:Key="Menu_Workspace">工作区</x:String>
    <x:String x:Key="Menu_NodeEditor">节点编辑器</x:String>
    <x:String x:Key="Menu_Settings">设置</x:String>
    <x:String x:Key="Menu_ToggleMinimap">切换小地图</x:String>
    <x:String x:Key="Menu_ZoomIn">放大</x:String>
    <x:String x:Key="Menu_ZoomOut">缩小</x:String>
    <x:String x:Key="Menu_ResetZoom">重置缩放</x:String>

    <!-- 窗口菜单 -->
    <x:String x:Key="Menu_Window">窗口</x:String>
    <x:String x:Key="Menu_WindowProjectExplorer">项目资源管理器</x:String>
    <x:String x:Key="Menu_WindowProjectSetting">打包设置</x:String>
    <x:String x:Key="Menu_WindowDevice">设备</x:String>
    <x:String x:Key="Menu_WindowImages">镜像管理</x:String>
    <x:String x:Key="Menu_WindowProperties">属性</x:String>
    <x:String x:Key="Menu_WindowWorkspaceLog">输出</x:String>
    <x:String x:Key="Menu_WindowAdbLog">设备日志</x:String>
    <x:String x:Key="Menu_WindowTerminal">终端</x:String>

    <!-- 工具菜单 -->
    <x:String x:Key="Menu_FlashTools">烧录工具</x:String>
    <x:String x:Key="Menu_FirmwareTools">固件工具</x:String>
    <x:String x:Key="Menu_DeviceManager">设备管理器</x:String>
    <x:String x:Key="Menu_LogWindow">日志窗口</x:String>

    <!-- 底部选项卡 -->
    <x:String x:Key="Tab_Device">设备</x:String>

    <!-- 帮助菜单 -->
    <x:String x:Key="Menu_About">关于 UotanStudio</x:String>
    <x:String x:Key="Menu_Documentation">文档</x:String>
    <x:String x:Key="Menu_ReportIssue">报告问题</x:String>

    <!-- 关于对话框 -->
    <x:String x:Key="About_Version">版本</x:String>
    <x:String x:Key="About_Title">关于 UotanStudio</x:String>
    <x:String x:Key="About_Description">集固件解打包、开发板烧录与可视化编程于一体的一站式工具箱。</x:String>
    <x:String x:Key="About_Close">关闭</x:String>

    <x:String x:Key="Menu_CompareFiles">文件比较</x:String>
    <x:String x:Key="Menu_CompareFolders">文件夹比较</x:String>

    <x:String x:Key="Menu_KeyManager">密钥管理</x:String>
    <x:String x:Key="Keys_Subtitle">管理设备认证与 Payload 签名密钥，独立于当前工程。</x:String>
    <x:String x:Key="Keys_Search">搜索名称、用途或指纹</x:String>
    <x:String x:Key="Keys_Library">我的密钥</x:String>
    <x:String x:Key="Keys_Refresh">刷新</x:String>
    <x:String x:Key="Keys_Create">生成与导入</x:String>
    <x:String x:Key="Keys_Name">密钥名称</x:String>
    <x:String x:Key="Keys_Formats">ADB：RSA 2048 · HDC：RSA 3072 · Payload：RSA 2048 / 4096。私钥保存在本机密钥库；不会自动替换设备认证密钥或签名镜像。</x:String>
    <x:String x:Key="Keys_Generate">生成密钥对</x:String>
    <x:String x:Key="Keys_Import">导入私钥…</x:String>
    <x:String x:Key="Keys_Password">导入密码（如有）</x:String>
    <x:String x:Key="Keys_Details">密钥详情</x:String>
    <x:String x:Key="Keys_Empty">生成、导入或选择一个密钥以查看详情。</x:String>
    <x:String x:Key="Keys_Rename">重命名</x:String>
    <x:String x:Key="Keys_CopyPublic">复制公钥</x:String>
    <x:String x:Key="Keys_ExportPublic">导出公钥…</x:String>
    <x:String x:Key="Keys_ExportPair">导出公私钥…</x:String>
    <x:String x:Key="Keys_RemoveHint">确认从列表移除，文件保留在密钥库 .deleted 目录</x:String>
    <x:String x:Key="Keys_Remove">移除密钥</x:String>
    <x:String x:Key="Keys_New">新增密钥</x:String>
    <x:String x:Key="Keys_Delete">永久删除</x:String>
    <x:String x:Key="Keys_DeleteHint">确认永久删除所选密钥（不可恢复）</x:String>
    <x:String x:Key="Keys_PayloadSigning">Payload 发布签名密钥</x:String>
    <x:String x:Key="Keys_ChoosePayload">从密钥库选择 Payload 密钥</x:String>
    <x:String x:Key="Keys_ExternalPrivate">或选择外部 PEM / DER 私钥</x:String>
    <x:String x:Key="Keys_Unsigned">不签名</x:String>
    <x:String x:Key="Keys_PayloadSigningHint">选中密钥后同时签名元数据和 Payload。外部私钥须为未加密 RSA 2048/4096；加密 PEM 可先导入密钥库。</x:String>
</ResourceDictionary>
