<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.ZhCn.Settings">

    <x:String x:Key="Settings_General">通用设置</x:String>
    <x:String x:Key="Settings_Firmware">固件工具</x:String>
    <x:String x:Key="Settings_FirmwareParallelism">并行数量</x:String>
    <x:String x:Key="Settings_FirmwareParallelismHint">默认 4，可设置为 1–8。用于支持并行的固件打包和解包，修改后对新任务生效。数量越大，内存占用通常越高。</x:String>
    <x:String x:Key="Settings_ErofsLegacy">EROFS legacy 布局</x:String>
    <x:String x:Key="Settings_ErofsLegacyHint">新建 EROFS 镜像采用 pre-5.13 布局（不使用 big-pcluster），使 Linux 5.4/5.10 内核可直接挂载。仅当目标内核为 5.13+ 且希望镜像更小时才关闭。</x:String>
    <x:String x:Key="Settings_Flash">烧录设置</x:String>
    <x:String x:Key="Settings_NodeEditor">节点编辑器</x:String>
    <x:String x:Key="Settings_Language">语言</x:String>
    <x:String x:Key="Settings_Theme">主题</x:String>
    <x:String x:Key="Settings_ThemeDefault">跟随系统</x:String>
    <x:String x:Key="Settings_ThemeLight">浅色</x:String>
    <x:String x:Key="Settings_ThemeDark">深色</x:String>
    <x:String x:Key="Settings_AutoSave">自动保存</x:String>
    <x:String x:Key="Settings_DebugMode">调试模式</x:String>
    <x:String x:Key="Settings_UnpackToolPath">解包工具路径</x:String>
    <x:String x:Key="Settings_TempDir">临时文件目录</x:String>
    <x:String x:Key="Settings_AutoVerify">解包后自动校验</x:String>
    <x:String x:Key="Settings_PathPlaceholder">输入路径...</x:String>
    <x:String x:Key="Settings_DeviceTimeout">设备超时时间</x:String>
    <x:String x:Key="Settings_AutoBackup">烧录前自动备份</x:String>
    <x:String x:Key="Settings_SnapToGrid">网格对齐</x:String>
    <x:String x:Key="Settings_GridSize">网格大小</x:String>
    <x:String x:Key="Settings_ConnectionStyle">连接线样式</x:String>
    <x:String x:Key="Settings_ConnBezier">贝塞尔曲线</x:String>
    <x:String x:Key="Settings_ConnLine">直线</x:String>
    <x:String x:Key="Settings_ConnStep">阶梯线</x:String>
    <x:String x:Key="Settings_Appearance">外观设置</x:String>
    <x:String x:Key="Settings_ThemePreview">主题预览</x:String>
    <x:String x:Key="Settings_LanguageAutoDetect">自动检测</x:String>
    <x:String x:Key="Settings_LanguagePreview">语言预览</x:String>
    <x:String x:Key="Settings_LanguagePreviewText">这是所选语言的预览文本。</x:String>
    <x:String x:Key="Settings_VersionInfo">版本信息</x:String>
    <x:String x:Key="Settings_FirmwareModule">固件解打包模块</x:String>
    <x:String x:Key="Settings_FlashModule">开发板烧录模块</x:String>
    <x:String x:Key="Settings_VisualProgrammingModule">可视化编程模块</x:String>
    <x:String x:Key="Settings_Version">版本</x:String>
    <x:String x:Key="Settings_CheckForUpdates">检查更新</x:String>
    <x:String x:Key="Settings_CheckingUpdates">检查中...</x:String>
    <x:String x:Key="Settings_UpToDate">已是最新版本</x:String>
    <x:String x:Key="Settings_UpdateAvailable">有可用更新</x:String>
    <x:String x:Key="Settings_UpdateCheckFailed">更新检查失败</x:String>
    <x:String x:Key="Settings_ResetToDefaults">恢复默认设置</x:String>
    <x:String x:Key="Settings_ResetConfirm">确定要恢复所有设置为默认值吗？</x:String>
    <x:String x:Key="Settings_SettingsSaved">设置已保存</x:String>
    <x:String x:Key="Settings_SaveFailed">保存设置失败：{0}</x:String>
    <x:String x:Key="Settings_ThemeFollowSystem">跟随系统</x:String>
    <x:String x:Key="Settings_ThemeLightMode">浅色模式</x:String>
    <x:String x:Key="Settings_ThemeDarkMode">深色模式</x:String>
    <x:String x:Key="Settings_AutoDetect">自动检测</x:String>
    <x:String x:Key="Settings_AdbPath">ADB 路径</x:String>
    <x:String x:Key="Settings_FastbootPath">Fastboot 路径</x:String>
    <x:String x:Key="Settings_Mcp">MCP</x:String>
    <x:String x:Key="Settings_McpHint">在此维护 MCP 服务器连接与本地暴露端口；保存后写入应用设置。</x:String>
    <x:String x:Key="Settings_McpServerName">名称</x:String>
    <x:String x:Key="Settings_McpTransport">传输</x:String>
    <x:String x:Key="Settings_McpCommand">命令</x:String>
    <x:String x:Key="Settings_McpArguments">参数</x:String>
    <x:String x:Key="Settings_McpUrl">URL</x:String>
    <x:String x:Key="Settings_McpEnabled">启用</x:String>
    <x:String x:Key="Settings_McpAdd">添加服务器</x:String>
    <x:String x:Key="Settings_McpRemove">删除</x:String>
    <x:String x:Key="Settings_McpExpose">暴露为 MCP 服务器</x:String>
    <x:String x:Key="Settings_McpExposePort">端口</x:String>
    <x:String x:Key="Settings_McpSave">保存 MCP 设置</x:String>
    <x:String x:Key="Settings_Developers">开发成员</x:String>
    <x:String x:Key="Settings_GitHub">GitHub</x:String>
    <x:String x:Key="Settings_Coolapk">酷安</x:String>

    <x:String x:Key="Settings_AI">AI 助手</x:String>
    <x:String x:Key="Settings_AIEndpoint">API 地址</x:String>
    <x:String x:Key="Settings_AIApiKey">API 密钥</x:String>
    <x:String x:Key="Settings_AIToggleKey">显示 / 隐藏 API 密钥</x:String>
    <x:String x:Key="Settings_AIModels">模型</x:String>
    <x:String x:Key="Settings_AIFetchModels">获取模型列表</x:String>
</ResourceDictionary>
