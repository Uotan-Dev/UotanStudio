<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.EnUs.Menu">

    <!-- Top-level menus -->
    <x:String x:Key="Menu_File">File</x:String>
    <x:String x:Key="Menu_Edit">Edit</x:String>
    <x:String x:Key="Menu_View">View</x:String>
    <x:String x:Key="Menu_Tools">Tools</x:String>
    <x:String x:Key="Menu_Help">Help</x:String>

    <!-- File menu -->
    <x:String x:Key="Menu_NewProject">New Project</x:String>
    <x:String x:Key="Menu_OpenProject">Open Project...</x:String>
    <x:String x:Key="Menu_OpenRecent">Open Recent</x:String>
    <x:String x:Key="Menu_Save">Save</x:String>
    <x:String x:Key="Menu_SaveAs">Save As...</x:String>
    <x:String x:Key="Menu_ImportImage">Import Image...</x:String>
    <x:String x:Key="Menu_ExportImage">Export Image...</x:String>
    <x:String x:Key="Menu_Export">Export...</x:String>
    <x:String x:Key="Menu_Exit">Exit</x:String>

    <!-- Edit menu -->
    <x:String x:Key="Menu_Undo">Undo</x:String>
    <x:String x:Key="Menu_Redo">Redo</x:String>
    <x:String x:Key="Menu_Cut">Cut</x:String>
    <x:String x:Key="Menu_Copy">Copy</x:String>
    <x:String x:Key="Menu_Paste">Paste</x:String>
    <x:String x:Key="Menu_Delete">Delete</x:String>
    <x:String x:Key="Menu_SelectAll">Select All</x:String>
    <x:String x:Key="Menu_Preferences">Preferences...</x:String>

    <!-- View menu -->
    <x:String x:Key="Menu_Workspace">Workspace</x:String>
    <x:String x:Key="Menu_NodeEditor">Node Editor</x:String>
    <x:String x:Key="Menu_Settings">Settings</x:String>
    <x:String x:Key="Menu_ToggleMinimap">Toggle Minimap</x:String>
    <x:String x:Key="Menu_ZoomIn">Zoom In</x:String>
    <x:String x:Key="Menu_ZoomOut">Zoom Out</x:String>
    <x:String x:Key="Menu_ResetZoom">Reset Zoom</x:String>

    <!-- Window menu -->
    <x:String x:Key="Menu_Window">Window</x:String>
    <x:String x:Key="Menu_WindowProjectExplorer">Project Explorer</x:String>
    <x:String x:Key="Menu_WindowProjectSetting">Packing Settings</x:String>
    <x:String x:Key="Menu_WindowDevice">Device</x:String>
    <x:String x:Key="Menu_WindowImages">Images</x:String>
    <x:String x:Key="Menu_WindowProperties">Properties</x:String>

    <!-- Tools menu -->
    <x:String x:Key="Menu_FlashTools">Flash Tools</x:String>
    <x:String x:Key="Menu_FirmwareTools">Firmware Tools</x:String>
    <x:String x:Key="Menu_DeviceManager">Device Manager</x:String>
    <x:String x:Key="Menu_LogWindow">Log Window</x:String>

    <!-- Bottom tabs -->
    <x:String x:Key="Tab_Device">Device</x:String>

    <!-- Help menu -->
    <x:String x:Key="Menu_About">About UotanStudio</x:String>
    <x:String x:Key="Menu_Documentation">Documentation</x:String>
    <x:String x:Key="Menu_ReportIssue">Report an Issue</x:String>

    <!-- About dialog -->
    <x:String x:Key="About_Version">Version</x:String>
    <x:String x:Key="About_Description">An integrated toolbox for firmware unpack/pack, board flashing and visual programming.</x:String>
    <x:String x:Key="About_Close">Close</x:String>

    <x:String x:Key="Menu_CompareFiles">Compare Files</x:String>
    <x:String x:Key="Menu_CompareFolders">Compare Folders</x:String>

</ResourceDictionary>
