<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.EnUs.Common">

    <!-- Tabs -->
    <x:String x:Key="Tab_Workspace">Workspace</x:String>
    <x:String x:Key="Tab_Node">Node</x:String>
    <x:String x:Key="Tab_Log">Log</x:String>
    <x:String x:Key="Tab_Settings">Settings</x:String>
    <x:String x:Key="Tab_Compare">Compare</x:String>

    <!-- ViewLocator -->
    <x:String x:Key="ViewLocator_NotFound">Not Found: </x:String>

    <!-- ImageView -->
    <x:String x:Key="ImageView_ExtractSelected">Extract Selected</x:String>
    <x:String x:Key="ImageView_SynthesizeImg">Synthesize img</x:String>
    <x:String x:Key="ImageView_SynthesizeBr">Synthesize br</x:String>
    <x:String x:Key="ImageView_DeleteSelected">Delete Selected</x:String>
    <x:String x:Key="ImageView_SynthesizeSuper">Synthesize Super</x:String>
    <x:String x:Key="ImageView_SynthesizeDat">Synthesize dat</x:String>
    <x:String x:Key="ImageView_ImportHint">Import images into the project images/ folder</x:String>
    <x:String x:Key="ImageView_ExportHint">Export the selected image to an external path</x:String>
    <x:String x:Key="ImageView_ExtractHint">Unpack the selected image to intermediate/</x:String>
    <x:String x:Key="ImageView_SuperHint">Build a super image from the project's raw/sparse images</x:String>
    <x:String x:Key="ImageView_DatHint">Generate .new.dat + .transfer.list (Android v4)</x:String>
    <x:String x:Key="ImageView_NoSelection">No image selected</x:String>
    <x:String x:Key="ImageView_NoProject">No project is open</x:String>
    <x:String x:Key="ImageView_OperationDone">Operation complete</x:String>

    <!-- Splash window -->
    <x:String x:Key="Splash_Subtitle">Firmware Toolbox</x:String>
    <x:String x:Key="Splash_Initializing">Initializing...</x:String>
    <x:String x:Key="Splash_Scanning">Scanning USB devices...</x:String>
    <x:String x:Key="Splash_FoundDevices">{0} device(s) found</x:String>
    <x:String x:Key="Splash_Preparing">Preparing main window...</x:String>

    <!-- MainWindow -->
    <x:String x:Key="MainWindow_Title">UotanStudio</x:String>
    <x:String x:Key="Document_BuildProp">build.prop</x:String>
    <x:String x:Key="Document_InitRc">init.rc</x:String>

    <!-- ProjectExplorer -->
    <x:String x:Key="ProjectExplorer_Outer">Outer</x:String>
    <x:String x:Key="ProjectExplorer_Inner">Inner</x:String>
    <x:String x:Key="ProjectExplorer_Innermost">Innermost</x:String>
    <x:String x:Key="Explorer_OpenAsText">Open as Text</x:String>
    <x:String x:Key="Explorer_OpenAsHex">Open as Hex</x:String>
    <x:String x:Key="Explorer_OpenAsDtb">Open as Device Tree</x:String>
    <x:String x:Key="Explorer_OpenAsDex">Open as DEX</x:String>
    <x:String x:Key="Explorer_OpenAsAxml">Open as Manifest</x:String>
    <x:String x:Key="Explorer_OpenAsArsc">Open as ARSC</x:String>
    <x:String x:Key="Explorer_OpenAsApk">Open as APK</x:String>
    <x:String x:Key="Explorer_OpenAsFirmware">Open in Firmware Info</x:String>
    <x:String x:Key="Explorer_OpenAsMenu">Open With</x:String>
    <x:String x:Key="Dock_Dtb_Save">Save</x:String>
    <x:String x:Key="Dock_Dtb_Tree">Device Tree</x:String>
    <x:String x:Key="Dock_Dtb_Source">Device Tree Source</x:String>
    <x:String x:Key="Dock_Dtb_CompileError">Compile Error</x:String>
    <x:String x:Key="Dock_Dex_Save">Rebuild &amp; Save</x:String>
    <x:String x:Key="Dock_Dex_Disassembling">Parsing and disassembling, please wait…</x:String>
    <x:String x:Key="Dock_Manifest_Save">Rebuild &amp; Save</x:String>
    <x:String x:Key="Dock_Manifest_Busy">Parsing manifest, please wait…</x:String>
    <x:String x:Key="Dock_Arsc_Save">Rebuild &amp; Save</x:String>
    <x:String x:Key="Dock_Arsc_Busy">Parsing resource table, please wait…</x:String>
    <x:String x:Key="Dock_Hex_Save">Save</x:String>
    <x:String x:Key="Dock_Hex_Busy">Loading file, please wait…</x:String>
    <x:String x:Key="Dock_Apk_Busy">Analyzing APK, please wait…</x:String>
    <x:String x:Key="FirmwareInfo_Title">Firmware Info</x:String>
    <x:String x:Key="FirmwareInfo_FormatName">Format Name</x:String>
    <x:String x:Key="FirmwareInfo_Summary">Summary</x:String>
    <x:String x:Key="FirmwareInfo_Metadata">Metadata</x:String>
    <x:String x:Key="FirmwareInfo_Entries">Entries</x:String>
    <x:String x:Key="FirmwareInfo_Components">Components</x:String>
    <x:String x:Key="FirmwareInfo_Loading">Loading firmware info, please wait…</x:String>
    <x:String x:Key="FirmwareInfo_Error">Failed to Read</x:String>
    <x:String x:Key="FirmwareInfo_Unrecognized">Unrecognized file format</x:String>

    <!-- PartitionEditor -->
    <x:String x:Key="Dock_Partition_Save">Save</x:String>
    <x:String x:Key="Dock_Partition_Partitions">Partitions</x:String>
    <x:String x:Key="Dock_Partition_Properties">Properties</x:String>
    <x:String x:Key="Dock_Partition_NoSelection">Select a partition to edit its properties.</x:String>
    <x:String x:Key="Dock_Partition_Name">Name</x:String>
    <x:String x:Key="Dock_Partition_Start">Start (sector)</x:String>
    <x:String x:Key="Dock_Partition_Size">Size (sectors)</x:String>
    <x:String x:Key="Dock_Partition_Type">Type</x:String>
    <x:String x:Key="Dock_Partition_TypeHint">e.g. linear / zero / mtd / 0x83 / GPT GUID</x:String>

    <!-- Compare tools -->
    <x:String x:Key="Compare_Equal">Equal</x:String>
    <x:String x:Key="Compare_Different">Different</x:String>
    <x:String x:Key="Compare_LeftOnly">Left Only</x:String>
    <x:String x:Key="Compare_RightOnly">Right Only</x:String>
    <x:String x:Key="Compare_Left">Left</x:String>
    <x:String x:Key="Compare_Right">Right</x:String>
    <x:String x:Key="Compare_Refresh">Refresh</x:String>
    <x:String x:Key="Compare_CopyLeftToRight">Copy → Right</x:String>
    <x:String x:Key="Compare_CopyRightToLeft">Copy → Left</x:String>
    <x:String x:Key="Compare_DeleteLeft">Delete Left</x:String>
    <x:String x:Key="Compare_DeleteRight">Delete Right</x:String>
    <x:String x:Key="Compare_OpenTextCompare">Open Text Compare</x:String>
    <x:String x:Key="Compare_NextDiff">Next Difference</x:String>
    <x:String x:Key="Compare_PrevDiff">Previous Difference</x:String>
    <x:String x:Key="Compare_Summary">Summary</x:String>
    <x:String x:Key="Compare_FileCompare">File Compare</x:String>
    <x:String x:Key="Compare_FolderCompare">Folder Compare</x:String>
    <x:String x:Key="Compare_DropHint">Drag two files or two folders here to compare them&#10;or pick them from the Tools menu.</x:String>
    <x:String x:Key="Compare_DropRightFile">Drop another file here to compare as the right side</x:String>
    <x:String x:Key="Compare_DropRightFolder">Drop another folder here to compare as the right side</x:String>
    <x:String x:Key="Compare_HexRaw">Raw Hex Data</x:String>
    <x:String x:Key="Compare_Metadata">Metadata</x:String>
    <x:String x:Key="Compare_Unrecognized">Unrecognized firmware format</x:String>

</ResourceDictionary>
