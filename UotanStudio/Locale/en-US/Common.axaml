    <x:String x:Key="Dock_Manifest_ToggleRightView">Switch right pane layout</x:String>
    <x:String x:Key="Dock_Arsc_Save">Rebuild &amp; Save</x:String>
    <x:String x:Key="Dock_Arsc_Busy">Parsing resource table, please wait…</x:String>
