    <x:String x:Key="Log_Channel_Flash">Flash</x:String>
    <x:String x:Key="Log_Channel_Firmware">Firmware</x:String>
    <x:String x:Key="Log_Channel_Build">Build</x:String>

    <!-- Workspace drag-drop -->
    <x:String x:Key="Workspace_DropNoFiles">Dropped content contains no openable files; ignored.</x:String>
    <x:String x:Key="Workspace_DropOpenFailed">Failed to open dropped files.</x:String>

    <!-- Flash wizard -->
    <x:String x:Key="FlashWizard_Title">Flash Wizard</x:String>
    <x:String x:Key="FlashWizard_ImagesHeader">Partition Images</x:String>
    <x:String x:Key="FlashWizard_DeviceHeader">Target Device</x:String>
    <x:String x:Key="FlashWizard_RulesHeader">Mode Whitelist Rules</x:String>
    <x:String x:Key="FlashWizard_NoDevice">No device selected</x:String>
    <x:String x:Key="FlashWizard_RuleFastboot">Fastboot mode can flash any partition (non-empty partition name)</x:String>
    <x:String x:Key="FlashWizard_RuleEdl">EDL requires a ready device and the partition matched against rawprogram</x:String>
    <x:String x:Key="FlashWizard_RuleRkdl">RKDL requires a ready device and a non-empty partition name</x:String>
    <x:String x:Key="FlashWizard_RuleAdbNotSupported">ADB supports sideload only; not supported by this wizard</x:String>
