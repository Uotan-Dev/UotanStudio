    <x:String x:Key="Tab_Log">Log</x:String>
    <x:String x:Key="Tab_Settings">Settings</x:String>
    <x:String x:Key="Tab_Compare">Compare</x:String>

    <!-- ViewLocator -->
    <x:String x:Key="ViewLocator_NotFound">Not Found: </x:String>

    <!-- ImageView -->
    <x:String x:Key="ImageView_CommonImages">Unpack</x:String>
    <x:String x:Key="ImageView_AllImages">Pack</x:String>
    <x:String x:Key="ImageView_Refresh">Refresh</x:String>
    <x:String x:Key="ImageView_ExtractSelected">Extract</x:String>
    <x:String x:Key="ImageView_SynthesizeImg">Build IMG</x:String>
    <x:String x:Key="ImageView_SynthesizeBr">Build BR</x:String>
    <x:String x:Key="ImageView_DeleteSelected">Delete</x:String>
    <x:String x:Key="ImageView_SynthesizeSuper">Build Super</x:String>
    <x:String x:Key="ImageView_SynthesizeDat">Build DAT</x:String>
    <x:String x:Key="ImageView_ImportHint">Import images into the project images/ folder</x:String>
    <x:String x:Key="ImageView_ExportHint">Export the selected image to an external path</x:String>
    <x:String x:Key="ImageView_ExtractHint">Unpack the selected image to intermediate/</x:String>
    <x:String x:Key="ImageView_SuperHint">Build a super image from the project's raw/sparse images</x:String>
    <x:String x:Key="ImageView_DatHint">Generate .new.dat + .transfer.list (Android v4)</x:String>
    <x:String x:Key="ImageView_NoSelection">No image selected</x:String>
    <x:String x:Key="ImageView_NoProject">No project is open</x:String>
    <x:String x:Key="ImageView_OperationDone">Operation complete</x:String>
    <x:String x:Key="ImageView_FlashWizard">Flash Wizard</x:String>
    <x:String x:Key="ImageView_FlashWizardHint">Open the one-click flash wizard</x:String>
    <x:String x:Key="ImageView_SelectHint">Include this image in batch operations</x:String>

    <!-- FirmwareInfo actions -->
    <x:String x:Key="FirmwareInfo_Verify">Verify</x:String>
    <x:String x:Key="FirmwareInfo_UnpackToProject">Unpack to Project</x:String>
    <x:String x:Key="FirmwareInfo_Result">Result</x:String>
    <x:String x:Key="FirmwareInfo_Verifying">Verifying…</x:String>
    <x:String x:Key="FirmwareInfo_Unpacking">Unpacking…</x:String>
    <x:String x:Key="FirmwareInfo_NoProject">No project is open; cannot unpack.</x:String>
    <x:String x:Key="FirmwareInfo_UnpackUnsupported">Unpacking to the project is not supported for this format.</x:String>

    <!-- Log channels -->
    <x:String x:Key="Log_Channel_All">All Channels</x:String>
