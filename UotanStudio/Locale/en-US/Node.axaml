    <x:String x:Key="Node_Choice_Xml">XML</x:String>
    <x:String x:Key="Node_Choice_Ini">INI (explicit dialect)</x:String>
    <x:String x:Key="Node_Choice_Elf">ELF</x:String>
    <x:String x:Key="Node_Choice_Sparse">Android sparse</x:String>
