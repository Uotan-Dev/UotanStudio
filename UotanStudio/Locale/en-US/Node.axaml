    <x:String x:Key="Node_Choice_Xz">XZ</x:String>
    <x:String x:Key="Node_Choice_Zstd">Zstandard</x:String>
    <x:String x:Key="Node_Choice_Lz4">LZ4</x:String>
    <x:String x:Key="Node_Choice_Bsdiff">bsdiff</x:String>
    <x:String x:Key="Node_Choice_Rockchip">Rockchip RKAF / RKFW</x:String>
    <x:String x:Key="Node_Choice_Ops">OnePlus OPS</x:String>
    <x:String x:Key="Node_Choice_Ozip">OPPO OZIP</x:String>
    <x:String x:Key="Node_Choice_Ntpi">NTPI</x:String>
    <x:String x:Key="Node_Choice_Amlogic">Amlogic ampack</x:String>
