<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Locale.EnUs.Settings">

    <x:String x:Key="Settings_General">General</x:String>
    <x:String x:Key="Settings_Firmware">Firmware Tools</x:String>
    <x:String x:Key="Settings_FirmwareParallelism">Parallel workers</x:String>
    <x:String x:Key="Settings_FirmwareParallelismHint">Default: detected physical core count. Range: 1-64. Applies to new firmware packing and extraction tasks that support parallel processing. More workers generally use more memory.</x:String>
    <x:String x:Key="Settings_ErofsLegacy">EROFS legacy layout</x:String>
    <x:String x:Key="Settings_ErofsLegacyHint">Build new EROFS images with the pre-5.13 layout (no big-pcluster) so Linux 5.4/5.10 kernels can mount them. Disable only when the target kernel is 5.13+ and a smaller image is preferred.</x:String>
    <x:String x:Key="Settings_Flash">Flash</x:String>
    <x:String x:Key="Settings_NodeEditor">Node Editor</x:String>
    <x:String x:Key="Settings_Language">Language</x:String>
    <x:String x:Key="Settings_Theme">Theme</x:String>
    <x:String x:Key="Settings_ThemeDefault">Follow System</x:String>
    <x:String x:Key="Settings_ThemeLight">Light</x:String>
    <x:String x:Key="Settings_ThemeDark">Dark</x:String>
    <x:String x:Key="Settings_AutoSave">Auto Save</x:String>
    <x:String x:Key="Settings_DebugMode">Debug Mode</x:String>
    <x:String x:Key="Settings_UnpackToolPath">Unpack Tool Path</x:String>
    <x:String x:Key="Settings_TempDir">Temp Directory</x:String>
    <x:String x:Key="Settings_AutoVerify">Auto Verify After Unpack</x:String>
    <x:String x:Key="Settings_PathPlaceholder">Enter path...</x:String>
    <x:String x:Key="Settings_DeviceTimeout">Device Timeout</x:String>
    <x:String x:Key="Settings_AutoBackup">Auto Backup Before Flash</x:String>
    <x:String x:Key="Settings_SnapToGrid">Snap to Grid</x:String>
    <x:String x:Key="Settings_GridSize">Grid Size</x:String>
    <x:String x:Key="Settings_ConnectionStyle">Connection Style</x:String>
    <x:String x:Key="Settings_ConnBezier">Bezier</x:String>
    <x:String x:Key="Settings_ConnLine">Line</x:String>
    <x:String x:Key="Settings_ConnStep">Step</x:String>
    <x:String x:Key="Settings_Appearance">Appearance</x:String>
    <x:String x:Key="Settings_ThemePreview">Theme Preview</x:String>
    <x:String x:Key="Settings_LanguageAutoDetect">Auto Detect</x:String>
    <x:String x:Key="Settings_LanguagePreview">Language Preview</x:String>
    <x:String x:Key="Settings_LanguagePreviewText">This is a preview of the selected language.</x:String>
    <x:String x:Key="Settings_VersionInfo">Version Information</x:String>
    <x:String x:Key="Settings_FirmwareModule">Firmware Unpack Module</x:String>
    <x:String x:Key="Settings_FlashModule">Board Flash Module</x:String>
    <x:String x:Key="Settings_VisualProgrammingModule">Visual Programming Module</x:String>
    <x:String x:Key="Settings_Version">Version</x:String>
    <x:String x:Key="Settings_CheckForUpdates">Check for Updates</x:String>
    <x:String x:Key="Settings_CheckingUpdates">Checking...</x:String>
    <x:String x:Key="Settings_UpToDate">Already up to date</x:String>
    <x:String x:Key="Settings_UpdateAvailable">Update available</x:String>
    <x:String x:Key="Settings_UpdateCheckFailed">Update check failed</x:String>
    <x:String x:Key="Settings_ResetToDefaults">Reset to Defaults</x:String>
    <x:String x:Key="Settings_ResetConfirm">Are you sure you want to reset all settings to defaults?</x:String>
    <x:String x:Key="Settings_SettingsSaved">Settings saved</x:String>
    <x:String x:Key="Settings_SaveFailed">Could not save settings: {0}</x:String>
    <x:String x:Key="Settings_ThemeFollowSystem">Follow System</x:String>
    <x:String x:Key="Settings_ThemeLightMode">Light Mode</x:String>
    <x:String x:Key="Settings_ThemeDarkMode">Dark Mode</x:String>
    <x:String x:Key="Settings_AutoDetect">Auto Detect</x:String>
    <x:String x:Key="Settings_AdbPath">ADB Path</x:String>
    <x:String x:Key="Settings_FastbootPath">Fastboot Path</x:String>
    <x:String x:Key="Settings_Mcp">MCP</x:String>
    <x:String x:Key="Settings_McpHint">Maintain MCP server connections and the local exposure port here; values are written to the application settings when saved.</x:String>
    <x:String x:Key="Settings_McpServerName">Name</x:String>
    <x:String x:Key="Settings_McpTransport">Transport</x:String>
    <x:String x:Key="Settings_McpCommand">Command</x:String>
    <x:String x:Key="Settings_McpArguments">Arguments</x:String>
    <x:String x:Key="Settings_McpUrl">URL</x:String>
    <x:String x:Key="Settings_McpEnabled">Enabled</x:String>
    <x:String x:Key="Settings_McpAdd">Add Server</x:String>
    <x:String x:Key="Settings_McpRemove">Remove</x:String>
    <x:String x:Key="Settings_McpExpose">Expose as MCP server</x:String>
    <x:String x:Key="Settings_McpExposePort">Port</x:String>
    <x:String x:Key="Settings_McpSave">Save MCP Settings</x:String>
    <x:String x:Key="Settings_McpExposeRoot">Sandbox root</x:String>
    <x:String x:Key="Settings_McpExposeRootPlaceholder">Full directory path (empty = unrestricted)</x:String>
    <x:String x:Key="Settings_McpExposeRootPick">Select the MCP sandbox root</x:String>
    <x:String x:Key="Settings_McpExposeRootHint">Every file path an MCP client sends must resolve inside this directory. Leaving it empty exposes the whole filesystem, the behavior this setting replaces.</x:String>
    <x:String x:Key="Settings_McpExposeFlash">Allow flash tools</x:String>
    <x:String x:Key="Settings_McpExposeFlashWarning">Warning: enabling this registers the wiping, flashing and reboot tools on the loopback port, so any local process that can reach that port can erase or rewrite partitions on a connected device and reboot it. Keep it off unless you trust every program running on this machine.</x:String>
    <x:String x:Key="Settings_Developers">Developers</x:String>
    <x:String x:Key="Settings_GitHub">GitHub</x:String>
    <x:String x:Key="Settings_Coolapk">Coolapk</x:String>

    <x:String x:Key="Settings_AI">AI Assistant</x:String>
    <x:String x:Key="Settings_AIEndpoint">API endpoint</x:String>
    <x:String x:Key="Settings_AIApiKey">API key</x:String>
    <x:String x:Key="Settings_AIToggleKey">Show / hide API key</x:String>
    <x:String x:Key="Settings_AIModels">Model</x:String>
    <x:String x:Key="Settings_AIFetchModels">Get models</x:String>
    <x:String x:Key="Settings_DeviceCommunication">Device communication</x:String>
    <x:String x:Key="Settings_UsbBackend">USB backend</x:String>
    <x:String x:Key="Settings_UsbAuto">Automatic (platform default)</x:String>
    <x:String x:Key="Settings_UsbNative">Force platform native</x:String>
    <x:String x:Key="Settings_UsbLibusb">Force libusb</x:String>
    <x:String x:Key="Settings_AdbServer">ADB server</x:String>
    <x:String x:Key="Settings_HdcServer">HDC server</x:String>
    <x:String x:Key="Settings_ServerUnchecked">Not checked</x:String>
    <x:String x:Key="Settings_ServerListening">Endpoint listening</x:String>
    <x:String x:Key="Settings_ServerAbsent">Not running (connection refused)</x:String>
    <x:String x:Key="Settings_ServerUnknown">Unknown (connection error or timeout)</x:String>
    <x:String x:Key="Settings_StopAdbServer">Stop ADB server</x:String>
    <x:String x:Key="Settings_StopHdcServer">Stop HDC server</x:String>
    <x:String x:Key="Settings_ServerStopping">Stopping server…</x:String>
    <x:String x:Key="Settings_ServerStopped">Server stop confirmed. Device list refresh requested.</x:String>
    <x:String x:Key="Settings_ServerStopFailed">Could not stop server: {0}</x:String>
</ResourceDictionary>