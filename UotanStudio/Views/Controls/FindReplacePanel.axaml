<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://irihi.tech/iconica/tdesign"
             x:Class="UotanStudio.Views.Controls.FindReplacePanel"
             AutomationProperties.Name="{DynamicResource FindReplace_Title}">
  <UserControl.Styles>
    <Style Selector="Button.find-tool, ToggleButton.find-tool">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.find-tool:checked">
      <Setter Property="Background" Value="{DynamicResource EditorPaneSplitterBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
    </Style>
    <Style Selector="Button.find-tool icons|TDesignIconBase, ToggleButton.find-tool icons|TDesignIconBase">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ToggleButton#ReplaceToggle">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource FindReplace_Expand}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource FindReplace_Expand}" />
    </Style>
    <Style Selector="ToggleButton#ReplaceToggle:checked">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource FindReplace_Collapse}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource FindReplace_Collapse}" />
    </Style>
    <Style Selector="TextBox.find-input">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="4" Padding="4" BoxShadow="0 2 8 0 #30000000">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="22,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="2" RowSpacing="3">
      <ToggleButton Name="ReplaceToggle" Classes="find-tool" IsChecked="True">
        <Grid Width="16" Height="16">
          <icons:ChevronUp IsVisible="{Binding #ReplaceToggle.IsChecked}" />
          <icons:ChevronDown IsVisible="{Binding !#ReplaceToggle.IsChecked}" />
        </Grid>
      </ToggleButton>
      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="2">
        <TextBox Name="FindBox" Classes="find-input" PlaceholderText="{DynamicResource FindReplace_FindPlaceholder}"
                 AutomationProperties.Name="{DynamicResource FindReplace_Find}">
          <TextBox.InnerRightContent>
            <icons:Search Width="14" Height="14" Margin="0,0,4,0" Opacity="0.65" />
          </TextBox.InnerRightContent>
        </TextBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
          <Button Name="PreviousButton" Click="OnPreviousClick" Classes="find-tool" IsEnabled="False" ToolTip.Tip="{DynamicResource FindReplace_Previous}"
                  AutomationProperties.Name="{DynamicResource FindReplace_Previous}">
            <icons:ArrowUp />
          </Button>
          <Button Name="NextButton" Click="OnNextClick" Classes="find-tool" IsEnabled="False" ToolTip.Tip="{DynamicResource FindReplace_Next}"
                  AutomationProperties.Name="{DynamicResource FindReplace_Next}">
            <icons:ArrowDown />
          </Button>
          <Button Name="CloseButton" Classes="find-tool" Click="OnCloseClick" ToolTip.Tip="{DynamicResource FindReplace_Close}"
                  AutomationProperties.Name="{DynamicResource FindReplace_Close}">
            <icons:Close />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="2"
            IsVisible="{Binding #ReplaceToggle.IsChecked}">
        <TextBox Name="ReplaceBox" Classes="find-input" PlaceholderText="{DynamicResource FindReplace_ReplacePlaceholder}"
                 AutomationProperties.Name="{DynamicResource FindReplace_Replace}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1" Margin="0,0,23,0">
          <Button Name="ReplaceButton" Click="OnReplaceClick" Classes="find-tool" IsEnabled="False" ToolTip.Tip="{DynamicResource FindReplace_Replace}"
                  AutomationProperties.Name="{DynamicResource FindReplace_Replace}">
            <icons:Search />
          </Button>
          <Button Name="ReplaceAllButton" Click="OnReplaceAllClick" Classes="find-tool" IsEnabled="False" ToolTip.Tip="{DynamicResource FindReplace_ReplaceAll}"
                  AutomationProperties.Name="{DynamicResource FindReplace_ReplaceAll}">
            <icons:File />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="1">
          <ToggleButton Name="MatchCaseToggle" Classes="find-tool" ToolTip.Tip="{DynamicResource FindReplace_MatchCase}"
                        AutomationProperties.Name="{DynamicResource FindReplace_MatchCase}">
            <icons:Text />
          </ToggleButton>
          <ToggleButton Name="WholeWordToggle" Classes="find-tool" ToolTip.Tip="{DynamicResource FindReplace_WholeWord}"
                        AutomationProperties.Name="{DynamicResource FindReplace_WholeWord}">
            <icons:TextformatUnderline />
          </ToggleButton>
          <ToggleButton Name="RegexToggle" Classes="find-tool" ToolTip.Tip="{DynamicResource FindReplace_Regex}"
                        AutomationProperties.Name="{DynamicResource FindReplace_Regex}">
            <icons:Code />
          </ToggleButton>
          <ToggleButton Name="PreserveCaseToggle" Classes="find-tool" ToolTip.Tip="{DynamicResource FindReplace_PreserveCase}"
                        AutomationProperties.Name="{DynamicResource FindReplace_PreserveCase}">
            <icons:Text />
          </ToggleButton>
        </StackPanel>
        <ComboBox Name="ScopeBox" Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                  Height="22" MinHeight="0" FontSize="12" Padding="6,0"
                  VerticalContentAlignment="Center" SelectedIndex="0"
                  ToolTip.Tip="{DynamicResource FindReplace_Scope}" AutomationProperties.Name="{DynamicResource FindReplace_Scope}">
          <ComboBoxItem Content="{DynamicResource FindReplace_CurrentDocument}" />
          <ComboBoxItem Content="{DynamicResource FindReplace_Selection}" />
          <ComboBoxItem Content="{DynamicResource FindReplace_OpenDocuments}" />
          <ComboBoxItem Content="{DynamicResource FindReplace_Project}" />
        </ComboBox>
      </Grid>
      <TextBlock Name="ResultStatus" Grid.Row="3" Grid.ColumnSpan="2" FontSize="11"
                 TextWrapping="Wrap" MaxWidth="280" Margin="2,0" />
    </Grid>
    </ScrollViewer>
  </Border>
</UserControl>
