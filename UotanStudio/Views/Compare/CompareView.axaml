<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="https://irihi.tech/iconica/tdesign"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:vm="using:UotanStudio.ViewModels.Compare"
             xmlns:compareviews="using:UotanStudio.Views.Compare"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Compare.CompareView"
             x:DataType="vm:CompareViewModel"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.Drop="OnDrop">
  <!-- 透明背景必须显式给出：Avalonia 命中测试只落到有 Background 的元素，无背景时空白区域
       InputHitTest 失败，DragDropDevice.GetTarget 返回 null 导致 OS 光标显示禁止。 -->
  <!-- Transparent background is required: Avalonia hit-testing only lands on elements with a
       Background, so without it InputHitTest fails on empty areas and DragDropDevice.GetTarget
       returns null, making the OS cursor show the "not allowed" glyph. -->
  <UserControl.Resources>
    <!-- 行模板（左/右）：目录树行渲染展开箭头 + 资源管理器图标 + 名称，文本行渲染行号 + 文本；
         两侧共用同一份行列表，因此同名条目落在同一行、单侧条目在另一侧自动留空。
         整行变色规则与 Beyond Compare 一致：不同 → 两侧整行高亮，仅单侧 → 该侧淡色背景。 -->
    <!-- Row templates (left/right): a tree row renders the expander, the explorer glyph and the name, a text
         row renders the line number and text. Both panes share one row list, so same-name entries share a row
         and single-side entries stay blank on the other side. Whole-row colouring follows Beyond Compare:
         different → both rows highlighted, single-side → that side tinted. -->
    <DataTemplate x:Key="CompareLeftRowTemplate" x:DataType="vm:CompareRowViewModel">
      <!-- 整行可命中：Grid 没有背景时空白区域不参与命中测试，右键菜单只会在文件名那一段生效。 -->
      <!-- The whole row is hit-testable: without a background a Grid ignores empty areas, so the context menu only appeared over the
           file name. -->
      <Grid ColumnDefinitions="3,*" MinHeight="20" Background="Transparent" ContextRequested="OnRowContextRequested">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Compare_CopyTextToOtherSide}" Tag="Left"
                      IsVisible="{Binding ShowTextTransfer}" Click="OnCopyTextToOtherSide" />
            <MenuItem Header="{DynamicResource Compare_DeleteSelectedRows}" Tag="Left"
                      IsVisible="{Binding ShowTextTransfer}" Click="OnDeleteSelectedTextRows" />
            <MenuItem Header="{DynamicResource Compare_CopyToOtherSide}" Tag="Left"
                      IsVisible="{Binding ShowComparedTransfers}" Click="OnCopyToOtherSide" />
            <MenuItem Header="{DynamicResource Compare_MoveToOtherSide}" Tag="Left"
                      IsVisible="{Binding ShowComparedTransfers}" Click="OnMoveToOtherSide" />
            <MenuItem Header="{DynamicResource Compare_CopyToLeftColumn}" Tag="Left"
                      IsVisible="{Binding ShowBrowsingTransfers}" Click="OnCopyToNeighbourColumn" />
            <MenuItem Header="{DynamicResource Compare_CopyToRightColumn}" Tag="Right"
                      IsVisible="{Binding ShowBrowsingTransfers}" Click="OnCopyToNeighbourColumn" />
            <MenuItem Header="{DynamicResource Compare_MoveToLeftColumn}" Tag="Left"
                      IsVisible="{Binding ShowBrowsingTransfers}" Click="OnMoveToNeighbourColumn" />
            <MenuItem Header="{DynamicResource Compare_MoveToRightColumn}" Tag="Right"
                      IsVisible="{Binding ShowBrowsingTransfers}" Click="OnMoveToNeighbourColumn" />
            <Separator IsVisible="{Binding ShowEntryMenu}" />
            <MenuItem Header="{DynamicResource Menu_Delete}" IsVisible="{Binding ShowEntryMenu}" Tag="Left"
                      Click="OnDeleteEntry" />
            <MenuItem Header="{DynamicResource Explorer_Rename}" IsVisible="{Binding ShowEntryMenu}" Tag="Left"
                      Click="OnRenameEntry" />
            <MenuItem Header="{DynamicResource Explorer_NewFolder}" IsVisible="{Binding ShowEntryMenu}" Tag="Left"
                      Click="OnCreateFolder" />
            <MenuItem Header="{DynamicResource Explorer_CopyFullPath}" IsVisible="{Binding ShowEntryMenu}" Tag="Left"
                      Click="OnCopyEntryPath" />
            <MenuItem Header="{DynamicResource Compare_EnterFolder}" IsVisible="{Binding ShowBrowsingEntryFolder}"
                      Tag="Left" Click="OnEnterFolder" />
            <MenuItem Header="{DynamicResource Explorer_OpenInFileExplorer}" IsVisible="{Binding ShowEntryMenu}" Tag="Left"
                      Click="OnOpenEntryInExplorer" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Border Grid.ColumnSpan="2" Background="{Binding LeftTintBrush}"
                IsVisible="{Binding LeftTintBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Grid.ColumnSpan="2" Background="{DynamicResource DiffBackgroundBrush}"
                IsVisible="{Binding IsLeftDiff}" />
        <Border Grid.Column="0" Width="3" Background="{Binding StatusBrush}"
                Margin="2,3" CornerRadius="2" IsVisible="{Binding !IsLeftEmpty}" />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto"
              Margin="{Binding Depth, Converter={x:Static compareviews:DepthToIndentConverter.Instance}}">
          <controls:AppIcon Grid.Column="0" Kind="{Binding LeftIconKind}" Foreground="{Binding LeftIconBrush}"
                                 Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="0,0,4,0" IsVisible="{Binding ShowLeftIcon}" />
          <TextBlock Grid.Column="1" Text="{Binding LeftLine}" FontSize="11" Opacity="0.6" MinWidth="32"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="2,0,4,0"
                     IsVisible="{Binding ShowLeftLineNumber}" />
          <TextBlock Grid.Column="2" Text="{Binding LeftText}" FontFamily="Consolas" FontSize="12"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding ShowLeftText}" />
          <!-- 对比中该侧没有这一行 → 用斜杠占位，保持同行对应关系一眼可见。 -->
          <!-- The comparison has no such row on this side → a slash placeholder keeps the row alignment visible. -->
          <TextBlock Grid.Column="2" Text="/" FontFamily="Consolas" FontSize="12" Opacity="0.35"
                     VerticalAlignment="Center" IsVisible="{Binding ShowLeftFiller}" />
          <!-- 文本对比中该行可编辑：直接在行内改文本，鼠标可拖拽选中，顶部两个复制按钮把选中行推到另一侧。 -->
          <!-- Editable in a text comparison: the text is edited in place, mouse selection works, and the toolbar's copy
               buttons push the selected rows to the other side. -->
          <TextBox Grid.Column="2" Text="{Binding LeftText, Mode=TwoWay}" FontFamily="Consolas" FontSize="12"
                   IsVisible="{Binding IsEditable}" BorderThickness="0" Background="Transparent" Padding="0"
                   MinHeight="0" Height="20" VerticalContentAlignment="Center" AcceptsReturn="False"
                   PlaceholderText="{Binding ComparedFiller}"
                   KeyDown="OnRowEditorKeyDown" />
          <TextBlock Grid.Column="3" Text="{Binding LeftSub}" FontSize="11" Opacity="0.6"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,6,0"
                     IsVisible="{Binding !IsLeftEmpty}" />
        </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CompareRightRowTemplate" x:DataType="vm:CompareRowViewModel">
      <Grid ColumnDefinitions="3,*" MinHeight="20" Background="Transparent" ContextRequested="OnRowContextRequested">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Compare_CopyTextToOtherSide}" Tag="Right"
                      IsVisible="{Binding ShowTextTransfer}" Click="OnCopyTextToOtherSide" />
            <MenuItem Header="{DynamicResource Compare_DeleteSelectedRows}" Tag="Right"
                      IsVisible="{Binding ShowTextTransfer}" Click="OnDeleteSelectedTextRows" />
            <MenuItem Header="{DynamicResource Compare_CopyToOtherSide}" Tag="Right"
                      IsVisible="{Binding ShowComparedTransfers}" Click="OnCopyToOtherSide" />
            <MenuItem Header="{DynamicResource Compare_MoveToOtherSide}" Tag="Right"
                      IsVisible="{Binding ShowComparedTransfers}" Click="OnMoveToOtherSide" />
            <Separator IsVisible="{Binding ShowEntryMenu}" />
            <MenuItem Header="{DynamicResource Menu_Delete}" IsVisible="{Binding ShowEntryMenu}" Tag="Right"
                      Click="OnDeleteEntry" />
            <MenuItem Header="{DynamicResource Explorer_Rename}" IsVisible="{Binding ShowEntryMenu}" Tag="Right"
                      Click="OnRenameEntry" />
            <MenuItem Header="{DynamicResource Explorer_NewFolder}" IsVisible="{Binding ShowEntryMenu}" Tag="Right"
                      Click="OnCreateFolder" />
            <MenuItem Header="{DynamicResource Explorer_CopyFullPath}" IsVisible="{Binding ShowEntryMenu}" Tag="Right"
                      Click="OnCopyEntryPath" />
            <MenuItem Header="{DynamicResource Explorer_OpenInFileExplorer}" IsVisible="{Binding ShowEntryMenu}" Tag="Right"
                      Click="OnOpenEntryInExplorer" />
          </ContextMenu>
        </Grid.ContextMenu>
        <Border Grid.ColumnSpan="2" Background="{Binding RightTintBrush}"
                IsVisible="{Binding RightTintBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Grid.ColumnSpan="2" Background="{DynamicResource DiffBackgroundBrush}"
                IsVisible="{Binding IsRightDiff}" />
        <Border Grid.Column="0" Width="3" Background="{Binding StatusBrush}"
                Margin="2,3" CornerRadius="2" IsVisible="{Binding !IsRightEmpty}" />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto"
              Margin="{Binding Depth, Converter={x:Static compareviews:DepthToIndentConverter.Instance}}">
          <controls:AppIcon Grid.Column="0" Kind="{Binding RightIconKind}" Foreground="{Binding RightIconBrush}"
                                 Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="0,0,4,0" IsVisible="{Binding ShowRightIcon}" />
          <TextBlock Grid.Column="1" Text="{Binding RightLine}" FontSize="11" Opacity="0.6" MinWidth="32"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="2,0,4,0"
                     IsVisible="{Binding ShowRightLineNumber}" />
          <TextBlock Grid.Column="2" Text="{Binding RightText}" FontFamily="Consolas" FontSize="12"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding ShowRightText}" />
          <TextBlock Grid.Column="2" Text="/" FontFamily="Consolas" FontSize="12" Opacity="0.35"
                     VerticalAlignment="Center" IsVisible="{Binding ShowRightFiller}" />
          <TextBox Grid.Column="2" Text="{Binding RightText, Mode=TwoWay}" FontFamily="Consolas" FontSize="12"
                   IsVisible="{Binding IsEditable}" BorderThickness="0" Background="Transparent" Padding="0"
                   MinHeight="0" Height="20" VerticalContentAlignment="Center" AcceptsReturn="False"
                   PlaceholderText="{Binding ComparedFiller}"
                   KeyDown="OnRowEditorKeyDown" />
          <TextBlock Grid.Column="3" Text="{Binding RightSub}" FontSize="11" Opacity="0.6"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,6,0"
                     IsVisible="{Binding !IsRightEmpty}" />
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- 单个文件列：列头（按钮在路径左侧，确认与关闭在路径右侧）+ 行列表。
         列头按钮尺寸与 LogEditorView 顶部按钮一致（20×20，图标 12）。 -->
    <!-- One file column: header (buttons left of the path, confirm/close right of it) plus the row list.
         Header buttons match the LogEditorView toolbar size (20×20, 12 icon). -->
    <DataTemplate x:Key="CompareColumnTemplate" x:DataType="vm:CompareColumnViewModel">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="4,3"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="Small" Command="{Binding ReloadCommand}"
                      ToolTip.Tip="{DynamicResource Compare_Refresh}"
                      AutomationProperties.Name="{DynamicResource Compare_Refresh}">
                <avalonia:Refresh />
              </Button>
              <Button Classes="Small" Command="{Binding GoUpCommand}"
                      ToolTip.Tip="{DynamicResource Compare_GoUp}"
                      AutomationProperties.Name="{DynamicResource Compare_GoUp}">
                <avalonia:ArrowUp />
              </Button>
              <Button Classes="Small" Command="{Binding ToggleHexViewCommand}" IsVisible="{Binding ShowHexToggle}"
                      ToolTip.Tip="{DynamicResource Compare_HexRaw}"
                      AutomationProperties.Name="{DynamicResource Compare_HexRaw}">
                <avalonia:Brackets />
              </Button>
              <Button Classes="Small" Command="{Binding PrevDiffCommand}" IsVisible="{Binding ShowDiffNavigation}"
                      ToolTip.Tip="{DynamicResource Compare_PrevDiff}"
                      AutomationProperties.Name="{DynamicResource Compare_PrevDiff}">
                <avalonia:ArrowUp />
              </Button>
              <Button Classes="Small" Command="{Binding NextDiffCommand}" IsVisible="{Binding ShowDiffNavigation}"
                      ToolTip.Tip="{DynamicResource Compare_NextDiff}"
                      AutomationProperties.Name="{DynamicResource Compare_NextDiff}">
                <avalonia:ArrowDown />
              </Button>
            </StackPanel>
            <TextBox Grid.Column="1" Classes="Small" Height="22" MinHeight="0" FontSize="11" Padding="4,0"
                     FontFamily="Consolas" VerticalContentAlignment="Center"
                     Text="{Binding Path, Mode=TwoWay}" ToolTip.Tip="{Binding Path}"
                     PlaceholderText="{DynamicResource Compare_PathPlaceholder}"
                     AutomationProperties.Name="{DynamicResource Compare_PathPlaceholder}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="Small" Command="{Binding ConfirmPathCommand}"
                      ToolTip.Tip="{DynamicResource Compare_LoadPath}"
                      AutomationProperties.Name="{DynamicResource Compare_LoadPath}">
                <avalonia:Check />
              </Button>
              <!-- 文本对比编辑后出现：把本列内容写回文件（保留原编码与换行风格）。 -->
              <!-- Appears after text-comparison edits: writes this column's content back to the file. -->
              <Button Classes="Small" Command="{Binding SaveCommand}" IsVisible="{Binding IsDirty}"
                      ToolTip.Tip="{DynamicResource Compare_SaveFile}"
                      AutomationProperties.Name="{DynamicResource Compare_SaveFile}">
                <avalonia:Save />
              </Button>
              <Button Classes="Small" Command="{Binding CloseCommand}" IsVisible="{Binding CanClose}"
                      ToolTip.Tip="{DynamicResource Compare_CloseColumn}"
                      AutomationProperties.Name="{DynamicResource Compare_CloseColumn}">
                <avalonia:Close />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" IsVisible="{Binding IsBusy}" />

        <Grid>
          <!-- 文本对比：两侧各一个项目文本编辑器（行=对齐槽，填充槽显示斜杠；跨行选择、增删行、撤销/重做、多行粘贴
               都是编辑器原生行为，改动会被翻译成槽操作并同步到另一侧）。 -->
          <!-- Text comparison: one project text editor per side (one line per aligned slot, slashes for fillers). Cross-line
               selection, line insert/delete, undo/redo and multi-line paste are native, and every change is translated into
               slot operations and mirrored to the other side. -->
          <edit:TextEditor x:Name="CompareTextEditor" IsVisible="{Binding IsCompareTextEditorVisible}"
                           FontFamily="Consolas,monospace" FontSize="12" Padding="6,2"
                           Background="Transparent" Foreground="{DynamicResource TextForeground}"
                           ShowLineNumbers="True" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- 文本对比编辑器：常用编辑命令 + 把选中的行/文字复制到另一侧相同位置。 -->
            <!-- Text-comparison editor: the usual editing commands plus "copy the selected lines/text to the same place on the other side". -->
            <edit:TextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Compare_CopyTextToOtherSide}" Tag="CopyToOtherSide"
                          Click="OnCopyEditorSelectionToOtherSide" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_Cut}" Click="OnEditorCut" />
                <MenuItem Header="{DynamicResource Menu_Copy}" Click="OnEditorCopy" />
                <MenuItem Header="{DynamicResource Menu_Paste}" Click="OnEditorPaste" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_SelectAll}" Click="OnEditorSelectAll" />
              </ContextMenu>
            </edit:TextEditor.ContextMenu>
          </edit:TextEditor>

          <!-- 浏览文本文件：使用项目文本编辑器（真正的多行编辑、跨行选择、撤销/重做、多行粘贴）。 -->
          <!-- Browsing a text file: the project's text editor (real multi-line editing, cross-line selection, undo/redo,
               multi-line paste). -->
          <edit:TextEditor x:Name="BrowseTextEditor" IsVisible="{Binding IsBrowsingTextEditor}"
                           FontFamily="Consolas,monospace" FontSize="12" Padding="6,2"
                           Background="Transparent" Foreground="{DynamicResource TextForeground}"
                           ShowLineNumbers="True" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- 浏览文本编辑器：当前 AvaloniaEdit 版本没有自带右键菜单，这里补回常用编辑命令。 -->
            <!-- Browsing text editor: this AvaloniaEdit version ships no built-in context menu, so the usual editing commands are restored. -->
            <edit:TextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Menu_Cut}" Click="OnEditorCut" />
                <MenuItem Header="{DynamicResource Menu_Copy}" Click="OnEditorCopy" />
                <MenuItem Header="{DynamicResource Menu_Paste}" Click="OnEditorPaste" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu_SelectAll}" Click="OnEditorSelectAll" />
              </ContextMenu>
            </edit:TextEditor.ContextMenu>
          </edit:TextEditor>

          <!-- 左单元格行列表：浏览列显示目录树行或文件内容，对比左列显示对比结果左侧。 -->
          <!-- Left-cell row list: a browsing column shows tree rows or file content, the compare left column
               shows the comparison's left side. -->
          <ListBox x:Name="LeftCellsList" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowLeftCells}"
                   Classes="compare-rows" SelectionChanged="OnRowSelectionChanged"
                   SelectionMode="{Binding RowSelectionMode}"
                   AutoScrollToSelectedItem="False" Background="Transparent"
                   KeyDown="OnRowListKeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ItemTemplate="{StaticResource CompareLeftRowTemplate}" />

          <!-- 右单元格行列表：仅对比右列使用。 -->
          <!-- Right-cell row list: used by the compare right column only. -->
          <ListBox x:Name="RightCellsList" ItemsSource="{Binding Rows}" IsVisible="{Binding ShowRightCells}"
                   Classes="compare-rows" SelectionChanged="OnRowSelectionChanged"
                   SelectionMode="{Binding RowSelectionMode}"
                   AutoScrollToSelectedItem="False" Background="Transparent"
                   KeyDown="OnRowListKeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ItemTemplate="{StaticResource CompareRightRowTemplate}" />

          <!-- 列内空态提示 -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="12"
                      IsVisible="{Binding ShowHint}">
            <avalonia:FolderSearch Width="24" Height="24" Opacity="0.3"
                                   HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Compare_ColumnHint}" IsVisible="{Binding IsBrowsing}"
                       FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Compare_CompareEmpty}" IsVisible="{Binding IsCompareSide}"
                       FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </DataTemplate>

    <!-- 列间隔的 1px 分割线；可拖动的 GridSplitter 由代码直接放进列网格（放进模板内无法定位
         自己的列，导致拖不动）。 -->
    <!-- The 1px divider line of a column gap; the draggable GridSplitter is placed directly in the column
         grid by code (inside a template it cannot resolve its own column and never drags). -->
    <ControlTemplate x:Key="CompareDividerTemplate">
      <Border Width="1" HorizontalAlignment="Center"
              Background="{DynamicResource EditorPaneSplitterBackgroundBrush}"
              IsHitTestVisible="False" />
    </ControlTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 顶部与列头按钮尺寸参考 LogEditorView（20×20，图标 12）。 -->
    <!-- Toolbar and column-header buttons match LogEditorView's size (20×20, 12 icon). -->
    <Style Selector="Button.Small">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 图标控件是 TDesignIconBase 的派生类型，必须用 :is() 匹配基类；裸类型只匹配具体类型。 -->
    <!-- Icon controls derive from TDesignIconBase, so :is() is required; a bare type matches the exact type only. -->
    <Style Selector="Button.Small :is(avalonia|TDesignIconBase)">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <!-- 目录树行的展开箭头：透明背景、只在悬停时给出反馈，尺寸对齐行高。 -->
    <!-- The tree row's expander: transparent, hover feedback only, sized to the row height. -->
    <Style Selector="Button.tree-expander">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tree-expander :is(avalonia|TDesignIconBase)">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- 行列表：行内容自绘边框与背景，容器不额外留白。 -->
    <!-- Row lists: rows draw their own border and background, containers add no padding. -->
    <Style Selector="ListBox.compare-rows">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.compare-rows > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Grid Background="Transparent">
    <DockPanel>
      <!-- 顶栏：左侧两个复制按钮，右侧「开启/结束对比」与「添加文件夹」；其余按钮在各列路径行。 -->
      <!-- Toolbar: the two copy buttons on the left, start/stop-compare and add-folder on the right; every
           other button lives on a column's path row. -->
      <Border DockPanel.Dock="Top" Padding="6,4"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <!-- 左右两侧都是星号列，中间的复制按钮因此相对整条顶栏真正水平居中（而不是被挤到右侧）。 -->
        <!-- Both sides are star columns so the copy buttons in the middle are centred against the whole toolbar instead of being pushed right. -->
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="{Binding StatsText}" FontSize="12" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <!-- 两个复制按钮放在顶栏中间，且仅在对比状态下显示。 -->
          <!-- The two copy buttons sit in the middle of the toolbar and only appear while comparing. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      HorizontalAlignment="Center" IsVisible="{Binding IsComparing}">
            <Button Classes="Small" Command="{Binding CopyLeftToRightCommand}"
                    ToolTip.Tip="{DynamicResource Compare_CopyLeftToRight}"
                    AutomationProperties.Name="{DynamicResource Compare_CopyLeftToRight}">
              <avalonia:ArrowRight />
            </Button>
            <Button Classes="Small" Command="{Binding CopyRightToLeftCommand}"
                    ToolTip.Tip="{DynamicResource Compare_CopyRightToLeft}"
                    AutomationProperties.Name="{DynamicResource Compare_CopyRightToLeft}">
              <avalonia:ArrowLeft />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <Button Classes="Small" Command="{Binding ToggleCompareCommand}"
                    AutomationProperties.Name="{DynamicResource Compare_StartCompare}">
              <ToolTip.Tip>
                <Panel>
                  <TextBlock Text="{DynamicResource Compare_StartCompare}" IsVisible="{Binding !IsComparing}" />
                  <TextBlock Text="{DynamicResource Compare_StopCompare}" IsVisible="{Binding IsComparing}" />
                </Panel>
              </ToolTip.Tip>
              <Panel>
                <avalonia:FileCopy IsVisible="{Binding !IsComparing}" />
                <avalonia:CloseCircle IsVisible="{Binding IsComparing}" />
              </Panel>
            </Button>
            <Button Classes="Small" Click="OnAddFoldersClick"
                    ToolTip.Tip="{DynamicResource Compare_AddFolder}"
                    AutomationProperties.Name="{DynamicResource Compare_AddFolder}">
              <avalonia:FolderAdd />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 错误区 -->
      <Border DockPanel.Dock="Top" Padding="6,4" Background="#22C42B1C"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <!-- 文件列由代码按列集合动态生成：每列之间插入分割线与可拖动分隔条。 -->
      <!-- File columns are generated from the column collection: a divider and a draggable splitter sit
           between them. -->
      <Grid x:Name="ColumnGrid" ClipToBounds="True" />
    </DockPanel>

    <!-- 加载中的 busy 指示：大文件比对 / 十六进制原始视图扫描期间显示（命令执行时按钮自身
         也会变灰禁用，二者配合给出明确的进行中反馈）。 -->
    <!-- Busy indicator while loading: shown during large-file comparisons / hex raw scans (the executing
         command also disables its button, together giving clear in-progress feedback). -->
    <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False" Background="#22000000">
      <ProgressBar Width="160" Height="6" IsIndeterminate="True"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
