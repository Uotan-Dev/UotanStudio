<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Devices"
        xmlns:views="using:UotanStudio.Views"
        Title="Device Manager"
        Width="900" Height="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        SystemDecorations="Full"
        x:Class="UotanStudio.Views.DeviceManagerDialog"
        x:DataType="vm:DeviceManagerViewModel">
    <views:DeviceManagerView DataContext="{Binding}" />
</Window>
