<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UotanStudio.ViewModels.Workspace"
             xmlns:shell="using:UotanStudio.Services.Terminal"
             xmlns:icons="https://irihi.tech/iconica/tdesign"
             x:Class="UotanStudio.Views.Workspace.TerminalView"
             x:DataType="vm:TerminalViewModel" Background="{DynamicResource PageBackground}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <WrapPanel ItemSpacing="8" LineSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ComboBox Name="ShellBox" Classes="Small" Width="152" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                    AutomationProperties.Name="{DynamicResource Terminal_Shell}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="shell:TerminalProfile">
                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Name="NewTerminalButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  VerticalAlignment="Center" Command="{Binding NewTerminalCommand}"
                  ToolTip.Tip="{DynamicResource Terminal_New}" AutomationProperties.Name="{DynamicResource Terminal_New}">
            <icons:Add Width="12" Height="12" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="CloseTerminalButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Command="{Binding CloseTerminalCommand}" ToolTip.Tip="{DynamicResource Terminal_Close}"
                  AutomationProperties.Name="{DynamicResource Terminal_Close}">
            <icons:Delete Width="12" Height="12" />
          </Button>
          <Button Name="CopyTerminalButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnCopyClick" ToolTip.Tip="{DynamicResource Menu_Copy}" AutomationProperties.Name="{DynamicResource Menu_Copy}">
            <icons:Copy Width="12" Height="12" />
          </Button>
          <Button Name="PasteTerminalButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnPasteClick" ToolTip.Tip="{DynamicResource Menu_Paste}" AutomationProperties.Name="{DynamicResource Menu_Paste}">
            <icons:Paste Width="12" Height="12" />
          </Button>
          <Button Name="ClearTerminalButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnClearClick" ToolTip.Tip="{DynamicResource Terminal_Clear}" AutomationProperties.Name="{DynamicResource Terminal_Clear}">
            <icons:Clear Width="12" Height="12" />
          </Button>
          <Button Name="TerminalBottomButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnBottomClick" ToolTip.Tip="{DynamicResource Terminal_Bottom}" AutomationProperties.Name="{DynamicResource Terminal_Bottom}">
            <icons:ChevronDownDouble Width="12" Height="12" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Session.WorkingDirectory}" FontSize="11" MaxWidth="240"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.WorkingDirectory}" />
      </WrapPanel>
    </Border>
    <Grid Name="SessionHost" Grid.Row="1" Background="{DynamicResource PageBackground}" />
    <StackPanel Grid.Row="2" Margin="8,0" Spacing="0">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource LogErrorBrush}" FontSize="11" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Session.Status}" FontSize="11" TextWrapping="Wrap"
                 IsVisible="{Binding Session.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>
</UserControl>
