<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:vm="using:UotanStudio.ViewModels.Workspace"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:icons="https://irihi.tech/iconica/tdesign"
             x:Class="UotanStudio.Views.Workspace.WorkspaceLogView"
             x:DataType="vm:WorkspaceLogViewModel">
  <UserControl.Styles>
    <Style Selector="Border#TopBar ComboBoxItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- 顶栏：筛选与操作按钮 -->
    <Border Grid.Row="0" Name="TopBar" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <controls:ResponsiveToolbar Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    controls:ResponsiveToolbar.Priority="2">
          <TextBlock Text="{DynamicResource Log_LevelFilter}" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox Classes="Small" MinWidth="64" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding LevelFilter}"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LogFilterDisplayConverter}}"
                           FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    controls:ResponsiveToolbar.Priority="1">
          <TextBlock Text="{DynamicResource Log_SourceFilter}" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox Classes="Small" MinWidth="68" MaxWidth="120" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Sources}" ToolTip.Tip="{Binding SourceFilter}"
                    SelectedItem="{Binding SourceFilter}"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LogFilterDisplayConverter}}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBox Name="LogSearchBox" Classes="Small" MinWidth="120"
                 HorizontalAlignment="Stretch"
                 controls:ResponsiveToolbar.Priority="3"
                 controls:ResponsiveToolbar.IsFlexible="True"
                 controls:ResponsiveToolbar.PreferredWidth="200"
                 Height="22" MinHeight="0" FontSize="11" Padding="4,0"
                 VerticalContentAlignment="Center" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{DynamicResource Log_Search}" AutomationProperties.Name="{DynamicResource Log_Search}">
          <TextBox.InnerLeftContent>
            <icons:Search Width="12" Height="12" Margin="4,0,0,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="Small" Width="18" Height="18" MinHeight="0" Padding="2"
                    Command="{Binding ClearSearchCommand}" ToolTip.Tip="{DynamicResource Log_ClearSearch}">
              <icons:Close Width="10" Height="10" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <Button Name="ClearLogsButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                VerticalAlignment="Center" Click="OnClearClick"
                controls:ResponsiveToolbar.Priority="2"
                ToolTip.Tip="{DynamicResource Log_Clear}">
          <icons:Delete Width="12" Height="12" />
        </Button>
      </controls:ResponsiveToolbar>
    </Border>
    <!-- 日志编辑器 -->
    <edit:TextEditor Grid.Row="1" Name="LogEditor"
                     IsReadOnly="True" ShowLineNumbers="False" WordWrap="False"
                     FontFamily="{StaticResource MonospaceFontFamily}" FontSize="13"
                     Padding="8,4" Background="Transparent"
                     Foreground="{DynamicResource TextForeground}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <edit:TextEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Name="CopySelectionMenuItem" Header="{DynamicResource Menu_Copy}"
                    InputGesture="Ctrl+C" IsEnabled="False" Click="OnCopySelectionClick" />
          <MenuItem Header="{DynamicResource Menu_SelectAll}"
                    InputGesture="Ctrl+A" Click="OnSelectAllClick" />
        </ContextMenu>
      </edit:TextEditor.ContextMenu>
    </edit:TextEditor>
  </Grid>
</UserControl>
