<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:ursa="using:Ursa.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Workspace.ImageView"
             x:DataType="viewmodels:ImageViewModel">
    <Grid RowDefinitions="*,Auto">
        <ursa:LoadingContainer Grid.Row="0" Name="ImageBusyContainer"
                               IsLoading="{Binding IsOperating}"
                               LoadingMessage="{DynamicResource ImageView_Processing}">
            <ursa:LoadingContainer.Indicator>
                <ursa:LoadingIcon Classes="Large"
                                  IsLoading="{Binding $parent[ursa:LoadingContainer].IsLoading, Mode=TwoWay}" />
            </ursa:LoadingContainer.Indicator>
            <ursa:LoadingContainer.LoadingMessageTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
            </ursa:LoadingContainer.LoadingMessageTemplate>
            <Grid RowDefinitions="Auto,Auto,*" IsEnabled="{Binding CanOperate}">
                <Grid Grid.Row="0" Margin="5,5" ColumnDefinitions="28,*,28">
                    <Button Grid.Column="0"
                            Width="28" Height="28"
                            Padding="0"
                            Classes="Small"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding DeleteSelectedCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_DeleteSelected}">
                        <avalonia:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                    </Button>

                    <Border Grid.Column="1"
                            Margin="0,0"
                            Padding="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Theme="{StaticResource RadioButtonGroupBorder}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton GroupName="ImageScope"
                                         MinWidth="0" MinHeight="24" Padding="8,0" Margin="0"
                                         IsChecked="{Binding IsUnpackMode, Mode=TwoWay}"
                                         Theme="{StaticResource ButtonRadioButton}"
                                         Classes="Small segment"
                                         Content="{DynamicResource ImageView_UnpackMode}" />
                            <RadioButton GroupName="ImageScope"
                                         MinWidth="0" MinHeight="24" Padding="8,0" Margin="0"
                                         IsChecked="{Binding IsPackMode, Mode=TwoWay}"
                                         Theme="{StaticResource ButtonRadioButton}"
                                         Classes="Small segment"
                                         Content="{DynamicResource ImageView_PackMode}" />
                            <RadioButton GroupName="ImageScope"
                                         MinWidth="0" MinHeight="24" Padding="8,0" Margin="0"
                                         IsChecked="{Binding IsOutputMode, Mode=TwoWay}"
                                         Theme="{StaticResource ButtonRadioButton}"
                                         Classes="Small segment"
                                         Content="{DynamicResource ImageView_OutputMode}" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2"
                            Width="28" Height="28"
                            Padding="0"
                            Classes="Small"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_Refresh}">
                        <avalonia:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                    </Button>
                </Grid>

                <ComboBox Grid.Row="1"
                          Classes="Small"
                          FontSize="12"
                          ItemsSource="{Binding SubProjectItems}"
                          SelectedItem="{Binding SelectedSubProject}"
                          Margin="5,0,5,5"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsSubProjectVisible}" />

                <!-- 镜像表格：当前行用于单文件操作，复选框用于批量选择。 -->
                <DataGrid Grid.Row="2" Name="ImagesGrid"
                          ItemsSource="{Binding Images}"
                          SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="None"
                          FontSize="12"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.RowTheme>
                        <ControlTheme TargetType="DataGridRow"
                                      BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="IsVisible" Value="{Binding IsVisible, DataType=viewmodels:ImageEntryViewModel}" />
                            <Setter Property="ContextMenu">
                                <ContextMenu x:DataType="viewmodels:ImageEntryViewModel"
                                             Opening="OnImageMenuOpening">
                                    <MenuItem Classes="unpack-action" Header="{DynamicResource ImageView_ExtractSelected}" IsEnabled="{Binding !IsDirectory}" Click="OnExtractMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="PackageDown" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="pack-action" Header="{DynamicResource ImageView_SynthesizeImg}" Click="OnSynthesizeImgMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="ImagePlus" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="pack-action" Header="{DynamicResource ImageView_SynthesizeBr}" Click="OnSynthesizeBrMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="ArchivePlus" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Classes="pack-action" />
                                    <MenuItem Classes="pack-action" Header="{DynamicResource ImageView_SynthesizeSuper}" Click="OnSynthesizeSuperMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="LayersPlus" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="pack-action" Header="{DynamicResource ImageView_SynthesizeDat}" Click="OnSynthesizeDatMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="FileMultipleOutline" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="flash-action" Header="{DynamicResource ImageView_Flash}" Click="OnFlashSelectedMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="Flash" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Classes="boot-action" Header="{DynamicResource ImageView_BootPatch}" IsEnabled="False" Click="OnBootPatchMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="Build" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Menu_Delete}" Click="OnDeleteMenuClick">
                                        <MenuItem.Icon>
                                            <avalonia:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter>
                        </ControlTheme>
                    </DataGrid.RowTheme>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource ImageView_SelectHint}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="Auto" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                               Margin="4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding RelativePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Format}" Width="Auto" FontSize="12" IsReadOnly="True" />

                        <DataGridTemplateColumn Width="Auto" CanUserSort="True" SortMemberPath="SizeBytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12"
                                               Margin="4,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ursa:LoadingContainer>

        <!-- 底部按钮区 -->
        <Border Grid.Row="1" Name="ImageOperationFooter" Padding="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 FontSize="12"
                                 ShowProgressText="True"
                                 Value="{Binding ProgressPercent}"
                                 Height="20"
                                 HorizontalAlignment="Stretch"
                                 CornerRadius="4" />
                    <Grid IsEnabled="{Binding CanOperate}">
                        <controls:JustifiedWrapPanel MinItemWidth="110" ItemSpacing="6" LineSpacing="6"
                                                       IsVisible="{Binding IsUnpackMode}">
                            <Button MinWidth="110" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding ExtractSelectedCommand}"
                                    ToolTip.Tip="{DynamicResource ImageView_ExtractHint}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <avalonia:MaterialIcon Grid.Column="0" Kind="PackageDown" Width="14" Height="14" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_ExtractSelected}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" MaxLines="2" />
                                </Grid>
                            </Button>
                            <Button MinWidth="110" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding FlashSelectedCommand}"
                                    ToolTip.Tip="{DynamicResource ImageView_FlashSelectedHint}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <avalonia:MaterialIcon Grid.Column="0" Kind="Flash" Width="14" Height="14" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_FlashSelected}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" MaxLines="2" />
                                </Grid>
                            </Button>
                        </controls:JustifiedWrapPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsPackMode}">
                            <Button MinWidth="110" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding SynthesizeImgCommand}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <avalonia:MaterialIcon Grid.Column="0" Kind="ImagePlus" Width="14" Height="14" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeImg}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" MaxLines="2" />
                                </Grid>
                            </Button>
                            <controls:JustifiedWrapPanel MinItemWidth="110" ItemSpacing="6" LineSpacing="6">
                                <Button MinWidth="110" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                        Command="{Binding SynthesizeBrCommand}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <avalonia:MaterialIcon Grid.Column="0" Kind="ArchivePlus" Width="14" Height="14" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeBr}"
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" MaxLines="2" />
                                    </Grid>
                                </Button>
                                <Button MinWidth="110" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                        Command="{Binding SynthesizeDatCommand}"
                                        ToolTip.Tip="{DynamicResource ImageView_DatHint}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <avalonia:MaterialIcon Grid.Column="0" Kind="FileMultipleOutline" Width="14" Height="14" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeDat}"
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" MaxLines="2" />
                                    </Grid>
                                </Button>
                            </controls:JustifiedWrapPanel>
                        </StackPanel>

                        <controls:JustifiedWrapPanel MinItemWidth="110" ItemSpacing="6" LineSpacing="6"
                                                       IsVisible="{Binding IsOutputMode}">
                            <Button MinWidth="110" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    Command="{Binding FlashSelectedCommand}"
                                    ToolTip.Tip="{DynamicResource ImageView_FlashSelectedHint}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <avalonia:MaterialIcon Grid.Column="0" Kind="Flash" Width="14" Height="14" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_FlashSelected}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" MaxLines="2" />
                                </Grid>
                            </Button>
                            <Button MinWidth="110" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    Click="OnPackRomClick">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                    <avalonia:MaterialIcon Grid.Column="0" Kind="Archive" Width="14" Height="14" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_PackRom}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" MaxLines="2" />
                                </Grid>
                            </Button>
                        </controls:JustifiedWrapPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
