<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Workspace.ImageView"
             x:DataType="viewmodels:ImageViewModel">
    <Grid RowDefinitions="*,Auto">
        <!-- 镜像表格：当前行用于单文件操作，复选框用于批量选择。 -->
        <DataGrid Grid.Row="0" Name="ImagesGrid"
                  ItemsSource="{Binding Images}"
                  SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="None"
                  FontSize="12"
                  Background="Transparent"
                  BorderThickness="0">
            <DataGrid.RowTheme>
                <ControlTheme TargetType="DataGridRow"
                              BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ContextMenu">
                        <ContextMenu x:DataType="viewmodels:ImageEntryViewModel">
                            <MenuItem Header="{DynamicResource ImageView_ExtractSelected}" Click="OnExtractMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeImg}" Click="OnSynthesizeImgMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeBr}" Click="OnSynthesizeBrMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeSuper}" Click="OnSynthesizeSuperMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeDat}" Click="OnSynthesizeDatMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_FlashAll}" Click="OnFlashAllMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_DeleteSelected}" Click="OnDeleteMenuClick" />
                        </ContextMenu>
                    </Setter>
                </ControlTheme>
            </DataGrid.RowTheme>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{DynamicResource ImageView_SelectHint}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                       Margin="4,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding RelativePath}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Format}" Width="Auto" FontSize="12" IsReadOnly="True" />

                <DataGridTemplateColumn Width="Auto" CanUserSort="True" SortMemberPath="SizeBytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <TextBlock Text="{Binding DisplaySize}" FontSize="12"
                                       Margin="4,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Opacity="0.72" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮区 -->
        <Border Grid.Row="1" Padding="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Margin="2,0"
                           TextWrapping="Wrap" />
                <controls:JustifiedWrapPanel MinItemWidth="110" ItemSpacing="6" LineSpacing="6">
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding ExtractSelectedCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_ExtractHint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="PackageDown" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_ExtractSelected}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding SynthesizeImgCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="ImagePlus" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_SynthesizeImg}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding SynthesizeBrCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="ArchivePlus" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_SynthesizeBr}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding DeleteSelectedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_DeleteSelected}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding SynthesizeSuperCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_SuperHint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="LayersPlus" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_SynthesizeSuper}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding SynthesizeDatCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_DatHint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="FileMultipleOutline" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_SynthesizeDat}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding FlashAllCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_FlashAllHint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="Flash" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_FlashAll}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" HorizontalAlignment="Stretch"
                            Command="{Binding OpenFlashWizardCommand}"
                            ToolTip.Tip="{DynamicResource ImageView_FlashWizardHint}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="Flash" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource ImageView_FlashWizard}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </controls:JustifiedWrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
