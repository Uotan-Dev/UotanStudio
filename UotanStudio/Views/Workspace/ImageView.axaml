<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Workspace.ImageView"
             x:DataType="viewmodels:ImageViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Margin="5,5">
            <Border Margin="0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Theme="{StaticResource RadioButtonGroupBorder}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="ImageScope"
                                 IsChecked="True"
                                 Theme="{StaticResource ButtonRadioButton}"
                                 Classes="Small"
                                 Content="{DynamicResource ImageView_CommonImages}" />
                    <RadioButton GroupName="ImageScope"
                                 Theme="{StaticResource ButtonRadioButton}"
                                 Classes="Small"
                                 Content="{DynamicResource ImageView_AllImages}" />
                </StackPanel>
            </Border>

            <Button Width="28" Height="28"
                    Padding="0"
                    Classes="Small"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{DynamicResource ImageView_Refresh}">
                <avalonia:MaterialIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </Grid>

        <ComboBox Grid.Row="1"
                  Classes="Small"
                  FontSize="12"
                  ItemsSource="{Binding ImageFilterItems}"
                  SelectedItem="{Binding SelectedImageFilter}"
                  Margin="5,0,5,5"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsImageFilterVisible}" />

        <!-- 镜像表格：当前行用于单文件操作，复选框用于批量选择。 -->
        <DataGrid Grid.Row="2" Name="ImagesGrid"
                  ItemsSource="{Binding Images}"
                  SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="None"
                  FontSize="12"
                  Background="Transparent"
                  BorderThickness="0">
            <DataGrid.RowTheme>
                <ControlTheme TargetType="DataGridRow"
                              BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="IsVisible" Value="{Binding IsVisible, DataType=viewmodels:ImageEntryViewModel}" />
                    <Setter Property="ContextMenu">
                        <ContextMenu x:DataType="viewmodels:ImageEntryViewModel">
                            <MenuItem Header="{DynamicResource ImageView_ExtractSelected}" Click="OnExtractMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeImg}" Click="OnSynthesizeImgMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeBr}" Click="OnSynthesizeBrMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeSuper}" Click="OnSynthesizeSuperMenuClick" />
                            <MenuItem Header="{DynamicResource ImageView_SynthesizeDat}" Click="OnSynthesizeDatMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_FlashAll}" Click="OnFlashAllMenuClick" />
                            <Separator />
                            <MenuItem Header="{DynamicResource ImageView_DeleteSelected}" Click="OnDeleteMenuClick" />
                        </ContextMenu>
                    </Setter>
                </ControlTheme>
            </DataGrid.RowTheme>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{DynamicResource ImageView_SelectHint}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                       Margin="4,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding RelativePath}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Format}" Width="Auto" FontSize="12" IsReadOnly="True" />

                <DataGridTemplateColumn Width="Auto" CanUserSort="True" SortMemberPath="SizeBytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
                            <TextBlock Text="{Binding DisplaySize}" FontSize="12"
                                       Margin="4,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Opacity="0.72" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮区 -->
        <Border Grid.Row="3" Padding="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel Spacing="5">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 FontSize="12"
                                 ShowProgressText="True"
                                 Value="{Binding ProgressPercent}"
                                 Height="20"
                                 HorizontalAlignment="Stretch"
                                 CornerRadius="4" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <controls:JustifiedWrapPanel MinItemWidth="110" ItemSpacing="6" LineSpacing="6">
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding ExtractSelectedCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_ExtractHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="PackageDown" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_ExtractSelected}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding SynthesizeImgCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="ImagePlus" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeImg}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding SynthesizeBrCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="ArchivePlus" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeBr}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding DeleteSelectedCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="DeleteOutline" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_DeleteSelected}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding SynthesizeSuperCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_SuperHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="LayersPlus" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeSuper}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding SynthesizeDatCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_DatHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="FileMultipleOutline" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_SynthesizeDat}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding PackImageCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_PackImageHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="Archive" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_PackImage}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding FlashAllCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_FlashAllHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="Flash" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_FlashAll}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                        <Button MinWidth="110" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Command="{Binding OpenFlashWizardCommand}"
                                ToolTip.Tip="{DynamicResource ImageView_FlashWizardHint}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <avalonia:MaterialIcon Grid.Column="0" Kind="Flash" Width="14" Height="14" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource ImageView_FlashWizard}"
                                           FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" MaxLines="2" />
                            </Grid>
                        </Button>
                    </controls:JustifiedWrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
