<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        x:Class="UotanStudio.Views.Workspace.FlashWizardView"
        x:DataType="viewmodels:FlashWizardViewModel"
        Title="{DynamicResource FlashWizard_Title}"
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="Full">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="340,*">
    <!-- 列标题 / Column headers -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
      <avalonia:MaterialIcon Kind="FileOutline" Width="16" Height="16"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentColor}" />
      <TextBlock Text="{DynamicResource FlashWizard_ImagesHeader}" FontSize="13" FontWeight="Bold" />
    </StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" Spacing="6">
      <avalonia:MaterialIcon Kind="Cellphone" Width="16" Height="16"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AccentColor}" />
      <TextBlock Text="{DynamicResource FlashWizard_DeviceHeader}" FontSize="13" FontWeight="Bold" />
    </StackPanel>

    <!-- 左：分区镜像列表 / Left: partition image list -->
    <Border Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Padding="6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
      <ListBox ItemsSource="{Binding Images}"
               SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="viewmodels:ImageEntryViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,3">
              <avalonia:MaterialIcon Grid.Column="0" Kind="ImageMultipleOutline" Width="16" Height="16"
                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentColor}" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Format}" FontSize="10" Opacity="0.6" />
                  <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}" FontSize="10" Opacity="0.5" />
                </StackPanel>
              </StackPanel>
              <avalonia:MaterialIcon Grid.Column="2" Kind="CheckCircle" Width="14" Height="14"
                                     VerticalAlignment="Center" Margin="6,0,0,0"
                                     Foreground="{DynamicResource AccentColor}"
                                     IsVisible="{Binding IsSelected}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- 右：设备信息 + 白名单规则 / Right: device info + whitelist rules -->
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,8,0,0" Spacing="8">
      <TextBlock Text="{Binding DeviceDisplay}" FontSize="14" FontWeight="Bold"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding DeviceDetail}" FontSize="12" Opacity="0.8"
                 TextWrapping="Wrap" LineHeight="18" />
      <Border Padding="8,6" Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource FlashWizard_RulesHeader}" FontSize="11" FontWeight="Bold"
                     Opacity="0.7" />
          <TextBlock Text="{Binding RuleText}" FontSize="12" Foreground="{DynamicResource AccentColor}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <CheckBox IsChecked="{Binding RebootAfterFlash}"
                Content="{DynamicResource FlashWizard_AfterFlashReboot}" FontSize="12" />
    </StackPanel>

    <!-- 进度 + 状态 / Progress + status -->
    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Spacing="4">
      <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" />
      <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- 操作按钮 / Action buttons -->
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button MinWidth="90" Command="{Binding FlashCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <avalonia:MaterialIcon Kind="Flash" Width="14" Height="14" />
          <TextBlock Text="{DynamicResource FlashWizard_FlashButton}" FontSize="11" />
        </StackPanel>
      </Button>
      <Button MinWidth="90" Command="{Binding RebootDeviceCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <avalonia:MaterialIcon Kind="Restart" Width="14" Height="14" />
          <TextBlock Text="{DynamicResource FlashWizard_RebootButton}" FontSize="11" />
        </StackPanel>
      </Button>
      <Button MinWidth="90" Content="{DynamicResource FlashWizard_CloseButton}"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
