<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="https://irihi.tech/iconica/tdesign"
             xmlns:plugins="using:UotanStudio.Services.VisualPlugins"
             xmlns:vm="using:UotanStudio.ViewModels.Workspace"
             x:Class="UotanStudio.Views.Workspace.PatchToolView"
             x:DataType="vm:PluginToolViewModel">
    <UserControl.Resources>
        <CornerRadius x:Key="PluginCardCornerRadius">6</CornerRadius>
        <SolidColorBrush x:Key="PluginCardBackgroundBrush" Color="{DynamicResource CardBackground}" />
        <SolidColorBrush x:Key="PluginCardBorderBrush" Color="{DynamicResource BorderForegroundColor}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.PluginActionButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            <Setter Property="BorderBrush" Value="{StaticResource PluginCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.ModeChip">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.PluginEntryCard">
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PluginCardBorderBrush}" />
        </Style>
        <Style Selector="ListBox.PluginList > ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <avalonia:App Width="20" Height="20"
                          Stroke1="{DynamicResource AccentColor}" />
            <TextBlock Text="{DynamicResource Dock_Plugins}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource PluginTool_Description}"
                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <StackPanel IsVisible="{Binding !Plugins.Count}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6">
                <avalonia:App Width="40" Height="40" Opacity="0.25"
                              HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Plugin_Empty}"
                           Opacity="0.7" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
            </StackPanel>

            <ListBox Classes="PluginList"
                     ItemsSource="{Binding Plugins}"
                     SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                     IsVisible="{Binding !!Plugins.Count}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="plugins:VisualPluginRegistration">
                        <Border Classes="PluginEntryCard">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                            <Border Classes="ModeChip"
                                                    Background="{StaticResource PluginCardBackgroundBrush}"
                                                    BorderBrush="{StaticResource PluginCardBorderBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding !!Version}">
                                                <TextBlock Text="{Binding Version}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.65"
                                               TextWrapping="Wrap" IsVisible="{Binding !!Description}"
                                               ToolTip.Tip="{Binding Description}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="PluginActionButton"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[UserControl].DataContext.ApplyPluginCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{DynamicResource Plugin_UseTemplate}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <avalonia:PlayCircleStroke Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Plugin_UseTemplate}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap"
                   FontSize="12" Opacity="0.65" IsVisible="{Binding !!Status}" />
    </Grid>
</UserControl>