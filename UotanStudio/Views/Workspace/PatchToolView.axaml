<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:plugins="using:UotanStudio.Services.VisualPlugins"
             xmlns:vm="using:UotanStudio.ViewModels.Workspace"
             x:Class="UotanStudio.Views.Workspace.PatchToolView"
             x:DataType="vm:PluginToolViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <avalonia:MaterialIcon Kind="PuzzleOutline" Width="20" Height="20"
                                  Foreground="{DynamicResource AccentColor}" />
            <TextBlock Text="{DynamicResource Dock_Plugins}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource PluginTool_Description}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <Grid Grid.Row="2">
            <TextBlock Text="{DynamicResource Plugin_Empty}" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !Plugins.Count}" />
            <ListBox ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="plugins:VisualPluginRegistration">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.72"
                                               TextWrapping="Wrap" IsVisible="{Binding !!Description}" />
                                    <TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.ApplyPluginCommand}"
                                        CommandParameter="{Binding}" Padding="8,4"
                                        ToolTip.Tip="{DynamicResource Plugin_UseTemplate}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16" />
                                        <TextBlock Text="{DynamicResource Plugin_UseTemplate}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding !!Status}" />
    </Grid>
</UserControl>
