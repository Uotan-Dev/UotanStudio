<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="UotanStudio.Views.Workspace.PropertiesView"
    x:DataType="viewmodels:PropertiesViewModel">
  <Grid>
    <!-- 无选择占位 -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                IsVisible="{Binding !HasSelection}">
      <avalonia:MaterialIcon Kind="CursorDefaultClickOutline" Width="32" Height="32" Opacity="0.3"
                             HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource Dock_Properties_NoSelection}"
                 FontSize="12" Opacity="0.5" HorizontalAlignment="Center" />
    </StackPanel>

    <DataGrid Name="PropertiesGrid" IsVisible="{Binding HasSelection}"
              ItemsSource="{Binding Properties}"
              AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="None" GridLinesVisibility="Horizontal"
              CanUserResizeColumns="False" CanUserReorderColumns="False" CanUserSortColumns="False"
              MinColumnWidth="0" RowHeight="28"
              HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
              SizeChanged="OnPropertiesGridSizeChanged">
      <DataGrid.Styles>
        <Style Selector="DataGridCell">
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <!-- DataGrid requires a finite initial maximum before it can be resized. -->
        <DataGridTemplateColumn Width="Auto" MaxWidth="10000">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewmodels:PropertiesViewModel+PropertyRow">
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                         Margin="6,3" Opacity="0.75" VerticalAlignment="Center"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1">
                <ToolTip.Tip>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="480" />
                </ToolTip.Tip>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="viewmodels:PropertiesViewModel+PropertyRow">
              <Grid>
                <Border Padding="6,3" Background="Transparent" IsVisible="{Binding !IsLanguageSelector}">
                  <ToolTip.Tip>
                    <ToolTip MaxWidth="680">
                      <ScrollViewer MaxWidth="640" MaxHeight="480"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Value}" FontSize="13"
                                   TextWrapping="Wrap" TextTrimming="None" MaxLines="0" />
                      </ScrollViewer>
                    </ToolTip>
                  </ToolTip.Tip>
                  <TextBlock Text="{Binding Value}" FontSize="13"
                             VerticalAlignment="Center" HorizontalAlignment="Stretch"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </Border>
                <ComboBox IsVisible="{Binding IsLanguageSelector}"
                          ItemsSource="{Binding $parent[DataGrid].((viewmodels:PropertiesViewModel)DataContext).AvailableLanguages}"
                          SelectedItem="{Binding $parent[DataGrid].((viewmodels:PropertiesViewModel)DataContext).SelectedLanguage, Mode=TwoWay}"
                          ToolTip.Tip="{Binding $parent[DataGrid].((viewmodels:PropertiesViewModel)DataContext).SelectedLanguage}"
                          Classes="Small" FontSize="13"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          MinWidth="0" MinHeight="0" Padding="6,0"
                          BorderThickness="0" CornerRadius="0" Background="Transparent">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" FontSize="13"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
