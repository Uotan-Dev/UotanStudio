<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:controls="using:UotanStudio.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Workspace.WorkspaceView"
             x:DataType="viewmodels:WorkspaceViewModel"
             Background="Transparent"
             Focusable="True"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.Drop="OnDrop">

  <!-- 透明背景必须显式给出：Avalonia 命中测试只落到有 Background 的元素，空白区域
       InputHitTest 失败会让 DragDropDevice.GetTarget 返回 null，OS 光标显示禁止。 -->
  <!-- Transparent background is required so hit-testing lands on empty areas of this view;
       otherwise the OS drag cursor may show the "not allowed" glyph. -->
  <Grid>
    <dock:DockControl x:Name="DockControl"
                     Layout="{Binding Layout}"
                     IsDockingEnabled="True"
                     AutoCreateDataTemplates="True" />
    <Canvas>
      <Grid Name="DocumentSearchHost" IsVisible="False" ClipToBounds="True">
        <controls:FindReplacePanel Name="DocumentSearchPanel" IsVisible="False" MaxWidth="300" Margin="4"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Top" />
      </Grid>
    </Canvas>
  </Grid>
</UserControl>
