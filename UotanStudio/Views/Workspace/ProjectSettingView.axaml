<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             xmlns:controls="using:UotanStudio.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             x:Class="UotanStudio.Views.Workspace.ProjectSettingView"
             x:DataType="viewmodels:ProjectSettingViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical" Spacing="5">
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_ImageType}" />
            <StackPanel MinWidth="210" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Left">
                <RadioButton GroupName="ImageType" FontSize="13" IsChecked="{Binding TypeEXT4}">
                    <TextBlock Text="EXT4" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton GroupName="ImageType" FontSize="13" IsChecked="{Binding TypeEROFS}">
                    <TextBlock Text="EROFS" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton GroupName="ImageType" FontSize="13" IsChecked="{Binding TypeF2FS}">
                    <TextBlock Text="F2FS" TextWrapping="NoWrap" />
                </RadioButton>
            </StackPanel>
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_ImageFormat}" />
            <StackPanel MinWidth="145" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Left">
                <RadioButton FontSize="13" IsChecked="{Binding FormatRAW}">
                    <TextBlock Text="RAW" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton FontSize="13" IsChecked="{Binding FormatSPARSE}">
                    <TextBlock Text="SPARSE" TextWrapping="NoWrap" />
                </RadioButton>
            </StackPanel>
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_EXT4RW}" />
            <StackPanel MinWidth="145" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Left">
                <RadioButton FontSize="13" IsChecked="{Binding EXT4RO}">
                    <TextBlock Text="RO" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton FontSize="13" IsChecked="{Binding EXT4RW}">
                    <TextBlock Text="RW" TextWrapping="NoWrap" />
                </RadioButton>
            </StackPanel>
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_SizeCalc}" />
            <StackPanel MinWidth="145" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Left">
                <RadioButton FontSize="13" IsChecked="{Binding SizeAuto}">
                    <TextBlock Text="{DynamicResource Dock_Auto}" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton FontSize="13" IsChecked="{Binding SizeOri}">
                    <TextBlock Text="{DynamicResource Dock_OriginalSize}" TextWrapping="NoWrap" />
                </RadioButton>
            </StackPanel>
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_EXT4Compress}" />
            <StackPanel MinWidth="145" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Left">
                <RadioButton FontSize="13" IsChecked="{Binding EXT4NoCompress}">
                    <TextBlock Text="{DynamicResource Dock_NoCompress}" TextWrapping="NoWrap" />
                </RadioButton>
                <RadioButton FontSize="13" IsChecked="{Binding EXT4Compress}">
                    <TextBlock Text="{DynamicResource Dock_Compress}" TextWrapping="NoWrap" />
                </RadioButton>
            </StackPanel>
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,15,5,0"
                                    MinLabelWidth="75" MaxLabelWidth="180"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"
                       Text="{DynamicResource Dock_EROFSAlgorithm}" />
            <ComboBox MinWidth="145" MaxWidth="240" Padding="5"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="{DynamicResource Dock_EROFSAlgorithmHint}"
                      ItemsSource="{Binding ErofsAlgorithmOptions}"
                      SelectedItem="{Binding SelectedErofsAlgorithm}" />
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,10,5,0"
                                    MinLabelWidth="90" MaxLabelWidth="90"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       TextWrapping="Wrap"
                       ToolTip.Tip="{DynamicResource Dock_EROFSCompLevelHint}"
                       Text="{DynamicResource Dock_EROFSCompLevel}" />
            <ComboBox MinWidth="155" MaxWidth="240"
                      HorizontalAlignment="Stretch" Padding="5"
                      ToolTip.Tip="{DynamicResource Dock_EROFSCompLevelHint}"
                      ItemsSource="0123456789" SelectedIndex="{Binding EROFSComGrade}" />
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,10,5,0"
                                    MinLabelWidth="90" MaxLabelWidth="90"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Dock_BRCompLevel}" />
            <ComboBox MinWidth="155" MaxWidth="240"
                      HorizontalAlignment="Stretch" Padding="5"
                      ItemsSource="0123456789" SelectedIndex="{Binding BRComGrade}" />
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,0,5,0"
                                    MinLabelWidth="90" MaxLabelWidth="90"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Dock_UTCTime}" />
            <TextBox MinWidth="155" MaxWidth="240"
                     HorizontalAlignment="Stretch" Padding="5"
                     Text="{Binding UTCTime}" FontSize="13" />
        </controls:ResponsiveFormRow>
        <controls:ResponsiveFormRow Margin="8,0,5,0"
                                    MinLabelWidth="90" MaxLabelWidth="90"
                                    ColumnSpacing="5">
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Dock_DATSegments}" />
            <TextBox MinWidth="155" MaxWidth="240"
                     HorizontalAlignment="Stretch" Padding="5"
                     Text="{Binding DATSeg}" FontSize="13" PlaceholderText="0-999" />
        </controls:ResponsiveFormRow>
    </StackPanel>
  </ScrollViewer>
</UserControl>
