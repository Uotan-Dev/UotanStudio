<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             x:Class="UotanStudio.Views.Workspace.ProjectSettingView"
             x:DataType="viewmodels:ProjectSettingViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.setting-field">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="WrapPanel.radio-group">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="ItemsAlignment" Value="Center" />
      <Setter Property="ItemSpacing" Value="16" />
      <Setter Property="LineSpacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                AllowAutoHide="True">
    <StackPanel Margin="12" Spacing="12">
      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_ImageType}" />
        <WrapPanel Classes="radio-group">
          <RadioButton GroupName="ImageType" IsChecked="{Binding TypeEXT4}">
            <TextBlock Text="EXT4" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton GroupName="ImageType" IsChecked="{Binding TypeEROFS}">
            <TextBlock Text="EROFS" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton GroupName="ImageType" IsChecked="{Binding TypeF2FS}">
            <TextBlock Text="F2FS" TextWrapping="NoWrap" />
          </RadioButton>
        </WrapPanel>
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_ImageFormat}" />
        <WrapPanel Classes="radio-group">
          <RadioButton IsChecked="{Binding FormatRAW}">
            <TextBlock Text="RAW" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton IsChecked="{Binding FormatSPARSE}">
            <TextBlock Text="SPARSE" TextWrapping="NoWrap" />
          </RadioButton>
        </WrapPanel>
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_F2FSAndroidCapacity}" />
        <TextBox Text="{Binding F2fsAndroidImageSizeBytes}"
                 PlaceholderText="{DynamicResource Dock_Bytes}"
                 ToolTip.Tip="{DynamicResource Dock_F2FSAndroidCapacityHint}" />
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_EROFSAlgorithm}" />
        <ComboBox ToolTip.Tip="{DynamicResource Dock_EROFSAlgorithmHint}"
                  ItemsSource="{Binding ErofsAlgorithmOptions}"
                  SelectedItem="{Binding SelectedErofsAlgorithm}" />
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   ToolTip.Tip="{DynamicResource Dock_EROFSFeaturesHint}"
                   Text="{DynamicResource Dock_EROFSFeatures}" />
        <TextBox ToolTip.Tip="{DynamicResource Dock_EROFSFeaturesHint}"
                 Text="{Binding ErofsFeatureOverrides}"
                 PlaceholderText="!big_pcluster" />
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_F2FSAlgorithm}" />
        <ComboBox ItemsSource="{Binding F2fsCompressionAlgorithmOptions}"
                  SelectedItem="{Binding SelectedF2fsCompressionAlgorithm}" />
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_F2FSCompression}" />
        <WrapPanel Classes="radio-group">
          <RadioButton IsChecked="{Binding F2fsNoCompress}">
            <TextBlock Text="{DynamicResource Dock_NoCompress}" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton IsChecked="{Binding F2fsCompressionEnabled}">
            <TextBlock Text="{DynamicResource Dock_Compress}" TextWrapping="NoWrap" />
          </RadioButton>
        </WrapPanel>
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_EXT4Compress}" />
        <WrapPanel Classes="radio-group">
          <RadioButton IsChecked="{Binding EXT4NoCompress}">
            <TextBlock Text="{DynamicResource Dock_NoCompress}" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton IsChecked="{Binding EXT4Compress}">
            <TextBlock Text="{DynamicResource Dock_Compress}" TextWrapping="NoWrap" />
          </RadioButton>
        </WrapPanel>
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_EXT4RW}" />
        <WrapPanel Classes="radio-group">
          <RadioButton IsChecked="{Binding EXT4RO}">
            <TextBlock Text="RO" TextWrapping="NoWrap" />
          </RadioButton>
          <RadioButton IsChecked="{Binding EXT4RW}">
            <TextBlock Text="RW" TextWrapping="NoWrap" />
          </RadioButton>
        </WrapPanel>
      </StackPanel>

      <StackPanel Classes="setting-field">
        <TextBlock Classes="field-label"
                   Text="{DynamicResource Dock_F2FSCompLevel}" />
        <ComboBox ItemsSource="0123456789"
                  SelectedIndex="{Binding F2fsCompressionLevel}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>