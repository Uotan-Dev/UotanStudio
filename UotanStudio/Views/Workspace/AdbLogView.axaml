<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:vm="using:UotanStudio.ViewModels"
             xmlns:live="using:UotanStudio.ViewModels.Workspace"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:icons="https://irihi.tech/iconica/tdesign"
             x:Class="UotanStudio.Views.Workspace.AdbLogView"
             x:DataType="vm:ILogViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton#PauseLogsButton">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource Log_Pause}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource Log_Pause}" />
    </Style>
    <Style Selector="ToggleButton#PauseLogsButton:checked">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource Log_Resume}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource Log_Resume}" />
    </Style>
    <Style Selector="Border#TopBar ComboBoxItem">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- 顶部错误提示条：与对比视图同一套单行样式与关闭按钮（加载/导出失败时出现）。 -->
    <!-- Top error banner: same single-line styling and dismiss button as the Compare view (shown on load/export failure). -->
    <controls:EditorErrorBanner Grid.Row="0"
                                Message="{Binding ErrorMessage, Mode=TwoWay}" />

    <!-- 顶栏：筛选与操作按钮（仅实时 ADB 日志面板显示） -->
    <Border Grid.Row="1" Name="TopBar" IsVisible="False" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <controls:ResponsiveToolbar Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    controls:ResponsiveToolbar.Priority="2">
          <TextBlock Text="{DynamicResource Log_LevelFilter}" FontSize="11" VerticalAlignment="Center" />
          <ComboBox Name="LevelFilterBox" Classes="Small" MinWidth="64" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Levels}" SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LogFilterDisplayConverter}}" FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBox Name="LogSearchBox" Classes="Small" MinWidth="120"
                 HorizontalAlignment="Stretch"
                 controls:ResponsiveToolbar.Priority="3"
                 controls:ResponsiveToolbar.IsFlexible="True"
                 controls:ResponsiveToolbar.PreferredWidth="200"
                 Height="22" MinHeight="0" FontSize="11" Padding="4,0"
                 VerticalContentAlignment="Center" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{DynamicResource Log_Search}" AutomationProperties.Name="{DynamicResource Log_Search}">
          <TextBox.InnerLeftContent>
            <icons:Search Width="12" Height="12" Margin="4,0,0,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="Small" Width="18" Height="18" MinHeight="0" Padding="2"
                    Command="{Binding ClearSearchCommand}" ToolTip.Tip="{DynamicResource Log_ClearSearch}" AutomationProperties.Name="{DynamicResource Log_ClearSearch}">
              <icons:Close Width="10" Height="10" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <ToggleButton Name="RegexSearchButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                      VerticalAlignment="Center" IsChecked="{Binding UseRegex, Mode=TwoWay}"
                      controls:ResponsiveToolbar.Priority="1"
                      ToolTip.Tip="{DynamicResource Log_UseRegex}" AutomationProperties.Name="{DynamicResource Log_UseRegex}">
          <TextBlock Text=".*" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ToggleButton>
        <Button Name="RegexGeneratorButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                VerticalAlignment="Center" Click="OnRegexGeneratorClick"
                controls:ResponsiveToolbar.Priority="0"
                ToolTip.Tip="{DynamicResource Log_RegexGenerator}" AutomationProperties.Name="{DynamicResource Log_RegexGenerator}">
          <icons:Formula Width="12" Height="12" />
        </Button>
        <ToggleButton Name="MatchCaseButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                      VerticalAlignment="Center" IsChecked="{Binding MatchCase, Mode=TwoWay}"
                      controls:ResponsiveToolbar.Priority="1"
                      ToolTip.Tip="{DynamicResource Log_MatchCase}" AutomationProperties.Name="{DynamicResource Log_MatchCase}">
          <TextBlock Text="Ab" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ToggleButton>
        <ToggleButton Name="AutoScrollButton" DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                      Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                      VerticalAlignment="Center" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                      controls:ResponsiveToolbar.Priority="1"
                      ToolTip.Tip="{DynamicResource Log_AutoScroll}" AutomationProperties.Name="{DynamicResource Log_AutoScroll}">
          <icons:ChevronDownDouble Width="12" Height="12" />
        </ToggleButton>
        <ToggleButton Name="PauseLogsButton" DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                      Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                      VerticalAlignment="Center" IsChecked="{Binding IsPaused, Mode=TwoWay}"
                      controls:ResponsiveToolbar.Priority="2">
          <Grid Width="12" Height="12">
            <icons:PauseCircleStroke Width="12" Height="12" IsVisible="{Binding !IsPaused}" />
            <icons:PlayCircleStroke Width="12" Height="12" IsVisible="{Binding IsPaused}" />
          </Grid>
        </ToggleButton>
        <Button Name="ResetLogsButton" DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                VerticalAlignment="Center" Command="{Binding ResetLogsCommand}"
                controls:ResponsiveToolbar.Priority="0"
                ToolTip.Tip="{DynamicResource AdbLog_Reset}" AutomationProperties.Name="{DynamicResource AdbLog_Reset}">
          <icons:Clear Width="12" Height="12" />
        </Button>
        <Button Name="ClearLogsButton" DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                VerticalAlignment="Center" Command="{Binding ClearLogsCommand}"
                controls:ResponsiveToolbar.Priority="1"
                ToolTip.Tip="{DynamicResource AdbLog_ClearAll}" AutomationProperties.Name="{DynamicResource AdbLog_ClearAll}">
          <icons:Clear Width="12" Height="12" />
        </Button>
        <Button Name="ExportLogsButton" DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                VerticalAlignment="Center" Click="OnExportClick"
                controls:ResponsiveToolbar.Priority="0"
                ToolTip.Tip="{DynamicResource Log_Export}" AutomationProperties.Name="{DynamicResource Log_Export}">
          <icons:Export Width="12" Height="12" />
        </Button>
        <TextBlock DataContext="{Binding LiveModel}" x:DataType="live:AdbLogViewModel"
                   Text="{Binding ConnectedSerial}"
                   IsVisible="{Binding ConnectedSerial, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                   FontSize="11" MinWidth="48" MaxWidth="180"
                   controls:ResponsiveToolbar.Priority="-1"
                   controls:ResponsiveToolbar.IsFlexible="True"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding ConnectedSerial}" />
        <TextBlock Name="SearchErrorText" Text="{Binding SearchError}" IsVisible="{Binding HasSearchError}"
                   Foreground="{DynamicResource LogErrorBrush}" FontSize="11" MinWidth="60" MaxWidth="180"
                   controls:ResponsiveToolbar.Priority="-1"
                   controls:ResponsiveToolbar.IsFlexible="True"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding SearchError}" />
      </controls:ResponsiveToolbar>
    </Border>

    <!-- 日志编辑器 -->
    <edit:TextEditor Grid.Row="2" Name="LogEditor"
                     IsReadOnly="True" ShowLineNumbers="False" WordWrap="False"
                     FontFamily="{StaticResource MonospaceFontFamily}" FontSize="13"
                     Padding="8,4" Background="Transparent"
                     Foreground="{DynamicResource TextForeground}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <edit:TextEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Name="CopySelectionMenuItem" Header="{DynamicResource Menu_Copy}"
                    InputGesture="Ctrl+C" IsEnabled="False" Click="OnCopySelectionClick" />
          <MenuItem Header="{DynamicResource Menu_SelectAll}"
                    InputGesture="Ctrl+A" Click="OnSelectAllClick" />
        </ContextMenu>
      </edit:TextEditor.ContextMenu>
    </edit:TextEditor>
  </Grid>
</UserControl>