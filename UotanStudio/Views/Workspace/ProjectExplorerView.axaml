<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Workspace"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Workspace.ProjectExplorerView"
             x:DataType="viewmodels:ProjectExplorerViewModel">
    <TreeView x:Name="ProjectTree" Margin="0 5 0 0" ItemsSource="{Binding TreeViewContent}"
              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
        <TreeView.ItemContainerTheme>
            <ControlTheme TargetType="TreeViewItem"
                          BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, x:DataType=viewmodels:ExplorerNode}" />
                <Setter Property="ContextMenu">
                    <ContextMenu x:DataType="viewmodels:ExplorerNode">
                        <!-- 菜单图标使用菜单自身前景色（单色，与 VS 的命令图标一致）；家族配色只用于左侧树节点。 -->
                        <!-- Menu icons use the menu's own foreground (monochrome, matching VS command icons);
                             the family colours are used by the tree nodes only. -->
                        <!-- 文件节点右键菜单：打开方式 -->
                        <MenuItem Header="{DynamicResource Explorer_OpenAsMenu}"
                                  IsVisible="{Binding !IsDirectory}">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="OpenInNew" />
                            </MenuItem.Icon>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsAuto}" Tag="{x:Static controls:EditorOpenMode.Auto}" Click="OnOpenWith" />
                            <MenuItem Header="{DynamicResource Explorer_OpenAsElf}" Tag="{x:Static controls:EditorOpenMode.Elf}" Click="OnOpenWith" />
                            <MenuItem Header="{DynamicResource Explorer_OpenAsPartition}" Tag="{x:Static controls:EditorOpenMode.Partition}" Click="OnOpenWith" />
                            <MenuItem Header="{DynamicResource Explorer_OpenAsText}"
                                      Tag="{x:Static controls:EditorOpenMode.Text}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FileDocumentOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsLog}" Tag="{x:Static controls:EditorOpenMode.Log}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="TextBoxMultipleOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsHex}"
                                      Tag="{x:Static controls:EditorOpenMode.Hex}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="CodeBraces" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsDtb}"
                                      Tag="{x:Static controls:EditorOpenMode.Dtb}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FileTreeOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsDex}"
                                      Tag="{x:Static controls:EditorOpenMode.Dex}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FileCodeOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsAxml}"
                                      Tag="{x:Static controls:EditorOpenMode.Axml}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FileXmlBox" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsArsc}"
                                      Tag="{x:Static controls:EditorOpenMode.Arsc}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="DatabaseOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsApk}"
                                      Tag="{x:Static controls:EditorOpenMode.Apk}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="Android" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsFirmware}"
                                      Tag="{x:Static controls:EditorOpenMode.Firmware}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="PackageOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_OpenAsFileSystem}"
                                      Tag="{x:Static controls:EditorOpenMode.FileSystem}" Click="OnOpenWith">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FolderSearchOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <!-- 镜像类文件：格式转换（确认后输出到子项目 output/，进度显示在镜像管理面板） -->
                        <MenuItem Header="{DynamicResource Explorer_ConvertFormat}"
                                  IsVisible="{Binding IsImageFile}">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="SwapHorizontal" />
                            </MenuItem.Icon>
                            <MenuItem Header="{DynamicResource Explorer_ConvertSparse}" Click="OnConvertSparse" />
                            <MenuItem Header="{DynamicResource Explorer_ConvertImgToDat}" Click="OnConvertImgToDat" />
                            <MenuItem Header="{DynamicResource Explorer_ConvertImgToBr}" Click="OnConvertImgToBr" />
                        </MenuItem>
                        <!-- 文件节点右键菜单：打开校验窗口 -->
                        <MenuItem Header="{DynamicResource Explorer_Checksum}"
                                  IsVisible="{Binding !IsDirectory}" Click="OnChecksum">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FileCheckOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_Add}" IsVisible="{Binding IsDirectory}">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="PlusOutline" />
                            </MenuItem.Icon>
                            <MenuItem Header="{DynamicResource Explorer_NewEmptySubProject}" Click="OnNewEmptySubProject">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FolderPlusOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_ImportExistingSubProject}" Click="OnImportExistingSubProject">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FolderArrowDownOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_NewFile}" Click="OnNewFile">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FilePlusOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Explorer_NewFolder}" Click="OnNewFolder">
                                <MenuItem.Icon>
                                    <icons:MaterialIcon Kind="FolderAddOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Explorer_Unpack}" IsVisible="{Binding !IsDirectory}" Click="OnUnpack">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="PackageDown" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource Menu_Cut}" Click="OnCut">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ContentCut" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Menu_Copy}" Click="OnCopy">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ContentCopy" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Menu_Paste}" Click="OnPaste">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ContentPaste" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Menu_Delete}" Click="OnDelete">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="DeleteOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_Rename}" Click="OnRename">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="RenameBoxOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_CopyFullPath}" Click="OnCopyFullPath">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ClipboardTextOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_OpenInFileExplorer}" Click="OnOpenInFileExplorer">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="FolderOpenOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_OpenInMultiColumnBrowser}" Click="OnOpenInCompareView">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="ViewColumnOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Explorer_OpenInTerminal}" IsVisible="{Binding IsDirectory}" Click="OnOpenInTerminal">
                            <MenuItem.Icon>
                                <icons:MaterialIcon Kind="Console" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter>
            </ControlTheme>
        </TreeView.ItemContainerTheme>
        <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="viewmodels:ExplorerNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- 图标按节点类型/扩展名区分，与 VS 解决方案管理器一致；占位节点不显示图标。 -->
                    <!-- Icons follow the node type/extension, mirroring the VS Solution Explorer; placeholders show none. -->
                    <icons:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16"
                                        Foreground="{Binding IconBrush}"
                                        VerticalAlignment="Center" IsVisible="{Binding !IsPlaceholder}" />
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>