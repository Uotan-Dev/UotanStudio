<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Plugins"
        xmlns:views="using:UotanStudio.Views"
        Title="Plugin Manager"
        Width="900" Height="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        SystemDecorations="Full"
        x:Class="UotanStudio.Views.PluginManagerDialog"
        x:DataType="vm:PluginManagerViewModel">
    <views:PluginManagerView DataContext="{Binding}" />
</Window>
