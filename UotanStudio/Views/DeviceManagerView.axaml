<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UotanStudio.ViewModels.Devices"
             xmlns:devices="using:UotanStudio.Abstractions.Devices"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="UotanStudio.Views.DeviceManagerView"
             x:DataType="vm:DeviceManagerViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部工具栏：协议切换 + 刷新 -->
        <Border Grid.Row="0" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Devices" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding EnumerateDevicesCommand}"
                            IsEnabled="{Binding !IsEnumerating}"
                            ToolTip.Tip="Refresh">
                        <avalonia:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                    </Button>
                </StackPanel>
                <!-- 协议快速连接 -->
                <ItemsControl ItemsSource="{x:Static devices:DeviceProtocolExtensions.AllProtocols}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="6,4" FontSize="11"
                                    Command="{Binding $parent[ItemsControl].((vm:DeviceManagerViewModel)DataContext).ConnectCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 中央：设备列表 + 能力描述 -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,3*">
            <!-- 左侧设备列表 -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}"
                     Margin="0,0,4,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="devices:DeviceInfo">
                        <StackPanel Margin="0,2" Spacing="2">
                            <TextBlock Text="{Binding Serial}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Protocol}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Manufacturer}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 右侧能力描述与操作 -->
            <Border Grid.Column="1" Padding="8" Margin="4,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Capabilities" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="4">
                            <TextBlock IsVisible="{Binding !HasSelection}" Text="No device selected"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,20" />

                            <ItemsControl IsVisible="{Binding HasSelection}"
                                          ItemsSource="{Binding SelectedDevice.Capabilities.SupportedProtocols}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,2" Margin="0,0,4,0"
                                                Background="{DynamicResource ControlBackgroundColor}"
                                                CornerRadius="3">
                                            <TextBlock Text="{Binding}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsAdbShell, Mode=OneWay}"
                                      IsEnabled="False" Content="ADB Shell" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsFastbootFlash, Mode=OneWay}"
                                      IsEnabled="False" Content="Fastboot Flash" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsPartitionErase, Mode=OneWay}"
                                      IsEnabled="False" Content="Partition Erase" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsOtaSideload, Mode=OneWay}"
                                      IsEnabled="False" Content="OTA Sideload" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsDualSlot, Mode=OneWay}"
                                      IsEnabled="False" Content="Dual Slot (A/B)" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsRebootModes, Mode=OneWay}"
                                      IsEnabled="False" Content="Reboot Modes" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.IsBootloaderUnlocked, Mode=OneWay}"
                                      IsEnabled="False" Content="Bootloader Unlocked" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsEdl, Mode=OneWay}"
                                      IsEnabled="False" Content="Qualcomm EDL" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsMtkBrom, Mode=OneWay}"
                                      IsEnabled="False" Content="MediaTek Brom" />
                            <CheckBox IsChecked="{Binding SelectedDevice.Capabilities.SupportsRkUpgrade, Mode=OneWay}"
                                      IsEnabled="False" Content="Rockchip Upgrade" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：操作按钮，根据选中设备能力动态启用 -->
        <Border Grid.Row="2" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                <Button Padding="8,4" Content="Flash" ToolTip.Tip="Flash partition"
                        IsEnabled="{Binding CanFlash}"
                        Command="{Binding FlashCommand}"
                        CommandParameter="boot|dummy.img" />
                <Button Padding="8,4" Content="Erase" ToolTip.Tip="Erase partition"
                        IsEnabled="{Binding CanErase}"
                        Command="{Binding EraseCommand}"
                        CommandParameter="userdata" />
                <Button Padding="8,4" Content="Reboot"
                        IsEnabled="{Binding CanReboot}"
                        Command="{Binding RebootCommand}"
                        CommandParameter="Bootloader" />
                <Button Padding="8,4" Content="ADB Shell"
                        IsEnabled="{Binding CanAdbShell}" />
                <Button Padding="8,4" Content="Disconnect"
                        IsEnabled="{Binding HasSelection}"
                        Command="{Binding DisconnectCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
