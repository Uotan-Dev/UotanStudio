<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels.Shell"
             xmlns:views="using:UotanStudio.Views.Shell"
             xmlns:app="using:UotanStudio"
             xmlns:models="using:UotanStudio.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="UotanStudio.Views.Shell.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <!-- Main Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16" Spacing="24" MaxWidth="800">

                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_HdcPath}" FontWeight="SemiBold" />
                    <TextBox Text="{Binding HdcPath, Mode=TwoWay}" PlaceholderText="{DynamicResource Settings_HdcPathHint}" />
                </StackPanel>

                <!-- Section 1: Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Appearance}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- Theme Selection -->
                    <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="13" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <RadioButton Content="{DynamicResource Settings_ThemeFollowSystem}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeLightMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeDarkMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    </StackPanel>

                <!-- Section 2: Language -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_LanguagePreview}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LanguagePreviewText}"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Section 3: General -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_General}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoSave}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding AutoSave, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_DebugMode}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugMode, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Firmware}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Text="{DynamicResource Settings_FirmwareParallelism}" VerticalAlignment="Center" FontSize="13" />
                        <NumericUpDown x:Name="FirmwareParallelismInput" Grid.Column="1"
                                       Value="{Binding FirmwareParallelism, Mode=TwoWay}" Minimum="1" Maximum="8"
                                       Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                                   Text="{DynamicResource Settings_FirmwareParallelismHint}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <views:AiSettingsView DataContext="{Binding Ai}"
                                      IsVisible="{x:Static app:AppFeatures.AiAssistantEnabled}" />

                <!-- Section 4: Open Source Credits -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_OpenSourceCredits}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 商业许可说明 -->
                    <TextBlock Text="{DynamicResource Settings_OpenSourceNotice}"
                               FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <!-- 开源项目列表 -->
                    <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.OpenSourceProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:OpenSourceProject">
                                <Border Padding="10,8" CornerRadius="6" Margin="0,3"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <!-- 作者头像 -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding AuthorAvatarUrl}" Width="44" Height="44"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <!-- 名称 / 协议 / 描述 -->
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LicenseName}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.75"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- 链接按钮:仓库 / 作者 -->
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Settings_OpenRepository}"
                                                    FontSize="11" Padding="8,2" HorizontalAlignment="Stretch"
                                                    Tag="{Binding RepositoryUrl}" Click="OnOpenLinkClick" />
                                            <Button Content="{Binding AuthorName}"
                                                    FontSize="11" Padding="8,2" HorizontalAlignment="Stretch"
                                                    Tag="{Binding AuthorGitHubUrl}" Click="OnOpenLinkClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section 5: Reset to Defaults -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,32">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}"
                            Command="{Binding ResetToDefaultsCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
