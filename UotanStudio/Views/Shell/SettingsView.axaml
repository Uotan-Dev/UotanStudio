<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels.Shell"
             xmlns:views="using:UotanStudio.Views.Shell"
             xmlns:app="using:UotanStudio"
             xmlns:models="using:UotanStudio.Models"
             xmlns:mcp="using:UotanStudio.Services.Mcp"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="UotanStudio.Views.Shell.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <!-- Main Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16" Spacing="24" MaxWidth="800">

                <!-- Section 1: Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Appearance}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- Theme Selection -->
                    <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="13" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <RadioButton Content="{DynamicResource Settings_ThemeFollowSystem}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeLightMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeDarkMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    </StackPanel>

                <!-- Section 2: Language -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_LanguagePreview}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LanguagePreviewText}"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_DeviceCommunication}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Text="{DynamicResource Settings_UsbBackend}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding DeviceUsbBackendIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{DynamicResource Settings_UsbAuto}" />
                            <ComboBoxItem Content="{DynamicResource Settings_UsbNative}" />
                            <ComboBoxItem Content="{DynamicResource Settings_UsbLibusb}" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings_AdbServer}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AdbServerStatus}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings_HdcServer}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HdcServerStatus}" Margin="0,8,0,0" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Settings_StopAdbServer}" Command="{Binding StopAdbServerCommand}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource Settings_StopHdcServer}" Command="{Binding StopHdcServerCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ServerActionStatus}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Section 3: General -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_General}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoSave}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding AutoSave, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_DebugMode}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugMode, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_FlashAutoBackup}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding FlashAutoBackup, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="12" Opacity="0.7"
                                   Text="{DynamicResource Settings_FlashAutoBackupDescription}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Firmware}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Text="{DynamicResource Settings_FirmwareParallelism}" VerticalAlignment="Center" FontSize="13" />
                        <NumericUpDown x:Name="FirmwareParallelismInput" Grid.Column="1"
                                       Value="{Binding FirmwareParallelism, Mode=TwoWay}" Minimum="1" Maximum="64"
                                       Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                                   Text="{DynamicResource Settings_FirmwareParallelismHint}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Text="{DynamicResource Settings_ErofsLegacy}" VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ErofsLegacyCompatibility, Mode=TwoWay}"
                                      HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                                   Text="{DynamicResource Settings_ErofsLegacyHint}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <views:AiSettingsView DataContext="{Binding Ai}"
                                      IsVisible="{x:Static app:AppFeatures.AiAssistantEnabled}" />

                <!-- Section: MCP -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Mcp}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{DynamicResource Settings_McpHint}" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,4" />

                    <!-- MCP 服务器连接列表 -->
                    <ItemsControl ItemsSource="{Binding McpServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mcp:McpServerConfig">
                                <Grid ColumnDefinitions="120,80,130,140,*,36,52" ColumnSpacing="6" Margin="0,3">
                                    <TextBox Grid.Column="0" Text="{Binding Name}"
                                             PlaceholderText="{DynamicResource Settings_McpServerName}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding $parent[UserControl].DataContext.McpTransportKinds}"
                                              SelectedItem="{Binding Transport}"
                                              ToolTip.Tip="{DynamicResource Settings_McpTransport}" />
                                    <TextBox Grid.Column="2" Text="{Binding Command}"
                                             PlaceholderText="{DynamicResource Settings_McpCommand}" />
                                    <TextBox Grid.Column="3" Text="{Binding Arguments}"
                                             PlaceholderText="{DynamicResource Settings_McpArguments}" />
                                    <TextBox Grid.Column="4" Text="{Binding Url}"
                                             PlaceholderText="{DynamicResource Settings_McpUrl}" />
                                    <CheckBox Grid.Column="5" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource Settings_McpEnabled}" />
                                    <Button Grid.Column="6" Content="{DynamicResource Settings_McpRemove}"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveMcpServerCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 添加服务器：右对齐 -->
                    <Button Content="{DynamicResource Settings_McpAdd}" Command="{Binding AddMcpServerCommand}"
                            HorizontalAlignment="Right" />

                    <!-- 暴露为 MCP 服务器 -->
                    <Grid ColumnDefinitions="160,*,180" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_McpExpose}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding McpExposeEnabled, Mode=TwoWay}" />
                        <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_McpExposePort}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" />
                            <NumericUpDown Grid.Column="1" Value="{Binding McpExposePort, Mode=TwoWay}"
                                           Minimum="1" Maximum="65535" Width="100" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_McpExposeRoot}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8,0,0" />
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto"
                              ColumnSpacing="6" Margin="0,8,0,0">
                            <TextBox Grid.Column="0" Text="{Binding McpExposeRootDirectory, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource Settings_McpExposeRootPlaceholder}" />
                            <Button Grid.Column="1" Content="{DynamicResource Keys_Browse}"
                                    Command="{Binding BrowseMcpRootCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{DynamicResource Settings_McpExposeRootHint}"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_McpExposeFlash}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8,0,0" />
                        <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding McpExposeAllowFlash, Mode=TwoWay}"
                                      Margin="0,8,0,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{DynamicResource Settings_McpExposeFlashWarning}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource LogErrorBrush}" />
                    </Grid>

                    <!-- 保存 MCP 设置：右对齐 -->
                    <Button Content="{DynamicResource Settings_McpSave}" Command="{Binding SaveMcpSettingsCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Section: Developers -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Developers}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 两列并排：头像在左，名称与介绍上下排列，GitHub 与酷安按钮上下排列 -->
                    <ItemsControl ItemsSource="{x:Static models:DevelopmentMembers.All}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DevelopmentMember">
                                <Border Padding="0,10" CornerRadius="6" Margin="0,3,6,3"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <!-- 头像 -->
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                                                ClipToBounds="True" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding AvatarUri, Converter={StaticResource AssetImageConverter}}"
                                                   Width="56" Height="56" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- 名称 / 英文名 / 介绍 -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding EnglishName}" FontSize="11" Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.75"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- GitHub / 酷安 -->
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <HyperlinkButton Content="{DynamicResource Settings_GitHub}" FontSize="11"
                                                             HorizontalAlignment="Right"
                                                             Tag="{Binding GitHubUrl}" Click="OnOpenLinkClick" />
                                            <HyperlinkButton Content="{DynamicResource Settings_Coolapk}" FontSize="11"
                                                             HorizontalAlignment="Right"
                                                             Tag="{Binding CoolapkUrl}" Click="OnOpenLinkClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section 5: Reset to Defaults（右对齐，与上方按钮一致） -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,32" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}"
                            Command="{Binding ResetToDefaultsCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>