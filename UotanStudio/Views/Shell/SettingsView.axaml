<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels.Shell"
             xmlns:models="using:UotanStudio.Models"
             xmlns:mcp="using:UotanStudio.Services.Mcp"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="UotanStudio.Views.Shell.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <!-- Main Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16" Spacing="24" MaxWidth="800">

                <!-- Section 1: Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Appearance}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- Theme Selection -->
                    <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="13" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <RadioButton Content="{DynamicResource Settings_ThemeFollowSystem}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeLightMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeDarkMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    </StackPanel>

                <!-- Section 2: Language -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_LanguagePreview}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LanguagePreviewText}"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Section 3: General -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_General}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoSave}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding AutoSave, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Section: MCP -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Mcp}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{DynamicResource Settings_McpHint}" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Margin="0,0,0,4" />

                    <!-- MCP 服务器连接列表 -->
                    <ItemsControl ItemsSource="{Binding McpServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mcp:McpServerConfig">
                                <Grid ColumnDefinitions="120,80,130,140,*,36,52" ColumnSpacing="6" Margin="0,3">
                                    <TextBox Grid.Column="0" Text="{Binding Name}"
                                             Watermark="{DynamicResource Settings_McpServerName}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding $parent[UserControl].DataContext.McpTransportKinds}"
                                              SelectedItem="{Binding Transport}" />
                                    <TextBox Grid.Column="2" Text="{Binding Command}"
                                             Watermark="{DynamicResource Settings_McpCommand}" />
                                    <TextBox Grid.Column="3" Text="{Binding Arguments}"
                                             Watermark="{DynamicResource Settings_McpArguments}" />
                                    <TextBox Grid.Column="4" Text="{Binding Url}"
                                             Watermark="{DynamicResource Settings_McpUrl}" />
                                    <CheckBox Grid.Column="5" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource Settings_McpEnabled}" />
                                    <Button Grid.Column="6" Content="{DynamicResource Settings_McpRemove}"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveMcpServerCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{DynamicResource Settings_McpAdd}" Command="{Binding AddMcpServerCommand}"
                            HorizontalAlignment="Left" />

                    <!-- 暴露为 MCP 服务器 -->
                    <Grid ColumnDefinitions="160,*,180" ColumnSpacing="8" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_McpExpose}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding McpExposeEnabled, Mode=TwoWay}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_McpExposePort}" FontSize="13" />
                            <NumericUpDown Value="{Binding McpExposePort, Mode=TwoWay}" Minimum="1" Maximum="65535" Width="100" />
                        </StackPanel>
                    </Grid>

                    <Button Content="{DynamicResource Settings_McpSave}" Command="{Binding SaveMcpSettingsCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Section 4: Open Source Credits -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_OpenSourceCredits}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- 商业许可说明 -->
                    <TextBlock Text="{DynamicResource Settings_OpenSourceNotice}"
                               FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <!-- 开源项目列表 -->
                    <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.OpenSourceProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:OpenSourceProject">
                                <Border Padding="10,8" CornerRadius="6" Margin="0,3"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <!-- 作者头像 -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding AuthorAvatarUrl}" Width="44" Height="44"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <!-- 名称 / 协议 / 描述 -->
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LicenseName}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.75"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- 链接按钮:仓库 / 作者 -->
                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Settings_OpenRepository}"
                                                    FontSize="11" Padding="8,2" HorizontalAlignment="Stretch"
                                                    Tag="{Binding RepositoryUrl}" Click="OnOpenLinkClick" />
                                            <Button Content="{Binding AuthorName}"
                                                    FontSize="11" Padding="8,2" HorizontalAlignment="Stretch"
                                                    Tag="{Binding AuthorGitHubUrl}" Click="OnOpenLinkClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section 5: Reset to Defaults -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,32">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}"
                            Command="{Binding ResetToDefaultsCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast Notification Overlay -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                IsVisible="{Binding IsToastVisible}"
                CornerRadius="8" Padding="12,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding ToastMessage}" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
