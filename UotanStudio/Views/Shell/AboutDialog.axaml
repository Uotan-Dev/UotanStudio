<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:models="using:UotanStudio.Models"
        x:Class="UotanStudio.Views.Shell.AboutDialog"
        Title="{DynamicResource About_Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanMinimize="False" CanMaximize="False" CanResize="False"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
    <Window.Styles>
        <Style Selector="WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MinimizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MaximizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,40,24,24">
        <!-- Logo / 名称 / 版本 / 简介 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Image Source="/Assets/UotanToolbox.png" Width="64" Height="64"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="UotanStudio" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,2,0,0">
                <TextBlock Text="{DynamicResource About_Channel}" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" Margin="0,0,2,0" />
                <Border x:Name="ReleaseBadge" CornerRadius="4" Padding="6,1" BorderThickness="1"
                        BorderBrush="Gray" VerticalAlignment="Center">
                    <TextBlock x:Name="ReleaseText" FontSize="10" Foreground="Gray" />
                </Border>
                <Border x:Name="BetaBadge" CornerRadius="4" Padding="6,1" BorderThickness="1"
                        BorderBrush="Gray" VerticalAlignment="Center">
                    <TextBlock x:Name="BetaText" FontSize="10" Foreground="Gray" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,2,0,0">
                <TextBlock Text="{DynamicResource About_Commit}" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" />
                <HyperlinkButton x:Name="CommitLink" FontSize="11" VerticalAlignment="Center"
                                 Click="OnCommitClick" />
                <TextBlock x:Name="CommitUnavailableText" Text="{DynamicResource About_CommitUnknown}"
                           FontSize="11" Opacity="0.7" VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
            <TextBlock Text="{DynamicResource About_Description}"
                       FontSize="12" Opacity="0.8"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,8" />
            <TextBlock Text="{DynamicResource About_FontNotice}"
                       FontSize="11" Opacity="0.7"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- 开源项目：点击“开源项目”按钮后向下展开 -->
        <StackPanel Grid.Row="1" x:Name="OpenSourcePanel" IsVisible="False" Spacing="8" Margin="0,4,0,0">
            <Border Height="1" Background="{DynamicResource BorderBrush}" />

            <!-- 许可与分发说明 -->
            <TextBlock Text="{DynamicResource About_OpenSourceNotice}"
                       FontSize="11" Opacity="0.75" TextWrapping="Wrap" />

            <!-- 开源项目列表 -->
            <ScrollViewer MaxHeight="320"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Static models:OpenSourceProjects.All}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:OpenSourceProject">
                            <Border Padding="0,6" CornerRadius="6" Margin="0,2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <!-- 名称 / 协议 / 描述：与上方说明文字左对齐（头像不能放在文本左侧） -->
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                            <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LicenseName}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.75"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 作者头像 -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                                            ClipToBounds="True" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Image Source="{Binding AuthorAvatarUrl}" Width="36" Height="36"
                                               Stretch="UniformToFill" />
                                    </Border>

                                    <!-- 链接:仓库 / 作者 -->
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <HyperlinkButton Content="{DynamicResource About_OpenRepository}"
                                                         FontSize="11" HorizontalAlignment="Right"
                                                         Tag="{Binding RepositoryUrl}" Click="OnOpenLinkClick" />
                                        <HyperlinkButton Content="{Binding AuthorName}"
                                                         FontSize="11" HorizontalAlignment="Right"
                                                         Tag="{Binding AuthorGitHubUrl}" Click="OnOpenLinkClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- 按钮：开源项目在关闭按钮左侧 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="OpenSourceButton" Content="{DynamicResource About_OpenSource}"
                    Click="OnOpenSourceClick" />
            <Button Content="{DynamicResource About_Close}" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
