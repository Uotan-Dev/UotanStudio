<Window xmlns="https://github.com/avaloniaui"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:vm="using:UotanStudio.ViewModels.Shell"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   xmlns:views="using:UotanStudio.Views.Shell"
   xmlns:app="using:UotanStudio"
   xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
   xmlns:devices="using:UotanStudio.ViewModels.Devices"
   xmlns:conv="using:UotanStudio.Converters"
   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
   x:Class="UotanStudio.Views.Shell.MainWindow"
   x:DataType="vm:MainViewModel"
   Icon="/Assets/UotanToolbox.png"
   Title=""
   MinWidth="720"
   ExtendClientAreaToDecorationsHint="True"
   ExtendClientAreaTitleBarHeightHint="32">
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+S" Command="{Binding MenuVM.SaveCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding MenuVM.SaveAsCommand}" />
		<KeyBinding Gesture="Ctrl+F" Command="{Binding MenuVM.FindCommand}" />
		<KeyBinding Gesture="Ctrl+H" Command="{Binding MenuVM.ReplaceCommand}" />
	</Window.KeyBindings>
	<DockPanel>
		<Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,136,0">
			<Image Grid.Column="0" Height="25" Margin="5" Source="/Assets/UotanToolbox.png" HorizontalAlignment="Left"/>
			<Menu Grid.Column="1" x:Name="TopMenu" HorizontalAlignment="Left">

				<!-- 文件 / File -->
				<MenuItem>
					<MenuItem.Header>
						<TextBlock Text="{DynamicResource Menu_File}" FontWeight="SemiBold" />
					</MenuItem.Header>
					<MenuItem Header="{DynamicResource Menu_NewProject}" Command="{Binding MenuVM.NewProjectCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FolderPlus" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_OpenProject}" Command="{Binding MenuVM.OpenProjectCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_OpenRecent}"
							  IsEnabled="{Binding MenuVM.HasRecentProjects}"
							  ItemsSource="{Binding MenuVM.RecentProjects}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="History" Width="16" Height="16" />
						</MenuItem.Icon>
						<!-- 注意：不能用 ItemTemplate 嵌套 MenuItem（会容器套容器且外层无 Command 被禁用），
						     须用 ItemContainerTheme 直接给生成的 MenuItem 容器设置 Header/Command。 -->
						<MenuItem.ItemContainerTheme>
							<ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
								<Setter Property="Header" Value="{Binding DisplayName, x:DataType=vm:RecentProjectEntry}" />
								<Setter Property="Command" Value="{Binding OpenCommand, x:DataType=vm:RecentProjectEntry}" />
							</ControlTheme>
						</MenuItem.ItemContainerTheme>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_Save}" Command="{Binding MenuVM.SaveCommand}" InputGesture="Ctrl+S">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ContentSave" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{Binding MenuVM.SaveAsCommand}" InputGesture="Ctrl+Shift+S">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ContentSaveEditOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_ImportImage}" Command="{Binding MenuVM.ImportImageCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FileImport" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_ExportImage}" Command="{Binding MenuVM.ExportImageCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FileExport" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Export}" Command="{Binding MenuVM.ExportCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Export" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_Exit}" Command="{Binding MenuVM.ExitCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ExitToApp" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<!-- 编辑 / Edit -->
				<MenuItem>
					<MenuItem.Header>
						<TextBlock Text="{DynamicResource Menu_Edit}" FontWeight="SemiBold" />
					</MenuItem.Header>
					<MenuItem Header="{DynamicResource FindReplace_Find}" Command="{Binding MenuVM.FindCommand}" InputGesture="Ctrl+F">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Magnify" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource FindReplace_Replace}" Command="{Binding MenuVM.ReplaceCommand}" InputGesture="Ctrl+H">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FindReplace" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_Undo}" Command="{Binding MenuVM.UndoCommand}" InputGesture="Ctrl+Z">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Undo" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Redo}" Command="{Binding MenuVM.RedoCommand}" InputGesture="Ctrl+Y">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Redo" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_Cut}" Command="{Binding MenuVM.CutCommand}" InputGesture="Ctrl+X">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ContentCut" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Copy}" Command="{Binding MenuVM.CopyCommand}" InputGesture="Ctrl+C">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Paste}" Command="{Binding MenuVM.PasteCommand}" InputGesture="Ctrl+V">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ContentPaste" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Delete}" Command="{Binding MenuVM.DeleteCommand}" InputGesture="Delete">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_SelectAll}" Command="{Binding MenuVM.SelectAllCommand}" InputGesture="Ctrl+A">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="SelectAll" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<!-- 视图 / View -->
				<MenuItem>
					<MenuItem.Header>
						<TextBlock Text="{DynamicResource Menu_View}" FontWeight="SemiBold" />
					</MenuItem.Header>
					<MenuItem Header="{DynamicResource Menu_Workspace}" Command="{Binding MenuVM.GoToWorkspaceCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="MonitorDashboard" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_NodeEditor}" Command="{Binding MenuVM.GoToNodeEditorCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="ScriptTextPlayOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_Settings}" Command="{Binding MenuVM.GoToSettingsCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Tab_Compare}" Command="{Binding MenuVM.GoToCompareCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FileCompare" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_ToggleMinimap}" Command="{Binding MenuVM.ToggleMinimapCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="MapOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_ZoomIn}" Command="{Binding MenuVM.ZoomInCommand}" InputGesture="Ctrl++">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_ZoomOut}" Command="{Binding MenuVM.ZoomOutCommand}" InputGesture="Ctrl+-">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="MagnifyMinusOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_ResetZoom}" Command="{Binding MenuVM.ResetZoomCommand}" InputGesture="Ctrl+0">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Restore" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

				<!-- 窗口 / Window -->
				<MenuItem>
					<MenuItem.Header>
						<TextBlock Text="{DynamicResource Menu_Window}" FontWeight="SemiBold" />
					</MenuItem.Header>
					<MenuItem Header="{DynamicResource Menu_WindowProjectExplorer}"
							  ToggleType="CheckBox"
							  IsChecked="{Binding MenuVM.WorkspacePanels.ProjectExplorerVisible, Mode=OneWay}"
							  Command="{Binding MenuVM.ToggleProjectExplorerCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowProjectSetting}"
							  ToggleType="CheckBox"
							  IsChecked="{Binding MenuVM.WorkspacePanels.ProjectSettingVisible, Mode=OneWay}"
							  Command="{Binding MenuVM.ToggleProjectSettingCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowDevice}"
							  ToggleType="CheckBox"
							  IsChecked="{Binding MenuVM.WorkspacePanels.DeviceVisible, Mode=OneWay}"
							  Command="{Binding MenuVM.ToggleDevicePanelCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowImages}"
							  ToggleType="CheckBox"
							  IsChecked="{Binding MenuVM.WorkspacePanels.ImagesViewVisible, Mode=OneWay}"
							  Command="{Binding MenuVM.ToggleImagesViewCommand}" />
					<MenuItem Header="{DynamicResource Dock_AiAssistant}"
					          IsVisible="{x:Static app:AppFeatures.AiAssistantEnabled}"
					          ToggleType="CheckBox"
					          IsChecked="{Binding MenuVM.WorkspacePanels.AiAssistantVisible, Mode=OneWay}"
					          Command="{Binding MenuVM.ToggleAiAssistantCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowProperties}"
					     ToggleType="CheckBox"
					     IsChecked="{Binding MenuVM.WorkspacePanels.PropertiesVisible, Mode=OneWay}"
					     Command="{Binding MenuVM.TogglePropertiesCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowWorkspaceLog}"
					     ToggleType="CheckBox"
					     IsChecked="{Binding MenuVM.WorkspacePanels.WorkspaceLogVisible, Mode=OneWay}"
					     Command="{Binding MenuVM.ToggleWorkspaceLogCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowAdbLog}"
					     ToggleType="CheckBox"
					     IsChecked="{Binding MenuVM.WorkspacePanels.AdbLogVisible, Mode=OneWay}"
					     Command="{Binding MenuVM.ToggleAdbLogCommand}" />
					<MenuItem Header="{DynamicResource Menu_WindowTerminal}"
					     ToggleType="CheckBox"
					     IsChecked="{Binding MenuVM.WorkspacePanels.TerminalVisible, Mode=OneWay}"
					     Command="{Binding MenuVM.ToggleTerminalCommand}" />
				</MenuItem>

				<!-- 工具 / Tools -->
				<MenuItem>
				 <MenuItem.Header>
				  <TextBlock Text="{DynamicResource Menu_Tools}" FontWeight="SemiBold" />
				 </MenuItem.Header>
				 <MenuItem Header="{DynamicResource Menu_DeviceManager}" Command="{Binding MenuVM.OpenDeviceCommand}">
					<MenuItem.Icon>
						<avalonia:MaterialIcon Kind="Devices" Width="16" Height="16" />
					</MenuItem.Icon>
				 </MenuItem>
				 <MenuItem Header="{DynamicResource Menu_LogWindow}" Command="{Binding MenuVM.OpenLogWindowCommand}">
					<MenuItem.Icon>
						<avalonia:MaterialIcon Kind="ScrollTextOutline" Width="16" Height="16" />
					</MenuItem.Icon>
				 </MenuItem>
				 <Separator />
				 <MenuItem Header="{DynamicResource Menu_CompareFiles}" Command="{Binding MenuVM.CompareFilesCommand}">
					<MenuItem.Icon>
						<avalonia:MaterialIcon Kind="FileCompare" Width="16" Height="16" />
					</MenuItem.Icon>
				 </MenuItem>
				 <MenuItem Header="{DynamicResource Menu_CompareFolders}" Command="{Binding MenuVM.CompareFoldersCommand}">
					<MenuItem.Icon>
						<avalonia:MaterialIcon Kind="FolderMultipleOutline" Width="16" Height="16" />
					</MenuItem.Icon>
				 </MenuItem>
				</MenuItem>

				<!-- 帮助 / Help -->
				<MenuItem>
					<MenuItem.Header>
						<TextBlock Text="{DynamicResource Menu_Help}" FontWeight="SemiBold" />
					</MenuItem.Header>
					<MenuItem Header="{DynamicResource Menu_Documentation}" Command="{Binding MenuVM.DocumentationCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{DynamicResource Menu_ReportIssue}" Command="{Binding MenuVM.ReportIssueCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="BugOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{DynamicResource Menu_About}" Command="{Binding MenuVM.AboutCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="InformationOutline" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>

			</Menu>
			<TextBlock Grid.Column="2" Text="{Binding WindowTitle}" FontSize="12" Opacity="0.7"
					   VerticalAlignment="Center" Margin="16 0 12 0" TextTrimming="CharacterEllipsis" />
			<Menu Grid.Column="3" x:Name="DeviceSelectorMenu" VerticalAlignment="Center" Margin="0,0,4,0">
				<MenuItem x:Name="DeviceSelector" Height="28" Padding="8,2"
						  ToolTip.Tip="{DynamicResource Device_Select}"
						  AutomationProperties.Name="{DynamicResource Device_Select}">
					<MenuItem.Header>
						<Grid ColumnDefinitions="16,*,12" ColumnSpacing="8" MinWidth="132" MaxWidth="280">
							<avalonia:MaterialIcon Kind="Cellphone" Width="16" Height="16" />
							<!-- 未选中时显示占位文本，选中后显示设备名（两块互斥切换，保留本地化资源引用）。 -->
							<TextBlock Grid.Column="1" Text="{DynamicResource Device_Select}"
									   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
									   IsVisible="{Binding DeviceVM.HasSelectedDevice, Converter={x:Static BoolConverters.Not}}" />
							<TextBlock Grid.Column="1" Text="{Binding DeviceVM.SelectedDeviceName}"
									   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
									   IsVisible="{Binding DeviceVM.HasSelectedDevice}" />
							<avalonia:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="12" Height="12" />
						</Grid>
					</MenuItem.Header>
					<!-- 空态：未检测到设备时显示禁用占位项。 -->
					<MenuItem Header="{DynamicResource Device_NoDevices}" IsEnabled="False"
							  IsVisible="{Binding DeviceVM.HasDevices, Converter={x:Static BoolConverters.Not}}" />
					<!-- 真实设备列表：绑定 DeviceViewModel 单例，点选同步 SelectedDevice（与设备面板共享选择状态）。 -->
					<MenuItem Header="{DynamicResource Device_Select}" ItemsSource="{Binding DeviceVM.Devices}"
							  IsVisible="{Binding DeviceVM.HasDevices}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Cellphone" Width="16" Height="16" />
						</MenuItem.Icon>
						<!-- 注意：不能用 ItemTemplate 嵌套 MenuItem（会容器套容器且外层无 Command 被禁用），
						     须用 ItemContainerTheme 直接给生成的 MenuItem 容器设置 Header/Command/选中打勾。 -->
						<MenuItem.ItemContainerTheme>
							<ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
								<Setter Property="Header" Value="{Binding DisplayName, x:DataType=devices:DeviceInfo}" />
								<Setter Property="ToggleType" Value="CheckBox" />
								<Setter Property="IsChecked" Value="{Binding IsSelected, x:DataType=devices:DeviceInfo, Mode=OneWay}" />
								<Setter Property="Command" Value="{Binding SelectCommand, x:DataType=devices:DeviceInfo}" />
							</ControlTheme>
						</MenuItem.ItemContainerTheme>
					</MenuItem>
					<Separator />
					<MenuItem x:Name="DeviceSelectorManagerItem" Header="{DynamicResource Menu_DeviceManager}"
							  Command="{Binding MenuVM.OpenDeviceCommand}">
						<MenuItem.Icon>
							<avalonia:MaterialIcon Kind="Devices" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</MenuItem>
			</Menu>
		</Grid>

		<!-- 主内容页面区域 -->
		<views:MainView />
	</DockPanel>
</Window>
