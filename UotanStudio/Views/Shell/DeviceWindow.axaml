<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="using:UotanStudio.Views.Devices"
        Title="{DynamicResource Menu_DeviceManager}"
        Width="960" Height="640"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full"
        Icon="/Assets/UotanToolbox.png"
        x:Class="UotanStudio.Views.Shell.DeviceWindow">
    <Window.Styles>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Styles>
    <pages:DeviceView Margin="0,32,0,0" />
</Window>
