<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodes="using:UotanStudio.Views.Nodes"
        xmlns:vm="using:UotanStudio.ViewModels.Nodes"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:project="clr-namespace:UotanStudio.Services.Projects;assembly=UotanStudio.Projects"
        x:Class="UotanStudio.Views.Shell.VisualPluginEditorWindow"
        x:DataType="vm:NodeEditorViewModel"
        Width="1180" Height="760" MinWidth="820" MinHeight="560"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" WindowStartupLocation="CenterScreen"
        Icon="/Assets/UotanToolbox.png">
    <Grid Margin="0,32,0,0" RowDefinitions="44,Auto,Auto,*">
        <Border Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Node_EditInterface}" Click="EditInterfaceClick" IsEnabled="{Binding !IsExecuting}" />
                    <icons:MaterialIcon Kind="PuzzleOutline" Width="18" Height="18" />
                    <TextBlock x:Name="PluginNameText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PluginVersionText" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="SavePluginButton" Grid.Column="1" Height="32" Padding="12,0" Click="SaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" />
                        <TextBlock Text="{DynamicResource Plugin_SaveGraph}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Expander x:Name="ResourcePanel" Grid.Row="1" Header="{DynamicResource Plugin_Resources}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="10,2">
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Plugin_ResourceHelp}" TextWrapping="Wrap" Opacity="0.75" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBox x:Name="ResourceIdText" PlaceholderText="{DynamicResource Plugin_ResourceId}" />
                    <Button x:Name="AddResourceButton" Grid.Column="1" Content="{DynamicResource Plugin_AddResource}" Click="AddResourceClick" />
                    <Button x:Name="RemoveResourceButton" Grid.Column="2" Content="{DynamicResource Plugin_RemoveResource}" Click="RemoveResourceClick" />
                    <Button x:Name="ExportBundleButton" Grid.Column="3" Content="{DynamicResource Plugin_ExportBundle}" Click="ExportBundleClick" />
                </Grid>
                <ListBox x:Name="ResourceList" MaxHeight="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="project:VisualPluginAsset">
                            <Grid ColumnDefinitions="180,*,110" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Length, StringFormat='{}{0:N0} B'}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Sha256}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Expander>
        <Expander x:Name="RequirementsPanel" Grid.Row="2" Header="{DynamicResource Plugin_Requirements}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="10,2">
            <StackPanel Spacing="6" IsEnabled="{Binding !IsExecuting}">
                <TextBlock Text="{DynamicResource Plugin_DependencyHelp}" TextWrapping="Wrap" Opacity="0.75" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Plugin_Version}" VerticalAlignment="Center" />
                    <TextBox x:Name="VersionInput" Grid.Column="1" TextChanged="RequirementsChanged" MaxLength="64" />
                </Grid>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Text="{DynamicResource Plugin_Dependencies}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Plugin_Conflicts}" />
                    <TextBox x:Name="DependenciesInput" Grid.Row="1" AcceptsReturn="True" MinHeight="72" MaxHeight="150" MaxLength="32768" TextChanged="RequirementsChanged" />
                    <TextBox x:Name="ConflictsInput" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" MinHeight="72" MaxHeight="150" MaxLength="32768" TextChanged="RequirementsChanged" />
                </Grid>
                <TextBlock x:Name="RequirementsError" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
        </Expander>
        <nodes:NodeEditorView x:Name="GraphHost" Grid.Row="3" />
    </Grid>
</Window>
