<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UotanStudio.Views.Shell"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ursa="using:Ursa.Controls"
        x:Class="UotanStudio.Views.Shell.NewProjectWindow"
        Title="{DynamicResource Menu_NewProject}"
        Width="800" Height="600" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        CanMinimize="False" CanMaximize="False"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
    <Window.Resources>
        <DataTemplate x:Key="ImageEntryTemplate" x:DataType="local:NewProjectImageEntry">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Height="28" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" MinHeight="0"
                              Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName}" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                               ToolTip.Tip="{Binding Tip}" />
                    <TextBlock Grid.Column="2" Text="{Binding Format}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Format}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MinimizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MaximizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,48,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.project-field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="ListBox.image-list > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.image-list > ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="0,32,0,0">
        <ursa:LoadingContainer Grid.Row="0" Name="MainBusyContainer" IsLoading="False">
            <ursa:LoadingContainer.Indicator>
                <ursa:LoadingIcon Classes="Large"
                                  IsLoading="{Binding $parent[ursa:LoadingContainer].IsLoading, Mode=TwoWay}" />
            </ursa:LoadingContainer.Indicator>
            <ursa:LoadingContainer.LoadingMessageTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
            </ursa:LoadingContainer.LoadingMessageTemplate>
            <Grid Name="FormContent" RowDefinitions="Auto,*" Margin="20,20,20,16" RowSpacing="14">
            <StackPanel Spacing="12" Grid.IsSharedSizeScope="True">
                <Grid RowDefinitions="Auto" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectFieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="field-label" Text="{DynamicResource NewProject_Name}" />
                    <TextBox Grid.Column="1" Name="ProjectNameBox" Classes="project-field"
                             PlaceholderText="{DynamicResource NewProject_NamePlaceholder}"
                             AutomationProperties.Name="{DynamicResource NewProject_Name}" />
                </Grid>
                <Grid RowDefinitions="Auto" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectFieldLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectBrowseButton" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="field-label" Text="{DynamicResource NewProject_Location}" />
                    <TextBox Grid.Column="1" Name="ProjectLocationBox" Classes="project-field"
                             AutomationProperties.Name="{DynamicResource NewProject_Location}" />
                    <Button Grid.Column="2" Classes="browse" HorizontalAlignment="Stretch" Click="OnBrowseLocationClick"
                            ToolTip.Tip="{DynamicResource NewProject_BrowseLocation}"
                            AutomationProperties.Name="{DynamicResource NewProject_BrowseLocation}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource NewProject_SelectFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Name="ImagePicker" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectFieldLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectBrowseButton" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProjectBrowseButton" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="field-label" Text="{DynamicResource NewProject_AddImages}" />
                    <TextBox Grid.Column="1" Name="ImagePathsBox" Classes="project-field"
                             PlaceholderText="{DynamicResource NewProject_ImagesPlaceholder}"
                             AutomationProperties.Name="{DynamicResource NewProject_AddImages}">
                        <TextBox.InnerRightContent>
                            <Button Name="ClearImagesButton" IsVisible="False" Classes="Small" Padding="4"
                                    Click="OnClearImagesClick" ToolTip.Tip="{DynamicResource NewProject_ClearImages}"
                                    AutomationProperties.Name="{DynamicResource NewProject_ClearImages}">
                                <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <Button Grid.Column="2" Classes="browse" HorizontalAlignment="Stretch" Click="OnBrowseImagesClick"
                            ToolTip.Tip="{DynamicResource NewProject_BrowseImages}"
                            AutomationProperties.Name="{DynamicResource NewProject_BrowseImages}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="FileMultipleOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource NewProject_SelectImages}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="browse" HorizontalAlignment="Stretch" Click="OnGetRomClick"
                            ToolTip.Tip="{DynamicResource NewProject_GetRom}"
                            AutomationProperties.Name="{DynamicResource NewProject_GetRom}">
                        <TextBlock Text="{DynamicResource NewProject_GetRom}" VerticalAlignment="Center" />
                    </Button>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="20">
                        <CheckBox Name="SelectAllBox" Content="{DynamicResource Menu_SelectAll}" IsChecked="True" />
                        <CheckBox Name="UnpackImagesBox" Content="{DynamicResource NewProject_UnpackImages}" IsChecked="True" />
                        <CheckBox Name="UnpackFullyBox" Content="{DynamicResource NewProject_UnpackFully}" IsChecked="True" />
                        <CheckBox Name="MergeMyPartitionsBox" IsVisible="False" IsChecked="False"
                                  Content="{DynamicResource NewProject_MergeMyPartitions}"
                                  ToolTip.Tip="{DynamicResource NewProject_MergeMyPartitionsTip}"
                                  AutomationProperties.Name="{DynamicResource NewProject_MergeMyPartitions}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Border Name="ImageListPanel" Grid.Row="1" IsVisible="False" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Background="{DynamicResource PageBackground}">
                        <ItemsControl Name="ImageHeaders" Height="28">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                        <Grid Margin="8,0" Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="88" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource NewProject_ImageName}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{DynamicResource NewProject_ImageFormat}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ListBox Name="ImageList" Grid.Row="1" Classes="image-list" Background="Transparent"
                             BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:NewProjectImageRow">
                                <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageEntryTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding ColumnCount}" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </Grid>
        </ursa:LoadingContainer>
        <Border Grid.Row="1" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PageBackground}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Name="ProgressPanel" IsVisible="False" Width="280" Spacing="4" Margin="0,0,16,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ProgressBar Name="OperationProgress" Minimum="0" Maximum="100"
                                 FontSize="12"
                                 ShowProgressText="True"
                                 Height="20"
                                 HorizontalAlignment="Stretch"
                                 CornerRadius="4" />
                    <TextBlock Name="OperationStats" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="CancelButton" Content="{DynamicResource Editor_Cancel}" MinWidth="88" Height="32"
                        IsCancel="True" Click="OnCancelClick" />
                <Button Name="CreateButton" Content="{DynamicResource NewProject_Create}" Theme="{StaticResource SolidButton}"
                        MinWidth="88" Height="32" IsDefault="True" Click="OnCreateClick" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
