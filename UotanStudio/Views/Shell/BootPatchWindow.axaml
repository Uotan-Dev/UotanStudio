<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:ursa="using:Ursa.Controls"
        xmlns:vms="using:UotanStudio.ViewModels"
        x:Class="UotanStudio.Views.Shell.BootPatchWindow"
        Title="{DynamicResource ImageView_BootPatch}"
        Width="620" Height="440" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        CanMinimize="False" CanMaximize="False"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="Button"><Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="TextBox"><Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="32" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style Selector="ComboBox"><Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="32" /></Style>
        <Style Selector="WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel">
            <Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MinimizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MaximizeButton], WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
            <Setter Property="IsVisible" Value="False" /><Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background"><ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" /></Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,48,0" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.path-field">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.browse"><Setter Property="MinWidth" Value="108" /><Setter Property="Height" Value="32" /></Style>
        <Style Selector="CheckBox.compact-check">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="0,32,0,0">
        <ursa:LoadingContainer Grid.Row="0" Name="MainBusyContainer" IsLoading="False">
            <ursa:LoadingContainer.Indicator>
                <ursa:LoadingIcon Classes="Large" IsLoading="{Binding $parent[ursa:LoadingContainer].IsLoading, Mode=TwoWay}" />
            </ursa:LoadingContainer.Indicator>
            <ursa:LoadingContainer.LoadingMessageTemplate>
                <DataTemplate>
                    <TextBlock Text="{DynamicResource ImageView_BootPatch}" FontSize="12"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
            </ursa:LoadingContainer.LoadingMessageTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20" Spacing="14" Grid.IsSharedSizeScope="True">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BootPatchFieldLabel" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BootPatchSourceColumn" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="field-label" Text="{DynamicResource BootPatch_File}" />
                        <ComboBox Grid.Column="1" Name="FileSourceBox" Width="192">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vms:LocalizedOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2" Grid.ColumnSpan="2" Name="FileVersionBox"
                                  HorizontalAlignment="Stretch" />
                        <TextBox Grid.Column="2" Name="FilePathBox" Classes="path-field" IsReadOnly="True"
                                 IsVisible="False" />
                        <Button Grid.Column="3" Name="BrowseFileButton" Classes="browse" IsVisible="False"
                                Content="{DynamicResource BootPatch_SelectFile}" Click="OnBrowseFileClick" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BootPatchFieldLabel" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BootPatchSourceColumn" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="field-label" Text="{DynamicResource BootPatch_Boot}" />
                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Name="BootPathBox" Classes="path-field" IsReadOnly="True" />
                        <Button Grid.Column="3" Classes="browse" Content="{DynamicResource BootPatch_SelectFile}" Click="OnBrowseBootClick" />
                    </Grid>
                    <Grid Name="PatchOptionsPanel" RowDefinitions="Auto,Auto" RowSpacing="8" IsVisible="False">
                        <Grid Name="PatchInputRow" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <TextBox Name="PrebootDeviceBox" PlaceholderText="{DynamicResource BootPatch_DevicePlaceholder}" />
                            <ComboBox Grid.Column="1" Name="ArchitectureBox" HorizontalAlignment="Stretch" SelectedIndex="-1" />
                            <ComboBox Grid.Column="1" Name="KmiBox" HorizontalAlignment="Stretch" SelectedIndex="-1" IsVisible="False" />
                        </Grid>
                        <WrapPanel Grid.Row="1" Name="MagiskOptionsRow" Orientation="Horizontal"
                                   ItemWidth="220" ItemHeight="40" MaxHeight="200"
                                   HorizontalAlignment="Center" VerticalAlignment="Top">
                            <CheckBox Classes="compact-check" Name="ForceRootfsBox" IsChecked="False">
                                <TextBlock Text="{DynamicResource BootPatch_ForceRootfs}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox Classes="compact-check" Name="KeepEncryptionBox" IsChecked="True">
                                <TextBlock Text="{DynamicResource BootPatch_KeepEncryption}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox Classes="compact-check" Name="InstallRecoveryBox">
                                <TextBlock Text="{DynamicResource BootPatch_InstallRecovery}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox Classes="compact-check" Name="KeepAvbBox" IsChecked="True">
                                <TextBlock Text="{DynamicResource BootPatch_KeepAvb}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox Classes="compact-check" Name="PatchVbmetaBox">
                                <TextBlock Text="{DynamicResource BootPatch_PatchVbmeta}" TextWrapping="Wrap" />
                            </CheckBox>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ursa:LoadingContainer>
        <Border Grid.Row="1" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PageBackground}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Name="ProgressPanel" IsVisible="False" Width="280" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ProgressBar Name="PatchProgressBar" Minimum="0" Maximum="100" Value="0" ShowProgressText="True" Height="20" CornerRadius="4" />
                    <TextBlock Name="ProgressText" Text="{DynamicResource BootPatch_Progress}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Editor_Cancel}" MinWidth="88" Height="32" IsCancel="True" Click="OnCancelClick" />
                    <Button Name="StartButton" Content="{DynamicResource BootPatch_Start}" Theme="{StaticResource SolidButton}" MinWidth="110" Height="32" IsDefault="True" Click="OnStartPatchClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
