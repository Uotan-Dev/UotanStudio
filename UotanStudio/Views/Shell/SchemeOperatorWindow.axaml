<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:schemes="using:UotanStudio.Services.Projects.Schemes"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        x:Class="UotanStudio.Views.Shell.SchemeOperatorWindow"
        x:DataType="vm:SchemeOperatorViewModel"
        Title="{DynamicResource Scheme_Title}"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBox"><Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="32" /></Style>
    <Style Selector="ComboBox"><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="0,32,0,0">
    <Border Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <icons:PlayCircleStroke Width="20" Height="20" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding FilePath}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Opacity="0.75" />
        <Button Grid.Column="2" Height="32" Padding="12,0" Click="OnOpenClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:FolderOpen Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Scheme_Open}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Height="32" Padding="12,0" Click="OnRunClick" IsEnabled="{Binding CanRun}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:PlayCircleStroke Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Scheme_Run}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Height="32" Padding="12,0" Click="OnStopClick" IsEnabled="{Binding CanStop}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:StopCircleStroke Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Scheme_Stop}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="410,*" ColumnSpacing="12" Margin="12">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding SchemeName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SchemeVersion}" FontSize="12" Opacity="0.65" />
            <TextBlock Text="{Binding SchemeDescription}" TextWrapping="Wrap" Opacity="0.85" />
          </StackPanel>

          <Separator />

          <TextBlock Text="{DynamicResource Scheme_Inputs}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Inputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SchemeInputViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="*" Foreground="Red" IsVisible="{Binding Required}" />
                  </StackPanel>

                  <TextBox Text="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsPlainTextInput}" />
                  <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="●" IsVisible="{Binding IsMaskedTextInput}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPlainBrowseInput}">
                    <TextBox Text="{Binding Value, Mode=TwoWay}" />
                    <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="40" Content="…"
                            Click="OnBrowseInputClick" Tag="{Binding}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsMaskedBrowseInput}">
                    <TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="●" />
                    <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="40" Content="…"
                            Click="OnBrowseInputClick" Tag="{Binding}" />
                  </Grid>

                  <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" IsVisible="{Binding IsBooleanInput}" />
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" IsVisible="{Binding IsChoiceInput}" />

                  <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator />

          <TextBlock Text="{DynamicResource Scheme_Assets}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Assets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="schemes:SchemeAsset">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding RelativePath}" FontSize="11" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Length}" FontSize="11" Opacity="0.65"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Text="{DynamicResource Scheme_Stages}" FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,6,0,8">
          <ListBox ItemsSource="{Binding Stages}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SchemeStageRunViewModel">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Opacity="0.85" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" FontSize="11"
                             Foreground="Red" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{DynamicResource Scheme_NoStages}" IsVisible="{Binding !HasStages}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
          <TextBlock Text="{DynamicResource Scheme_Resume}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ResumeOptions}"
                    SelectedItem="{Binding SelectedResumeOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SchemeResumeOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="{DynamicResource Scheme_StageStatus}" FontSize="12" Opacity="0.7" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"
                       IsIndeterminate="{Binding IsRunning}" />
          <TextBlock Text="{Binding StatusText}" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="4" Margin="0,10,0,0">
          <TextBlock Text="{DynamicResource Scheme_Result}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ResultText}" FontSize="13" />
          <TextBlock Text="{Binding FailedStageText}" Foreground="Red" FontSize="12"
                     TextWrapping="Wrap" IsVisible="{Binding HasFailedStage}" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12"
                     TextWrapping="Wrap" IsVisible="{Binding HasError}" />
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                  MaxHeight="180" IsVisible="{Binding HasLog}">
            <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                     Background="Transparent" />
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>