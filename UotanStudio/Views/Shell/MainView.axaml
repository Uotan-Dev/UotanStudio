<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avalonia="https://irihi.tech/iconica/tdesign"
			 xmlns:vm="using:UotanStudio.ViewModels.Shell"
			 xmlns:workspaceviews="using:UotanStudio.Views.Workspace"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="UotanStudio.Views.Shell.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>
	<DockPanel>
		<TabbedPage Name="MainTabs"
					TabPlacement="Bottom">
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage>
				<ContentPage.Icon>
					<avalonia:Dashboard1 Width="18" Height="18" Margin="0 -7 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -7" Text="{DynamicResource Tab_Workspace}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
				<workspaceviews:WorkspaceView Name="WorkspaceDocuments" DataContext="{Binding WorkspaceVM}" />
			</ContentPage>
			<ContentPage Name="FlashTab">
				<ContentPage.Icon>
					<avalonia:Thunder Width="18" Height="18" Margin="0 -7 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -7" Text="{DynamicResource Tab_Flash}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
			</ContentPage>
			<ContentPage Name="NodeEditorTab" DataContext="{Binding NodeEditorVM}">
				<ContentPage.Icon>
					<avalonia:PlayCircleStroke Width="18" Height="18" Margin="0 -7 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -7" Text="{DynamicResource Tab_Node}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
			</ContentPage>
			<ContentPage Name="DeliveryTab">
				<ContentPage.Icon>
					<avalonia:Gift Width="18" Height="18" Margin="0 -7 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -7" Text="{DynamicResource Tab_Delivery}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
			</ContentPage>
			<ContentPage Name="SettingsTab" DataContext="{Binding SettingsVM}">
				<ContentPage.Icon>
					<avalonia:Setting Width="18" Height="18" Margin="0 -7 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -7" Text="{DynamicResource Tab_Settings}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
		</TabbedPage>
	</DockPanel>
</UserControl>
