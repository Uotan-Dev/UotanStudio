<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:vm="using:UotanStudio.ViewModels.Shell"
			 xmlns:workspaceviews="using:UotanStudio.Views.Workspace"
			 xmlns:nodeviews="using:UotanStudio.Views.Nodes"
			 xmlns:shellviews="using:UotanStudio.Views.Shell"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="UotanStudio.Views.Shell.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>
	<DockPanel>
		<Border DockPanel.Dock="Top" IsVisible="{OnPlatform Android=True, Default=False}"
				Padding="12,8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
				BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
				<avalonia:MaterialIcon Grid.Column="0" Kind="ToolboxOutline" Width="24" Height="24"
						VerticalAlignment="Center" />
				<TextBlock Grid.Column="1" Text="{Binding WindowTitle}" VerticalAlignment="Center"
						FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
				<Button Grid.Column="2" Command="{Binding MenuVM.NewProjectCommand}" ToolTip.Tip="{DynamicResource Menu_NewProject}"
						Padding="8" MinWidth="40" MinHeight="40">
					<avalonia:MaterialIcon Kind="FilePlusOutline" Width="20" Height="20" />
				</Button>
				<Button Grid.Column="3" Command="{Binding MenuVM.OpenProjectCommand}" ToolTip.Tip="{DynamicResource Menu_OpenProject}"
						Padding="8" MinWidth="40" MinHeight="40">
					<avalonia:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
				</Button>
				<Button Grid.Column="4" Command="{Binding MenuVM.SaveCommand}" ToolTip.Tip="{DynamicResource Menu_Save}"
						Padding="8" MinWidth="40" MinHeight="40">
					<avalonia:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20" />
				</Button>
			</Grid>
		</Border>
		<TabbedPage Name="MainTabs"
					TabPlacement="Bottom">
			<TabbedPage.PageTransition>
				<CrossFade Duration="0:0:0.2" />
			</TabbedPage.PageTransition>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage>
				<ContentPage.Icon>
					<avalonia:MaterialIcon Kind="MonitorDashboard" Width="18" Margin="0 -10 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Workspace}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
				<workspaceviews:WorkspaceView Name="WorkspaceDocuments" DataContext="{Binding WorkspaceVM}" />
			</ContentPage>
			<ContentPage>
				<ContentPage.Icon>
					<avalonia:MaterialIcon Kind="PackageVariantClosed" Width="18" Margin="0 -10 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Delivery}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
				<shellviews:DeliveryView Name="DeliveryPage" />
			</ContentPage>
			<ContentPage>
				<ContentPage.Icon>
					<avalonia:MaterialIcon Kind="ScriptTextPlayOutline" Width="18" Margin="0 -10 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Node}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
				<nodeviews:NodeEditorView DataContext="{Binding NodeEditorVM}" />
			</ContentPage>
			<ContentPage>
				<ContentPage.Icon>
					<avalonia:MaterialIcon Kind="CogOutline" Width="18" Margin="0 -10 0 0" />
				</ContentPage.Icon>
				<ContentPage.Header>
					<TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Settings}" FontSize="13" FontWeight="SemiBold" />
				</ContentPage.Header>
				<shellviews:SettingsView DataContext="{Binding SettingsVM}" />
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
			<ContentPage TabbedPage.IsTabEnabled="False">
			</ContentPage>
		</TabbedPage>
	</DockPanel>
</UserControl>
