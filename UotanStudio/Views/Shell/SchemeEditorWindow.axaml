<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:keys="using:UotanStudio.Services.Keys"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        x:Class="UotanStudio.Views.Shell.SchemeEditorWindow"
        x:DataType="vm:SchemeEditorViewModel"
        Title="{DynamicResource Scheme_Title}"
        Width="1180" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TextBox"><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="30" /></Style>
    <Style Selector="ComboBox"><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="30" /></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="0,32,0,0">
    <Border Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <icons:Sitemap Width="20" Height="20" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding FilePath}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Opacity="0.75" />
        <Button Grid.Column="2" Height="32" Padding="12,0" Click="OnOpenClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:FolderOpen Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Scheme_Open}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Height="32" Padding="12,0" Click="OnSaveClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:Save Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Scheme_Save}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Height="32" Padding="12,0" Click="OnNewClick"
                Content="{DynamicResource Dialog_NewFile}" />
        <ComboBox Grid.Column="5" Width="170" Height="32"
                  ItemsSource="{Binding PublisherKeys}"
                  SelectedItem="{Binding SelectedPublisherKey, Mode=TwoWay}"
                  PlaceholderText="{DynamicResource Plugin_Publisher}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="keys:ManagedKey">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="6" Height="32" Padding="12,0" Click="OnSignClick"
                ToolTip.Tip="{DynamicResource Plugin_Sign}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:CheckDouble Width="16" Height="16" />
            <TextBlock Text="{DynamicResource Plugin_Sign}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="12,6,12,0" Spacing="4">
      <TextBlock Text="{Binding LastError}" Foreground="Red" FontSize="12"
                 TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding ValidationText}" Foreground="DarkOrange" FontSize="12"
                 TextWrapping="Wrap" IsVisible="{Binding HasValidationMessages}" />
      <TextBlock Text="{Binding SignatureText}" FontSize="12" Opacity="0.75" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="460,*" ColumnSpacing="12" Margin="12">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Scheme_Title}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Name, Mode=TwoWay}" />
            <TextBox Text="{Binding Version, Mode=TwoWay}" PlaceholderText="1.0.0" />
            <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="54" />
            <TextBox Text="{Binding Author, Mode=TwoWay}" />
          </StackPanel>

          <Separator />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Scheme_Inputs}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Width="30" Height="28" Content="+" Click="OnAddInputClick"
                    ToolTip.Tip="{DynamicResource Scheme_Inputs}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Inputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SchemeInputEditorViewModel">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <TextBox Text="{Binding Id, Mode=TwoWay}" PlaceholderText="ID" />
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Scheme_Title}" />
                    <Button Grid.Column="2" Width="28" Height="28" Content="−" Click="OnRemoveInputClick"
                            Tag="{Binding}" ToolTip.Tip="{DynamicResource Menu_Delete}" />
                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SchemeInputTypeOption">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <CheckBox Content="{DynamicResource Node_Conn_Required}"
                                IsChecked="{Binding Required, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Node_Conn_Sensitive}"
                                IsChecked="{Binding Sensitive, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DefaultValue, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Scheme_Inputs}" />
                    <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding ChoicesText, Mode=TwoWay}"
                             AcceptsReturn="True" Height="54"
                             PlaceholderText="{DynamicResource Node_PortType_List}"
                             IsVisible="{Binding IsChoiceInput}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Scheme_Assets}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Width="30" Height="28" Content="+" Click="OnAddAssetClick"
                      ToolTip.Tip="{DynamicResource Scheme_Assets}" />
              <Button Width="30" Height="28" Click="OnImportAssetClick"
                      ToolTip.Tip="{DynamicResource Scheme_Assets}">
                <icons:FolderOpen Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Assets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SchemeAssetEditorViewModel">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <TextBox Text="{Binding Id, Mode=TwoWay}" PlaceholderText="ID" />
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Scheme_Assets}" />
                    <Button Grid.Column="2" Width="28" Height="28" Content="−" Click="OnRemoveAssetClick"
                            Tag="{Binding}" ToolTip.Tip="{DynamicResource Menu_Delete}" />
                    <TextBox Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding RelativePath, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Node_PortType_Path}" />
                    <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding Sha256, Mode=TwoWay}"
                             PlaceholderText="SHA-256" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LengthText, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Node_PortType_Number}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,160,*">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
          <TextBlock Text="{DynamicResource Scheme_Stages}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Width="30" Height="28" Content="+" Click="OnAddStageClick"
                  ToolTip.Tip="{DynamicResource Scheme_Stages}" />
          <Button Grid.Column="2" Width="30" Height="28" Content="↑" Click="OnMoveStageUpClick"
                  ToolTip.Tip="{DynamicResource Scheme_Stages}" />
          <Button Grid.Column="3" Width="30" Height="28" Content="↓" Click="OnMoveStageDownClick"
                  ToolTip.Tip="{DynamicResource Scheme_Stages}" />
          <Button Grid.Column="4" Width="30" Height="28" Content="−" Click="OnRemoveStageClick"
                  ToolTip.Tip="{DynamicResource Menu_Delete}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,6,0,8">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage, Mode=TwoWay}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SchemeStageEditorViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontSize="11" Opacity="0.65" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <TextBlock Text="{DynamicResource Scheme_NoStages}" IsVisible="{Binding !HasStages}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <TextBox Text="{Binding SelectedStage.Id, Mode=TwoWay}" PlaceholderText="ID" />
              <TextBox Grid.Column="1" Text="{Binding SelectedStage.Name, Mode=TwoWay}"
                       PlaceholderText="{DynamicResource Scheme_Title}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <ComboBox ItemsSource="{Binding SelectedStage.KindOptions}"
                        SelectedItem="{Binding SelectedStage.Kind, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedStage.FailurePolicyOptions}"
                        SelectedItem="{Binding SelectedStage.FailurePolicy, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox x:Name="EmbedWorkflowCombo" ItemsSource="{Binding AvailableWorkflows}"
                        PlaceholderText="{DynamicResource Node_ImportTemplate}"
                        SelectionChanged="OnEmbedWorkflowSelected" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Height="30" Padding="8,0" Click="OnEmbedWorkflowClick"
                      Content="{DynamicResource Node_ImportTemplate}" />
            </Grid>
            <TextBox Text="{Binding SelectedStage.ProjectWorkflowName, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Node_ImportTemplate}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Height="30" Padding="8,0" Click="OnCanvasStageClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <icons:Sitemap Width="14" Height="14" />
                  <TextBlock Text="{DynamicResource Node_Canvas}" />
                </StackPanel>
              </Button>
              <Button Height="30" Padding="8,0" Click="OnSelectionStageClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <icons:CheckDouble Width="14" Height="14" />
                  <TextBlock Text="{DynamicResource Node_BatchSelection}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding SelectedStage.SourceText}" FontSize="11" Opacity="0.6"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>