<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:keys="using:UotanStudio.Services.Keys"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="UotanStudio.Views.Shell.AvbToolWindow"
        x:DataType="vm:AvbToolViewModel"
        Title="{DynamicResource Avb_Title}"
        Width="900" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" Icon="/Assets/UotanToolbox.png">
    <Window.Resources>
        <CornerRadius x:Key="KeyFieldCornerRadius">6</CornerRadius>
        <SolidColorBrush x:Key="KeyEntryBorderBrush" Color="{DynamicResource BorderForegroundColor}" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.field-caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.field-hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ListBox.key-list > ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource KeyFieldCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.key-field">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.key-field">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.key-action">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Border.result-card">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="CheckBox.compact-check">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabItem.avb-tab">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="0,32,0,0">
        <TabControl Grid.Row="0" Classes="avb-tabs" Padding="14,6,14,0" IsEnabled="{Binding IsIdle}">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabItem Classes="avb-tab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <icons:FileSafety Width="16" Height="16" />
                        <TextBlock Text="{DynamicResource Avb_TabFooter}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="0,14,14,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Classes="field-label" Text="{DynamicResource Avb_FooterImage}" />
                        <ComboBox Grid.Column="1" Classes="key-field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}"
                                  AutomationProperties.Name="{DynamicResource Avb_FooterImage}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Classes="key-action" Content="{DynamicResource Avb_FooterAddImage}"
                                    Click="OnAddImagesClick" />
                            <Button Classes="key-action" Content="{DynamicResource Avb_FooterRemoveImage}"
                                    Click="OnRemoveImageClick" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,0,4,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterSigningKey}" />
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox Classes="key-field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AvbKeys}" SelectedItem="{Binding SelectedKey}"
                                              DropDownOpened="OnAvbKeyDropDownOpened"
                                              AutomationProperties.Name="{DynamicResource Avb_FooterSigningKey}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="keys:ManagedKey">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="key-action" Width="32" Padding="0"
                                            Click="OnExportPublicKeyClick" ToolTip.Tip="{DynamicResource Avb_KeyExportPublic}"
                                            AutomationProperties.Name="{DynamicResource Avb_KeyExportPublic}">
                                        <icons:FileExport Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="key-action" Width="32" Padding="0"
                                            Click="OnRefreshKeysClick" ToolTip.Tip="{DynamicResource Avb_KeyRefresh}"
                                            AutomationProperties.Name="{DynamicResource Avb_KeyRefresh}">
                                        <icons:Refresh Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="key-action" Width="32" Padding="0"
                                            Click="OnManageKeysClick" ToolTip.Tip="{DynamicResource Avb_KeyManage}"
                                            AutomationProperties.Name="{DynamicResource Avb_KeyManage}">
                                        <icons:Key Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="14" RowSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterPartition}" />
                                    <TextBox Classes="key-field" Text="{Binding PartitionName}"
                                             PlaceholderText="{DynamicResource Avb_FooterPartitionPlaceholder}"
                                             AutomationProperties.Name="{DynamicResource Avb_FooterPartition}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterMode}" />
                                    <ComboBox Classes="key-field" HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding FooterModeIndex}"
                                              AutomationProperties.Name="{DynamicResource Avb_FooterMode}">
                                        <ComboBoxItem Content="{DynamicResource Avb_FooterModeHash}" />
                                        <ComboBoxItem Content="{DynamicResource Avb_FooterModeHashtree}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"
                                            ToolTip.Tip="{DynamicResource Avb_FooterFlagsHint}">
                                    <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterFlags}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                        <CheckBox Classes="compact-check" IsChecked="{Binding DisableVerity}"
                                                  Content="{DynamicResource Avb_FooterDisableVerity}" FontSize="12" />
                                        <CheckBox Grid.Column="1" Classes="compact-check"
                                                  IsChecked="{Binding DisableAvbVerification}"
                                                  Content="{DynamicResource Avb_FooterDisableVerification}" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Expander Header="{DynamicResource Avb_FooterAdvanced}">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="14" RowSpacing="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterRollbackIndex}" />
                                        <TextBox Classes="key-field" Text="{Binding RollbackIndex}"
                                                 AutomationProperties.Name="{DynamicResource Avb_FooterRollbackIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterRollbackLocation}" />
                                        <TextBox Classes="key-field" Text="{Binding RollbackIndexLocation}"
                                                 AutomationProperties.Name="{DynamicResource Avb_FooterRollbackLocation}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterPartitionSize}" />
                                        <TextBox Classes="key-field" Text="{Binding PartitionSize}"
                                                 AutomationProperties.Name="{DynamicResource Avb_FooterPartitionSize}" />
                                        <TextBlock Classes="field-hint" Text="{DynamicResource Avb_FooterPartitionSizeHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterTrustedKey}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Classes="key-field" Text="{Binding TrustedPublicKeyPath}"
                                                     PlaceholderText="{DynamicResource Avb_FooterTrustedKeyPlaceholder}"
                                                     AutomationProperties.Name="{DynamicResource Avb_FooterTrustedKey}" />
                                            <Button Grid.Column="1" Classes="key-action"
                                                    Content="{DynamicResource Avb_Browse}"
                                                    Click="OnTrustedKeyBrowseClick" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Expander>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-caption" Text="{DynamicResource Avb_FooterOutput}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="key-field" Text="{Binding FooterOutputPath}"
                                             AutomationProperties.Name="{DynamicResource Avb_FooterOutput}" />
                                    <Button Grid.Column="1" Classes="key-action"
                                            Content="{DynamicResource Avb_Browse}"
                                            Click="OnFooterOutputBrowseClick" />
                                </Grid>
                            </StackPanel>
                            <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                <Button Classes="key-action" Content="{DynamicResource Avb_FooterSign}"
                                        Click="OnAddFooterClick" />
                                <Button Classes="key-action" Content="{DynamicResource Avb_FooterVerify}"
                                        Click="OnVerifyImageClick" />
                                <Button Classes="key-action" Content="{DynamicResource Avb_FooterInspect}"
                                        Click="OnInspectImageClick" />
                                <Button Classes="key-action" Content="{DynamicResource Avb_FooterUnsign}"
                                        Click="OnRemoveFooterClick" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Classes="avb-tab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <icons:File Width="16" Height="16" />
                        <TextBlock Text="{DynamicResource Avb_TabOta}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,14,14,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Classes="field-label" Text="{DynamicResource Avb_OtaInput}" />
                        <TextBox Grid.Column="1" Classes="key-field" Text="{Binding OtaInputPath}" IsReadOnly="True"
                                 AutomationProperties.Name="{DynamicResource Avb_OtaInput}" />
                        <Button Grid.Column="2" Classes="key-action" Content="{DynamicResource Avb_Browse}"
                                Click="OnOtaInputBrowseClick" />
                        <TextBlock Grid.Row="1" Classes="field-label" Text="{DynamicResource Avb_OtaOutput}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="key-field" Text="{Binding OtaOutputPath}"
                                 AutomationProperties.Name="{DynamicResource Avb_OtaOutput}" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="key-action"
                                Content="{DynamicResource Avb_Browse}" Click="OnOtaOutputBrowseClick" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{DynamicResource Avb_OtaPartitions}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="key-action"
                                        Content="{DynamicResource Avb_OtaLoadPartitions}"
                                        Click="OnLoadOtaPartitionsClick" />
                            </Grid>
                            <Border Grid.Row="1" Classes="result-card"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Avb_OtaPartitionsEmpty}"
                                               IsVisible="{Binding !HasOtaPartitions}"
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.65"
                                               VerticalAlignment="Center" />
                                    <ListBox ItemsSource="{Binding OtaPartitions}"
                                             IsVisible="{Binding HasOtaPartitions}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AvbOtaPartitionOption">
                                                <CheckBox Classes="compact-check" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Content="{Binding Name}" FontSize="12" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Margin="0,0,4,0">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="14" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaFooterMode}" />
                                        <ComboBox Classes="key-field" HorizontalAlignment="Stretch"
                                                  SelectedIndex="{Binding OtaFooterModeIndex}"
                                                  AutomationProperties.Name="{DynamicResource Avb_OtaFooterMode}">
                                            <ComboBoxItem Content="{DynamicResource Avb_FooterModeHash}" />
                                            <ComboBoxItem Content="{DynamicResource Avb_FooterModeHashtree}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaOptions}" />
                                        <Grid Height="32">
                                            <CheckBox Classes="compact-check" Height="32" VerticalAlignment="Center"
                                                      IsChecked="{Binding DisableAvb}"
                                                      Content="{DynamicResource Avb_OtaDisableAvb}" FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaPayloadKey}" />
                                        <ComboBox Classes="key-field" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PayloadKeys}"
                                                  SelectedItem="{Binding SelectedPayloadKey}"
                                                  AutomationProperties.Name="{DynamicResource Avb_OtaPayloadKey}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="keys:ManagedKey">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaZipKey}" />
                                        <ComboBox Classes="key-field" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ZipKeys}"
                                                  SelectedItem="{Binding SelectedZipKey}"
                                                  SelectionChanged="OnZipKeySelectionChanged"
                                                  AutomationProperties.Name="{DynamicResource Avb_OtaZipKey}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="keys:ManagedKey">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaCertificate}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="key-field" Text="{Binding OtaCertificatePath}"
                                                 AutomationProperties.Name="{DynamicResource Avb_OtaCertificate}" />
                                        <Button Grid.Column="1" Classes="key-action"
                                                Content="{DynamicResource Avb_Browse}"
                                                Click="OnOtaCertificateBrowseClick" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-caption" Text="{DynamicResource Avb_OtaPrivateKey}" />
                                    <TextBox Classes="key-field" Text="{Binding OtaPrivateKeyPath}" IsReadOnly="True"
                                             AutomationProperties.Name="{DynamicResource Avb_OtaPrivateKey}" />
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="key-action" Content="{DynamicResource Avb_OtaPatch}"
                                            Click="OnPatchOtaClick" />
                                    <Button Classes="key-action" Content="{DynamicResource Avb_OtaVerify}"
                                            Click="OnVerifyOtaClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
    </Grid>
</Window>
