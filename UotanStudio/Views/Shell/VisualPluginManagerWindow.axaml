<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:plugins="using:UotanStudio.Services.VisualPlugins"
        xmlns:keys="using:UotanStudio.Services.Keys"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        x:Class="UotanStudio.Views.Shell.VisualPluginManagerWindow"
        x:DataType="vm:VisualPluginManagerViewModel"
        Title="{DynamicResource Menu_VisualPluginManager}"
        Width="900" Height="620" MinWidth="760" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" WindowStartupLocation="CenterScreen"
        Icon="/Assets/UotanToolbox.png">
    <Window.Resources>
        <CornerRadius x:Key="PluginCardCornerRadius">6</CornerRadius>
        <SolidColorBrush x:Key="PluginCardBackgroundBrush" Color="{DynamicResource CardBackground}" />
        <SolidColorBrush x:Key="PluginCardBorderBrush" Color="{DynamicResource BorderForegroundColor}" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.plugin-action">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
        </Style>
        <Style Selector="Border.ModeChip">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.PluginEntryCard">
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PluginCardBorderBrush}" />
        </Style>
        <Style Selector="ListBox.plugin-list > ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    <Grid Margin="20,52,20,20" ColumnDefinitions="300,*" ColumnSpacing="20">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBox x:Name="PluginSearchBox" Height="32" VerticalContentAlignment="Center"
                     Text="{Binding Search, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Plugin_Search}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{DynamicResource Plugin_Library}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plugin-action" Click="ImportClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:FileImport Width="16" Height="16" />
                        <TextBlock Text="{DynamicResource Plugin_Import}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="plugin-action" Width="32" MinWidth="0" Padding="0" Click="RefreshClick"
                        ToolTip.Tip="{DynamicResource Plugin_Refresh}">
                    <icons:Refresh Width="16" Height="16" />
                </Button>
            </Grid>
            <Grid Grid.Row="2">
                <StackPanel IsVisible="{Binding !Plugins.Count}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="6">
                    <icons:App Width="40" Height="40" Opacity="0.25"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Plugin_Empty}"
                               Opacity="0.7" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                </StackPanel>
                <ListBox x:Name="VisualPluginList" Classes="plugin-list"
                         ItemsSource="{Binding Plugins}"
                         SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                         IsVisible="{Binding !!Plugins.Count}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="plugins:VisualPluginRegistration">
                            <Border Classes="PluginEntryCard">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                            <Border Classes="ModeChip"
                                                    Background="{DynamicResource SemiColorPrimary}">
                                                <TextBlock Text="{Binding KindText}" FontSize="10"
                                                           Foreground="{DynamicResource AccentHoverForeground}" />
                                            </Border>
                                            <Border Classes="ModeChip"
                                                    Background="{DynamicResource SemiColorPrimaryLight}"
                                                    BorderBrush="{DynamicResource SemiColorPrimaryPointerover}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsEnabled}">
                                                <TextBlock Text="{DynamicResource Plugin_Enabled}" FontSize="10"
                                                           Foreground="{DynamicResource SemiColorPrimaryPointerover}" />
                                            </Border>
                                            <Border Classes="ModeChip"
                                                    Background="{StaticResource PluginCardBackgroundBrush}"
                                                    BorderBrush="{StaticResource PluginCardBorderBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding !!Version}">
                                                <TextBlock Text="{Binding Version}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding !!Description}"
                                               ToolTip.Tip="{Binding Description}" />
                                    <TextBlock Text="{Binding DisplayErrorText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                               IsVisible="{Binding !!ErrorText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <TextBlock Text="{DynamicResource Plugin_SelectHint}" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelection}" />
            <ScrollViewer IsVisible="{Binding HasSelection}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,0,6,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedPlugin.Description}" Opacity="0.72"
                                   TextWrapping="Wrap" IsVisible="{Binding !!SelectedPlugin.Description}" />
                    </StackPanel>
                    <Separator />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="10">
                        <TextBlock Text="{DynamicResource Plugin_Id}" Opacity="0.65" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedPlugin.Id}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource Plugin_Author}" Opacity="0.65" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlugin.Author}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource Plugin_Platforms}" Opacity="0.65" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlugin.Platforms}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource Plugin_RequiredNodes}" Opacity="0.65" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPlugin.RequiredNodes}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="{DynamicResource Plugin_Capabilities}" Opacity="0.65" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPlugin.Capabilities}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="{DynamicResource Plugin_Diagnostics}" Opacity="0.65" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPlugin.DisplayErrorText}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                        <TextBlock Grid.Row="6" Text="{DynamicResource Plugin_Dependencies}" Opacity="0.65"
                                   IsVisible="{Binding !!SelectedPlugin.Dependencies}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedPlugin.Dependencies}"
                                   TextWrapping="Wrap" IsVisible="{Binding !!SelectedPlugin.Dependencies}" />
                        <TextBlock Grid.Row="7" Text="{DynamicResource Plugin_Conflicts}" Opacity="0.65"
                                   IsVisible="{Binding !!SelectedPlugin.Conflicts}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedPlugin.Conflicts}"
                                   TextWrapping="Wrap" IsVisible="{Binding !!SelectedPlugin.Conflicts}" />
                        <TextBlock Grid.Row="8" Text="{DynamicResource Plugin_Publisher}" Opacity="0.65" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedPlugin.PublisherText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="9" Text="{DynamicResource Plugin_Fingerprint}" Opacity="0.65" />
                        <SelectableTextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedPlugin.FingerprintText}"
                                             TextWrapping="Wrap" />
                        <TextBlock Grid.Row="10" Text="{DynamicResource Plugin_Permissions}" Opacity="0.65" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedPlugin.PermissionText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="11" Text="{DynamicResource Plugin_GrantedPermissions}" Opacity="0.65" />
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedPlugin.GrantedPermissionText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="12" Text="{DynamicResource Plugin_Trust}" Opacity="0.65" />
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedPlugin.TrustText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <ComboBox Width="180" ItemsSource="{Binding PublisherKeys}"
                                  SelectedItem="{Binding SelectedPublisherKey, Mode=TwoWay}"
                                  PlaceholderText="{DynamicResource Plugin_Publisher}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="keys:ManagedKey">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_Sign}"
                                Click="SignClick" IsEnabled="{Binding !!SelectedPublisherKey}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_UseTemplate}"
                                Click="UseTemplateClick" IsEnabled="{Binding SelectedPlugin.IsAvailable}"
                                IsVisible="{Binding SelectedPlugin.IsTemplate}" />
                        <Button Classes="plugin-action" Content="{Binding SelectedPlugin.EditActionText}"
                                Click="EditGraphClick" IsEnabled="{Binding SelectedPlugin.IsAvailable}"
                                IsVisible="{Binding !SelectedPlugin.IsTemplate}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_Disable}"
                                Click="DisableClick" IsVisible="{Binding SelectedPlugin.ShowDisableAction}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_Enable}"
                                Click="EnableClick" IsVisible="{Binding SelectedPlugin.ShowEnableAction}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_TrustPublisher}"
                                Click="TrustPublisherClick" IsVisible="{Binding SelectedPlugin.ShowTrustAction}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_UntrustPublisher}"
                                Click="UntrustPublisherClick" IsVisible="{Binding SelectedPlugin.ShowUntrustAction}" />
                        <Button Classes="plugin-action" Click="RemoveClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:Delete Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource Plugin_Remove}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>