<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:plugins="using:UotanStudio.Services.VisualPlugins"
        xmlns:icons="using:Material.Icons.Avalonia"
        x:Class="UotanStudio.Views.Shell.VisualPluginManagerWindow"
        x:DataType="vm:VisualPluginManagerViewModel"
        Title="{DynamicResource Menu_VisualPluginManager}"
        Width="900" Height="620" MinWidth="760" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full" WindowStartupLocation="CenterScreen"
        Icon="/Assets/UotanToolbox.png">
    <Window.Styles>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.plugin-action">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="ListBox.plugin-list > ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    <Grid Margin="20,52,20,20" ColumnDefinitions="300,*" ColumnSpacing="20">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBox x:Name="PluginSearchBox" Height="32"
                     Text="{Binding Search, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Plugin_Search}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{DynamicResource Plugin_Library}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="plugin-action" Click="ImportClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" />
                        <TextBlock Text="{DynamicResource Plugin_Import}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Width="32" Height="32" Padding="0" Click="RefreshClick"
                        ToolTip.Tip="{DynamicResource Plugin_Refresh}">
                    <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                </Button>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="{DynamicResource Plugin_Empty}" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !Plugins.Count}" />
                <ListBox x:Name="VisualPluginList" Classes="plugin-list"
                         ItemsSource="{Binding Plugins}"
                         SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,10,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="plugins:VisualPluginRegistration">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11" Opacity="0.65" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource Plugin_Template}" FontSize="11"
                                                   Foreground="{DynamicResource AccentColor}" IsVisible="{Binding IsTemplate}" />
                                        <TextBlock Text="{DynamicResource Plugin_Composite}" FontSize="11"
                                                   Foreground="{DynamicResource AccentColor}" IsVisible="{Binding !IsTemplate}" />
                                        <TextBlock Text="{DynamicResource Plugin_Enabled}" FontSize="11"
                                                   IsVisible="{Binding IsEnabled}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayErrorText}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                               IsVisible="{Binding !!ErrorText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <TextBlock Text="{DynamicResource Plugin_SelectHint}" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelection}" />
            <ScrollViewer IsVisible="{Binding HasSelection}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,0,6,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedPlugin.Description}" Opacity="0.72"
                                   TextWrapping="Wrap" IsVisible="{Binding !!SelectedPlugin.Description}" />
                    </StackPanel>
                    <Separator />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="10">
                        <TextBlock Text="{DynamicResource Plugin_Id}" Opacity="0.65" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedPlugin.Id}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource Plugin_Author}" Opacity="0.65" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlugin.Author}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource Plugin_Platforms}" Opacity="0.65" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlugin.Platforms}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource Plugin_RequiredNodes}" Opacity="0.65" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPlugin.RequiredNodes}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="{DynamicResource Plugin_Capabilities}" Opacity="0.65" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPlugin.Capabilities}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="{DynamicResource Plugin_Diagnostics}" Opacity="0.65" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPlugin.DisplayErrorText}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_UseTemplate}"
                                Click="UseTemplateClick" IsEnabled="{Binding SelectedPlugin.IsAvailable}"
                                IsVisible="{Binding SelectedPlugin.IsTemplate}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_EditGraph}"
                                Click="EditGraphClick" IsEnabled="{Binding SelectedPlugin.IsAvailable}"
                                IsVisible="{Binding !SelectedPlugin.IsTemplate}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_Disable}"
                                Click="DisableClick" IsVisible="{Binding SelectedPlugin.ShowDisableAction}" />
                        <Button Classes="plugin-action" Content="{DynamicResource Plugin_Enable}"
                                Click="EnableClick" IsVisible="{Binding SelectedPlugin.ShowEnableAction}" />
                        <Button Classes="plugin-action" Click="RemoveClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource Plugin_Remove}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>