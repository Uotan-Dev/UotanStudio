<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="using:Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels.Shell"
             xmlns:ursa="using:Ursa.Controls"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="820"
             x:Class="UotanStudio.Views.Shell.FlashView"
             x:DataType="vm:FlashViewModel"
             Background="{DynamicResource PageBackground}">
    <Design.DataContext>
        <vm:FlashViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- 日志框是多行只读控件，需要覆盖主题给出的单行高度并让文本顶端对齐。 -->
        <!-- The log box is a multi-line read-only control, so it overrides the themed single-line height. -->
        <Style Selector="TextBox#LogBox">
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="NaN" />
        </Style>
        <Style Selector="Button.pane-action">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </UserControl.Styles>

    <!-- 三份内容在同一网格中换位：宽屏为「日志 | 分区 | 操作」，窄屏把日志移到分区列表下方；
         窗口高度不足时由外层 ScrollViewer 提供整页纵向滚动。 -->
    <!-- One grid, three panes: wide screens use "log | partitions | actions", narrow screens move the log below the
         list. The outer ScrollViewer scrolls the whole page when the window is shorter than the content. -->
    <Grid>
    <ScrollViewer Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AllowAutoHide="True">
        <Grid Name="FlashLayout" Margin="12">
            <Border Name="PackageBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                    Padding="12,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <Grid Name="PackageBarGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                      SizeChanged="OnPackageBarSizeChanged">
                    <TextBlock Text="{DynamicResource Flash_Package}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Name="PackagePathBox"
                             Height="32" VerticalContentAlignment="Center"
                             LostFocus="OnPackagePathLostFocus"
                             PlaceholderText="{DynamicResource Flash_PackagePlaceholder}"
                             Text="{Binding PackagePath, Mode=TwoWay}"
                             AutomationProperties.Name="{DynamicResource Flash_Package}" />
                    <StackPanel Grid.Column="2" Name="PackageButtonRow" Orientation="Horizontal" Spacing="8">
                        <Button Name="ChooseFileButton" MinWidth="92" Click="OnChooseFileClick"
                                Content="{DynamicResource Flash_ChooseFile}" />
                        <Button Name="ChooseFolderButton" MinWidth="100" Click="OnChooseFolderClick"
                                Content="{DynamicResource Flash_ChooseFolder}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Name="LogPane" Grid.Row="2" Grid.Column="0"
                    CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Margin="12,8,8,4" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Flash_Log}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Name="ClearLogButton" Classes="Small" Padding="8,0" MinWidth="0"
                                Click="OnClearLogClick" Content="{DynamicResource Flash_ClearLog}"
                                AutomationProperties.Name="{DynamicResource Flash_ClearLog}" />
                    </Grid>
                    <TextBox Grid.Row="1" Name="LogBox" Margin="12,0,12,12" Padding="8"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding LogText, Mode=OneWay}"
                             PlaceholderText="{DynamicResource Flash_LogPlaceholder}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{DynamicResource Flash_Log}" />
                </Grid>
            </Border>

            <Border Name="PartitionPane" Grid.Row="2" Grid.Column="2"
                    CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Margin="12,8,8,4" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                        <CheckBox Name="SelectAllBox" VerticalAlignment="Center"
                                  Content="{DynamicResource Flash_SelectAll}"
                                  IsChecked="{Binding IsSelectAllChecked, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource Flash_Selected}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" MinWidth="20" Text="{Binding SelectedCount}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="4" Name="PartitionSearchBox" Width="220" MinWidth="120"
                                 Height="32" VerticalContentAlignment="Center"
                                 PlaceholderText="{DynamicResource Flash_SearchPlaceholder}"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 AutomationProperties.Name="{DynamicResource Flash_SearchPlaceholder}" />
                    </Grid>
                    <!-- 总进度行常驻，数值与说明文本由刷写流程写入，未开始时显示 0。 -->
                    <!-- The overall row is always present; the flash run writes its value and caption, and it reads zero before a run starts. -->
                    <Grid Grid.Row="1" Margin="12,4,12,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <ProgressBar Name="OverallProgress" Minimum="0" Maximum="100"
                                     Value="{Binding OverallPercent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding OverallText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="12,0,12,12">
                        <DataGrid Name="PartitionGrid" ItemsSource="{Binding VisiblePartitions}"
                                  AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  IsReadOnly="False" SelectionMode="Single" RowHeight="30"
                                  Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" MinWidth="56" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Flash_Select}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:FlashPartitionEntry">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      MinWidth="0" Padding="0"
                                                      AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="Auto" MinWidth="96" IsReadOnly="True"
                                                    Header="{DynamicResource Flash_Partition}"
                                                    Binding="{Binding Name}" />
                                <DataGridTextColumn Width="Auto" MinWidth="80" IsReadOnly="True"
                                                    Header="{DynamicResource Flash_Command}"
                                                    Binding="{Binding Command}" />
                                <DataGridTextColumn Width="Auto" MinWidth="80" IsReadOnly="True"
                                                    Header="{DynamicResource Flash_Size}"
                                                    Binding="{Binding Size}" />
                                <DataGridTemplateColumn Width="*" MinWidth="120" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Flash_File}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:FlashPartitionEntry">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding FileName}" ToolTip.Tip="{Binding FilePath}"
                                                           Margin="6,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Padding="4,0" MinWidth="30"
                                                        Click="OnChoosePartitionImageClick"
                                                        ToolTip.Tip="{DynamicResource Flash_ChooseFile}">
                                                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto" MinWidth="140" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{DynamicResource Flash_Status}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:FlashPartitionEntry">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <ProgressBar Width="90" VerticalAlignment="Center"
                                                             Minimum="0" Maximum="100" Value="{Binding Percent}"
                                                             IsVisible="{Binding IsRunning}" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                           Margin="6,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 空态覆盖在列表上：没有分区时提示先加载刷机包，而不是显示空表头。 -->
                        <!-- Empty state overlays the grid so an unloaded package shows guidance instead of bare headers. -->
                        <StackPanel IsVisible="{Binding !HasVisiblePartitions}" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="320">
                            <icons:MaterialIcon Kind="FormatListBulleted" Width="28" Height="28"
                                                HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="{DynamicResource Flash_NoPartitions}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Flash_NoPartitionsHint}" HorizontalAlignment="Center"
                                       FontSize="12" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Name="ActionPane" Grid.Row="2" Grid.Column="4"
                    CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="True">
                    <StackPanel Margin="12" Spacing="10">
                        <TextBlock Name="DeviceStatusBar" Text="{Binding SelectedDeviceText}"
                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Flash_Basic}" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <Button Name="ReadInfoButton" Classes="pane-action"
                                    Click="OnReadInfoClick"
                                    Content="{DynamicResource Flash_ReadInfo}" />
                            <CheckBox Name="ShowAllPartitionsBox" Content="{DynamicResource Flash_ShowAllPartitions}" />
                            <Button Name="FlashSelectedButton" Classes="pane-action"
                                    Click="OnFlashSelectedClick"
                                    Content="{DynamicResource Flash_FlashSelected}" />
                            <!-- 完整包有两种等价入口：USB 端点与显式串口；动作行只按“包已就绪且目标可用”显隐，
                                 选项行跟随动作行而不是单独的 USB 按钮。 -->
                            <!-- The bundle has two equivalent entries, a USB endpoint and an explicit serial port; the
                                 action row shows only when the bundle is ready and a usable target exists, and the
                                 option rows follow the action row rather than the USB button alone. -->
                            <StackPanel Name="BundleActionRow" Spacing="8" IsVisible="False">
                                <Button Name="FlashEdlBundleButton" Classes="pane-action" IsVisible="False"
                                        Click="OnFlashEdlBundleClick"
                                        Content="{DynamicResource Flash_FlashEdlBundle}" />
                                <Button Name="EdlSerialFlashButton" Classes="pane-action"
                                        Click="OnEdlSerialFlashClick"
                                        Content="{DynamicResource Flash_EdlSerialFlash}"
                                        AutomationProperties.Name="{DynamicResource Flash_EdlSerialFlash}" />
                            </StackPanel>
                            <TextBlock Name="EdlSerialPortLabel" Text="{DynamicResource Flash_EdlSerialPort}"
                                       IsVisible="{Binding #EdlSerialFlashButton.IsVisible}"
                                       FontSize="12" Opacity="0.8" />
                            <ComboBox Name="EdlSerialPortBox" Height="32"
                                      IsVisible="{Binding #EdlSerialFlashButton.IsVisible}"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlSerialPort}" />
                            <Button Name="EraseSelectedButton" Classes="pane-action"
                                    Click="OnEraseSelectedClick"
                                    Content="{DynamicResource Flash_EraseSelected}" />
                            <Button Name="SwitchSlotButton" Classes="pane-action"
                                    Click="OnSwitchSlotClick"
                                    Content="{DynamicResource Flash_SwitchSlot}" />
                            <Button Name="CancelFlashButton" Classes="pane-action" IsEnabled="False"
                                    Click="OnCancelFlashClick"
                                    Content="{DynamicResource Flash_Cancel}" />
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource EditorPaneSplitterBackgroundBrush}" />
                        <!-- 复选框按两列四行排布：列宽由网格统一决定，同一列的勾选框上下对齐。 -->
                        <!-- Check boxes form two columns by four rows; the grid fixes the column widths so boxes in
                             the same column line up instead of being centred per line. -->
                        <Grid Name="FlashOptionGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto"
                              RowSpacing="6" ColumnSpacing="12" HorizontalAlignment="Left">
                            <CheckBox Name="DisableVbmetaBox" Content="{DynamicResource Flash_DisableVbmeta}"
                                      HorizontalAlignment="Left" />
                            <CheckBox Grid.Column="1" Name="DeleteCowBox" Content="{DynamicResource Flash_DeleteCow}"
                                      HorizontalAlignment="Left" />
                            <CheckBox Grid.Row="1" Name="AddRootBox" IsEnabled="False"
                                      Content="{DynamicResource Flash_AddRoot}" HorizontalAlignment="Left" />
                            <CheckBox Grid.Row="2" Name="EraseDataBox" Content="{DynamicResource Flash_EraseData}"
                                      HorizontalAlignment="Left" />
                            <CheckBox Grid.Row="2" Grid.Column="1" Name="RebootAfterBox"
                                      Content="{DynamicResource Flash_RebootAfter}" HorizontalAlignment="Left" />
                            <CheckBox Grid.Row="3" Name="VerifyAfterFlashBox"
                                      Content="{DynamicResource Flash_VerifyAfterFlash}" HorizontalAlignment="Left" />
                            <!-- 两项策略只被完整 EDL 包流程消费，因此与包按钮同步显隐，避免对其他协议产生无效开关。 -->
                            <!-- Both policy boxes are honored only by the full EDL bundle flow, so they share the bundle button's -->
                            <!-- visibility instead of offering dead switches for other protocols. -->
                            <CheckBox Grid.Row="4" Name="SkipAbsentSourcesBox"
                                      IsVisible="{Binding #BundleActionRow.IsVisible}"
                                      Content="{DynamicResource Flash_SkipAbsentSources}" HorizontalAlignment="Left" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Name="ContinueOnFailureBox"
                                      IsVisible="{Binding #BundleActionRow.IsVisible}"
                                      Content="{DynamicResource Flash_ContinueOnFailure}" HorizontalAlignment="Left" />
                            <!-- UFS provisioning 只随完整包流程出现，与包按钮同步显隐，避免对其他协议产生无效开关。 -->
                            <!-- UFS provisioning appears only with the full bundle flow, sharing the bundle button's
                                 visibility instead of offering a dead switch for other protocols. -->
                            <CheckBox Grid.Row="5" Name="EdlSkipUfsBox"
                                      IsVisible="{Binding #BundleActionRow.IsVisible}"
                                      Content="{DynamicResource Flash_EdlSkipUfsProvision}" HorizontalAlignment="Left" />
                            <!-- 三项调优只被完整 EDL 包流程消费，与包按钮同步显隐；未选时保持编排器默认。 -->
                            <!-- The three tuning controls are honored only by the full EDL bundle flow and share the
                                 bundle button's visibility; leaving them unset keeps the orchestrator defaults. -->
                            <TextBlock Grid.Row="6" Text="{DynamicResource Flash_EdlSectorSize}"
                                       IsVisible="{Binding #BundleActionRow.IsVisible}"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                            <ComboBox Grid.Row="6" Grid.Column="1" Name="EdlSectorSizeBox" Height="28"
                                      MinWidth="88" SelectedIndex="0"
                                      IsVisible="{Binding #BundleActionRow.IsVisible}"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlSectorSize}">
                                <ComboBoxItem Content="{DynamicResource Flash_Auto}" />
                                <ComboBoxItem Content="512" />
                                <ComboBoxItem Content="2048" />
                                <ComboBoxItem Content="4096" />
                            </ComboBox>
                            <TextBlock Grid.Row="7" Text="{DynamicResource Flash_EdlSlot}"
                                       IsVisible="{Binding #BundleActionRow.IsVisible}"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                            <ComboBox Grid.Row="7" Grid.Column="1" Name="EdlSlotBox" Height="28"
                                      MinWidth="88" SelectedIndex="0"
                                      IsVisible="{Binding #BundleActionRow.IsVisible}"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlSlot}">
                                <ComboBoxItem Content="{DynamicResource Flash_Auto}" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                            </ComboBox>
                            <TextBlock Grid.Row="8" Text="{DynamicResource Flash_EdlWipeFirst}"
                                       IsVisible="{Binding #BundleActionRow.IsVisible}"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                            <TextBox Grid.Row="8" Grid.Column="1" Name="EdlWipeFirstBox" Height="28"
                                     Width="88" Text="0" PlaceholderText="0"
                                     IsVisible="{Binding #BundleActionRow.IsVisible}"
                                     AutomationProperties.Name="{DynamicResource Flash_EdlWipeFirst}" />
                        </Grid>
                        <Button Name="ChooseRootPackageButton" Classes="pane-action"
                                Click="OnChooseRootPackageClick"
                                Content="{DynamicResource Flash_ChooseRootPackage}" />
                        <Border Height="1" Background="{DynamicResource EditorPaneSplitterBackgroundBrush}" />
                        <TextBlock Text="{DynamicResource Flash_Mtk}" FontWeight="SemiBold" />
                        <!-- MTK 下载块只在检测到 scatter 输入或 MTK 设备时出现，整块由接线代码控制可见性。 -->
                        <!-- The MTK download block appears once scatter input or an MTK device is present; the wiring code owns its visibility. -->
                        <StackPanel Name="MtkPane" Spacing="8" IsVisible="False">
                            <TextBlock Name="MtkPortLabel" Text="{DynamicResource Flash_MtkPorts}"
                                       FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkPortBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkPorts}" />
                            <Button Name="RefreshMtkPortsButton" Classes="pane-action"
                                    Click="OnRefreshMtkPortsClick"
                                    Content="{DynamicResource Flash_MtkRefreshPorts}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkRefreshPorts}" />
                            <Button Name="ChooseMtkDaButton" Classes="pane-action"
                                    Click="OnChooseMtkDaClick"
                                    Content="{DynamicResource Flash_MtkDaFile}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkDaFile}" />
                            <TextBlock Name="MtkDaPathText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <Button Name="ChooseMtkEmiButton" Classes="pane-action"
                                    Click="OnChooseMtkEmiClick"
                                    Content="{DynamicResource Flash_MtkEmiFile}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkEmiFile}" />
                            <TextBlock Name="MtkEmiPathText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <!-- 自动匹配由设备上报的硬件代码挑选 DA 条目，勾选后手数条目索引失效。 -->
                            <!-- Auto-match lets the reported hardware code pick the DA entry; the counted index is ignored. -->
                            <CheckBox Name="MtkAutoMatchBox" Content="{DynamicResource Flash_MtkAutoMatch}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkAutoMatch}" />
                            <TextBlock Text="{DynamicResource Flash_MtkEntryIndex}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkEntryIndexBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsChecked, ElementName=MtkAutoMatchBox}"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkEntryIndex}" />
                            <!-- 密钥目录可选；存在匹配的 sla_<hwcode>.pem 时才会应答 Boot ROM SLA 请求。 -->
                            <!-- The key directory is optional; a Boot ROM SLA request is answered only with a matching sla_<hwcode>.pem. -->
                            <Button Name="ChooseMtkKeyDirButton" Classes="pane-action"
                                    Click="OnChooseMtkKeyDirClick"
                                    Content="{DynamicResource Flash_MtkKeyDir}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkKeyDir}" />
                            <TextBlock Name="MtkKeyDirText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <!-- 显式认证文件可选；选择后按上游 auth 文件约定随 E2 原样发送，优先于密钥目录。 -->
                            <!-- The explicit auth file is optional; when selected it is sent verbatim with E2 per the upstream auth-file convention and wins over the key directory. -->
                            <Button Name="ChooseMtkAuthFileButton" Classes="pane-action"
                                    Click="OnChooseMtkAuthFileClick"
                                    Content="{DynamicResource Flash_MtkAuthFile}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkAuthFile}" />
                            <TextBlock Name="MtkAuthFileText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <TextBlock Name="MtkBaudLabel" Text="{DynamicResource Flash_MtkBaud}"
                                       FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkBaudBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkBaud}" />
                            <!-- 下载代理家族由本选择框决定，不做探测：XFlash 用于新芯片，Legacy 用于旧芯片，XML 用于按区域名寻址的 v6 代理。 -->
                            <!-- The download-agent family is chosen here, never probed: XFlash for current chips, Legacy for legacy chips and XML for the region-named v6 agent. -->
                            <TextBlock Text="{DynamicResource Flash_MtkProtocol}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkProtocolBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkProtocol}">
                                <ComboBoxItem Content="{DynamicResource Flash_MtkProtocolXFlash}" />
                                <ComboBoxItem Content="{DynamicResource Flash_MtkProtocolLegacy}" />
                                <ComboBoxItem Content="{DynamicResource Flash_MtkProtocolXml}" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Flash_MtkStorageKind}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkStorageKindBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkStorageKind}" />
                            <CheckBox Name="MtkAttachAgentBox" Content="{DynamicResource Flash_MtkAttachAgent}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkAttachAgent}" />
                            <Button Name="MtkFlashButton" Classes="pane-action"
                                    Click="OnMtkFlashClick"
                                    Content="{DynamicResource Flash_MtkFlash}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkFlash}" />
                            <Button Name="MtkReadbackButton" Classes="pane-action"
                                    Click="OnMtkReadbackClick"
                                    Content="{DynamicResource Flash_MtkReadback}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkReadback}" />
                            <Button Name="MtkShowGptButton" Classes="pane-action"
                                    Click="OnMtkShowGptClick"
                                    Content="{DynamicResource Flash_MtkShowGpt}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkShowGpt}" />
                            <!-- 整用户区转储是只读操作，按所选代理家族上报的容量分块读取，目标文件由用户挑选；
                                 字节先落暂存文件，长度与上报值一致时才替换目标。 -->
                            <!-- A whole-user-area dump is read-only: it walks the capacity the selected agent family
                                 reported in chunks, takes the destination file from the user, and replaces the target
                                 only after the staged length equals the reported length. -->
                            <Button Name="MtkFullDumpButton" Classes="pane-action"
                                    Click="OnMtkFullDumpClick"
                                    Content="{DynamicResource Flash_MtkFullDump}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkFullDump}" />
                            <TextBlock Text="{DynamicResource Flash_MtkSecurityGroup}" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.8" />
                            <!-- 安全配置与 efuse 都按面板选定的代理家族执行：XML 家族没有 seccfg 或 efuse 通路，由服务层直接拒绝，不降级到其他家族。 -->
                            <!-- The secure-boot configuration and eFuse reads follow the family chosen in the pane: the
                                 XML family has no seccfg or eFuse path and is refused by the service rather than being
                                 substituted with another family. -->
                            <TextBlock Text="{DynamicResource Flash_MtkSecCfgPartition}" FontSize="12" Opacity="0.8" />
                            <TextBox Name="MtkSecCfgPartitionBox" Height="32" VerticalContentAlignment="Center" Text="0"
                                     PlaceholderText="{DynamicResource Flash_MtkSecCfgPartition}"
                                     AutomationProperties.Name="{DynamicResource Flash_MtkSecCfgPartition}" />
                            <Button Name="MtkSecCfgReadButton" Classes="pane-action"
                                    Click="OnMtkSecCfgReadClick"
                                    Content="{DynamicResource Flash_MtkSecCfgRead}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkSecCfgRead}" />
                            <TextBlock Text="{DynamicResource Flash_MtkSecCfgLock}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkSecCfgLockBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" SelectedIndex="0"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkSecCfgLock}" />
                            <Button Name="MtkSecCfgApplyButton" Classes="pane-action"
                                    Click="OnMtkSecCfgApplyClick"
                                    Content="{DynamicResource Flash_MtkSecCfgApply}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkSecCfgApply}" />
                            <Button Name="MtkEfusePublicKeyButton" Classes="pane-action"
                                    Click="OnMtkEfusePublicKeyClick"
                                    Content="{DynamicResource Flash_MtkEfusePublicKey}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkEfusePublicKey}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Name="MtkEfuseStartBox" Height="32" VerticalContentAlignment="Center" Text="0"
                                         PlaceholderText="{DynamicResource Flash_MtkEfuseStart}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkEfuseStart}" />
                                <TextBox Grid.Column="1" Name="MtkEfuseCountBox" Height="32"
                                         VerticalContentAlignment="Center" Text="16"
                                         PlaceholderText="{DynamicResource Flash_MtkEfuseCount}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkEfuseCount}" />
                            </Grid>
                            <Button Name="MtkEfuseRangeButton" Classes="pane-action"
                                    Click="OnMtkEfuseRangeClick"
                                    Content="{DynamicResource Flash_MtkEfuseRange}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkEfuseRange}" />
                            <!-- 下载代理内存读写按面板选定的家族分派：寄存器读写以四字为单位循环，块读写上限由 Comm 校验，
                                 界面只解析输入形状，不重复实现边界规则；poke 是不可逆写，必须同时勾选确认并经对话框确认。 -->
                            <!-- The download-agent memory group dispatches on the family chosen in the pane: register
                                 access loops in four-byte cells, the bulk ceilings are validated by Comm rather than
                                 duplicated here, and a poke is an irreversible write that needs both the checkbox and
                                 the confirmation dialog. -->
                            <TextBlock Text="{DynamicResource Flash_MtkDaMemoryGroup}" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.8" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Name="MtkMemoryAddressBox" Height="32" VerticalContentAlignment="Center"
                                         Text="0x10000" PlaceholderText="{DynamicResource Flash_MtkMemoryAddress}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkMemoryAddress}" />
                                <TextBox Grid.Column="1" Name="MtkMemoryLengthBox" Height="32"
                                         VerticalContentAlignment="Center" Text="64"
                                         PlaceholderText="{DynamicResource Flash_MtkMemoryLength}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkMemoryLength}" />
                            </Grid>
                            <CheckBox Name="MtkMemoryRegisterBox" Content="{DynamicResource Flash_MtkMemoryAsRegister}"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkMemoryAsRegister}" />
                            <Button Name="MtkMemoryPeekButton" Classes="pane-action"
                                    Click="OnMtkMemoryPeekClick"
                                    Content="{DynamicResource Flash_MtkMemoryPeek}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkMemoryPeek}" />
                            <TextBox Name="MtkPokeDataBox" Height="32" VerticalContentAlignment="Center"
                                     PlaceholderText="{DynamicResource Flash_MtkPokeData}"
                                     AutomationProperties.Name="{DynamicResource Flash_MtkPokeData}" />
                            <CheckBox Name="MtkPokeConfirmBox" Content="{DynamicResource Flash_MtkPokeConfirm}"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkPokeConfirm}" />
                            <Button Name="MtkPokeButton" Classes="pane-action" Click="OnMtkPokeClick"
                                    Content="{DynamicResource Flash_MtkPoke}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkPoke}" />
                            <Button Name="MtkBromDumpButton" Classes="pane-action" Click="OnMtkBromDumpClick"
                                    Content="{DynamicResource Flash_MtkBromDump}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkBromDump}" />
                            <!-- OEM 密钥写入是不可逆操作：类别、密钥与可选 SEJ 基址都由用户给出，缺失基址时由服务层拒绝而不是猜测。 -->
                            <!-- OEM key programming is irreversible: the class, the key and the optional SEJ base all
                                 come from the user, and a missing base is refused by the service rather than guessed. -->
                            <TextBlock Text="{DynamicResource Flash_MtkOemKeyKind}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkOemKeyKindBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" SelectedIndex="0"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkOemKeyKind}" />
                            <TextBox Name="MtkOemKeyHexBox" Height="32" VerticalContentAlignment="Center"
                                     PlaceholderText="{DynamicResource Flash_MtkOemKeyHex}"
                                     AutomationProperties.Name="{DynamicResource Flash_MtkOemKeyHex}" />
                            <TextBox Name="MtkOemKeySejBaseBox" Height="32" VerticalContentAlignment="Center"
                                     PlaceholderText="{DynamicResource Flash_MtkOemKeySejBaseOptional}"
                                     AutomationProperties.Name="{DynamicResource Flash_MtkOemKeySejBase}" />
                            <Button Name="MtkOemKeyProgramButton" Classes="pane-action"
                                    Click="OnMtkOemKeyProgramClick"
                                    Content="{DynamicResource Flash_MtkOemKeyProgram}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkOemKeyProgram}" />
                            <!-- 预览只描述将要提交的寄存器窗口、单元数与密钥摘要，任何字节都不发出；提交仍需要单独的写入按钮。 -->
                            <!-- The preview describes the register window, unit count and key digest a submission would
                                 use without sending any byte; the write stays a separate action. -->
                            <Button Name="MtkOemKeyPreviewButton" Classes="pane-action"
                                    Click="OnMtkOemKeyPreviewClick"
                                    Content="{DynamicResource Flash_MtkOemKeyPreview}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkOemKeyPreview}" />
                            <!-- 擦除对已列出的 scatter 行与“无镜像但策略允许”的行都生效，范围由实机 GPT 复核。 -->
                            <!-- Erase covers both listed scatter rows and policy-eligible rows without an image;
                                 the live GPT re-checks every range. -->
                            <Button Name="MtkEraseButton" Classes="pane-action"
                                    Click="OnMtkEraseClick"
                                    Content="{DynamicResource Flash_MtkErase}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkErase}" />
                            <!-- 以下两组操作只在 USB 上的 MediaTek 租约成立时出现：串口路径没有 BootROM 阶段的控制面。 -->
                            <!-- These two groups appear only for a MediaTek lease on USB: the serial path has no
                                 BootROM-stage control surface. -->
                            <StackPanel Name="MtkUsbOnlyRow" Spacing="8" IsVisible="False">
                            <!-- BootROM 利用只在用户逐项显式授权后运行：家族与载荷来源都按名字指名，未实现的家族由服务层直接拒绝，绝不改用其他家族。 -->
                            <!-- The BootROM exploit runs only under explicit per-item authorization: family and payload
                                 source are named by the user, and an unimplemented family is refused rather than swapped. -->
                            <CheckBox Name="MtkExploitBypassBox" Content="{DynamicResource Flash_MtkExploitBypass}"
                                      HorizontalAlignment="Left" Click="OnMtkExploitAuthorizationClick"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkExploitBypass}" />
                            <CheckBox Name="MtkExploitVolatileBox" Content="{DynamicResource Flash_MtkExploitVolatile}"
                                      HorizontalAlignment="Left" Click="OnMtkExploitAuthorizationClick"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkExploitVolatile}" />
                            <TextBlock Text="{DynamicResource Flash_MtkExploitFamily}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkExploitFamilyBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" SelectedIndex="0"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkExploitFamily}" />
                            <TextBlock Text="{DynamicResource Flash_MtkExploitPayload}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkExploitPayloadBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkExploitPayload}" />
                            <Button Name="MtkBypassButton" Classes="pane-action"
                                    Click="OnMtkBypassClick"
                                    Content="{DynamicResource Flash_MtkRunBypass}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkRunBypass}" />
                            <!-- RPMB 只读捕获的寻址形态必须属于所选代理家族支持的组合；组合不支持时先在本地拒绝，不接触设备。 -->
                            <!-- The read-only RPMB capture must use an addressing shape the chosen family supports; an
                                 unsupported combination is refused locally before any device contact. -->
                            <TextBlock Text="{DynamicResource Flash_MtkRpmbMode}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="MtkRpmbModeBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" SelectedIndex="0"
                                      AutomationProperties.Name="{DynamicResource Flash_MtkRpmbMode}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Name="MtkRpmbOffsetBox" Height="32" VerticalContentAlignment="Center"
                                         PlaceholderText="{DynamicResource Flash_MtkRpmbOffset}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkRpmbOffset}" />
                                <TextBox Grid.Column="1" Name="MtkRpmbLengthBox" Height="32"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="{DynamicResource Flash_MtkRpmbLength}"
                                         AutomationProperties.Name="{DynamicResource Flash_MtkRpmbLength}" />
                            </Grid>
                            <Button Name="MtkRpmbReadButton" Classes="pane-action"
                                    Click="OnMtkRpmbReadClick"
                                    Content="{DynamicResource Flash_MtkRpmbRead}"
                                    AutomationProperties.Name="{DynamicResource Flash_MtkRpmbRead}" />
                            </StackPanel>
                            <!-- 关机与两种启动模式切换都要先启动到存储就绪的代理，因此复用本面板的 DA/EMI/端口选择。 -->
                            <!-- Every power and boot-mode request first boots a storage-ready agent, so it reuses this
                                 pane's DA/EMI/port selection. -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Name="MtkRebootButton" Classes="pane-action"
                                        Click="OnMtkRebootClick"
                                        Content="{DynamicResource Flash_MtkReboot}"
                                        AutomationProperties.Name="{DynamicResource Flash_MtkReboot}" />
                                <Button Grid.Column="1" Name="MtkRebootFastbootButton" Classes="pane-action"
                                        Click="OnMtkRebootFastbootClick"
                                        Content="{DynamicResource Flash_MtkRebootFastboot}"
                                        AutomationProperties.Name="{DynamicResource Flash_MtkRebootFastboot}" />
                                <Button Grid.Column="2" Name="MtkPowerOffButton" Classes="pane-action"
                                        Click="OnMtkPowerOffClick"
                                        Content="{DynamicResource Flash_MtkPowerOff}"
                                        AutomationProperties.Name="{DynamicResource Flash_MtkPowerOff}" />
                            </Grid>
                            <TextBlock Name="MtkScatterHintText" Text="{DynamicResource Flash_MtkLoadScatterHint}"
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Name="EdlHeader" Text="{DynamicResource Flash_Edl}" FontWeight="SemiBold" IsVisible="False" />
                        <StackPanel Name="EdlPane" Spacing="8" IsVisible="False">
                            <TextBlock Name="EdlStorageInfoText" Text="{DynamicResource Flash_EdlStorageInfoUnknown}"
                                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                            <TextBlock Name="EdlCapabilityText" IsVisible="False"
                                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                            <Button Name="EdlReadStorageInfoButton" Classes="pane-action"
                                    Click="OnEdlReadStorageInfoClick"
                                    Content="{DynamicResource Flash_EdlReadStorageInfo}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlReadStorageInfo}" />
                            <Button Name="EdlChooseProgrammerButton" Classes="pane-action"
                                    Click="OnEdlChooseProgrammerClick"
                                    Content="{DynamicResource Flash_EdlChooseProgrammer}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlChooseProgrammer}" />
                            <TextBlock Name="EdlProgrammerPathText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <!-- 包内同时存在多个 firehose loader 时由用户显式选择，不自动取第一个。 -->
                            <!-- When the package ships several firehose loaders the user picks one; the first is never assumed. -->
                            <TextBlock Name="EdlProgrammerChoiceLabel" FontSize="12" Opacity="0.8" IsVisible="False"
                                       Text="{DynamicResource Flash_EdlProgrammerChoice}" />
                            <ComboBox Name="EdlProgrammerPickBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" IsVisible="False"
                                      SelectionChanged="OnEdlProgrammerPickChanged"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlProgrammerChoice}" />
                            <!-- 鉴权只在初始化前生效：先选命令家族，再给出项目号与设备序列号，二者与 Sahara 上报身份交叉校验。 -->
                            <!-- Vendor startup requirements apply before initialization: pick the command family, then
                                 the project id and serial, which are cross-checked against the identity Sahara reports. -->
                            <TextBlock Text="{DynamicResource Flash_EdlAuthKind}" FontSize="12" Opacity="0.8" />
                            <ComboBox Name="EdlAuthKindBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnEdlAuthKindChanged"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlAuthKind}" />
                            <ComboBox Name="EdlOnePlusModelBox" Height="32" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" IsVisible="False"
                                      SelectionChanged="OnEdlOnePlusModelChanged"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlOnePlusModel}" />
                            <!-- SetNetType 只在部分 OnePlus loader 上被要求，且不能与普通项目号校验同时使用。 -->
                            <!-- SetNetType is only required by some OnePlus loaders and never combines with ordinary
                                 project-name verification. -->
                            <CheckBox Name="EdlNetTypeBox" Content="{DynamicResource Flash_EdlNetType}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlNetType}" />
                            <!-- 下面三项是链路兼容开关：只在驱动或 programmer 表现出对应异常时勾选，默认全部关闭。 -->
                            <!-- The three entries below are link-compatibility switches; enable them only when the
                                 driver or programmer shows the matching failure, and all three stay off by default. -->
                            <CheckBox Name="EdlQudRecoveryBox" Content="{DynamicResource Flash_EdlQudRecovery}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlQudRecovery}" />
                            <CheckBox Name="EdlPendingCompletionBox"
                                      Content="{DynamicResource Flash_EdlPendingCompletion}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlPendingCompletion}" />
                            <TextBox Name="EdlAuthTimeoutBox" Height="32" VerticalContentAlignment="Center" Text="60000"
                                     PlaceholderText="{DynamicResource Flash_EdlAuthTimeout}"
                                     AutomationProperties.Name="{DynamicResource Flash_EdlAuthTimeout}" />
                            <TextBox Name="EdlProjectIdBox" Height="32" VerticalContentAlignment="Center"
                                     PlaceholderText="{DynamicResource Flash_EdlProjectId}"
                                     AutomationProperties.Name="{DynamicResource Flash_EdlProjectId}" />
                            <TextBox Name="EdlSerialBox" Height="32" VerticalContentAlignment="Center"
                                     PlaceholderText="{DynamicResource Flash_EdlSerial}"
                                     AutomationProperties.Name="{DynamicResource Flash_EdlSerial}" />
                            <Button Name="EdlReadbackButton" Classes="pane-action"
                                    Click="OnEdlReadbackClick"
                                    Content="{DynamicResource Flash_EdlReadbackSelected}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlReadbackSelected}" />
                            <!-- 擦除按清单里的扇区范围执行，支持 NUM_DISK_SECTORS 相对地址，由目标端求值。 -->
                            <!-- Erase follows the manifest's sector range, supports the NUM_DISK_SECTORS-relative
                                 address and lets the target evaluate it. -->
                            <Button Name="EdlEraseButton" Classes="pane-action"
                                    Click="OnEdlEraseClick"
                                    Content="{DynamicResource Flash_EdlErase}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlErase}" />
                            <!-- 修复分区表只写回设备自身读回的表，不引入包内 GPT；写后按元数据指纹复核。 -->
                            <!-- The repair writes back only the table read from the device itself, never a packaged
                                 GPT, and revalidates the metadata fingerprint afterwards. -->
                            <Button Name="EdlRepairGptButton" Classes="pane-action"
                                    Click="OnEdlRepairGptClick"
                                    Content="{DynamicResource Flash_EdlRepairGpt}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlRepairGpt}" />
                            <!-- 内存转储只面向处于 Sahara 内存调试（crashdump）态的目标：不加载 programmer，也不配置存储。 -->
                            <!-- The memory dump targets a device sitting in Sahara memory-debug (crashdump) mode: no
                                 programmer is loaded and no storage is configured. -->
                            <Button Name="EdlRamDumpButton" Classes="pane-action"
                                    Click="OnEdlRamDumpClick"
                                    Content="{DynamicResource Flash_EdlRamDump}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlRamDump}" />
                            <!-- 重启走 firehose power reset，内部会先尽力发送 setbootablestoragedrive。 -->
                            <!-- The reboot goes through firehose power reset, which first sends a best-effort
                                 setbootablestoragedrive. -->
                            <Button Name="EdlResetButton" Classes="pane-action"
                                    Click="OnEdlResetClick"
                                    Content="{DynamicResource Flash_EdlReset}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlReset}" />
                            <!-- 断电、回到 EDL 与切换活动分区都复用同一套 programmer 与鉴权配置，只在命令字上不同。 -->
                            <!-- Power-off, the return to EDL and the active-partition switch reuse the same programmer and
                                 authentication configuration and differ only in the command sent. -->
                            <Button Name="EdlPowerOffButton" Classes="pane-action"
                                    Click="OnEdlPowerOffClick"
                                    Content="{DynamicResource Flash_EdlPowerOff}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlPowerOff}" />
                            <Button Name="EdlResetToEdlButton" Classes="pane-action"
                                    Click="OnEdlResetToEdlClick"
                                    Content="{DynamicResource Flash_EdlResetToEdl}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlResetToEdl}" />
                            <TextBox Name="EdlActiveSlotBox" Height="32" VerticalContentAlignment="Center" Text="a"
                                     PlaceholderText="{DynamicResource Flash_EdlSetActiveSlot}"
                                     AutomationProperties.Name="{DynamicResource Flash_EdlSetActiveSlot}" />
                            <Button Name="EdlSetActiveSlotButton" Classes="pane-action"
                                    Click="OnEdlSetActiveSlotClick"
                                    Content="{DynamicResource Flash_EdlSetActiveSlotApply}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlSetActiveSlotApply}" />
                            <!-- UFS provisioning 只吃外部描述符文件：预览不写设备，提交前必须确认，非 UFS 存储由服务层拒绝。 -->
                            <!-- UFS provisioning takes an external descriptor profile: the preview writes nothing, the
                                 submission needs confirmation, and non-UFS storage is refused by the service layer. -->
                            <Button Name="EdlChooseUfsProfileButton" Classes="pane-action"
                                    Click="OnEdlChooseUfsProfileClick"
                                    Content="{DynamicResource Flash_EdlUfsProfileChoose}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlUfsProfileChoose}" />
                            <TextBlock Name="EdlUfsProfileText" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <Button Name="EdlUfsPreviewButton" Classes="pane-action"
                                    Click="OnEdlUfsPreviewClick"
                                    Content="{DynamicResource Flash_EdlUfsPreview}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlUfsPreview}" />
                            <Button Name="EdlUfsProvisionButton" Classes="pane-action"
                                    Click="OnEdlUfsProvisionClick"
                                    Content="{DynamicResource Flash_EdlUfsProvision}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlUfsProvision}" />
                            <Button Name="EdlUfsResetButton" Classes="pane-action"
                                    Click="OnEdlUfsResetClick"
                                    Content="{DynamicResource Flash_EdlUfsReset}"
                                    AutomationProperties.Name="{DynamicResource Flash_EdlUfsReset}" />
                            <CheckBox Name="EdlGenerateXmlBox" Content="{DynamicResource Flash_EdlGenerateXml}"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlGenerateXml}" />
                            <CheckBox Name="EdlGeneralizedXmlBox" Content="{DynamicResource Flash_EdlGeneralizedXml}"
                                      HorizontalAlignment="Left" IsEnabled="False"
                                      AutomationProperties.Name="{DynamicResource Flash_EdlGeneralizedXml}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Flash_Image}" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <Button Name="ExtractSelectedButton" Classes="pane-action" IsEnabled="False"
                                    Click="OnExtractSelectedClick"
                                    Content="{DynamicResource Flash_ExtractSelected}" />
                            <Button Name="BuildWiredPackageButton" Classes="pane-action" IsEnabled="False"
                                    Click="OnBuildWiredPackageClick"
                                    Content="{DynamicResource Flash_BuildWiredPackage}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
    <!-- 覆盖层忙碌徽标：仅绑定 IsBusy 显隐，IsHitTestVisible=False 保证不拦截取消/操作输入。 -->
    <!-- Busy badge overlay: visibility driven by IsBusy only; IsHitTestVisible=False keeps cancel/action input intact. -->
    <Border IsVisible="{Binding IsBusy}" IsHitTestVisible="False" ZIndex="100"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
            Padding="16,8" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ursa:LoadingIcon IsLoading="{Binding IsBusy}" Width="20" Height="20" />
            <TextBlock Text="{DynamicResource Flash_Busy}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</UserControl>