<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        Title="{DynamicResource Menu_LogWindow}"
        Width="820" Height="480"
        MinWidth="600" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowDecorations="Full"
        Icon="/Assets/UotanToolbox.png"
        x:Class="UotanStudio.Views.Shell.LogWindow"
        x:DataType="vm:LogViewModel">
  <Window.Styles>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
      <Setter Property="Background">
        <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
      </Setter>
    </Style>
    <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
      <Setter Property="Margin" Value="40,0,136,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*" Margin="0,32,0,0">
    <!-- 顶栏：标题、筛选与操作按钮 -->
    <Border Grid.Row="0" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="{DynamicResource Log_Panel_Title}"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Log_LevelFilter}" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox Classes="Small" Width="86" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding LevelFilter}"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LogFilterDisplayConverter}}"
                           FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{DynamicResource Log_SourceFilter}" FontSize="11" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
          <ComboBox Classes="Small" Width="120" Height="22" MinHeight="0" Padding="6,0"
                    ItemsSource="{Binding Sources}" ToolTip.Tip="{Binding SourceFilter}"
                    SelectedItem="{Binding SourceFilter}"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource LogFilterDisplayConverter}}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBox Grid.Column="2" Name="LogSearchBox" Classes="Small"
                 Height="22" MinHeight="0" MinWidth="120" FontSize="11" Padding="4,0"
                 VerticalContentAlignment="Center" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{DynamicResource Log_Search}" AutomationProperties.Name="{DynamicResource Log_Search}">
          <TextBox.InnerLeftContent>
            <icons:Search Width="12" Height="12" Margin="4,0,0,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="Small" Width="18" Height="18" MinHeight="0" Padding="2"
                    Command="{Binding ClearSearchCommand}" ToolTip.Tip="{DynamicResource Log_ClearSearch}">
              <icons:Close Width="10" Height="10" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Name="ExportLogsButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnExportClick" ToolTip.Tip="{DynamicResource Log_Export}">
            <icons:Export Width="12" Height="12" />
          </Button>
          <Button Name="ClearLogsButton" Classes="Small" Width="20" Height="20" MinHeight="0" Padding="2"
                  Click="OnClearClick" ToolTip.Tip="{DynamicResource Log_Clear}">
            <icons:Delete Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- 通道 Tab 与日志列表：通道筛选与级别/组件筛选叠加生效 -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <!-- 通道 Tab：全部 / 通用 / 设备 / 烧录 / 固件 / 节点 -->
      <TabControl Grid.Row="0" Padding="8,2,8,0"
                  ItemsSource="{Binding Channels}"
                  SelectedItem="{Binding SelectedChannel}">
        <TabControl.ItemTemplate>
          <DataTemplate DataType="vm:LogViewModel+LogChannelOption">
            <TextBlock Text="{Binding Display}" FontSize="11" Margin="8,3" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate />
        </TabControl.ContentTemplate>
      </TabControl>
      <edit:TextEditor Grid.Row="1" Name="LogEditor"
                       IsReadOnly="True" ShowLineNumbers="False" WordWrap="False"
                       FontFamily="Consolas,monospace" FontSize="13"
                       Padding="8,4" Background="Transparent"
                       Foreground="{DynamicResource TextForeground}"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <edit:TextEditor.ContextMenu>
          <ContextMenu>
            <MenuItem Name="CopySelectionMenuItem" Header="{DynamicResource Menu_Copy}"
                      InputGesture="Ctrl+C" IsEnabled="False" Click="OnCopySelectionClick" />
            <MenuItem Header="{DynamicResource Menu_SelectAll}"
                      InputGesture="Ctrl+A" Click="OnSelectAllClick" />
          </ContextMenu>
        </edit:TextEditor.ContextMenu>
      </edit:TextEditor>
    </Grid>
  </Grid>
</Window>
