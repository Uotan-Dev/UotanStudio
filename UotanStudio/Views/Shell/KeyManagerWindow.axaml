<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UotanStudio.ViewModels.Shell" xmlns:keys="using:UotanStudio.Services.Keys" xmlns:icons="https://irihi.tech/iconica/tdesign"
        xmlns:views="using:UotanStudio.Views.Shell"
        x:Class="UotanStudio.Views.Shell.KeyManagerWindow" x:DataType="vm:KeyManagerViewModel"
        Title="{DynamicResource Menu_KeyManager}" Width="880" Height="606" MinWidth="800" MinHeight="540"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32" WindowDecorations="Full"
        WindowStartupLocation="CenterScreen" Icon="/Assets/UotanToolbox.png">
    <Window.Resources>
        <CornerRadius x:Key="KeyFieldCornerRadius">6</CornerRadius>
        <SolidColorBrush x:Key="KeyEntryBorderBrush" Color="{DynamicResource BorderForegroundColor}" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="Background">
                <ImageBrush Source="/Assets/UotanToolbox.png" DestinationRect="5,3.5,25,25" Stretch="Uniform" />
            </Setter>
        </Style>
        <Style Selector="WindowDrawnDecorations[HasTitleBar=True] /template/ TextBlock">
            <Setter Property="Margin" Value="40,0,136,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="{StaticResource KeyFieldCornerRadius}" />
        </Style>
        <Style Selector="TextBox.key-field">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="TextBlock.certificate-section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.certificate-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.key-action">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ListBox.key-list > ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource KeyFieldCornerRadius}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    <Grid Margin="0,32,0,0" RowDefinitions="*,Auto">
        <Grid Name="KeyManagerContent" Margin="20,20,4,16" ColumnDefinitions="280,*" ColumnSpacing="20" IsEnabled="{Binding IsIdle}">
            <Grid Name="KeyLibraryPane" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <TextBox Name="KeySearchBox" Classes="key-field" PlaceholderText="{DynamicResource Keys_Search}" Text="{Binding Search}"
                         AutomationProperties.Name="{DynamicResource Keys_Search}" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Keys_Library}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="key-action" Content="{DynamicResource Keys_New}" Command="{Binding NewKeyCommand}" Click="NewClick" />
                    <Button Grid.Column="2" Classes="key-action" Width="32" Padding="0" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{DynamicResource Keys_Refresh}" AutomationProperties.Name="{DynamicResource Keys_Refresh}">
                        <icons:Refresh Width="16" Height="16" />
                    </Button>
                </Grid>
                <ListBox Name="KeyList" Grid.Row="2" Classes="key-list" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,12,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="keys:ManagedKey">
                            <Border Name="KeyEntryCard" CornerRadius="{StaticResource KeyFieldCornerRadius}" BorderThickness="1"
                                    BorderBrush="{StaticResource KeyEntryBorderBrush}" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="Kind" />
                                                        <DynamicResourceExtension ResourceKey="Keys_InUse" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                                <TextBlock.IsVisible>
                                                    <MultiBinding>
                                                        <MultiBinding.Converter>
                                                            <views:DefaultKeyBadgeConverter />
                                                        </MultiBinding.Converter>
                                                        <Binding />
                                                        <Binding Path="DataContext.DefaultSignatureIds" ElementName="KeyManagerContent" />
                                                        <Binding Path="Kind" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="Small" Width="28" Height="28" MinWidth="0" Padding="0"
                                            VerticalAlignment="Center" Click="DeleteClick" ToolTip.Tip="{DynamicResource Keys_Delete}"
                                            AutomationProperties.Name="{DynamicResource Keys_Delete}">
                                        <icons:Delete Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <ScrollViewer Name="DetailsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                <StackPanel Spacing="14" Margin="0,0,16,0">
                    <StackPanel Name="KeyCreationContent" Spacing="14" IsVisible="{Binding !HasSelection}" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource Keys_Create}" FontWeight="SemiBold" />
                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="KeyCreationLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="field-label" Text="{DynamicResource Keys_Name}" />
                            <TextBox Grid.Column="1" Name="NewKeyNameBox" Classes="key-field" Text="{Binding Name}" MaxLength="80"
                                     PlaceholderText="{DynamicResource Keys_Name}" AutomationProperties.Name="{DynamicResource Keys_Name}" />
                            <TextBlock Grid.Row="1" Classes="field-label" Text="{DynamicResource Keys_Purpose}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding KindIndex}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Keys_Purpose}">
                                <ComboBoxItem Content="ADB" />
                                <ComboBoxItem Content="HDC" />
                                <ComboBoxItem Content="Payload" />
                                <ComboBoxItem Content="{DynamicResource Keys_ApkKey}" />
                                <ComboBoxItem Content="{DynamicResource Keys_ApkCertificate}" />
                                <ComboBoxItem Content="{DynamicResource Keys_Zip}" />
                                <ComboBoxItem Content="AVB" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="8" IsVisible="{Binding !IsApkCertificate}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="KeyCreationLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="field-label" Text="{DynamicResource Keys_Bits}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PayloadSizes}" SelectedItem="{Binding PayloadBits}"
                                      IsEnabled="{Binding IsBitsEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Keys_Bits}" />
                        </Grid>
                        <StackPanel Name="ApkCertificateContent" Spacing="10" IsVisible="{Binding IsApkCertificate}">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_KeystoreAlias}" />
                                    <TextBox Classes="key-field" Text="{Binding CertificateAlias}" AutomationProperties.Name="{DynamicResource Keys_KeystoreAlias}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_KeystorePassword}" />
                                    <TextBox Name="ApkKeystorePasswordBox" Classes="key-field" PasswordChar="●" Text="{Binding KeystorePassword}" AutomationProperties.Name="{DynamicResource Keys_KeystorePassword}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_ValidityYears}" />
                                    <NumericUpDown Minimum="1" Maximum="100" Value="{Binding ValidityYears}" AutomationProperties.Name="{DynamicResource Keys_ValidityYears}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:InfoCircle Width="16" Height="16" />
                                <TextBlock Classes="certificate-section" Text="{DynamicResource Keys_CertificateHolder}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_CommonName}" />
                                    <TextBox Classes="key-field" Text="{Binding CommonName}" AutomationProperties.Name="{DynamicResource Keys_CommonName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_OrganizationUnit}" />
                                    <TextBox Classes="key-field" Text="{Binding OrganizationalUnit}" AutomationProperties.Name="{DynamicResource Keys_OrganizationUnit}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_Organization}" />
                                    <TextBox Classes="key-field" Text="{Binding Organization}" AutomationProperties.Name="{DynamicResource Keys_Organization}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_Locality}" />
                                    <TextBox Classes="key-field" Text="{Binding Locality}" AutomationProperties.Name="{DynamicResource Keys_Locality}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_State}" />
                                    <TextBox Classes="key-field" Text="{Binding State}" AutomationProperties.Name="{DynamicResource Keys_State}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_CountryCode}" />
                                    <TextBox Classes="key-field" Text="{Binding CountryCode}" MaxLength="2" AutomationProperties.Name="{DynamicResource Keys_CountryCode}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:Key Width="16" Height="16" />
                                <TextBlock Classes="certificate-section" Text="{DynamicResource Keys_KeyConfiguration}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_Algorithm}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <RadioButton GroupName="ApkCertificateAlgorithm" Content="{DynamicResource Keys_Rsa}" IsChecked="{Binding IsRsaAlgorithm, Mode=TwoWay}" />
                                        <RadioButton GroupName="ApkCertificateAlgorithm" Content="{DynamicResource Keys_Ec}" IsChecked="{Binding IsEcAlgorithm, Mode=TwoWay}" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_KeySizeCurve}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <RadioButton GroupName="ApkCertificateSize" Content="{DynamicResource Keys_Rsa2048}" IsChecked="{Binding IsKeySize2048, Mode=TwoWay}" IsVisible="{Binding IsRsaAlgorithm}" />
                                        <RadioButton GroupName="ApkCertificateSize" Content="RSA 3072" IsChecked="{Binding IsKeySize3072, Mode=TwoWay}" IsVisible="{Binding IsRsaAlgorithm}" />
                                        <RadioButton GroupName="ApkCertificateSize" Content="{DynamicResource Keys_Rsa4096}" IsChecked="{Binding IsKeySize4096, Mode=TwoWay}" IsVisible="{Binding IsRsaAlgorithm}" />
                                        <RadioButton GroupName="ApkCertificateSize" Content="P-256" IsChecked="{Binding IsKeySizeP256, Mode=TwoWay}" IsVisible="{Binding IsEcAlgorithm}" />
                                        <RadioButton GroupName="ApkCertificateSize" Content="P-384" IsChecked="{Binding IsKeySizeP384, Mode=TwoWay}" IsVisible="{Binding IsEcAlgorithm}" />
                                        <RadioButton GroupName="ApkCertificateSize" Content="P-521" IsChecked="{Binding IsKeySizeP521, Mode=TwoWay}" IsVisible="{Binding IsEcAlgorithm}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:File Width="16" Height="16" />
                                <TextBlock Classes="certificate-section" Text="{DynamicResource Keys_OutputFormat}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="certificate-label" Text="{DynamicResource Keys_SelectOutputFormat}" />
                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <RadioButton GroupName="ApkCertificateFormat" Content="{DynamicResource Keys_FormatAll}" IsChecked="{Binding IsFormatAll, Mode=TwoWay}" />
                                    <RadioButton GroupName="ApkCertificateFormat" Content="{DynamicResource Keys_FormatJks}" IsChecked="{Binding IsFormatJks, Mode=TwoWay}" />
                                    <RadioButton GroupName="ApkCertificateFormat" Content="{DynamicResource Keys_FormatPkcs12}" IsChecked="{Binding IsFormatPkcs12, Mode=TwoWay}" />
                                    <RadioButton GroupName="ApkCertificateFormat" Content="{DynamicResource Keys_FormatPem}" IsChecked="{Binding IsFormatPem, Mode=TwoWay}" />
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Keys_FormatHint}" TextWrapping="Wrap" Opacity="0.65" FontSize="11" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsOutputDirectoryRequired}">
                                <TextBox Classes="key-field" Text="{Binding OutputDirectory}" PlaceholderText="{DynamicResource Keys_OutputDirectory}" AutomationProperties.Name="{DynamicResource Keys_OutputDirectory}" />
                                <Button Grid.Column="1" Classes="key-action" Content="{DynamicResource Keys_Browse}" Click="BrowseApkOutputDirectoryClick" />
                            </Grid>
                        </StackPanel>
                        <Grid Name="KeyCreationActions" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="8">
                            <StackPanel Name="ImportKeyControls" Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2"
                                        IsVisible="{Binding !IsApkCertificate}">
                                <Button Name="ImportKeyButton" Classes="key-action" Content="{DynamicResource Keys_Import}" Click="ImportClick"
                                        IsEnabled="{Binding CanImport}" />
                                <TextBox Name="ImportPasswordBox" Classes="key-field" Width="210" HorizontalAlignment="Left"
                                         Text="{Binding Password}" PasswordChar="●" PlaceholderText="{DynamicResource Keys_Password}" AutomationProperties.Name="{DynamicResource Keys_Password}" />
                            </StackPanel>
                            <Button Name="GenerateKeyButton" Grid.Column="2" Classes="key-action" Command="{Binding GenerateCommand}" Click="GenerateClick" HorizontalAlignment="Right">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Keys_Generate}" IsVisible="{Binding !IsApkCertificate}" />
                                    <TextBlock Text="{DynamicResource Keys_GenerateCertificate}" IsVisible="{Binding IsApkCertificate}" />
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock Name="KeyFormatsHint" Text="{DynamicResource Keys_Formats}" TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
                    </StackPanel>
                    <StackPanel Name="KeyDetailsContent" Spacing="14" IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{DynamicResource Keys_Details}" FontWeight="SemiBold" />
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Classes="key-field" Text="{Binding RenameText}" MaxLength="80" AutomationProperties.Name="{DynamicResource Keys_Name}" />
                                <Button Grid.Column="1" Classes="key-action" Content="{DynamicResource Keys_Rename}" Command="{Binding RenameCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedKey.Summary}" />
                            <SelectableTextBlock Text="{Binding SelectedKey.Fingerprint}" TextWrapping="Wrap" FontSize="12" />
                            <TextBox Name="PublicKeyBox" Text="{Binding PublicKey, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="160"
                                     FontFamily="Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        IsVisible="{Binding CanSetCurrentDefault}">
                                <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.75"
                                           Text="{DynamicResource Keys_AlreadyDefault}"
                                           IsVisible="{Binding IsSelectedDefault}" />
                                <Button Name="SetCurrentDefaultButton" Classes="key-action" Content="{DynamicResource Keys_SetCurrent}" Click="SetCurrentClick"
                                        IsEnabled="{Binding !IsSelectedDefault}"
                                        ToolTip.Tip="{DynamicResource Keys_SetCurrentHint}" AutomationProperties.Name="{DynamicResource Keys_SetCurrent}" />
                            </StackPanel>
                            <WrapPanel Name="KeyExportActions" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                <Button Classes="key-action" Content="{DynamicResource Keys_CopyPublic}" Click="CopyClick" />
                                <Button Classes="key-action" Content="{DynamicResource Keys_ExportPublic}" Click="ExportPublicClick" />
                                <Button Classes="key-action" Content="{DynamicResource Keys_ExportPair}" Click="ExportPairClick" />
                                <Button Classes="key-action" Content="{DynamicResource Keys_ExportCertificate}" Click="ExportCertificateClick"
                                        IsVisible="{Binding HasCertificate}" ToolTip.Tip="{DynamicResource Keys_ExportCertificate}"
                                        AutomationProperties.Name="{DynamicResource Keys_ExportCertificate}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
            <SelectableTextBlock Name="StatusText" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                 TextWrapping="Wrap" FontSize="12" Margin="20,0,20,12" />
        </StackPanel>
    </Grid>
</Window>
