<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels"
             xmlns:views="using:UotanStudio.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <DockPanel>
        <TabbedPage Name="MainTabs"
                    TabPlacement="Bottom">
            <TabbedPage.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TabbedPage.PageTransition>

            <!-- Device Tab -->
            <ContentPage>
                <ContentPage.Icon>
                    <avalonia:MaterialIcon Kind="Devices" Width="18" Margin="0 -10 0 0" />
                </ContentPage.Icon>
                <ContentPage.Header>
                    <TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Device}" FontSize="13" FontWeight="SemiBold" />
                </ContentPage.Header>
                <views:DeviceView DataContext="{Binding DeviceVM}" />
            </ContentPage>

            <!-- Workspace Tab -->
            <ContentPage>
                <ContentPage.Icon>
                    <avalonia:MaterialIcon Kind="MonitorDashboard" Width="18" Margin="0 -10 0 0" />
                </ContentPage.Icon>
                <ContentPage.Header>
                    <TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Workspace}" FontSize="13" FontWeight="SemiBold" />
                </ContentPage.Header>
                <!-- WorkspaceView 自行持有工作区布局（见 WorkspaceView 构造函数），无需父级注入 -->
                <views:WorkspaceView />
            </ContentPage>

            <!-- Node Tab -->
            <ContentPage>
                <ContentPage.Icon>
                    <avalonia:MaterialIcon Kind="ScriptTextPlayOutline" Width="18" Margin="0 -10 0 0" />
                </ContentPage.Icon>
                <ContentPage.Header>
                    <TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Node}" FontSize="13" FontWeight="SemiBold" />
                </ContentPage.Header>
                <views:NodeEditorView DataContext="{Binding NodeEditorVM}" />
            </ContentPage>

            <!-- Log Tab -->
            <ContentPage>
                <ContentPage.Icon>
                    <avalonia:MaterialIcon Kind="FileDocumentOutline" Width="18" Margin="0 -10 0 0" />
                </ContentPage.Icon>
                <ContentPage.Header>
                    <TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Log}" FontSize="13" FontWeight="SemiBold" />
                </ContentPage.Header>
                <views:LogView DataContext="{Binding LogVM}" />
            </ContentPage>

            <!-- Settings Tab -->
            <ContentPage>
                <ContentPage.Icon>
                    <avalonia:MaterialIcon Kind="CogOutline" Width="18" Margin="0 -10 0 0" />
                </ContentPage.Icon>
                <ContentPage.Header>
                    <TextBlock Margin="0 0 0 -10" Text="{DynamicResource Tab_Settings}" FontSize="13" FontWeight="SemiBold" />
                </ContentPage.Header>
                <views:SettingsView DataContext="{Binding SettingsVM}" />
            </ContentPage>
        </TabbedPage>
    </DockPanel>
</UserControl>
