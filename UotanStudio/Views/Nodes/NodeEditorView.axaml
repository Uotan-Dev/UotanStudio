<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:vm="using:UotanStudio.ViewModels.Nodes"
             xmlns:nodify="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
             xmlns:nodeVm="using:UotanStudio.ViewModels.NodeViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="UotanStudio.Views.Nodes.NodeEditorView"
             x:DataType="vm:NodeEditorViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolboxOperationTemplate" DataType="{x:Type vm:NodeToolboxItem}">
            <Grid ColumnDefinitions="*,Auto,28" Margin="0,1">
                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="6,4" Click="OnToolboxItemClicked" ToolTip.Tip="{Binding TypeKey}">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Node_Toolbox_Destructive}" FontSize="10"
                                   Foreground="{DynamicResource LogErrorBrush}" IsVisible="{Binding IsDestructive}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Content="⋯" Padding="4" IsVisible="{Binding HasPresets}"
                        ToolTip.Tip="{DynamicResource Node_Toolbox_Presets}" Tag="toolbox-preset">
                    <Button.Flyout>
                        <Flyout>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeToolboxPreset}">
                                        <Button Content="{Binding Name}" Command="{Binding CreateCommand}"
                                                HorizontalAlignment="Stretch" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" Content="{Binding FavoriteGlyph}" Command="{Binding ToggleFavoriteCommand}"
                        Classes.favorite="{Binding IsFavorite}"
                        ToolTip.Tip="{Binding FavoriteHint}" Padding="2" VerticalAlignment="Stretch" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.favorite">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="nodify|Connection.selected">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="StrokeThickness" Value="4" />
        </Style>
        <!-- 三栏之间的分隔线（圆角边缘 + 单侧投影）与拖动条，样式与交付页保持一致。 -->
        <!-- Divider (rounded edge plus one-sided shadow) and drag handle between the three panes,
             matching the delivery page. -->
        <Style Selector="controls|RoundedPaneDivider.pane-edge">
            <Setter Property="EdgeBrush" Value="{DynamicResource EditorPaneSplitterBackgroundBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style Selector="controls|RoundedPaneDivider.pane-edge.vertical">
            <Setter Property="Width" Value="0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="IsVertical" Value="True" />
        </Style>
        <!-- 拖动条：自绘拖动逻辑（见代码后置），保证相邻两栏只在自身之间搬运宽度、
             不牵动第三栏，也不会把任何一栏拖到最小宽度以下。 -->
        <!-- Drag handles: the drag is handled in code-behind so that the two adjacent panes only trade width
             between themselves, never touching the third pane or dropping below a pane minimum. -->
        <Style Selector="Border.splitter-handle">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Height="40" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- 左侧: 搜索框 -->
                <TextBox DockPanel.Dock="Left" Width="200" Height="28"
                         PlaceholderText="{DynamicResource Node_SearchNodes}"
                         Text="{Binding SearchText}"
                         VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                    <Button Width="28" Height="28" Padding="0" Click="OnImportTemplateClick"
                            ToolTip.Tip="{DynamicResource Node_ImportTemplate}">
                        <avalonia:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Click="OnExportTemplateClick"
                            ToolTip.Tip="{DynamicResource Node_ExportTemplate}">
                        <avalonia:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Click="OnEncapsulateClick"
                            ToolTip.Tip="{DynamicResource Node_Encapsulate}" IsEnabled="{Binding HasSelectedNodes}">
                        <avalonia:MaterialIcon Kind="Group" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Click="OnExpandCompositeClick"
                            ToolTip.Tip="{DynamicResource Node_ExpandComposite}">
                        <avalonia:MaterialIcon Kind="Ungroup" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="CollapseCompositeButton" Width="28" Height="28" Padding="0"
                            Click="OnCollapseCompositeClick"
                            IsVisible="{Binding CanCollapseExpandedComposite}"
                            ToolTip.Tip="{DynamicResource Node_CollapseComposite}">
                        <avalonia:MaterialIcon Kind="Undo" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Click="OnEditCompositeClick"
                            ToolTip.Tip="{DynamicResource Plugin_EditGraph}">
                        <avalonia:MaterialIcon Kind="PencilOutline" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0" Click="OnExportCompositeClick"
                            ToolTip.Tip="{DynamicResource Node_ExportComposite}">
                        <avalonia:MaterialIcon Kind="PuzzleOutline" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- 右侧: 缩放控制 + 小地图开关 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Spacing="4">
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip.Tip="{DynamicResource Node_ZoomOut}">
                        <avalonia:MaterialIcon Kind="Minus" Width="16" Height="16" />
                    </Button>
                    <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}"
                               VerticalAlignment="Center" Width="50"
                               TextAlignment="Center" FontSize="12" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ZoomInCommand}"
                            ToolTip.Tip="{DynamicResource Node_ZoomIn}">
                        <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ResetZoomCommand}"
                            ToolTip.Tip="{DynamicResource Node_ResetZoom}">
                        <avalonia:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="4,0" />
                    <ToggleButton Width="28" Height="28" Padding="0"
                                  IsChecked="{Binding ShowMinimap}"
                                  ToolTip.Tip="{DynamicResource Node_ToggleMinimap}">
                        <avalonia:MaterialIcon Kind="Map" Width="16" Height="16" />
                    </ToggleButton>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="4,0" />
                    <Button x:Name="DeleteSelectedButton"
                            MinWidth="92" Height="28" Padding="6,0"
                            Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="{Binding DeleteSelectionText}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                            <TextBlock x:Name="DeleteSelectedLabel"
                                       Text="{Binding DeleteSelectionText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 中间: 运行控制 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="4">
                    <Button x:Name="PreviewPatchButton" Height="28" Padding="8,0"
                            Command="{Binding PreviewCommand}"
                            Content="{DynamicResource Node_Patch_Preview}"
                            ToolTip.Tip="{DynamicResource Node_Patch_PreviewHint}" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding RunCommand}"
                            ToolTip.Tip="{DynamicResource Node_Run}">
                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="Green" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="{DynamicResource Node_Stop}">
                        <avalonia:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="Red" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="24" Padding="8,2"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedNode.StatusDisplay}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding Zoom, StringFormat='{}{0:P0}'}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_NodesLabel}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Connections.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_ConnectionsLabel}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Expander x:Name="PatchChangesPanel" DockPanel.Dock="Bottom" MaxHeight="300"
                  Header="{Binding PatchOutcomeText}" IsExpanded="True"
                  IsVisible="{Binding HasPatchReview}">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Node_Patch_ReportHint}" TextWrapping="Wrap" Margin="8,0" />
                <TextBlock Text="{DynamicResource Node_Patch_CompositeReportHint}" TextWrapping="Wrap" Margin="8,0" />
                <TextBlock Text="{DynamicResource Node_Patch_CompositeReportTruncated}" IsVisible="{Binding CompositeReportTruncated}"
                           TextWrapping="Wrap" Margin="8,0" />
                <ListBox x:Name="CompositeExecutionList" ItemsSource="{Binding CompositeExecutions}" MaxHeight="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatchCompositeExecutionViewModel}">
                            <StackPanel Spacing="3" Margin="4">
                                <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Parent}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Applicability}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="PatchChangeList" ItemsSource="{Binding PatchChanges}" MaxHeight="240">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatchChangeViewModel}">
                            <StackPanel Spacing="3" Margin="4">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StagedBy}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Node_Patch_BinaryPreviewHint}" IsVisible="{Binding HasBinaryPreview}" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="160" IsVisible="{Binding HasBinaryPreview}">
                                    <TextBlock Text="{Binding BinaryPreview}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{DynamicResource Node_Patch_Before}" />
                                        <TextBlock Text="{Binding BeforeHash}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BeforeText}" FontSize="11" TextWrapping="Wrap" MaxHeight="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{DynamicResource Node_Patch_After}" />
                                        <TextBlock Text="{Binding AfterHash}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AfterText}" FontSize="11" TextWrapping="Wrap" MaxHeight="100" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Expander>

        <!-- 底部执行日志面板（状态栏上方） -->
        <Border DockPanel.Dock="Bottom" MaxHeight="180"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Expander Header="{DynamicResource Node_ExecLog}" IsExpanded="False" Padding="6,2">
                <ListBox ItemsSource="{Binding ExecutionLog}"
                         MaxHeight="150"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="13"
                                       Foreground="{DynamicResource TextForeground}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </Border>

        <!-- 左中右三栏：始终按 1:4:1 比例分布，两侧保留最小宽度，
             窗口变窄时三栏一起收缩而不是让两侧内容消失；栏间可拖动调整。 -->
        <!-- Three panes always laid out 1:4:1 with minimum widths, so a narrow window shrinks all of them
             instead of dropping the side content, and each pane border can be dragged. -->
        <!-- 三栏的最小宽度写在列定义上（而不是子元素上），GridSplitter 才会在拖动时遵守，
             左右两栏无法被直接拖没。 -->
        <!-- Minimum widths live on the column definitions (not the children) so that GridSplitter honours
             them while dragging and the side panes cannot be collapsed. -->
        <Grid Name="PaneLayout" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="150" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="4*" MinWidth="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" MinWidth="150" />
            </Grid.ColumnDefinitions>
        <!-- 左侧工具箱面板 -->
        <Border Grid.Column="0" BorderThickness="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Toolbox}"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="8,8,8,4" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding VisibleToolboxCategories}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NodeToolboxCategory}">
                                <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2">
                                    <StackPanel Margin="4,0">
                                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !HasFamilies}"
                                                      ItemTemplate="{StaticResource ToolboxOperationTemplate}" />
                                        <ItemsControl ItemsSource="{Binding Families}" IsVisible="{Binding HasFamilies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:NodeToolboxCategory}">
                                                    <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                      ItemTemplate="{StaticResource ToolboxOperationTemplate}" />
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <controls:RoundedPaneDivider Grid.Column="1" Classes="pane-edge vertical" />
        <Border Grid.Column="1" Classes="splitter-handle"
                PointerPressed="OnLeftSplitterPressed" PointerMoved="OnSplitterMoved"
                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost" />

        <!-- 右侧属性面板 -->
        <Border Grid.Column="4" BorderThickness="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Properties}"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="8,8,8,4" />
                <Border x:Name="VisualPluginWorkspace" DockPanel.Dock="Bottom"
                        Margin="8,12,8,8" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource EditorPaneSplitterBackgroundBrush}" BorderThickness="1"
                        IsVisible="{Binding ShowVisualPluginWorkspace}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="5,5,0,0"
                                BorderBrush="{DynamicResource EditorPaneSplitterBackgroundBrush}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackground}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:MaterialIcon Kind="PuzzleOutline" Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource Node_PluginWorkspace}" FontWeight="SemiBold"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="10" Spacing="8">
                            <TextBlock Text="{DynamicResource Node_PluginWorkspaceEmpty}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" IsVisible="{Binding !EditableVisualPlugins.Count}" />
                            <ComboBox x:Name="VisualPluginSelector" Height="28" FontSize="12"
                                      ItemsSource="{Binding EditableVisualPlugins}"
                                      SelectedItem="{Binding SelectedVisualPlugin, Mode=TwoWay}"
                                      IsVisible="{Binding !!EditableVisualPlugins.Count}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="OpenVisualPluginEditorButton" Height="28" Padding="8,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnOpenVisualPluginEditorClick"
                                    IsEnabled="{Binding !!SelectedVisualPlugin}"
                                    IsVisible="{Binding !!EditableVisualPlugins.Count}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:MaterialIcon Kind="GraphOutline" Width="15" Height="15" />
                                    <TextBlock Text="{DynamicResource Node_OpenPluginEditor}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer>
                    <Grid>
                        <!-- 未选中节点时的占位提示 -->
                        <TextBlock Text="{DynamicResource Node_NoSelection}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"
                                   IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}" />

                        <!-- 选中节点后的属性面板 -->
                        <StackPanel Margin="8" Spacing="6"
                                    IsVisible="{Binding IsMultipleSelection}">
                            <TextBlock Text="{DynamicResource Node_BatchSelection}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="{Binding SelectedNodeCount}" />
                                <Run Text=" " />
                                <Run Text="{DynamicResource Node_BatchSelectedSuffix}" />
                            </TextBlock>
                            <Separator Margin="0,4" />
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Category}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCategoryDisplay}"
                                           FontSize="12" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Type}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTypeDisplay}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <StackPanel Spacing="4" IsVisible="{Binding CanEditBatchConstant}">
                                <Separator Margin="0,4" />
                                <TextBlock Text="{DynamicResource Node_BatchConstant}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_Const_ValueType}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" FontSize="12"
                                              ItemsSource="{x:Static nodeVm:FlowNodeViewModel.ValueTypeOptions}"
                                              SelectedItem="{Binding BatchNodeValueType, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_Const_Value}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" />
                                    <TextBox Grid.Column="1" FontSize="12" Height="24"
                                             Text="{Binding BatchNodeValue, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Node_BatchMixed}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding CanEditBatchProjectImage}">
                                <Separator Margin="0,4" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_ProjImg_Select}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" />
                                    <TextBox Grid.Column="1" FontSize="12" Height="24"
                                             Text="{Binding BatchSelectedImage, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Node_BatchMixed}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Node_Prop_Inputs}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding BatchInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:BatchNodeInputViewModel}">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                            <TextBlock Grid.Column="0" FontSize="12" Margin="0,2,8,0"
                                                       VerticalAlignment="Center" Text="{Binding LocalizedTitle}" />
                                            <TextBox Grid.Column="1" FontSize="12" Height="24"
                                                     Text="{Binding TextValue, Mode=TwoWay}"
                                                     IsVisible="{Binding IsTextOrPathPort}"
                                                     PlaceholderText="{DynamicResource Node_BatchMixed}" />
                                            <NumericUpDown Grid.Column="1" FontSize="12" Height="24"
                                                           Value="{Binding NumberValue, Mode=TwoWay}"
                                                           IsVisible="{Binding IsNumberPort}" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                                      IsVisible="{Binding IsBooleanPort}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="8" Spacing="6"
                                    IsVisible="{Binding IsSingleSelection}">
                            <TextBlock Text="{Binding SelectedNode.LocalizedTitle}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Margin="0,0,0,4" />
                            <Separator Margin="0,4" />

                            <!-- 节点类别 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Category}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCategoryDisplay}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 执行状态 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedNode.StatusDisplay}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 节点类型键 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Type}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedNode.TypeKey}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 位置 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Location}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           FontSize="12">
                                    <Run Text="{Binding SelectedNode.Location.X}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding SelectedNode.Location.Y}" />
                                </TextBlock>
                            </Grid>

                            <Separator Margin="0,4" />

                            <!-- 常量节点的值类型与值编辑器 -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding SelectedNode.IsConstantNode}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_Const_ValueType}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" FontSize="12"
                                              ItemsSource="{x:Static nodeVm:FlowNodeViewModel.ValueTypeOptions}"
                                              SelectedItem="{Binding SelectedNode.NodeValueType, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_Const_Value}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" />
                                    <TextBox Grid.Column="1" FontSize="12" Height="24"
                                             Text="{Binding SelectedNode.NodeValue, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource Node_Const_Hint}" />
                            </StackPanel>

                            <!-- 工程镜像引用节点的镜像选择编辑区 -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding SelectedNode.IsProjectImageNode}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_ProjImg_Select}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" FontSize="12"
                                              ItemsSource="{Binding SelectedNode.AvailableImages}"
                                              SelectedItem="{Binding SelectedNode.SelectedImage, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource Node_ProjImg_Hint}" />
                            </StackPanel>

                            <!-- 输入端口：为 Text/Number/Boolean/Path 类型提供初始值编辑器 -->
                            <TextBlock Text="{DynamicResource Node_Prop_Inputs}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <CheckBox Content="{DynamicResource Node_AdvancedParameters}" IsChecked="{Binding ShowAdvancedParameters}" />
                            <ItemsControl ItemsSource="{Binding SelectedParameterInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" FontSize="12" Margin="0,2,8,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="• " />
                                                <Run Text="{Binding LocalizedTitle}" />
                                            </TextBlock>
                                            <!-- 文本 / 路径：文本框 + 路径浏览 -->
                                            <TextBox Grid.Column="1" FontSize="12" MinHeight="{Binding EditorMinHeight}"
                                                     AcceptsReturn="{Binding IsMultiline}"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding InitialValue, Mode=TwoWay}"
                                                     PasswordChar="{Binding EditorPasswordChar}"
                                                     IsVisible="{Binding UsesTextEditor}">
                                            </TextBox>
                                            <ComboBox Grid.Column="1" FontSize="12"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      IsVisible="{Binding CanEditChoice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type nodeVm:NodePortChoice}">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- 数值：数值框 -->
                                            <NumericUpDown Grid.Column="1" FontSize="12" Height="24"
                                                           Value="{Binding InitialNumberValue, Mode=TwoWay}"
                                                           IsVisible="{Binding CanEditNumber}" />
                                            <!-- 布尔：开关 -->
                                            <CheckBox Grid.Column="1" FontSize="12"
                                                      IsChecked="{Binding InitialBooleanValue, Mode=TwoWay}"
                                                      IsVisible="{Binding CanEditBoolean}"
                                                      VerticalContentAlignment="Center" />
                                            <Button Grid.Column="2" Content="…" Width="26" Height="24" Padding="0"
                                                    Margin="4,0,0,0" FontSize="12"
                                                    IsVisible="{Binding CanBrowsePath}"
                                                    Click="OnBrowsePathClick"
                                                    Tag="{Binding}" />
                                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SourceDescription}"
                                                       IsVisible="{Binding HasConnectedSource}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,6"
                                                       FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding LocalizedHint}" IsVisible="{Binding HasHint}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 输出端口 -->
                            <TextBlock Text="{DynamicResource Node_Prop_Outputs}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Output}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <StackPanel Spacing="2" Margin="0,1">
                                            <TextBlock FontSize="12">
                                                <Run Text="• " />
                                                <Run Text="{Binding LocalizedTitle}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DataPreview}" FontSize="11"
                                                       TextWrapping="Wrap" MaxHeight="120"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <controls:RoundedPaneDivider Grid.Column="3" Classes="pane-edge vertical" ShadowLeft="True" />
        <Border Grid.Column="3" Classes="splitter-handle"
                PointerPressed="OnRightSplitterPressed" PointerMoved="OnSplitterMoved"
                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost" />

        <!-- 中央节点画布区域 - 使用 Grid 叠加小地图 -->
        <Grid Grid.Column="2" x:Name="EditorSurface"
              ClipToBounds="True"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnCanvasDragOver"
              DragDrop.DragLeave="OnCanvasDragLeave"
              DragDrop.Drop="OnCanvasDrop">
            <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 Zoom="{Binding Zoom, Mode=TwoWay}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 AllowAlign="True"
                                 AllowAutoPanning="True"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 x:Name="Editor">

                <!-- 节点模板 -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:FlowNodeViewModel}">
                                     <nodify:Node Header="{Binding LocalizedTitle}"
                                          Input="{Binding Input}"
                                          Output="{Binding Output}"
                                          Location="{Binding Location, Mode=TwoWay}"
                                          IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                          BorderBrush="{Binding NodeBorderBrush}"
                                          BorderThickness="{Binding NodeBorderThickness}">
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeInput IsConnected="{Binding IsConnected}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                        <!-- 端口类型徽章 + 标题 -->
                                        <nodify:NodeInput.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border CornerRadius="3" Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding LocalizedTitle}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </nodify:NodeInput.Header>
                                    </nodify:NodeInput>
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>
                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeOutput IsConnected="{Binding IsConnected}"
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                        <!-- 端口类型徽章 + 标题 -->
                                        <nodify:NodeOutput.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border CornerRadius="3" Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding LocalizedTitle}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </nodify:NodeOutput.Header>
                                    </nodify:NodeOutput>
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- 连接线模板 -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectionViewModel}">
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Classes.selected="{Binding IsSelected}"
                                           Target="{Binding Target.Anchor}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- 待处理连接线模板（拖拽连线时显示） -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:PendingConnectionViewModel}">
                        <nodify:PendingConnection
                            StartedCommand="{Binding StartCommand}"
                            CompletedCommand="{Binding FinishCommand}"
                            EnablePreview="True"
                            EnableSnapping="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>

            <Canvas x:Name="DropPreviewLayer" IsHitTestVisible="False">
                <Border x:Name="NodeDropPreview"
                        IsVisible="False"
                        Opacity="0.82"
                        RenderTransformOrigin="0%,0%">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Border.RenderTransform>
                    <nodify:Node x:DataType="nodeVm:FlowNodeViewModel"
                                 Header="{Binding LocalizedTitle}"
                                 Input="{Binding Input}"
                                 Output="{Binding Output}">
                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                <nodify:NodeInput IsConnected="{Binding IsConnected}">
                                    <nodify:NodeInput.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border CornerRadius="3" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding LocalizedTitle}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </nodify:NodeInput.Header>
                                </nodify:NodeInput>
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>
                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                <nodify:NodeOutput IsConnected="{Binding IsConnected}">
                                    <nodify:NodeOutput.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border CornerRadius="3" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding LocalizedTitle}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </nodify:NodeOutput.Header>
                                </nodify:NodeOutput>
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                    </nodify:Node>
                </Border>
            </Canvas>

            <!-- 小地图 - 作为叠加层放在 Grid 中，而非 NodifyEditor 的子元素 -->
            <Canvas IsHitTestVisible="False">
                <Border x:Name="SelectionBox"
                        IsVisible="False"
                        BorderBrush="{DynamicResource SemiColorPrimary}"
                        Background="{DynamicResource SemiColorPrimaryLight}"
                        Opacity="0.35"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
            </Canvas>

            <nodify:NodifyEditorMinimap Editor="{Binding #Editor}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Width="180" Height="120"
                                        Margin="8"
                                        IsVisible="{Binding ShowMinimap}" />
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
