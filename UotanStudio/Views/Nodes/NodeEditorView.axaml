<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="https://irihi.tech/iconica/tdesign"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:views="using:UotanStudio.Views.Nodes"
             xmlns:vm="using:UotanStudio.ViewModels.Nodes"
             xmlns:nodify="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
             xmlns:nodeVm="using:UotanStudio.ViewModels.NodeViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="UotanStudio.Views.Nodes.NodeEditorView"
             x:DataType="vm:NodeEditorViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolboxOperationTemplate" DataType="{x:Type vm:NodeToolboxItem}">
            <Panel Margin="0,1">
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="6,6,0,2"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding IsHeading}" />
                <Grid ColumnDefinitions="*,Auto,28" IsVisible="{Binding IsOperation}">
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="6,4" Click="OnToolboxItemClicked" ToolTip.Tip="{Binding TypeKey}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Node_Toolbox_Destructive}" FontSize="10"
                                       Foreground="{DynamicResource LogErrorBrush}" IsVisible="{Binding RequiresConfirmation}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Content="⋯" Padding="4" IsVisible="{Binding HasPresets}"
                            ToolTip.Tip="{DynamicResource Node_Toolbox_Presets}" Tag="toolbox-preset">
                        <Button.Flyout>
                            <Flyout>
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeToolboxPreset}">
                                            <Button Content="{Binding Name}" Command="{Binding CreateCommand}"
                                                    HorizontalAlignment="Stretch" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Content="{Binding FavoriteGlyph}" Command="{Binding ToggleFavoriteCommand}"
                            Classes.favorite="{Binding IsFavorite}"
                            ToolTip.Tip="{Binding FavoriteHint}" Padding="2" VerticalAlignment="Stretch" />
                </Grid>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.favorite">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="nodify|Connection.selected">
            <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="StrokeThickness" Value="4" />
        </Style>
        <!-- 三栏之间的分隔线（圆角边缘 + 单侧投影）与拖动条，样式与交付页保持一致。 -->
        <!-- Divider (rounded edge plus one-sided shadow) and drag handle between the three panes,
             matching the delivery page. -->
        <Style Selector="controls|RoundedPaneDivider.pane-edge">
            <Setter Property="EdgeBrush" Value="{DynamicResource EditorPaneSplitterBackgroundBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style Selector="controls|RoundedPaneDivider.pane-edge.vertical">
            <Setter Property="Width" Value="0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="IsVertical" Value="True" />
        </Style>
        <!-- 拖动条：自绘拖动逻辑（见代码后置），保证相邻两栏只在自身之间搬运宽度、
             不牵动第三栏，也不会把任何一栏拖到最小宽度以下。 -->
        <!-- Drag handles: the drag is handled in code-behind so that the two adjacent panes only trade width
             between themselves, never touching the third pane or dropping below a pane minimum. -->
        <Style Selector="Border.splitter-handle">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- 节点项目标签条：解决方案登记的每个节点项目一个标签，点击切换活动画布，叉号关闭文档。 -->
        <!-- Node project tab strip: one tab per node project the solution registers. Clicking switches the
             active canvas; the cross closes that document. -->
        <Border DockPanel.Dock="Top" Padding="8,4"
                IsVisible="{Binding HasOpenNodeProjects}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding OpenDocuments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NodeProjectDocument}">
                        <Border CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Padding="8,3" Background="Transparent" Classes="flat"
                                        Tag="{Binding Name}" Click="OnNodeTabSelected" Content="{Binding Name}" />
                                <Button Width="22" Background="Transparent" Classes="flat"
                                        Tag="{Binding Name}" Click="OnNodeTabClosed"
                                        ToolTip.Tip="{DynamicResource Node_CloseTab}">
                                    <avalonia:Close Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 顶部工具栏：按功能分成左（图编辑）、中（执行控制）、右（视图与面板）三栏。 -->
        <!-- Top toolbar: three functional columns - graph editing (left), execution control (center),
             view and pane controls (right). -->
        <Border DockPanel.Dock="Top" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="EditorToolbar" ColumnDefinitions="*,Auto,*">
                <!-- 左栏：保存、撤销重做、模板导入导出与复合节点操作。每个子组本身也可换行，
                     否则窄列下子组会按单行宽度撑出窗口。 -->
                <!-- Left column: save, undo/redo, template import/export and composite node operations.
                     Each sub-group wraps too, otherwise it keeps its single-line width in a narrow column. -->
                <WrapPanel x:Name="ToolbarEditGroup" Grid.Column="0" Orientation="Horizontal"
                           ItemSpacing="4" LineSpacing="4"
                           VerticalAlignment="Center" Margin="0,2,8,2" IsEnabled="{Binding CanEditGraph}">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2,8,2">
                        <Button Width="28" Height="28" Padding="0"
                                Command="{Binding SaveCommand}"
                                IsVisible="{Binding ResourcePackage, Converter={x:Static ObjectConverters.IsNull}}"
                                ToolTip.Tip="{DynamicResource Menu_Save}">
                            <avalonia:Save Width="16" Height="16" />
                        </Button>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2,8,2">
                        <Button Width="28" Height="28" Padding="0" Click="OnUndoClick" IsEnabled="{Binding CanUndo}"
                                ToolTip.Tip="{DynamicResource Node_Undo}">
                            <avalonia:Rollback Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Click="OnRedoClick" IsEnabled="{Binding CanRedo}"
                                ToolTip.Tip="{DynamicResource Node_Redo}">
                            <avalonia:Forward Width="16" Height="16" />
                        </Button>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2,8,2">
                        <Button Width="28" Height="28" Padding="0" Click="OnImportTemplateClick"
                                ToolTip.Tip="{DynamicResource Node_ImportTemplate}">
                            <avalonia:FileImport Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Click="OnExportTemplateClick"
                                ToolTip.Tip="{DynamicResource Node_ExportTemplate}">
                            <avalonia:FileExport Width="16" Height="16" />
                        </Button>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2,8,2">
                        <Button Width="28" Height="28" Padding="0" Click="OnEncapsulateClick"
                                ToolTip.Tip="{DynamicResource Node_Encapsulate}" IsEnabled="{Binding HasSelectedNodes}">
                            <avalonia:Layers Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Click="OnExpandCompositeClick"
                                ToolTip.Tip="{DynamicResource Node_ExpandComposite}">
                            <avalonia:ViewModule Width="16" Height="16" />
                        </Button>
                        <Button x:Name="CollapseCompositeButton" Width="28" Height="28" Padding="0"
                                Click="OnCollapseCompositeClick"
                                IsVisible="{Binding CanCollapseExpandedComposite}"
                                ToolTip.Tip="{DynamicResource Node_CollapseComposite}">
                            <avalonia:Rollback Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Click="OnEditCompositeClick"
                                ToolTip.Tip="{DynamicResource Plugin_EditGraph}">
                            <avalonia:Edit Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Click="OnExportCompositeClick"
                                ToolTip.Tip="{DynamicResource Node_ExportComposite}">
                            <avalonia:App Width="16" Height="16" />
                        </Button>
                    </WrapPanel>
                    <!-- 设置选中节点的执行阶段；标签复用现有资源键。 -->
                    <!-- Assign the execution stage of the selected nodes; the label reuses an existing resource key. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2,8,2">
                        <TextBlock Text="{DynamicResource Node_Choice_Stage}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ToolbarExecutionStageSelector" MinWidth="64" Height="28" FontSize="12"
                                  ItemsSource="{Binding ExecutionStageLabels}"
                                  SelectedItem="{Binding SelectedExecutionStageLabel, Mode=TwoWay}"
                                  IsEnabled="{Binding HasSelectedNodes}"
                                  ToolTip.Tip="{DynamicResource Node_Choice_Stage}" />
                    </WrapPanel>
                </WrapPanel>

                <!-- 中栏：图校验、补丁预览与运行/停止。 -->
                <!-- Center column: graph validation, patch preview and run/stop. -->
                <WrapPanel x:Name="ToolbarRunGroup" Grid.Column="1" Orientation="Horizontal"
                           ItemSpacing="4" LineSpacing="4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2">
                    <Button x:Name="ValidateGraphButton" Width="28" Height="28" Padding="0"
                            Command="{Binding ValidateGraphCommand}" ToolTip.Tip="{DynamicResource Node_ValidateGraph}">
                        <avalonia:CheckDouble Width="16" Height="16" />
                    </Button>
                    <Button x:Name="PreviewPatchButton" Height="28" Padding="8,0"
                            Command="{Binding PreviewCommand}"
                            Content="{DynamicResource Node_Patch_Preview}"
                            ToolTip.Tip="{DynamicResource Node_Patch_PreviewHint}" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding RunCommand}"
                            ToolTip.Tip="{DynamicResource Node_Run}">
                        <avalonia:PlayCircleStroke Width="16" Height="16" Stroke1="Green" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="{DynamicResource Node_Stop}">
                        <avalonia:StopCircleStroke Width="16" Height="16" Stroke1="Red" />
                    </Button>
                </WrapPanel>

                <!-- 右栏：缩放、适配、小地图与紧凑显示，删除选中固定在最右侧；窄面板下追加左右两栏开关。 -->
                <!-- Right column: zoom, fit, minimap and compact display, with delete pinned to the far right,
                     plus the pane toggles when narrow. -->
                <WrapPanel x:Name="ToolbarViewGroup" Grid.Column="2" Orientation="Horizontal"
                           ItemSpacing="4" LineSpacing="4"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2">
                        <Button Width="28" Height="28" Padding="0"
                                Command="{Binding ZoomOutCommand}"
                                ToolTip.Tip="{DynamicResource Node_ZoomOut}">
                            <avalonia:Minus Width="16" Height="16" />
                        </Button>
                        <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}"
                                   VerticalAlignment="Center" Width="50"
                                   TextAlignment="Center" FontSize="12" />
                        <Button Width="28" Height="28" Padding="0"
                                Command="{Binding ZoomInCommand}"
                                ToolTip.Tip="{DynamicResource Node_ZoomIn}">
                            <avalonia:Add Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0"
                                Command="{Binding ResetZoomCommand}"
                                ToolTip.Tip="{DynamicResource Node_ResetZoom}">
                            <avalonia:Search Width="16" Height="16" />
                        </Button>
                        <Button x:Name="FitAllButton" Width="28" Height="28" Padding="0"
                                Command="{Binding FitAllCommand}" ToolTip.Tip="{DynamicResource Node_FitAll}">
                            <avalonia:Fullscreen Width="16" Height="16" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0"
                                Command="{Binding FocusSelectionCommand}"
                                IsEnabled="{Binding HasSelectedNodes}" ToolTip.Tip="{DynamicResource Node_FocusSelection}">
                            <avalonia:Focus Width="16" Height="16" />
                        </Button>
                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                                Margin="4,0" />
                        <ToggleButton Width="28" Height="28" Padding="0"
                                      IsChecked="{Binding ShowMinimap}"
                                      ToolTip.Tip="{DynamicResource Node_ToggleMinimap}">
                            <avalonia:Map Width="16" Height="16" />
                        </ToggleButton>
                        <ToggleButton Width="28" Height="28" Padding="0" IsChecked="{Binding CompactNodes}"
                                      ToolTip.Tip="{DynamicResource Node_CompactNodes}">
                            <avalonia:ViewModule Width="16" Height="16" />
                        </ToggleButton>
                    </WrapPanel>
                    <StackPanel x:Name="NarrowPaneControls" IsVisible="False" Orientation="Horizontal" Spacing="4" Margin="0,2">
                        <ToggleButton x:Name="ToolboxPaneToggle" Width="28" Height="28" Padding="0"
                                      Click="OnToolboxPaneToggle" ToolTip.Tip="{DynamicResource Node_Toolbox}">
                            <avalonia:Tools Width="16" Height="16" />
                        </ToggleButton>
                        <ToggleButton x:Name="PropertiesPaneToggle" Width="28" Height="28" Padding="0"
                                      Click="OnPropertiesPaneToggle" ToolTip.Tip="{DynamicResource Node_Properties}">
                            <avalonia:Filter Width="16" Height="16" />
                        </ToggleButton>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,2">
                        <Button x:Name="DeleteSelectedButton"
                                MinWidth="92" MaxWidth="220" Height="28" Padding="6,0"
                                Command="{Binding DeleteSelectedCommand}"
                                IsEnabled="{Binding CanDeleteSelection}"
                                ToolTip.Tip="{Binding DeleteSelectionText}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <avalonia:Delete Width="16" Height="16" />
                                <TextBlock x:Name="DeleteSelectedLabel"
                                           Text="{Binding DeleteSelectionText}"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock x:Name="WorkflowStatusText" Text="{Binding ExecutionStatus}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ExecutionStatus}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="CanvasHintText" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{DynamicResource Node_CanvasHint}"
                           IsVisible="{Binding $parent[views:NodeEditorView].CanvasHintVisible}" />
                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding Zoom, StringFormat='{}{0:P0}'}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_NodesLabel}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Connections.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_ConnectionsLabel}" />
                    <Run Text=" | " />
                    <Run Text="{DynamicResource Node_Choice_Stage}" />
                    <Run Text=" " />
                    <Run Text="{Binding SelectedExecutionStageLabel, Mode=OneWay}" />
                </TextBlock>
                <ProgressBar x:Name="WorkflowProgress" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,4,0,0"
                             Minimum="0" Maximum="1" Value="{Binding ExecutionProgress}" IsVisible="{Binding IsExecuting}" />
            </Grid>
        </Border>

        <Expander x:Name="PatchChangesPanel" DockPanel.Dock="Bottom" MaxHeight="300"
                  Header="{Binding PatchOutcomeText}" IsExpanded="True"
                  IsVisible="{Binding HasPatchReview}">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Node_Patch_ReportHint}" TextWrapping="Wrap" Margin="8,0" />
                <TextBlock Text="{DynamicResource Node_Patch_CompositeReportHint}" TextWrapping="Wrap" Margin="8,0" />
                <TextBlock Text="{DynamicResource Node_Patch_CompositeReportTruncated}" IsVisible="{Binding CompositeReportTruncated}"
                           TextWrapping="Wrap" Margin="8,0" />
                <ListBox x:Name="CompositeExecutionList" ItemsSource="{Binding CompositeExecutions}" MaxHeight="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatchCompositeExecutionViewModel}">
                            <StackPanel Spacing="3" Margin="4">
                                <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Parent}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Applicability}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="PatchChangeList" ItemsSource="{Binding PatchChanges}" MaxHeight="240">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatchChangeViewModel}">
                            <StackPanel Spacing="3" Margin="4">
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StagedBy}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Node_Patch_BinaryPreviewHint}" IsVisible="{Binding HasBinaryPreview}" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="160" IsVisible="{Binding HasBinaryPreview}">
                                    <TextBlock Text="{Binding BinaryPreview}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{DynamicResource Node_Patch_Before}" />
                                        <TextBlock Text="{Binding BeforeHash}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BeforeText}" FontSize="11" TextWrapping="Wrap" MaxHeight="100" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{DynamicResource Node_Patch_After}" />
                                        <TextBlock Text="{Binding AfterHash}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AfterText}" FontSize="11" TextWrapping="Wrap" MaxHeight="100" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Expander>

        <!-- 底部执行日志面板（状态栏上方） -->
        <Border DockPanel.Dock="Bottom" MaxHeight="180"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Expander Header="{DynamicResource Node_ExecLog}" IsExpanded="{Binding IsExecutionLogExpanded, Mode=TwoWay}" Padding="6,2">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding FailedNodes}" IsVisible="{Binding HasFailures}" MaxHeight="90">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type nodeVm:FlowNodeViewModel}">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnFocusFailureClick"
                                        ToolTip.Tip="{Binding ExecutionError}" Margin="0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <avalonia:ErrorCircle Width="16" Height="16" />
                                        <TextBlock Text="{Binding DisplayHeader}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                <ListBox ItemsSource="{Binding ExecutionLog}"
                         MaxHeight="150"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="13"
                                       Foreground="{DynamicResource TextForeground}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Expander>
        </Border>

        <!-- 左中右三栏：始终按 1:4:1 比例分布，两侧保留最小宽度，
             窗口变窄时三栏一起收缩而不是让两侧内容消失；栏间可拖动调整。 -->
        <!-- Three panes always laid out 1:4:1 with minimum widths, so a narrow window shrinks all of them
             instead of dropping the side content, and each pane border can be dragged. -->
        <!-- 三栏的最小宽度写在列定义上（而不是子元素上），GridSplitter 才会在拖动时遵守，
             左右两栏无法被直接拖没。 -->
        <!-- Minimum widths live on the column definitions (not the children) so that GridSplitter honours
             them while dragging and the side panes cannot be collapsed. -->
        <Grid Name="PaneLayout" ClipToBounds="True" RowDefinitions="*,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="4*" MinWidth="200" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1*" MinWidth="280" />
            </Grid.ColumnDefinitions>
        <!-- 左侧工具箱面板 -->
        <Border x:Name="ToolboxPane" Grid.Column="0" BorderThickness="0">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="8,4" MinHeight="28"
                         PlaceholderText="{DynamicResource Node_SearchNodes}"
                         Text="{Binding SearchText}" />
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Toolbox}"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="8,8,8,4" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding VisibleToolboxItems}" Margin="4" IsEnabled="{Binding CanEditGraph}"
                                  ItemTemplate="{StaticResource ToolboxOperationTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <controls:RoundedPaneDivider x:Name="LeftPaneDivider" Grid.Column="1" Classes="pane-edge vertical" />
        <Border x:Name="LeftPaneHandle" Grid.Column="1" Classes="splitter-handle"
                PointerPressed="OnLeftSplitterPressed" PointerMoved="OnSplitterMoved"
                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost" />

        <!-- 右侧属性面板 -->
        <Border x:Name="PropertiesPane" Grid.Column="4" BorderThickness="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Properties}"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="8,8,8,4" />
                <Border x:Name="VisualPluginWorkspace" DockPanel.Dock="Bottom"
                        Margin="8,12,8,8" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource EditorPaneSplitterBackgroundBrush}" BorderThickness="1"
                        IsVisible="{Binding ShowVisualPluginWorkspace}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="5,5,0,0"
                                BorderBrush="{DynamicResource EditorPaneSplitterBackgroundBrush}"
                                BorderThickness="0,0,0,1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackground}" />
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:App Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource Node_PluginWorkspace}" FontWeight="SemiBold"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="10" Spacing="8">
                            <TextBlock Text="{Binding CodeRuntimeDisabledText}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CodeRuntimeDisabled}" />
                            <TextBlock Text="{DynamicResource Node_PluginWorkspaceEmpty}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" IsVisible="{Binding !EditableVisualPlugins.Count}" />
                            <ComboBox x:Name="VisualPluginSelector" Height="28" FontSize="12"
                                      ItemsSource="{Binding EditableVisualPlugins}"
                                      SelectedItem="{Binding SelectedVisualPlugin, Mode=TwoWay}"
                                      IsVisible="{Binding !!EditableVisualPlugins.Count}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="OpenVisualPluginEditorButton" Height="28" Padding="8,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnOpenVisualPluginEditorClick"
                                    IsEnabled="{Binding !!SelectedVisualPlugin}"
                                    IsVisible="{Binding !!EditableVisualPlugins.Count}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:ChartLine Width="15" Height="15" />
                                    <TextBlock Text="{DynamicResource Node_OpenPluginEditor}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer>
                    <Grid IsEnabled="{Binding CanEditGraph}">
                        <!-- 未选中节点时的占位提示 -->
                        <TextBlock Text="{DynamicResource Node_NoSelection}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"
                                   IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}" />

                        <!-- 选中节点后的属性面板 -->
                        <StackPanel Margin="8" Spacing="6"
                                    IsVisible="{Binding IsMultipleSelection}">
                            <TextBlock Text="{DynamicResource Node_BatchSelection}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="{Binding SelectedNodeCount}" />
                                <Run Text=" " />
                                <Run Text="{DynamicResource Node_BatchSelectedSuffix}" />
                            </TextBlock>
                            <Separator Margin="0,4" />
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Category}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCategoryDisplay}"
                                           FontSize="12" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Type}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTypeDisplay}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Choice_Stage}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <ComboBox FontSize="12" Height="28" MinWidth="64"
                                              ItemsSource="{Binding ExecutionStageLabels}"
                                              SelectedItem="{Binding SelectedExecutionStageLabel, Mode=TwoWay}"
                                              ToolTip.Tip="{DynamicResource Node_Choice_Stage}" />
                                    <TextBlock Text="{DynamicResource Node_BatchMixed}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               IsVisible="{Binding IsExecutionStageMixed}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4" IsVisible="{Binding CanEditBatchProjectImage}">
                                <Separator Margin="0,4" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_ProjImg_Select}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" />
                                    <TextBox Grid.Column="1" FontSize="12" Height="24"
                                             Text="{Binding BatchSelectedImage, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Node_BatchMixed}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Node_Prop_Inputs}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding BatchInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:BatchNodeInputViewModel}">
                                        <Grid RowDefinitions="Auto,Auto" Margin="0,2">
                                            <TextBlock FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Text="{Binding LocalizedTitle}" />
                                            <TextBox Grid.Row="1" FontSize="12" MinHeight="28"
                                                     Text="{Binding TextValue, Mode=TwoWay}"
                                                     IsVisible="{Binding IsTextOrPathPort}"
                                                     PlaceholderText="{DynamicResource Node_BatchMixed}" />
                                            <NumericUpDown Grid.Row="1" FontSize="12" MinHeight="28"
                                                           Value="{Binding NumberValue, Mode=TwoWay}"
                                                           IsVisible="{Binding IsNumberPort}" />
                                            <CheckBox Grid.Row="1" IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                                      IsVisible="{Binding IsBooleanPort}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="8" Spacing="6"
                                    IsVisible="{Binding IsSingleSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SelectedNode.DisplayHeader}"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedNode.ExecutionStageBadge}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Separator Margin="0,4" />

                            <!-- 节点类别 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Category}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCategoryDisplay}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 执行状态 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Status}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedNode.StatusDisplay}"
                                           FontSize="12" />
                            </Grid>

                            <!-- 执行阶段 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Choice_Stage}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" FontSize="12" Height="28"
                                          ItemsSource="{Binding ExecutionStageLabels}"
                                          SelectedItem="{Binding SelectedExecutionStageLabel, Mode=TwoWay}"
                                          ToolTip.Tip="{DynamicResource Node_Choice_Stage}" />
                            </Grid>

                            <!-- 节点类型键 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Type}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                             Text="{Binding SelectedNode.TypeKey}"
                                            FontSize="12" TextWrapping="Wrap" />
                            </Grid>

                            <!-- 位置 -->
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_Location}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="NodeLocationText" Grid.Column="1"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SelectedNode.Location}">
                                    <Run Text="{Binding SelectedNode.Location.X, StringFormat='{}{0:0.#}'}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding SelectedNode.Location.Y, StringFormat='{}{0:0.#}'}" />
                                </TextBlock>
                            </Grid>

                            <!-- 备注名 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Node_Prop_CustomName}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Height="24" FontSize="12"
                                         Text="{Binding SelectedNode.CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Separator Margin="0,4" />

                            <!-- 工程镜像引用节点的镜像选择编辑区 -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding SelectedNode.IsProjectImageNode}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Node_ProjImg_Select}"
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,8,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" FontSize="12"
                                              ItemsSource="{Binding SelectedNode.AvailableImages}"
                                              SelectedItem="{Binding SelectedNode.SelectedImage, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource Node_ProjImg_Hint}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 输入端口：为 Text/Number/Boolean/Path 类型提供初始值编辑器 -->
                            <TextBlock Text="{DynamicResource Node_Prop_Inputs}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <CheckBox Content="{DynamicResource Node_AdvancedParameters}" IsChecked="{Binding ShowAdvancedParameters}" />
                            <TextBlock Text="{Binding SelectedNode.ExecutionError}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource LogErrorBrush}" />
                            <ItemsControl ItemsSource="{Binding SelectedParameterInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                                            <TextBlock Grid.ColumnSpan="2" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap"
                                                       VerticalAlignment="Center">
                                                <Run Text="• " />
                                                <Run Text="{Binding LocalizedTitle}" />
                                            </TextBlock>
                                            <!-- 文本 / 路径：文本框 + 路径浏览 -->
                                            <TextBox Grid.Row="1" Grid.Column="0" FontSize="12" MinHeight="{Binding EditorMinHeight}"
                                                     AcceptsReturn="{Binding IsMultiline}"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding InitialValue, Mode=TwoWay}"
                                                     PasswordChar="{Binding EditorPasswordChar}"
                                                     IsVisible="{Binding UsesTextEditor}">
                                            </TextBox>
                                            <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" FontSize="12"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      IsVisible="{Binding CanEditChoice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type nodeVm:NodePortChoice}">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- 数值：数值框 -->
                                            <NumericUpDown Grid.Row="1" Grid.Column="0" FontSize="12" MinHeight="28"
                                                           Value="{Binding InitialNumberValue, Mode=TwoWay}"
                                                           IsVisible="{Binding CanEditNumber}" />
                                            <!-- 布尔：开关 -->
                                            <CheckBox Grid.Row="1" Grid.Column="0" FontSize="12"
                                                      IsChecked="{Binding InitialBooleanValue, Mode=TwoWay}"
                                                      IsVisible="{Binding CanEditBoolean}"
                                                      VerticalContentAlignment="Center" />
                                            <Button Grid.Row="1" Grid.Column="1" Width="28" Height="28" Padding="0"
                                                    Margin="4,0,0,0" FontSize="12"
                                                    IsVisible="{Binding CanBrowsePath}"
                                                    Click="OnBrowsePathClick"
                                                    Tag="{Binding}" ToolTip.Tip="{DynamicResource Node_BrowsePath}">
                                                <avalonia:FolderOpen Width="16" Height="16" />
                                            </Button>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SourceDescription}"
                                                       IsVisible="{Binding HasConnectedSource}" TextWrapping="Wrap" FontSize="12" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,6"
                                                       FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding LocalizedHint}" IsVisible="{Binding HasHint}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 输出端口 -->
                            <TextBlock Text="{DynamicResource Node_Prop_Outputs}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Output}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <StackPanel Spacing="2" Margin="0,1">
                                            <TextBlock FontSize="12">
                                                <Run Text="• " />
                                                <Run Text="{Binding LocalizedTitle}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DataPreview}" FontSize="11"
                                                       TextWrapping="Wrap" MaxHeight="120"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <controls:RoundedPaneDivider x:Name="RightPaneDivider" Grid.Column="3" Classes="pane-edge vertical" ShadowLeft="True" />
        <Border x:Name="RightPaneHandle" Grid.Column="3" Classes="splitter-handle"
                PointerPressed="OnRightSplitterPressed" PointerMoved="OnSplitterMoved"
                PointerReleased="OnSplitterReleased" PointerCaptureLost="OnSplitterCaptureLost" />

        <!-- 中央节点画布区域 - 使用 Grid 叠加小地图 -->
        <Grid Grid.Column="2" x:Name="EditorSurface"
              ClipToBounds="True"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnCanvasDragOver"
              DragDrop.DragLeave="OnCanvasDragLeave"
              DragDrop.Drop="OnCanvasDrop">
            <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                                 IsEnabled="{Binding CanEditGraph}"
                                 Connections="{Binding Connections}"
                                 PendingConnection="{Binding PendingConnection}"
                                 Zoom="{Binding Zoom, Mode=TwoWay}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 AllowAlign="True"
                                 AllowAutoPanning="True"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 x:Name="Editor">

                <!-- 节点模板 -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:FlowNodeViewModel}">
                        <nodify:Node Input="{Binding CanvasInputs}"
                                     Output="{Binding Output}"
                                     Location="{Binding Location, Mode=TwoWay}"
                                     IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                     BorderBrush="{Binding NodeBorderBrush}"
                                     BorderThickness="{Binding NodeBorderThickness}"
                                     ToolTip.Tip="{Binding ValidationMessage}">
                            <nodify:Node.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding DisplayHeader}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding ExecutionStageBadge}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </nodify:Node.Header>
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeInput IsConnected="{Binding IsConnected}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                        <!-- 端口类型徽章 + 标题 -->
                                        <nodify:NodeInput.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border CornerRadius="3" Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding LocalizedTitle}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </nodify:NodeInput.Header>
                                    </nodify:NodeInput>
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>
                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeOutput IsConnected="{Binding IsConnected}"
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}">
                                        <!-- 端口类型徽章 + 标题 -->
                                        <nodify:NodeOutput.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border CornerRadius="3" Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding LocalizedTitle}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </nodify:NodeOutput.Header>
                                    </nodify:NodeOutput>
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- 连接线模板 -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectionViewModel}">
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Classes.selected="{Binding IsSelected}"
                                           Target="{Binding Target.Anchor}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- 待处理连接线模板（拖拽连线时显示） -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:PendingConnectionViewModel}">
                        <nodify:PendingConnection
                            StartedCommand="{Binding StartCommand}"
                            CompletedCommand="{Binding FinishCommand}"
                            EnablePreview="True"
                            EnableSnapping="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>

            <Canvas x:Name="DropPreviewLayer" IsHitTestVisible="False">
                <Border x:Name="NodeDropPreview"
                        IsVisible="False"
                        Opacity="0.82"
                        RenderTransformOrigin="0%,0%">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Border.RenderTransform>
                    <nodify:Node x:DataType="nodeVm:FlowNodeViewModel"
                                 Input="{Binding CanvasInputs}"
                                 Output="{Binding Output}">
                        <nodify:Node.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DisplayHeader}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ExecutionStageBadge}" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </nodify:Node.Header>
                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                <nodify:NodeInput IsConnected="{Binding IsConnected}">
                                    <nodify:NodeInput.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border CornerRadius="3" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding LocalizedTitle}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </nodify:NodeInput.Header>
                                </nodify:NodeInput>
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>
                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                <nodify:NodeOutput IsConnected="{Binding IsConnected}">
                                    <nodify:NodeOutput.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border CornerRadius="3" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding LocalizedPortTypeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding LocalizedTitle}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </nodify:NodeOutput.Header>
                                </nodify:NodeOutput>
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>
                    </nodify:Node>
                </Border>
            </Canvas>

            <!-- 小地图 - 作为叠加层放在 Grid 中，而非 NodifyEditor 的子元素 -->
            <Canvas IsHitTestVisible="False">
                <Border x:Name="SelectionBox"
                        IsVisible="False"
                        BorderBrush="{DynamicResource SemiColorPrimary}"
                        Background="{DynamicResource SemiColorPrimaryLight}"
                        Opacity="0.35"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
            </Canvas>

            <nodify:NodifyEditorMinimap Editor="{Binding #Editor}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Width="180" Height="120"
                                        Margin="8"
                                        IsVisible="{Binding ShowMinimap}" />
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
