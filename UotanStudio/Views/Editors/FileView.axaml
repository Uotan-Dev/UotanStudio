<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UotanStudio.Views.Editors.FileView"
             x:DataType="viewmodels:FileViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- 顶部错误提示条：与对比视图同一套单行样式与关闭按钮（此窗口不含文件路径行）。 -->
    <!-- Top error banner: same single-line styling and dismiss button as the Compare view (this window has no file path row). -->
    <controls:EditorErrorBanner Grid.Row="0"
                                Message="{Binding CompileError, Mode=TwoWay}" />

    <!-- 文本编辑器 -->
    <controls:CodeEditor Grid.Row="1" Name="Editor"
                         Text="{Binding Text, Mode=TwoWay}"
                         Language="{Binding Language}"
                         IsVisible="{Binding !IsBinary}" />

    <controls:HexViewer Grid.Row="1" Name="HexEditor" Data="{Binding RawBytes}"
                        IsVisible="{Binding IsBinary}" />

    <!-- 底部状态栏 -->
    <Border Grid.Row="2" Padding="6,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding IsBinary}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding SizeDisplay}" FontSize="12" Opacity="0.6" />
        <TextBlock Text="{Binding IsDirty, StringFormat='[*]'}"
                   FontSize="12" Foreground="Orange"
                   IsVisible="{Binding IsDirty}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>