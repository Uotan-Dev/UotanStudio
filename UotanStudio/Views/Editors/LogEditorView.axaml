<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="using:UotanStudio.Views.Workspace"
             xmlns:vm="using:UotanStudio.ViewModels.Editors"
             x:Class="UotanStudio.Views.Editors.LogEditorView"
             x:DataType="vm:LogEditorViewModel">
  <Grid>
    <workspace:AdbLogView />
    <Border IsVisible="{Binding IsLoading}" IsHitTestVisible="{Binding IsLoading}" ZIndex="1"
            Background="#A0000000">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <ProgressBar Width="220" IsIndeterminate="True" />
        <TextBlock Text="{DynamicResource Log_Loading}"
                   Foreground="White" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
