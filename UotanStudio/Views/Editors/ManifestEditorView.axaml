<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.ManifestEditorView"
             x:DataType="viewmodels:ManifestEditorViewModel">
  <DockPanel IsEnabled="{Binding !IsBusy}">
    <!-- 顶部工具栏：标题 + 右侧视图布局切换（文件路径已按需求移除，改为固定标题） -->
    <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <!-- 与文件管理器顶栏的格式名同款：加粗文字显示当前编辑器名称。 -->
        <!-- Same look as the file manager's format-name label: bold text naming the current editor. -->
        <TextBlock Grid.Column="0"
                   Text="{DynamicResource Dock_Manifest_Header}"
                   FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Width="18" Height="18"
                MinWidth="0" MinHeight="0"
                Margin="6,0,0,0" Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OnToggleRightViewClick"
                ToolTip.Tip="{DynamicResource Dock_Manifest_ToggleRightView}">
          <avalonia:MaterialIcon x:Name="RightViewLayoutIcon"
                                 Kind="ViewSplitVertical"
                                 Width="12" Height="12" />
        </Button>
      </Grid>
    </Border>

    <!-- 顶部错误提示条：与 FileManager 编辑器同一套样式。 -->
    <!-- Top error banner: same styling as the FileManager editor. -->
    <Border Classes="error-banner" DockPanel.Dock="Top"
            IsVisible="{Binding CompileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="error-banner" Text="{Binding CompileError}" />
    </Border>

    <!-- 左：元素结构树；右上：选中元素属性；右下：XML 文本预览 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="120" />
        <ColumnDefinition Width="3" />
        <ColumnDefinition Width="*" MinWidth="120" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0">
        <TreeView x:Name="ElementTree"
                  ItemsSource="{Binding Nodes}"
                  SelectionChanged="OnTreeSelectionChanged">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="viewmodels:ManifestTreeNodeViewModel" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" FontFamily="Consolas" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource EditorPaneSplitterBackgroundBrush}"
              IsHitTestVisible="False" />
      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Width="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="SizeWestEast"
                    ZIndex="1" />
      <avalonia:MaterialIcon Grid.Column="1"
                             Kind="DragVertical"
                             Width="7" Height="20"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource EditorPaneSplitterGripBrush}"
                             IsHitTestVisible="False"
                             Opacity="0.8"
                             ZIndex="2" />

      <Grid x:Name="RightPaneGrid"
            Grid.Column="2"
            ColumnDefinitions="*"
            RowDefinitions="*,3,*">
        <Border x:Name="AttributesPane" Grid.Row="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Padding="6,4" FontSize="11" Opacity="0.7"
                       Text="Attributes" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Attributes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewmodels:ManifestAttributeRow">
                    <controls:ResponsiveFormRow Margin="8,3"
                                                MinLabelWidth="120"
                                                MaxLabelWidth="120"
                                                MinEditorWidth="180"
                                                ColumnSpacing="3"
                                                RowSpacing="2">
                      <TextBlock Text="{Binding Name}" FontFamily="Consolas"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
                      <TextBox Text="{Binding Value, Mode=TwoWay}" FontFamily="Consolas" />
                    </controls:ResponsiveFormRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border x:Name="RightPaneSplitterTrack"
                Grid.Row="1"
                Background="{DynamicResource EditorPaneSplitterBackgroundBrush}"
                IsHitTestVisible="False" />
        <GridSplitter x:Name="RightPaneSplitter"
                      Grid.Row="1"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Height="7"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Cursor="SizeNorthSouth"
                      ZIndex="1" />
        <avalonia:MaterialIcon x:Name="RightPaneSplitterGrip"
                               Grid.Row="1"
                               Kind="DragHorizontal"
                               Width="20" Height="7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource EditorPaneSplitterGripBrush}"
                               IsHitTestVisible="False"
                               Opacity="0.8"
                               ZIndex="2" />

        <controls:CodeEditor Grid.Row="2" x:Name="SourceEditor"
                             Text="{Binding Source, Mode=TwoWay}" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>