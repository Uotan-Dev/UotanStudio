<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.FirmwareInfoView"
             x:DataType="viewmodels:FirmwareInfoViewModel">
  <DockPanel>
    <!-- 加载中提示条 -->
    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsBusy}">
      <TextBlock Text="{DynamicResource FirmwareInfo_Loading}"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Border>

    <!-- 顶部错误提示条：与 FileManager 编辑器同一套样式。 -->
    <!-- Top error banner: same styling as the FileManager editor. -->
    <Border Classes="error-banner" DockPanel.Dock="Top" IsVisible="{Binding HasError}">
      <TextBlock Classes="error-banner" Text="{Binding ErrorMessage}" />
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="14">

        <!-- 面板标题 -->
        <TextBlock Text="{DynamicResource FirmwareInfo_Title}"
                   FontSize="20" FontWeight="SemiBold" />

        <!-- 格式名 -->
        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                IsVisible="{Binding IsRecognized}">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource FirmwareInfo_FormatName}"
                       FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{Binding FormatName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 元数据键值对 -->
        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                IsVisible="{Binding HasMetadata}">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource FirmwareInfo_Metadata}"
                       FontWeight="SemiBold" FontSize="13" />
            <ItemsControl ItemsSource="{Binding MetadataGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:FirmwareMetadataGroup">
                  <StackPanel Spacing="6" Margin="0,8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PropertyRow">
                          <controls:ResponsiveFormRow MinLabelWidth="170" MaxLabelWidth="210"
                                                      MinEditorWidth="180" ColumnSpacing="16" RowSpacing="4" Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       FontSize="12" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding Value}" FontFamily="Consolas"
                                                 FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </controls:ResponsiveFormRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 组件列表（名称 + 大小） -->
        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                IsVisible="{Binding HasComponents}">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource FirmwareInfo_Components}"
                       FontWeight="SemiBold" FontSize="13" />
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:PropertyRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 条目列表 -->
        <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                IsVisible="{Binding HasEntries}">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource FirmwareInfo_Entries}"
                       FontWeight="SemiBold" FontSize="13" />
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
