<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.FirmwareInfoView"
             x:DataType="viewmodels:FirmwareInfoViewModel">
  <UserControl.Styles>
    <!-- 次标题：与 Logo 分区页次标题统一默认字号与半粗。 -->
    <!-- Subheading: default font size and semibold across every section. -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 键值行：与 ELF 文件头页统一尺寸与行间距。 -->
    <!-- Key/value row: matches the ELF header tab sizing and spacing. -->
    <Style Selector="controls|ResponsiveFormRow.info-row">
      <Setter Property="MinLabelWidth" Value="170" />
      <Setter Property="MaxLabelWidth" Value="210" />
      <Setter Property="MinEditorWidth" Value="180" />
      <Setter Property="ColumnSpacing" Value="16" />
      <Setter Property="RowSpacing" Value="4" />
      <Setter Property="Margin" Value="4,5" />
    </Style>

    <!-- 键列文本：与 ELF 文件头页统一默认字号与 0.75 不透明度。 -->
    <!-- Key text: default font size and 0.75 opacity matching the ELF header tab. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.field-label.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
    </Style>

    <!-- 值列文本：与 ELF 文件头页统一默认字号与等宽体。 -->
    <!-- Value text: default font size and monospace matching the ELF header tab. -->
    <Style Selector="SelectableTextBlock.field-value">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="SelectableTextBlock.field-value.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
    </Style>
    <Style Selector="SelectableTextBlock.field-value.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 条目行：无键名，等宽体整行铺满，与键列同一起始边。 -->
    <!-- Entry line: no key, monospace full width, sharing the key column's left edge. -->
    <Style Selector="SelectableTextBlock.entry-line">
      <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <DockPanel>
    <!-- 顶部错误提示条：与对比视图同一套单行样式与关闭按钮。 -->
    <!-- Top error banner: same single-line styling and dismiss button as the Compare view. -->
    <controls:EditorErrorBanner DockPanel.Dock="Top"
                                Message="{Binding ErrorMessage, Mode=TwoWay}"
                                DismissCommand="{Binding DismissErrorCommand}" />

    <!-- 顶部标题栏 -->
    <Border DockPanel.Dock="Top" Padding="16,12,16,0">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource FirmwareInfo_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FormatName}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding FormatName}" Opacity="0.7"
                   IsVisible="{Binding FormatName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <TabControl ItemsSource="{Binding Tabs}"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                IsVisible="{Binding IsRecognized}"
                Margin="16,8,16,16">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="viewmodels:FirmwareInfoTabItem">
          <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="viewmodels:FirmwareInfoTabItem">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,12">
              <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewmodels:PropertyRow">
                    <controls:ResponsiveFormRow Classes="info-row">
                      <TextBlock Classes="field-label" Text="{Binding Name}" />
                      <SelectableTextBlock Classes="field-value mono" Text="{Binding Value}" />
                    </controls:ResponsiveFormRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding HasComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="viewmodels:PropertyRow">
                    <controls:ResponsiveFormRow Classes="info-row">
                      <TextBlock Classes="field-label mono" Text="{Binding Name}" />
                      <SelectableTextBlock Classes="field-value mono muted" Text="{Binding Value}" />
                    </controls:ResponsiveFormRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <SelectableTextBlock Classes="entry-line" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
    </DockPanel>
    <Border IsVisible="{Binding IsBusy}" IsHitTestVisible="{Binding IsBusy}" ZIndex="1"
            Background="#A0000000">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <ProgressBar Width="220" IsIndeterminate="True" />
        <TextBlock Text="{DynamicResource FirmwareInfo_Loading}"
                   Foreground="White" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
