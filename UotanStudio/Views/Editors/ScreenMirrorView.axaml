<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UotanStudio.ViewModels.Editors"
             xmlns:local="using:UotanStudio.Views.Editors"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:DataType="vm:ScreenMirrorViewModel"
             x:Class="UotanStudio.Views.Editors.ScreenMirrorView"
             Focusable="True">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="8,4"
            Background="{DynamicResource PageBackground}">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <Panel Grid.Row="1" Background="Black">
      <local:ScreenMirrorVideoControl x:Name="FrameImage"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" />
      <TextBlock x:Name="WaitingLabel"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="White"
                 FontSize="13"
                 Text="{Binding DeviceName}" />
    </Panel>

    <Border Grid.Row="2"
            Padding="8,4"
            Background="{DynamicResource PageBackground}">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource ScreenMirror_Back}"
                Margin="0,0,6,0"
                Click="OnBackClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Back}" />
        <Button Content="{DynamicResource ScreenMirror_Home}"
                Margin="0,0,6,0"
                Click="OnHomeClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Home}" />
        <Button Content="{DynamicResource ScreenMirror_Recents}"
                Margin="0,0,6,0"
                Click="OnRecentsClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Recents}" />
        <Button Content="{DynamicResource ScreenMirror_Power}"
                Margin="0,0,6,0"
                Click="OnPowerClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Power}" />
        <Button Content="{DynamicResource ScreenMirror_VolumeDown}"
                Margin="0,0,6,0"
                Click="OnVolumeDownClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_VolumeDown}" />
        <Button Content="{DynamicResource ScreenMirror_VolumeUp}"
                Margin="0,0,6,0"
                Click="OnVolumeUpClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_VolumeUp}" />
        <Button Content="{DynamicResource ScreenMirror_PushClipboard}"
                Margin="0,0,6,0"
                Click="OnPushClipboardClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_PushClipboard}" />
        <Button Content="{DynamicResource ScreenMirror_PullClipboard}"
                Margin="0,0,6,0"
                Click="OnPullClipboardClick"
                AutomationProperties.Name="{DynamicResource ScreenMirror_PullClipboard}" />
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>
