<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:UotanStudio.ViewModels.Editors"
             xmlns:local="using:UotanStudio.Views.Editors"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:avalonia="https://irihi.tech/iconica/tdesign"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:DataType="vm:ScreenMirrorViewModel"
             x:Class="UotanStudio.Views.Editors.ScreenMirrorView"
             Focusable="True">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="8,4"
            Background="{DynamicResource PageBackground}">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{DynamicResource ScreenMirror_InputInjectionBlocked}"
                   IsVisible="{Binding InputInjectionBlocked}"
                   Foreground="{DynamicResource LogWarnBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Panel Grid.Row="1" Background="Black">
      <local:ScreenMirrorVideoControl x:Name="FrameImage"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" />
      <TextBlock x:Name="WaitingLabel"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="White"
                 FontSize="13"
                 Text="{Binding DeviceName}" />
    </Panel>

    <Border Grid.Row="2"
            Padding="6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <controls:JustifiedWrapPanel MinItemWidth="80" ItemSpacing="6" LineSpacing="6">
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnBackClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_Back}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Back}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:ChevronLeft Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_Back}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnHomeClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_Home}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Home}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:Home Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_Home}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnRecentsClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_Recents}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Recents}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:Layers Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_Recents}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnPowerClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_Power}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_Power}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:Poweroff Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_Power}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnVolumeDownClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_VolumeDown}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_VolumeDown}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:SoundDown Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_VolumeDown}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnVolumeUpClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_VolumeUp}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_VolumeUp}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:SoundUp Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_VolumeUp}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnPushClipboardClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_PushClipboard}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_PushClipboard}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:Upload Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_PushClipboard}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
        <Button MinWidth="80" Padding="6,4" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Click="OnPullClipboardClick"
                ToolTip.Tip="{DynamicResource ScreenMirror_PullClipboard}"
                AutomationProperties.Name="{DynamicResource ScreenMirror_PullClipboard}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <avalonia:Download Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ScreenMirror_PullClipboard}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" MaxLines="2" />
          </Grid>
        </Button>
      </controls:JustifiedWrapPanel>
    </Border>
  </Grid>
</UserControl>