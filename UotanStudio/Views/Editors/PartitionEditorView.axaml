<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             xmlns:controls="using:UotanStudio.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.PartitionEditorView"
             x:DataType="viewmodels:PartitionEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.band-segment">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.band-segment.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.band-label">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <DockPanel IsEnabled="{Binding !IsBusy}">
    <!-- 顶部工具栏：数据源描述 -->
    <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <!-- 镜像携带多份分区表时提供切换选择器。 -->
        <ComboBox DockPanel.Dock="Right" MinWidth="180" Margin="8,0,0,0" FontSize="11"
                  IsVisible="{Binding HasTableCopies}"
                  ItemsSource="{Binding TableCopies}"
                  SelectedItem="{Binding SelectedTableCopy, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionTableCopyItemViewModel">
              <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding SourceDescription}"
                   VerticalAlignment="Center"
                   FontSize="11" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 顶部错误提示条：与 FileManager 编辑器同一套样式。 -->
    <!-- Top error banner: same styling as the FileManager editor. -->
    <Border Classes="error-banner" DockPanel.Dock="Top"
            IsVisible="{Binding CompileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="error-banner" Text="{Binding CompileError}" />
    </Border>

    <!-- GNOME Disks 风格的可视化分区段布局：条带 + 对齐标签行。 -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
            <Button Content="{x:Static viewmodels:PartitionEditorViewModel.AddLabel}"
                    Command="{Binding AddPartitionCommand}" Padding="10,2" />
            <Button Content="{x:Static viewmodels:PartitionEditorViewModel.RemoveLabel}"
                    Command="{Binding RemovePartitionCommand}" Padding="10,2" />
          </StackPanel>
          <TextBlock Text="{Binding CapacityText}" VerticalAlignment="Center"
                     FontSize="11" Opacity="0.8" FontFamily="Consolas"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 条带段：宽度按扇区占比；点击联动选中分区。 -->
        <ItemsControl Height="34" ItemsSource="{Binding Segments}" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:PartitionBandPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionSegmentViewModel">
              <Border Background="{Binding Fill}" CornerRadius="3" ClipToBounds="True"
                      Classes.band-segment="True" Classes.selected="{Binding IsSelected}"
                      PointerPressed="OnSegmentPointerPressed"
                      ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Text="{Binding Text}" Margin="6,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#F4F7FB" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 标签行：与条带共用同一份段几何，逐段对齐。 -->
        <ItemsControl ItemsSource="{Binding Segments}" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:PartitionBandPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionSegmentViewModel">
              <Border Classes="band-label" ClipToBounds="True"
                      PointerPressed="OnSegmentPointerPressed"
                      ToolTip.Tip="{Binding Tooltip}">
                <StackPanel Spacing="0" Margin="1,0">
                  <TextBlock Text="{Binding LabelText}" FontSize="10"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding OffsetText}" FontSize="9" Opacity="0.6"
                             FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 左：分区列表；右：选中分区属性编辑 -->
    <Grid ColumnDefinitions="280,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="6,4" FontSize="11" Opacity="0.7"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PartitionsLabel}" />
          <TreeView x:Name="PartitionTree"
                    ItemsSource="{Binding Partitions}"
                    SelectedItem="{Binding SelectedPartition, Mode=TwoWay}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="viewmodels:PartitionItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontFamily="Consolas" />
                  <TextBlock Text="{Binding Size, StringFormat='({0})'}"
                             FontSize="10" Opacity="0.6" FontFamily="Consolas" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <Border Grid.Column="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="6,4" FontSize="11" Opacity="0.7"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PropertiesLabel}" />
          <TextBlock Text="{x:Static viewmodels:PartitionEditorViewModel.NoSelectionLabel}"
                     Margin="8,8,0,0" Opacity="0.6"
                     IsVisible="{Binding HasSelection, Converter={x:Static BoolConverters.Not}}" />
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Margin="8" Spacing="6">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.NameLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Name, Mode=TwoWay}" FontFamily="Consolas" />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.StartLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Start, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.SizeLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Size, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.TypeLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Type, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.TypeHintLabel}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>