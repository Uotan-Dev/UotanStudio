<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.PartitionEditorView"
             x:DataType="viewmodels:PartitionEditorViewModel">
  <DockPanel IsEnabled="{Binding !IsBusy}">
    <!-- 顶部工具栏：数据源描述 -->
    <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock Text="{Binding SourceDescription}"
                   VerticalAlignment="Center"
                   FontSize="11" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 顶部错误提示条：与 FileManager 编辑器同一套样式。 -->
    <!-- Top error banner: same styling as the FileManager editor. -->
    <Border Classes="error-banner" DockPanel.Dock="Top"
            IsVisible="{Binding CompileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="error-banner" Text="{Binding CompileError}" />
    </Border>

    <!-- 左：分区列表；右：选中分区属性编辑 -->
    <Grid ColumnDefinitions="280,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="6,4" FontSize="11" Opacity="0.7"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PartitionsLabel}" />
          <TreeView x:Name="PartitionTree"
                    ItemsSource="{Binding Partitions}"
                    SelectedItem="{Binding SelectedPartition, Mode=TwoWay}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="viewmodels:PartitionItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontFamily="Consolas" />
                  <TextBlock Text="{Binding Size, StringFormat='({0})'}"
                             FontSize="10" Opacity="0.6" FontFamily="Consolas" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <Border Grid.Column="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Padding="6,4" FontSize="11" Opacity="0.7"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PropertiesLabel}" />
          <TextBlock Text="{x:Static viewmodels:PartitionEditorViewModel.NoSelectionLabel}"
                     Margin="8,8,0,0" Opacity="0.6"
                     IsVisible="{Binding HasSelection, Converter={x:Static BoolConverters.Not}}" />
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Margin="8" Spacing="6">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.NameLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Name, Mode=TwoWay}" FontFamily="Consolas" />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.StartLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Start, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.SizeLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Size, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static viewmodels:PartitionEditorViewModel.TypeLabel}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedPartition.Type, Mode=TwoWay}" FontFamily="Consolas"
                         PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.TypeHintLabel}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>