<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:icons="https://irihi.tech/iconica/tdesign"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.PartitionEditorView"
             x:DataType="viewmodels:PartitionEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.band-segment">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.band-segment.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.band-label">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 顶栏紧凑控件：与日志窗口顶栏同尺寸（ComboBox 高 22 / 字号 11，按钮 20×20，搜索框高 22）。
         顶栏内边距固定 8,4，页面首行高度与其它编辑器一致。 -->
    <!-- Compact top-bar controls, matching the log window's toolbar (22px combo at 11px text, 20×20
         buttons, 22px search box). The strip padding is fixed at 8,4 so the first row keeps the same
         height as every other editor page. -->
    <Style Selector="ComboBox.Small">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Small">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.Small">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 栏目标题（分区 / 属性）与 Logo 分区页次标题统一字号与字重。 -->
    <!-- Column headings (Partitions / Properties) match the Logo partition subheadings. -->
    <Style Selector="TextBlock.pane-title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.field-value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <!-- 分区列表行：主题把行内边距写死在 TreeViewItemPadding 资源上（ContentPresenter 优先取该资源，
         而不是控件自己的 Padding），所以真正有效的压缩手段是在下方 TreeView.Resources 里覆盖该资源。
         这里再用后代选择器清掉 MinHeight 与控件自带 Padding 的叠加。 -->
    <!-- Partition rows: the theme hard-codes the row inset in the TreeViewItemPadding resource (the
         ContentPresenter prefers that resource over the control's own Padding), so the effective fix is
         overriding it in the TreeView.Resources block below. This style additionally clears MinHeight and
         the control's own Padding so nothing stacks on top of it. -->
    <Style Selector="TreeView.partition-tree TreeViewItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- 容量摘要：与次标题统一字号与字重。 -->
    <!-- Capacity summary: matches the subheading font size and weight. -->
    <Style Selector="TextBlock.capacity">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <DockPanel IsEnabled="{Binding !IsBusy}">
    <!-- 顶部标题栏：标题 + 数据源描述 + 表副本选择器。 -->
    <!-- Top header: title, data-source description, and the table-copy selector. -->
    <Border DockPanel.Dock="Top" Padding="16,12,16,4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Dock_Partition_Title}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SourceDescription}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding SourceDescription}" Opacity="0.7" />
        </StackPanel>
        <ComboBox Grid.Column="1" Classes="Small" MinWidth="180"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasTableCopies}"
                  ItemsSource="{Binding TableCopies}"
                  SelectedItem="{Binding SelectedTableCopy, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionTableCopyItemViewModel">
              <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>

    <!-- 顶部错误提示条：与 FileManager 编辑器同一套样式。 -->
    <!-- Top error banner: same styling as the FileManager editor. -->
    <Border Classes="error-banner" DockPanel.Dock="Top"
            IsVisible="{Binding CompileError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="error-banner" Text="{Binding CompileError}" />
    </Border>

    <!-- GNOME Disks 风格的可视化分区段布局：容量摘要与增删按钮在条带正上方（间距 4），
         与顶栏之间隔一条分隔线和 3px 内边距，按钮因此既不贴住下拉框，也不远离彩色条带。 -->
    <!-- GNOME Disks style visual partition band: the capacity summary and the add/remove buttons sit
         directly above the band (4px gap); a separator and 3px padding separate them from the toolbar
         above, so the buttons neither hug the combo box nor drift away from the coloured band. -->
    <Border DockPanel.Dock="Top" Padding="16,3,16,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <DockPanel LastChildFill="False">
          <!-- 图标按钮：与日志窗口顶栏的清空日志按钮同规格（20×20，图标 12）。 -->
          <!-- Icon buttons, sized like the log window's clear-log button (20×20 with a 12px icon). -->
          <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button Classes="Small" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="2"
                    Command="{Binding AddPartitionCommand}"
                    ToolTip.Tip="{x:Static viewmodels:PartitionEditorViewModel.AddLabel}"
                    AutomationProperties.Name="{x:Static viewmodels:PartitionEditorViewModel.AddLabel}">
              <icons:Add Width="12" Height="12" />
            </Button>
            <Button Classes="Small" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="2"
                    Command="{Binding RemovePartitionCommand}"
                    ToolTip.Tip="{x:Static viewmodels:PartitionEditorViewModel.RemoveLabel}"
                    AutomationProperties.Name="{x:Static viewmodels:PartitionEditorViewModel.RemoveLabel}">
              <icons:Delete Width="12" Height="12" />
            </Button>
          </StackPanel>
          <TextBlock Classes="capacity" Text="{Binding CapacityText}" />
        </DockPanel>

        <!-- 条带段：宽度按扇区占比；点击联动选中分区。 -->
        <ItemsControl Height="34" ItemsSource="{Binding Segments}" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:PartitionBandPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionSegmentViewModel">
              <Border Background="{Binding Fill}" CornerRadius="3" ClipToBounds="True"
                      Classes.band-segment="True" Classes.selected="{Binding IsSelected}"
                      PointerPressed="OnSegmentPointerPressed"
                      ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Text="{Binding Text}" Margin="6,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#F4F7FB" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 标签行：与条带共用同一份段几何，逐段对齐。 -->
        <ItemsControl ItemsSource="{Binding Segments}" ClipToBounds="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:PartitionBandPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:PartitionSegmentViewModel">
              <Border Classes="band-label" ClipToBounds="True"
                      PointerPressed="OnSegmentPointerPressed"
                      ToolTip.Tip="{Binding Tooltip}">
                <StackPanel Spacing="0" Margin="1,0">
                  <TextBlock Text="{Binding LabelText}" FontSize="10"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding OffsetText}" FontSize="9" Opacity="0.6"
                             FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 左：分区列表（含搜索）；右：选中分区属性编辑 -->
    <Grid ColumnDefinitions="280,*" Margin="16,0,16,16">
      <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="pane-title" Margin="0,6,8,4"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PartitionsLabel}" />
          <TextBox DockPanel.Dock="Top" Classes="Small" Margin="0,0,8,4"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.SearchLabel}"
                   AutomationProperties.Name="{x:Static viewmodels:PartitionEditorViewModel.SearchLabel}">
            <TextBox.InnerRightContent>
              <!-- 清除按钮不带提示文本，避免与搜索占位文本重复。 -->
              <Button Classes="Small" Width="18" Height="18" MinHeight="0" Padding="2"
                      Command="{Binding ClearSearchCommand}">
                <TextBlock Text="&#x2715;" FontSize="9" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <TextBlock DockPanel.Dock="Top" Margin="0,0,8,4" FontSize="11" Opacity="0.6"
                     IsVisible="{Binding HasNoSearchResult}"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.NoSearchResultLabel}" />
          <TreeView x:Name="PartitionTree" Classes="partition-tree"
                    ItemsSource="{Binding VisiblePartitions}"
                    SelectedItem="{Binding SelectedPartition, Mode=TwoWay}">
            <!-- 主题默认行内边距 0 4 8 4（上下各 4），压成上下各 1 让列表更密。 -->
            <!-- The theme's row inset is 0 4 8 4 (4px top and bottom); 1px each keeps the list compact. -->
            <TreeView.Resources>
              <Thickness x:Key="TreeViewItemPadding">0 1 8 1</Thickness>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="viewmodels:PartitionItemViewModel">
                <!-- 名称与括号内大小同基线：同一 TextBlock 的 Run 序列，去掉独立 TextBlock 造成的错位。 -->
                <!-- Name and its parenthesised size share one baseline via runs in a single TextBlock,
                     which removes the misalignment of two separate TextBlocks. -->
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Name}" FontFamily="Consolas" FontSize="13" />
                  <Run Text=" (" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Run Text="{Binding Size}" FontFamily="Consolas" FontSize="11" />
                  <Run Text=")" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <Border Grid.Column="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="pane-title" Margin="8,6,0,4"
                     Text="{x:Static viewmodels:PartitionEditorViewModel.PropertiesLabel}" />
          <TextBlock Text="{x:Static viewmodels:PartitionEditorViewModel.NoSelectionLabel}"
                     Margin="8,8,0,0" FontSize="13" Opacity="0.6"
                     IsVisible="{Binding HasSelection, Converter={x:Static BoolConverters.Not}}" />
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Margin="8,8,0,0" Spacing="6">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.NameLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.Name, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.StartLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.Start, Mode=TwoWay}"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.StartBytesLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.StartBytes, Mode=TwoWay}"
                         PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.BytesHintLabel}" />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.SizeLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.Size, Mode=TwoWay}"
                         PlaceholderText="0x..." />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.SizeBytesLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.SizeBytes, Mode=TwoWay}"
                         PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.BytesHintLabel}" />
              </Grid>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"
                           Text="{x:Static viewmodels:PartitionEditorViewModel.TypeLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Classes="field-value"
                         Text="{Binding SelectedPartition.Type, Mode=TwoWay}"
                         PlaceholderText="{x:Static viewmodels:PartitionEditorViewModel.TypeHintLabel}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
