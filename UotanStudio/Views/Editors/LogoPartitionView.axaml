<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="UotanStudio.Views.Editors.LogoPartitionView"
             x:DataType="viewmodels:LogoPartitionViewModel">
    <!-- Logo partition workbench: embedded images + preview + extraction + related partitions. -->
    <!-- Logo 分区工作台：内嵌图片、预览、提取与相关分区。 -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Dock_Logo_Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FormatName}" FontSize="12" Opacity="0.8" />
            <TextBlock Text="{Binding MagicDescription}" FontSize="12" Opacity="0.6"
                       TextWrapping="Wrap" MaxLines="2" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,1.2*,*" ColumnSpacing="12">
            <!-- 内嵌图片条目 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="{DynamicResource Dock_Logo_Entries}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          SelectionMode="Single" AutoGenerateColumns="False"
                          CanUserResizeColumns="True" CanUserSortColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          IsReadOnly="True" RowHeight="34" Background="Transparent"
                          BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnName}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnDimensions}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Dimensions}" Margin="6,0" VerticalAlignment="Center"
                                               FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnEncoding}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Encoding}" Margin="6,0" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnSize}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding SizeText}" Margin="6,0" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Dock_Logo_ExtractSelected}"
                            Command="{Binding ExtractSelectedCommand}" FontSize="12" />
                    <Button Content="{DynamicResource Dock_Logo_ExtractAll}"
                            Command="{Binding ExtractAllCommand}" FontSize="12" />
                    <Button Content="{DynamicResource Dock_Logo_OpenImage}"
                            Command="{Binding OpenSelectedImageCommand}" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- 选中条目预览 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{DynamicResource Dock_Logo_Preview}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Grid.Row="1" BorderThickness="1"
                        BorderBrush="{DynamicResource SemiColorBorder}">
                    <Grid>
                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8"
                               IsVisible="{Binding HasPreview}" />
                        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding !HasPreview}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                                   Opacity="0.75" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 相关分区 -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="{DynamicResource Dock_Logo_Related}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox Grid.Row="1" ItemsSource="{Binding RelatedPartitions}"
                         SelectedItem="{Binding SelectedRelated, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="1"
                         BorderBrush="{DynamicResource SemiColorBorder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RelatedPartitionRow">
                            <StackPanel Margin="8,4" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.72" />
                                <TextBlock Text="{Binding Capability}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Dock_Logo_OpenPartition}"
                            Command="{Binding OpenRelatedCommand}"
                            CommandParameter="{Binding SelectedRelated}" FontSize="12" />
                    <Button Content="{DynamicResource Dock_Logo_Refresh}"
                            Command="{Binding RefreshRelatedCommand}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,10,0,0"
                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" />
    </Grid>
</UserControl>