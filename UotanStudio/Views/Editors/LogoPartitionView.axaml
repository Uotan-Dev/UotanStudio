<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="UotanStudio.Views.Editors.LogoPartitionView"
             x:DataType="viewmodels:LogoPartitionViewModel">
    <!-- Logo partition workbench: embedded images + preview + extraction and replacement. -->
    <!-- Logo 分区工作台：内嵌图片、预览与提取替换。 -->
    <DockPanel>
        <controls:EditorErrorBanner DockPanel.Dock="Top"
                                    Message="{Binding ErrorMessage, Mode=TwoWay}" />
        <Border DockPanel.Dock="Top" Padding="16,12,16,0">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Dock_Logo_Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubtitleText}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SubtitleText}" Opacity="0.7"
                           IsVisible="{Binding SubtitleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <Grid RowDefinitions="*,Auto" Margin="16,8,16,16">
            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="16" Grid.IsSharedSizeScope="True">
            <!-- 内嵌图片条目 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{DynamicResource Dock_Logo_Entries}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Dock_Logo_ExtractSelected}"
                                Command="{Binding ExtractSelectedCommand}" FontSize="12" />
                        <Button Content="{DynamicResource Dock_Logo_ExtractAll}"
                                Command="{Binding ExtractAllCommand}" FontSize="12" />
                        <Button Content="{DynamicResource Dock_Logo_OpenImage}"
                                Command="{Binding OpenSelectedImageCommand}" FontSize="12" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          SelectionMode="Single" AutoGenerateColumns="False"
                          CanUserResizeColumns="True" CanUserSortColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          IsReadOnly="True" RowHeight="34" Background="Transparent"
                          BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                          CornerRadius="6">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding $parent[DataGrid].((viewmodels:LogoPartitionViewModel)DataContext).IsAllSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          MinWidth="0" MinHeight="24" Padding="0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              MinWidth="0" MinHeight="24" Padding="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnName}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnDimensions}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Dimensions}" Margin="6,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnEncoding}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding Encoding}" Margin="6,0" VerticalAlignment="Center"
                                               Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnSize}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding SizeText}" Margin="6,0" VerticalAlignment="Center"
                                               Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Dock_Logo_ColumnBytes}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="viewmodels:LogoPartitionEntryItem">
                                    <TextBlock Text="{Binding BytesText}" Margin="6,0" VerticalAlignment="Center"
                                               Opacity="0.72" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Dock_Logo_ReplaceSelected}"
                            Command="{Binding ReplaceSelectedCommand}" FontSize="12" />
                    <Button Content="{DynamicResource Dock_Logo_AddImage}"
                            Command="{Binding AddImageCommand}" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- 选中条目预览 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Dock_Logo_Preview}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6" />
                <Border Grid.Row="1" BorderThickness="1"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8"
                               IsVisible="{Binding HasPreview}" />
                        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding !HasPreview}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                                   Opacity="0.75" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,10,0,0"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" />
        </Grid>
    </DockPanel>
</UserControl>