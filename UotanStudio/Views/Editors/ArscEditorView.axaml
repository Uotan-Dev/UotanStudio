<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:viewmodels="using:UotanStudio.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UotanStudio.Views.Editors.ArscEditorView"
             x:DataType="viewmodels:ArscEditorViewModel">
  <DockPanel>
    <!-- 顶部错误提示条：与对比视图同一套单行样式与关闭按钮（此窗口不含文件路径行）。 -->
    <!-- Top error banner: same single-line styling and dismiss button as the Compare view (this window has no file path row). -->
    <controls:EditorErrorBanner DockPanel.Dock="Top"
                                Message="{Binding CompileError, Mode=TwoWay}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="120" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="*" MinWidth="120" />
      </Grid.ColumnDefinitions>

      <!-- 左：包→类型→配置→条目资源树 -->
      <Border Grid.Column="0">
        <TreeView x:Name="ResourceTree"
                  ItemsSource="{Binding Nodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  SelectionChanged="OnTreeSelectionChanged">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="viewmodels:ArscTreeNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonospaceFontFamily}" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <Border Grid.Column="1"
              Width="3"
              HorizontalAlignment="Center"
              Background="{DynamicResource EditorPaneSplitterBackgroundBrush}"
              IsHitTestVisible="False" />
      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="SizeWestEast" />

      <!-- 右：选中节点详情 -->
      <DockPanel Grid.Column="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Details}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewmodels:ArscDetailRow">
                <controls:ResponsiveFormRow Margin="8,3"
                                            MinLabelWidth="88"
                                            MaxLabelWidth="88"
                                            MinEditorWidth="180"
                                            ColumnSpacing="2"
                                            RowSpacing="2">
                  <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonospaceFontFamily}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                  <TextBox Text="{Binding Value, Mode=TwoWay}" FontFamily="{StaticResource MonospaceFontFamily}"
                           IsReadOnly="{Binding IsEditable, Converter={x:Static BoolConverters.Not}}"
                           TextWrapping="Wrap" />
                </controls:ResponsiveFormRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>