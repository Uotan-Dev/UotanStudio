<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:controls="using:UotanStudio.Views.Controls"
             xmlns:vm="using:UotanStudio.ViewModels.Editors"
             x:Class="UotanStudio.Views.Editors.QualcommImageView"
             x:DataType="vm:QualcommImageViewModel">
    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="HeaderTemplate">
                <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                </DataTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <controls:EditorErrorBanner DockPanel.Dock="Top"
                                    Message="{Binding ErrorMessage, Mode=TwoWay}" />
        <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Dock_Qualcomm_Title}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding FilePath}" Opacity="0.7" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnSelectImage"
                            Content="{DynamicResource Dock_Qualcomm_ChooseImage}"
                            VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Dock_Qualcomm_TrustedRoot}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding TrustedRootPath, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Dock_Qualcomm_OptionalRoot}"
                             ToolTip.Tip="{DynamicResource Dock_Qualcomm_RootHint}" />
                    <Button Grid.Column="2" Click="OnSelectRoot"
                            Content="{DynamicResource Dock_Qualcomm_ChooseRoot}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="3" Command="{Binding AnalyzeCommand}"
                            Content="{DynamicResource Dock_Qualcomm_Analyze}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="4" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                            Content="{DynamicResource Dock_Qualcomm_Cancel}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnExport" IsEnabled="{Binding HasResults}"
                        Content="{DynamicResource Dock_Qualcomm_Export}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid>
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" IsVisible="{Binding HasResults}"
                        Margin="16,8,16,16">
                <TabItem Header="{DynamicResource Dock_Qualcomm_Overview}">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding OverviewRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" Background="Transparent"
                              BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                              CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:DataType="vm:QualcommRow" Header="{DynamicResource Dock_Qualcomm_Field}"
                                                Binding="{Binding Name}" Width="210" />
                            <DataGridTextColumn x:DataType="vm:QualcommRow" Header="{DynamicResource Dock_Qualcomm_Value}"
                                                Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource Dock_Qualcomm_Segments}">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding SegmentRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" FontFamily="{StaticResource MonospaceFontFamily}"
                              Background="Transparent" BorderThickness="1"
                              BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:DataType="vm:QualcommRow" Header="{DynamicResource Dock_Qualcomm_Field}"
                                                Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn x:DataType="vm:QualcommRow" Header="{DynamicResource Dock_Qualcomm_Value}"
                                                Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource Dock_Qualcomm_Metadata}">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding MetadataRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto"
                              Background="Transparent" BorderThickness="1"
                              BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Field}" Width="290">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="8,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Value}" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap"
                                                             Margin="8,4" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource Dock_Qualcomm_Verification}">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding VerificationRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" Background="Transparent"
                              BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                              CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Field}" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="8,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Value}" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="8,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource Dock_Qualcomm_Programmer}">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ProgrammerRows}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" Background="Transparent"
                              BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                              CornerRadius="6">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Field}" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="8,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Dock_Qualcomm_Value}" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:QualcommRow">
                                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="8,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
            <Border IsVisible="{Binding IsBusy}" IsHitTestVisible="{Binding IsBusy}" ZIndex="1"
                    Background="#A0000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <ProgressBar Width="220" IsIndeterminate="True" />
                    <TextBlock Text="{DynamicResource Dock_Qualcomm_Loading}"
                               Foreground="White" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
