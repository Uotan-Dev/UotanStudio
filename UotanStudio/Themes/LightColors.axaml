<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Themes.LightColors">
    <Color x:Key="PageBackground">#f2f2f6</Color>
    <Color x:Key="CardBackground">#fefefe</Color>
    <Color x:Key="TextForeground">#1a1a1a</Color>
    <Color x:Key="SecondaryTextForeground">#666666</Color>
    <Color x:Key="BorderForegroundColor">#e0e0e0</Color>
    <Color x:Key="AccentColor">#0078d4</Color>
    <Color x:Key="HexForeground">#1a1a1a</Color>
    <Color x:Key="HexOffsetForeground">#8a8a8a</Color>
    <Color x:Key="HexAsciiForeground">#5a5a5a</Color>
    <Color x:Key="HexHeaderForeground">#8a8a8a</Color>
    <Color x:Key="HexHeaderBackground">#e8e8ec</Color>
    <Color x:Key="HexSelectionBrush">#6659c2ff</Color>
    <Color x:Key="HexCaretBrush">#0078d4</Color>
    <Color x:Key="HexEditedBrush">#c0504d</Color>
    <SolidColorBrush x:Key="LogTraceBrush" Color="#666666" />
    <SolidColorBrush x:Key="LogDebugBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#FF9800" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF0000" />
    <SolidColorBrush x:Key="LogFatalBrush" Color="#9C27B0" />
    <!-- VS 风格编辑器分隔轨道：默认状态也与页面背景保持清晰对比。 -->
    <!-- VS-style editor splitter track with clear contrast in its resting state. -->
    <SolidColorBrush x:Key="EditorPaneSplitterBackgroundBrush" Color="#D6D8DC" />
    <SolidColorBrush x:Key="EditorPaneSplitterGripBrush" Color="#4F555D" />
    <!-- 二进制差异比对：差异行高亮画刷（浅暖色）与前景画刷。 -->
    <!-- Binary diff compare: diff-line highlight brush (light warm) and its foreground. -->
    <SolidColorBrush x:Key="DiffBackgroundBrush" Color="#FFF3D9" />
    <SolidColorBrush x:Key="DiffForegroundBrush" Color="#6B4A00" />

    <!-- Fluent 兼容键：次要文本画刷（Semi 主题未提供，视图多处 DynamicResource 引用；
         缺失时解析回退默认色导致不随主题切换）。取 SecondaryTextForeground 颜色。 -->
    <!-- Fluent-compatible key: secondary text brush (not provided by the Semi theme, yet
         referenced via DynamicResource in several views; when missing, resolution falls
         back to the default color and ignores theme switching). Uses SecondaryTextForeground. -->
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource SecondaryTextForeground}" />
</ResourceDictionary>
