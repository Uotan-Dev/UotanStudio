<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Dock.Model.Core"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:icons="https://irihi.tech/iconica/tdesign"
        xmlns:themes="using:UotanStudio.Themes">
    <Styles.Resources>
        <x:Double x:Key="DocumentTabStripMinHeight">26</x:Double>
        <x:Double x:Key="DocumentTabStripItemMinHeight">26</x:Double>
        <Thickness x:Key="DocumentTabStripItemPadding">8,0,6,0</Thickness>
    </Styles.Resources>

    <!-- Document tab strip styles: compact single row (26px), mouse wheel down or toggle button expands to multiple rows,
         mouse wheel up or toggle button collapses to a single row, and indicator bar aligns flush with document top divider. -->
    <!-- 文档标签栏样式：紧凑单行显示（26px），鼠标滚轮向下滚动或点击右侧按钮展开为多行，
         滚轮向上滚动或点击右侧按钮收起为单行，并消除指示条与文档顶部水平分割线之间的空隙。 -->
    <Style Selector="dock|DocumentControl">
        <Setter Property="CloseTemplate">
            <DataTemplate x:DataType="core:IDockable">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Name="PART_PinTabButton"
                            Classes="doc-tab-action pin"
                            Focusable="False">
                        <icons:Pin Width="12" Height="12" />
                    </Button>
                    <Button Name="PART_CloseTabButton"
                            Classes="doc-tab-action close"
                            Focusable="False"
                            IsVisible="{Binding CanClose}"
                            Command="{Binding Factory.CloseDockable}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{DynamicResource DockMenu_Close}"
                            AutomationProperties.Name="{DynamicResource DockMenu_Close}">
                        <icons:Close Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="dock|DocumentTabStrip">
        <Setter Property="themes:DocumentTabStripWheelHandler.EnableWheelExpand" Value="True" />
        <Setter Property="MouseWheelScrollOrientation" Value="Vertical" />
        <Setter Property="Template">
            <ControlTemplate TargetType="dock:DocumentTabStrip">
                <Grid Background="{TemplateBinding Background}" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                      Content="{TemplateBinding TopContent}"
                                      ContentTemplate="{TemplateBinding TopContentTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="0"
                                      Content="{TemplateBinding LeftContent}"
                                      ContentTemplate="{TemplateBinding LeftContentTemplate}" />
                    <ContentPresenter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                      Content="{TemplateBinding BottomContent}"
                                      ContentTemplate="{TemplateBinding BottomContentTemplate}" />
                    <ContentPresenter Grid.Row="1" Grid.Column="2"
                                      Content="{TemplateBinding RightContent}"
                                      ContentTemplate="{TemplateBinding RightContentTemplate}" />
                    <!-- PART_Panel 直接作为 Grid.Column="1" 的子元素，避免包裹 DockPanel。
                         Dock.Avalonia 内部若检测到 PART_Panel.Parent 为 DockPanel，会在 Detach 期间注销
                         Bounds 监听器且 Attach 时不再重新注册，导致面板最大化时 PART_Panel 仍残留小窗宽度的
                         陈旧 MaxWidth，进而在全屏下产生首标签异常向右居中偏移的现象。 -->
                    <!-- PART_Panel placed directly in Grid.Column="1" without an intermediate DockPanel wrapper.
                         When PART_Panel.Parent is a DockPanel, Dock.Avalonia subscribes to Bounds on DockPanel,
                         clears the observables on DetachedFromVisualTree and never reattaches them, leaving a
                         stale MaxWidth from the small-window state that centers the tab host horizontally. -->
                    <Panel Name="PART_Panel"
                           Grid.Row="1"
                           Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="0"
                                      Margin="0"
                                      VerticalAlignment="Bottom"
                                      VerticalContentAlignment="Bottom">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                        <Border Name="PART_BorderFill" IsHitTestVisible="False" />
                        <ContentControl Name="PART_CreateButtonHost" IsHitTestVisible="False" />
                        <Panel Name="PART_TrailingFill" IsHitTestVisible="False" />
                    </Panel>
                    <Button Name="PART_ExpandToggleButton"
                            Grid.Row="1"
                            Grid.Column="3"
                            Focusable="False"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center">
                        <Panel Width="14" Height="14">
                            <icons:ChevronDown Name="PART_ExpandIcon" Width="14" Height="14" />
                            <icons:ChevronUp Name="PART_CollapseIcon" Width="14" Height="14" />
                        </Panel>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="dock|DocumentTabStrip /template/ Button#PART_ExpandToggleButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,2,4,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="ToolTip.Tip" Value="{DynamicResource Dock_ExpandTabs}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Dock_ExpandTabs}" />
    </Style>

    <Style Selector="dock|DocumentTabStrip[Orientation=Horizontal].has-overflow /template/ Button#PART_ExpandToggleButton">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="dock|DocumentTabStrip[Orientation=Horizontal].expanded /template/ Button#PART_ExpandToggleButton">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="dock|DocumentTabStrip /template/ Button#PART_ExpandToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
    </Style>

    <Style Selector="dock|DocumentTabStrip /template/ Button#PART_ExpandToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
    </Style>

    <Style Selector="dock|DocumentTabStrip.expanded /template/ Button#PART_ExpandToggleButton">
        <Setter Property="ToolTip.Tip" Value="{DynamicResource Dock_CollapseTabs}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Dock_CollapseTabs}" />
    </Style>

    <Style Selector="dock|DocumentTabStrip /template/ icons|ChevronDown#PART_ExpandIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="dock|DocumentTabStrip /template/ icons|ChevronUp#PART_CollapseIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="dock|DocumentTabStrip.expanded /template/ icons|ChevronDown#PART_ExpandIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="dock|DocumentTabStrip.expanded /template/ icons|ChevronUp#PART_CollapseIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="dock|DocumentTabStrip[Orientation=Horizontal]">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="dock|DocumentTabStrip[Orientation=Vertical]">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <!-- 默认单行状态：最大高度限制为单行（26px），必须指定 [Orientation=Horizontal] 以精确覆盖 Semi 默认样式 -->
    <!-- Default single-row state: max height capped at 1 row (26px), with [Orientation=Horizontal] to override Semi theme. -->
    <Style Selector="dock|DocumentTabStrip[Orientation=Horizontal] /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="MaxHeight" Value="{DynamicResource DocumentTabStripMinHeight}" />
    </Style>

    <!-- 滚轮向下滚动展开的多行状态：具体最大高度由 DocumentTabStripWheelHandler 按容器高度与行高整数倍动态计算 -->
    <!-- Expanded multi-row state: max height is computed dynamically by DocumentTabStripWheelHandler as an integer row multiple. -->
    <Style Selector="dock|DocumentTabStrip[Orientation=Horizontal].expanded /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem">
        <Setter Property="MinHeight" Value="{DynamicResource DocumentTabStripMinHeight}" />
        <Setter Property="Height" Value="{DynamicResource DocumentTabStripMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DocumentTabStripItemPadding}" />
    </Style>

    <!-- 文档标签行内操作按钮（固定 / 关闭）：默认隐藏不占视觉干扰，悬浮到对应标签时显示；已固定标签的固定按钮常显。 -->
    <!-- Inline document tab action buttons (pin / close): hidden at rest, revealed on tab hover; pinned tabs keep pin visible. -->
    <Style Selector="dock|DocumentTabStripItem Button.doc-tab-action">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem Button.doc-tab-action.pin">
        <Setter Property="ToolTip.Tip" Value="{DynamicResource Dock_PinTab}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Dock_PinTab}" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem:pointerover Button.doc-tab-action, dock|DocumentTabStripItem:selected Button.doc-tab-action">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem.pinned Button.doc-tab-action.pin">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="ToolTip.Tip" Value="{DynamicResource Dock_UnpinTab}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Dock_UnpinTab}" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem Button.doc-tab-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem Button.doc-tab-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
    </Style>

    <Style Selector="dock|DocumentTabStripItem.pinned Button.doc-tab-action.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
</Styles>