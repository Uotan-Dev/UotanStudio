<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UotanStudio.Themes.DarkColors">
    <Color x:Key="PageBackground">#1c1c1e</Color>
    <Color x:Key="CardBackground">#2c2c2e</Color>
    <Color x:Key="TextForeground">#fefefe</Color>
    <Color x:Key="SecondaryTextForeground">#999999</Color>
    <Color x:Key="BorderForegroundColor">#3a3a3c</Color>
    <Color x:Key="AccentColor">#4cc2ff</Color>
    <Color x:Key="HexForeground">#ffffff</Color>
    <Color x:Key="HexOffsetForeground">#7f8fa6</Color>
    <Color x:Key="HexAsciiForeground">#8fbf8f</Color>
    <Color x:Key="HexHeaderForeground">#9a9a9a</Color>
    <Color x:Key="HexHeaderBackground">#00000000</Color>
    <Color x:Key="HexSelectionBrush">#6659c2ff</Color>
    <Color x:Key="HexCaretBrush">#4cc2ff</Color>
    <Color x:Key="HexEditedBrush">#ff8a80</Color>
    <!-- VS 风格编辑器分隔轨道：默认状态也与页面背景保持清晰对比。 -->
    <!-- VS-style editor splitter track with clear contrast in its resting state. -->
    <SolidColorBrush x:Key="EditorPaneSplitterBackgroundBrush" Color="#36363A" />
    <SolidColorBrush x:Key="EditorPaneSplitterGripBrush" Color="#D0D2D6" />
    <!-- 二进制差异比对：差异行高亮画刷（深暖色）与前景画刷。 -->
    <!-- Binary diff compare: diff-line highlight brush (dark warm) and its foreground. -->
    <SolidColorBrush x:Key="DiffBackgroundBrush" Color="#5A3A00" />
    <SolidColorBrush x:Key="DiffForegroundBrush" Color="#FFE1A8" />

    <!-- Fluent 兼容键：次要文本画刷（Semi 主题未提供，视图多处 DynamicResource 引用；
         缺失时解析回退默认色导致不随主题切换）。取 SecondaryTextForeground 颜色。 -->
    <!-- Fluent-compatible key: secondary text brush (not provided by the Semi theme, yet
         referenced via DynamicResource in several views; when missing, resolution falls
         back to the default color and ignores theme switching). Uses SecondaryTextForeground. -->
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource SecondaryTextForeground}" />
</ResourceDictionary>
