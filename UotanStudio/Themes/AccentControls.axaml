<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:iri="https://irihi.tech/shared"
        xmlns:u="https://irihi.tech/ursa">
    <!-- 按钮与分段单选的状态补丁：Semi 只为悬浮/选中提供底色键，没有悬浮前景键，
         这里把普通主色悬浮（以及按下）按钮的文字与图标统一成纯白，配合主色底使用；
         文档标签行内操作按钮、标签栏展开按钮以及窗口标题栏按钮使用各自的中性/关闭底色，不套用主色悬浮前景。 -->
    <!-- State patch for buttons and segmented radios: Semi only ships background keys for hover/selection, so
         hover/pressed text/icon colour is set to pure white for accent-filled buttons. Inline document-tab
         action buttons, the tab-strip toggle button, and window caption buttons use their own fills instead. -->
    <Style Selector="Button:not(.doc-tab-action):not(.tab-strip-expand-toggle):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverForeground}" />
    </Style>
    <Style Selector="Button:not(.doc-tab-action):not(.tab-strip-expand-toggle):pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverForeground}" />
    </Style>

    <!-- 窗口标题栏按钮（最小化 / 最大化与还原 / 全屏）：悬浮与按下保持纯色前景，不泛红。 -->
    <!-- Window caption buttons (minimize / maximize-restore / fullscreen): keep solid neutral foreground on hover/press. -->
    <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MinimizeButton]:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MaximizeButton]:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MinimizeButton]:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=MaximizeButton]:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
    </Style>

    <!-- 窗口关闭按钮：浅色与深色模式下悬浮均为纯正红色底 + 纯白图标，消除深色模式下的泛白遮罩感。 -->
    <!-- Window close button: crisp opaque red fill with pure white icon in both light and dark modes. -->
    <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=CloseButton]:pointerover">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePointeroverBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=CloseButton]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePointeroverBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=CloseButton]:pressed">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePressedBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button[(chrome|WindowDecorationProperties.ElementRole)=CloseButton]:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CaptionButtonClosePressedBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource CaptionButtonCloseForeground}" />
    </Style>

    <!-- 复选框：悬浮与选中的方框改用主色（Semi 的悬浮边框键不会跟着调色板走，这里显式指定）。 -->
    <!-- Check box: hover and checked states use the accent (Semi's hover border key does not follow the palette). -->
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimaryPointerover}" />
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
    </Style>

    <!-- 单选框：圆环与圆点同样跟随主色。 -->
    <!-- Radio button: ring and dot follow the accent as well. -->
    <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="Fill" Value="{DynamicResource SemiColorPrimaryLight}" />
    </Style>
    <Style Selector="RadioButton:checked:pointerover /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimaryPointerover}" />
        <Setter Property="Fill" Value="{DynamicResource SemiColorPrimaryPointerover}" />
    </Style>

    <!-- 镜像文件管理上方的三个分段单选按钮：悬浮与选中都是主色底 + 浅色文字。 -->
    <!-- The three segmented radio buttons above the image list: accent fill with light text on hover/selection. -->
    <Style Selector="RadioButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverForeground}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverForeground}" />
    </Style>

    <!-- 未保存修改提示框：只让「保存」保持主色实心，「放弃修改」与「取消」同为中性按钮。 -->
    <!-- Unsaved-changes prompt: only "Save" keeps the accent solid fill; "Discard" matches the neutral "Cancel". -->
    <Style Selector="u|MessageBoxWindow.unsaved-changes-dialog /template/ Button#PART_NoButton">
        <Setter Property="Theme" Value="{DynamicResource {x:Type Button}}" />
        <Setter Property="iri:ClassHelper.Classes" Value="Tertiary" />
    </Style>
</Styles>
