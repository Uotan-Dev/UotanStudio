<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="UotanStudio.Pages.DeviceView"
             x:DataType="vm:DeviceViewModel">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Height="40" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding RefreshDevicesCommand}"
                        IsEnabled="{Binding !IsRefreshing}"
                        ToolTip.Tip="{DynamicResource Device_Refresh}">
                    <avalonia:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                </Button>
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_Connect}">
                    <avalonia:MaterialIcon Kind="LinkVariant" Width="16" Height="16" Foreground="Green" />
                </Button>
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_Disconnect}">
                    <avalonia:MaterialIcon Kind="LinkOff" Width="16" Height="16" Foreground="Red" />
                </Button>
                <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                        Margin="4,0" />
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding RebootCommand}"
                        CommandParameter="system"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_Reboot}">
                    <avalonia:MaterialIcon Kind="Restart" Width="16" Height="16" />
                </Button>
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding RebootCommand}"
                        CommandParameter="bootloader"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_RebootBootloader}">
                    <avalonia:MaterialIcon Kind="FastForward" Width="16" Height="16" />
                </Button>
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding RebootCommand}"
                        CommandParameter="recovery"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_RebootRecovery}">
                    <avalonia:MaterialIcon Kind="HospitalBoxOutline" Width="16" Height="16" />
                </Button>
                <Button Width="28" Height="28" Padding="0"
                        Command="{Binding RebootCommand}"
                        CommandParameter="edl"
                        IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{DynamicResource Device_RebootEdl}">
                    <avalonia:MaterialIcon Kind="DownloadOutline" Width="16" Height="16" />
                </Button>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Margin="8,0" />
            </StackPanel>
        </Border>

        <!-- 设备详情面板 -->
        <Border DockPanel.Dock="Bottom" Height="80" Padding="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding DeviceDetail}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- 统一设备列表 + 空状态提示（ADB/Fastboot/EDL/RKDL 不分组，统一管理） -->
        <Grid Margin="8">
            <!-- 空状态提示 -->
            <StackPanel IsVisible="{Binding HasNoDevices}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock Text="{DynamicResource Device_NoDevices}"
                           FontSize="14" Opacity="0.7"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Device_EmptyHint}"
                           FontSize="12" Opacity="0.5"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 全部设备 -->
            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     IsVisible="{Binding HasNoDevices, Converter={x:Static BoolConverters.Not}}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceInfo}">
                        <StackPanel Spacing="2" Margin="6,4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding State}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding Mode}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding Transport}" FontSize="11" Opacity="0.5" />
                                <TextBlock Text="Android {Binding AndroidVersion}" FontSize="11" Opacity="0.6"
                                           IsVisible="{Binding AndroidVersion, Converter={StaticResource StringNotNullOrEmptyConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
