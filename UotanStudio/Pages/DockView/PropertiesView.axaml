<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:UotanStudio.ViewModels"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="UotanStudio.Pages.DockView.PropertiesView"
    x:DataType="viewmodels:PropertiesViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- 标题栏 -->
    <Border Grid.Row="0" Padding="8,6"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <avalonia:MaterialIcon DockPanel.Dock="Left" Kind="InformationOutline" Width="14" Height="14"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}" />
        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Dock_Properties_Title}"
                   FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SelectedNodeTitle}"
                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" Margin="8,0,0,0"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasSelection}" />
      </DockPanel>
    </Border>

    <!-- 无选择占位 -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                IsVisible="{Binding !HasSelection}">
      <avalonia:MaterialIcon Kind="CursorDefaultClickOutline" Width="32" Height="32" Opacity="0.3"
                             HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource Dock_Properties_NoSelection}"
                 FontSize="12" Opacity="0.5" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- 属性列表：ScrollViewer + 行模板。
         每行左侧固定宽度属性名，右侧属性值列（*）自适应面板宽度铺满到最右，
         单行显示，超出省略，鼠标悬停 ToolTip 展示完整内容。 -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelection}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="8,6,8,6" Spacing="2">
        <!-- 内容类型标签 -->
        <Border Padding="6,3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,6">
          <TextBlock FontSize="10" Opacity="0.7" FontWeight="SemiBold"
                     Text="{Binding ContentTypeDisplay}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Properties}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="viewmodels:PropertiesViewModel+PropertyRow">
              <!-- 根 Grid 必须横向拉伸，使“*”值列真正铺满面板宽度 -->
              <Grid ColumnDefinitions="130,*" Margin="0,2" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="6,3" CornerRadius="3" Margin="0,0,4,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                             Opacity="0.75" VerticalAlignment="Center"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                             ToolTip.Tip="{Binding Name}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Stretch"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                           ToolTip.Tip="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
