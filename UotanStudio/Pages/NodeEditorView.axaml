<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels"
             xmlns:nodify="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia"
             xmlns:nodeVm="using:UotanStudio.ViewModels.NodeViewModels"
             xmlns:svc="using:UotanStudio.Services"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="UotanStudio.Pages.NodeEditorView"
             x:DataType="vm:NodeEditorViewModel">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Height="40" Padding="8,4"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- 左侧: 搜索框 -->
                <TextBox DockPanel.Dock="Left" Width="200" Height="28"
                         PlaceholderText="{DynamicResource Node_SearchNodes}"
                         Text="{Binding SearchText}"
                         VerticalAlignment="Center" />

                <!-- 右侧: 缩放控制 + 小地图开关 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Spacing="4">
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip.Tip="{DynamicResource Node_ZoomOut}">
                        <avalonia:MaterialIcon Kind="Minus" Width="16" Height="16" />
                    </Button>
                    <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}"
                               VerticalAlignment="Center" Width="50"
                               TextAlignment="Center" FontSize="12" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ZoomInCommand}"
                            ToolTip.Tip="{DynamicResource Node_ZoomIn}">
                        <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ResetZoomCommand}"
                            ToolTip.Tip="{DynamicResource Node_ResetZoom}">
                        <avalonia:MaterialIcon Kind="Magnify" Width="16" Height="16" />
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="4,0" />
                    <ToggleButton Width="28" Height="28" Padding="0"
                                  IsChecked="{Binding ShowMinimap}"
                                  ToolTip.Tip="{DynamicResource Node_ToggleMinimap}">
                        <avalonia:MaterialIcon Kind="Map" Width="16" Height="16" />
                    </ToggleButton>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                            Margin="4,0" />
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding DeleteSelectedCommand}"
                            ToolTip.Tip="{DynamicResource Node_DeleteSelected}">
                        <avalonia:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding ClearAllCommand}"
                            ToolTip.Tip="{DynamicResource Node_ClearAll}">
                        <avalonia:MaterialIcon Kind="TrashOutline" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- 中间: 运行控制 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="4">
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding RunCommand}"
                            ToolTip.Tip="{DynamicResource Node_Run}">
                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="Green" />
                    </Button>
                    <Button Width="28" Height="28" Padding="0"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="{DynamicResource Node_Stop}">
                        <avalonia:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="Red" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Height="24" Padding="8,2"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ExecutionStatus}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding Zoom, StringFormat='{}{0:P0}'}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_NodesLabel}" />
                    <Run Text=" | " />
                    <Run Text="{Binding Connections.Count, Mode=OneWay}" />
                    <Run Text="{DynamicResource Node_ConnectionsLabel}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 左侧工具箱 + 日志面板 -->
        <Border DockPanel.Dock="Left" Width="260"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 工具箱区(上方,占自然高) -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Toolbox}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Margin="8,8,8,4" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ToolboxCategories}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NodeToolboxCategory}">
                                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="8,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NodeToolboxItem}">
                                                        <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Padding="6,4" Margin="0,1"
                                                                IsVisible="{Binding IsVisible}"
                                                                Click="OnToolboxItemClicked">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 日志面板区(下方,填满剩余) -->
                <DockPanel DataContext="{Binding ToolboxLog}" Margin="0">
                    <!-- 日志面板顶部:标题 + 工具按钮 -->
                    <Border DockPanel.Dock="Top" Padding="8,4,8,4"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Node_LogPanel}"
                                       FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ToggleButton DockPanel.Dock="Right" Padding="4,2" Margin="4,0,0,0"
                                          IsChecked="{Binding IsPaused}"
                                          ToolTip.Tip="{DynamicResource Node_LogTogglePause}"
                                          VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="Pause" Width="14" Height="14" />
                            </ToggleButton>
                            <Button DockPanel.Dock="Right" Padding="4,2" Margin="4,0,0,0"
                                    Command="{Binding ClearActiveCommand}"
                                    ToolTip.Tip="{DynamicResource Node_LogClearActive}"
                                    VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                            </Button>
                            <ToggleButton DockPanel.Dock="Right" Padding="4,2" Margin="4,0,0,0"
                                          IsChecked="{Binding AutoScroll}"
                                          ToolTip.Tip="{DynamicResource Node_LogAutoScroll}"
                                          VerticalAlignment="Center">
                                <avalonia:MaterialIcon Kind="ArrowDownBold" Width="14" Height="14" />
                            </ToggleButton>
                            <TextBox DockPanel.Dock="Right" Width="90" Padding="4,2"
                                     PlaceholderText="{DynamicResource Node_LogFilterPlaceholder}"
                                     Text="{Binding Filter}"
                                     VerticalAlignment="Center" FontSize="11" />
                        </DockPanel>
                    </Border>

                    <!-- 分类切换栏 -->
                    <Border DockPanel.Dock="Top" Padding="4,2"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <ListBox ItemsSource="{Binding Categories}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 SelectedItem="{Binding ActiveCategory}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ToolboxLogCategory}">
                                    <Border Padding="6,2" CornerRadius="3"
                                            Background="{DynamicResource AccentBrushSemi}">
                                        <TextBlock Text="{Binding .}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 日志列表 -->
                    <ListBox ItemsSource="{Binding VisibleEntries}" Padding="2"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolboxLogViewModel+Entry}">
                                <Grid ColumnDefinitions="42,80,*" Margin="1">
                                    <TextBlock Grid.Column="0" Text="{Binding Level}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="10" Opacity="0.65" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- 右侧属性面板 -->
        <Border DockPanel.Dock="Right" Width="240"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Node_Properties}"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="8,8,8,4" />
                <ScrollViewer>
                    <Grid Margin="8">
                        <!-- 无选中状态 -->
                        <StackPanel IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Node_NoSelection}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20" />
                        </StackPanel>

                        <!-- 选中节点属性 -->
                        <StackPanel IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Spacing="6">
                            <TextBlock Text="{DynamicResource Node_Properties_Title}" FontSize="11" Opacity="0.7" />
                            <TextBox Text="{Binding SelectedNode.Title, Mode=TwoWay}" FontSize="12" />

                            <TextBlock Text="{DynamicResource Node_Properties_Category}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedNode.Category}" FontSize="12" />

                            <TextBlock Text="{DynamicResource Node_Properties_Location}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock FontSize="12">
                                <Run Text="{Binding SelectedNode.Location.X}" />
                                <Run Text=", " />
                                <Run Text="{Binding SelectedNode.Location.Y}" />
                            </TextBlock>

                            <TextBlock Text="{DynamicResource Node_Properties_Inputs}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Input}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <StackPanel Margin="0,2" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.7" />
                                            <TextBox Text="{Binding Value, Mode=TwoWay}" FontSize="12" Padding="4,2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Node_Properties_Outputs}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Output}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                        <StackPanel Margin="0,2" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.7" />
                                            <TextBox Text="{Binding Value, Mode=TwoWay}" FontSize="12" Padding="4,2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 中央节点画布区域 - 使用 Grid 叠加小地图 -->
        <Grid>
            <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                                 Connections="{Binding Connections}"
                                 Zoom="{Binding Zoom}"
                                 AllowAlign="True"
                                 AllowAutoPanning="True"
                                 ConnectionStartedCommand="{Binding ConnectionStartedCommand}"
                                 ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding RemoveConnectionCommand}"
                                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                 x:Name="Editor">

                <!-- 节点模板 -->
                <nodify:NodifyEditor.ItemTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:FlowNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding Input}"
                                     Output="{Binding Output}"
                                     Location="{Binding Location, Mode=TwoWay}"
                                     IsSelected="{Binding IsSelected, Mode=TwoWay}">
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeInput Header="{Binding Title}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      IsConnected="{Binding IsConnected, Mode=TwoWay}" />
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>
                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type nodeVm:NodeConnectorViewModel}">
                                    <nodify:NodeOutput Header="{Binding Title}"
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                       IsConnected="{Binding IsConnected, Mode=TwoWay}" />
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.ItemTemplate>

                <!-- 连接线模板 -->
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type nodeVm:NodeConnectionViewModel}">
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Target="{Binding Target.Anchor}"
                                           Text="{Binding Text}"
                                           SplitCommand="{Binding SplitCommand}"
                                           DisconnectCommand="{Binding DisconnectCommand}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <!-- 待定连接线模板（拖拽中的连接预览） -->
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate>
                        <nodify:PendingConnection EnablePreview="True"
                                                  EnableSnapping="True"
                                                  Direction="Forward" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>

            <!-- 小地图 - 作为叠加层放在 Grid 中，而非 NodifyEditor 的子元素 -->
            <nodify:NodifyEditorMinimap Editor="{Binding #Editor}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Width="180" Height="120"
                                        Margin="8"
                                        IsVisible="{Binding ShowMinimap}" />
        </Grid>
    </DockPanel>
</UserControl>
