<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="UotanStudio.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid>
        <!-- Main Content -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16" Spacing="24" MaxWidth="800">

                <!-- Section 1: Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Appearance}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <!-- Theme Selection -->
                    <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="13" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <RadioButton Content="{DynamicResource Settings_ThemeFollowSystem}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeLightMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource Settings_ThemeDarkMode}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Theme Preview -->
                    <TextBlock Text="{DynamicResource Settings_ThemePreview}" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                    <Border CornerRadius="8" Padding="16" Height="80"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Aa" FontSize="24" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Grid.Column="2" CornerRadius="4" Padding="16,6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Button" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Section 2: Language -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_LanguagePreview}"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LanguagePreviewText}"
                                   FontSize="13" FontStyle="Italic"
                                   Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Section 3: General -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_General}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoSave}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding AutoSave, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Section 4: Firmware Tools -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Firmware}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_UnpackToolPath}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding UnpackToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{DynamicResource Settings_PathPlaceholder}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_TempDir}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding TempDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{DynamicResource Settings_PathPlaceholder}"
                                 Margin="0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_AutoVerify}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding AutoVerifyAfterUnpack, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Section 5: Flash -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_Flash}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AdbPath}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding AdbPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{DynamicResource Settings_PathPlaceholder}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_FastbootPath}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FastbootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{DynamicResource Settings_PathPlaceholder}"
                                 Margin="0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_DeviceTimeout}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding DeviceTimeoutSeconds, Mode=TwoWay}"
                                       Minimum="5" Maximum="300"
                                       FormatString="0 s" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_AutoBackup}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8" />
                        <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding AutoBackupBeforeFlash, Mode=TwoWay}"
                                      Margin="0,8" />
                    </Grid>
                </StackPanel>

                <!-- Section 6: Node Editor -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_NodeEditor}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_SnapToGrid}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding SnapToGrid, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_GridSize}"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,8" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding GridSize, Mode=TwoWay}"
                                       Minimum="5" Maximum="100"
                                       Margin="0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_ConnectionStyle}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding ConnectionStyles}"
                                  SelectedIndex="{Binding ConnectionStyleIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>

                <!-- Section 7: Version Information -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Settings_VersionInfo}" FontWeight="SemiBold" FontSize="16" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                        <!-- Firmware Module Card -->
                        <Border CornerRadius="8" Padding="16" MinWidth="180"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Settings_FirmwareModule}" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{DynamicResource Settings_Version}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding FirmwareModuleVersion}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Button Content="{DynamicResource Settings_CheckForUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding !IsCheckingUpdates}"
                                        FontSize="12" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Flash Module Card -->
                        <Border CornerRadius="8" Padding="16" MinWidth="180"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Settings_FlashModule}" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{DynamicResource Settings_Version}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding FlashModuleVersion}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Button Content="{DynamicResource Settings_CheckForUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding !IsCheckingUpdates}"
                                        FontSize="12" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Visual Programming Module Card -->
                        <Border CornerRadius="8" Padding="16" MinWidth="180"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Settings_VisualProgrammingModule}" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{DynamicResource Settings_Version}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding VisualProgrammingModuleVersion}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Button Content="{DynamicResource Settings_CheckForUpdates}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        IsEnabled="{Binding !IsCheckingUpdates}"
                                        FontSize="12" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Update Check Result -->
                    <TextBlock Text="{Binding UpdateCheckResult}"
                               FontSize="12" Opacity="0.8"
                               IsVisible="{Binding UpdateCheckResult, Converter={StaticResource StringNotNullOrEmptyConverter}}" />
                </StackPanel>

                <!-- Section 8: Reset to Defaults -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,32">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}"
                            Command="{Binding ResetToDefaultsCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast Notification Overlay -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                IsVisible="{Binding IsToastVisible}"
                CornerRadius="8" Padding="12,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding ToastMessage}" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
