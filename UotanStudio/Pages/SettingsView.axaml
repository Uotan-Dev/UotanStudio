<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:UotanStudio.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
             x:Class="UotanStudio.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <!-- 卡片化区段标题样式：图标 + 标题 -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 1 3 0 rgba(0,0,0,0.06)" />
        </Style>
        <Style Selector="TextBlock.SettingsTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.SettingsDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16" Spacing="0" MaxWidth="820">

                <!-- ============ Section 1: Appearance ============ -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SettingsTitle" Text="{DynamicResource Settings_Appearance}" />
                        <Border Classes="SettingsDivider" />

                        <TextBlock Text="{DynamicResource Settings_Theme}" FontSize="13" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <RadioButton Content="{DynamicResource Settings_ThemeFollowSystem}"
                                         GroupName="ThemeGroup"
                                         IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                            <RadioButton Content="{DynamicResource Settings_ThemeLightMode}"
                                         GroupName="ThemeGroup"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            <RadioButton Content="{DynamicResource Settings_ThemeDarkMode}"
                                         GroupName="ThemeGroup"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Section 2: Language ============ -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SettingsTitle" Text="{DynamicResource Settings_Language}" />
                        <Border Classes="SettingsDivider" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,2">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_Language}"
                                       VerticalAlignment="Center" FontSize="13" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_LanguagePreview}"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding LanguagePreviewText}"
                                       FontSize="13" FontStyle="Italic"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Section 3: General ============ -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SettingsTitle" Text="{DynamicResource Settings_General}" />
                        <Border Classes="SettingsDivider" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto" Margin="0,2">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoSave}"
                                       VerticalAlignment="Center" FontSize="13" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          IsChecked="{Binding AutoSave}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Section 5: Flash ============ -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SettingsTitle" Text="{DynamicResource Settings_Flash}" />
                        <Border Classes="SettingsDivider" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto" Margin="0,2">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AutoBackup}"
                                       VerticalAlignment="Center" FontSize="13" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          IsChecked="{Binding AutoBackupBeforeFlash}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Section 6: Node Editor ============ -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="SettingsTitle" Text="{DynamicResource Settings_NodeEditor}" />
                        <Border Classes="SettingsDivider" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_SnapToGrid}"
                                       VerticalAlignment="Center" FontSize="13" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          IsChecked="{Binding SnapToGrid}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_GridSize}"
                                       VerticalAlignment="Center" FontSize="13" Margin="0,8" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Value="{Binding GridSize}"
                                           Minimum="5" Maximum="100"
                                           Margin="0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings_ConnectionStyle}"
                                       VerticalAlignment="Center" FontSize="13" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding ConnectionStyles}"
                                      SelectedIndex="{Binding ConnectionStyleIndex}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Section 8: Reset ============ -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,24">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}"
                            Command="{Binding ResetToDefaultsWithConfirmCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast Notification Overlay -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                IsVisible="{Binding IsToastVisible}"
                CornerRadius="8" Padding="12,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding ToastMessage}" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
