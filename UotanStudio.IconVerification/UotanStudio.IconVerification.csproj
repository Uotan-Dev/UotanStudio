<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>UotanStudio.IconVerification</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Reflection is used only by this manual verification host to enumerate the public icon controls. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzerOnBuild>false</EnableAotAnalyzerOnBuild>
    <EnableTrimAnalyzerOnBuild>false</EnableTrimAnalyzerOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio\UotanStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
