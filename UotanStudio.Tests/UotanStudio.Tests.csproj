<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MTP 模式下 xUnit v3 测试工程必须是可执行程序（测试宿主） -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>UotanStudio.Tests</RootNamespace>
    <!-- 启用 Microsoft.Testing.Platform 通道，使 dotnet test 可直接发现并运行 xunit.v3 测试 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firmware library under test (AVB, boot image, CPIO, Sparse, compression, Payload) -->
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
    <!-- Comm library under test (AVB verification wiring / protocol tests) -->
    <ProjectReference Include="..\UotanStudio.Comm\UotanStudio.Comm.csproj" />
    <!-- Application layer under test (FlashService / BackupService / DeviceInfo 等刷写与备份路径)。
         Avalonia UI 依赖随引用带入；需要构造 Avalonia 控件树的测试经 Avalonia.Headless 获得平台服务。 -->
    <ProjectReference Include="..\UotanStudio\UotanStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试中的轻量 Avalonia 平台初始化（SkiaPlatform.Initialize）：为构造 Avalonia 控件树
         （如 WorkspaceDockFactory 的 EmptyContent MaterialIcon）的测试提供渲染接口等服务。
         Lightweight Avalonia platform init for tests (SkiaPlatform.Initialize): provides the
         render interface for tests that construct Avalonia control trees (e.g. the
         WorkspaceDockFactory EmptyContent MaterialIcon). -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 基于 Microsoft.Testing.Platform（.NET 10 新测试体验）：
         不再引用 VSTest 体系的 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio，
         dotnet test 配合 TestingPlatformDotnetTestSupport=true 走 MTP 通道。 -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试夹具：真实世界 DEX 文件随构建复制到输出目录 -->
    <None Include="Firmware\Files\**\*.dex" CopyToOutputDirectory="PreserveNewest" />
    <!-- 测试基础设施：仓库固定的 AOSP avbtool.py 副本（WSL 交叉验证安装用） -->
    <None Include="TestInfrastructure\avbtool.py*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
