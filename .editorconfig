# UotanStudio EditorConfig
# https://learn.microsoft.com/en-us/visualstudio/code-style/code-style-and-editorconfig

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# 使用 var
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# 表达式体成员
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning

# 模式匹配
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# Null 检查
csharp_style_throw_expression = true:warning
csharp_style_conditional_delegate_call = true:warning

# 修饰符
dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# 命名规则
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# 未使用变量
csharp_style_unused_value_assignment_expression_statement = discard_variable:suggestion

# Using 指令放置
csharp_using_directive_placement = outside_namespace:warning

# 行长度
max_line_length = 120

[*.{axaml,xaml}]
indent_style = space
indent_size = 4
