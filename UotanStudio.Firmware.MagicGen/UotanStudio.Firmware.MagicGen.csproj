<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UotanStudio.Firmware.MagicGen</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 构建期代码生成工具；不进入运行时裁剪/发布路径。 -->
    <!-- Build-time code generator; not part of the runtime publish/trim path. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
  </ItemGroup>

</Project>
