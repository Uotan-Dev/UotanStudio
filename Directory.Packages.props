<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Iciclecreek.Avalonia.Terminal" Version="4.0.2" />
    <PackageVersion Include="Porta.Pty" Version="2.2.2" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Avalonia.Diagnostics" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageVersion Include="Irihi.Ursa" Version="2.2.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
    <PackageVersion Include="Material.Icons" Version="3.0.2" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageVersion Include="Semi.Avalonia.Dock" Version="12.0.0.2" />
    <PackageVersion Include="NodifyM.Avalonia" Version="12.0.0" />
    <!-- Device communication packages -->
    <PackageVersion Include="AdvancedSharpAdbClient" Version="3.6.16" />
    <PackageVersion Include="LibUsbDotNet" Version="3.0.224" />
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.12" />
    <!-- UotanStudio.Firmware third-party dependencies -->
    <PackageVersion Include="BrotliSharpLib" Version="0.3.3" />
    <PackageVersion Include="BsDiff" Version="1.1.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="LZMA-SDK" Version="22.1.1" />
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <!-- PKCS#7 CMS (SignedCms) for APK v1 JAR signature blocks -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- AVB signature verification (RSASSA-PSS / PKCS#1 v1.5), pure managed & AOT-friendly -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- LZOP container parsing / zlib inflate helpers -->
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <!-- Text diffing (line-level diff for the compare services) -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <!-- Official Model Context Protocol C# SDK for the embedded MCP server -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- Source-compatible command parsing with trimming/AOT support. -->
  </ItemGroup>
</Project>
