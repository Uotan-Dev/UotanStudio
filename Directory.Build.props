<Project>

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <CETCompat>false</CETCompat>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**</DefaultItemExcludes>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'UotanStudio.Tests' AND '$(MSBuildProjectName)' != 'UotanStudio.Benchmarks' AND '$(MSBuildProjectName)' != 'UotanStudio.ErofsBench' AND '$(MSBuildProjectName)' != 'erofs-producer'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzerOnBuild Condition="'$(EnableAotAnalyzerOnBuild)' == ''">true</EnableAotAnalyzerOnBuild>
    <EnableTrimAnalyzerOnBuild Condition="'$(EnableTrimAnalyzerOnBuild)' == ''">true</EnableTrimAnalyzerOnBuild>
  </PropertyGroup>

</Project>
