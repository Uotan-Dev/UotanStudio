<Project Sdk="Microsoft.NET.Sdk">
  <!-- 发布时用 Satori GC 替换默认 GC：仅自包含发布（含 NativeAOT）生效；版本跟随上游开发更新，需定期核对 NuGet。
       Swaps the default GC for Satori GC at publish time: takes effect only on self-contained publishes
       (NativeAOT included); the version tracks upstream development and needs periodic NuGet checks. -->
  <Sdk Name="PublishWithSatoriGC" Version="10.0.15-satori.40994390316.1" />
  <!-- riscv64 与 loongarch64 没有 Satori 运行时包：这些 RID 回落到默认 GC。
       riscv64 and loongarch64 have no Satori runtime packs: these RIDs fall back to the default GC. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and ($(RuntimeIdentifier.Contains('riscv64')) or $(RuntimeIdentifier.Contains('loongarch64')))">
    <UseSatoriGC>false</UseSatoriGC>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>partial</TrimMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 把构建所用 .NET SDK 版本写入程序集元数据，供设置页展示；SDK 解析器未提供该属性时不写入。
         Bakes the .NET SDK version used to build into assembly metadata for the settings page; omitted
         when the SDK resolver does not provide the property. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(NETCoreSdkVersion)' != ''">
      <_Parameter1>DotNetSdkVersion</_Parameter1>
      <_Parameter2>$(NETCoreSdkVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <!-- Preserve the Win32 composition surface getter the settings page reads to report the live host; the
         descriptor is scoped to Windows RIDs so Linux and macOS publishes keep trimming the Win32 platform. -->
    <TrimmerRootDescriptor Include="WindowsCompositionRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio\UotanStudio.csproj" />
    <ProjectReference Include="..\UotanStudio.Mcp\UotanStudio.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 文件关联图标：随输出目录复制，供注册表 DefaultIcon 引用。 -->
    <Content Include="Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- scrcpy 服务端 jar 不随仓库分发；UotanStudio/Services/Scrcpy/ScrcpyServerService.cs 在使用前按源站公布的
         长度与摘要校验后取入本地存储。若将来随包，放在 UotanStudio.Assets/Assets/scrcpy/scrcpy-server.jar，
         并运行 dotnet run tools/compress-embedded-assets.cs 生成帧与清单条目。
         The scrcpy server jar is not distributed with this repository; ScrcpyServerService checks the length
         and digest the origin publishes before taking it into the local store. A jar that ships later belongs
         at UotanStudio.Assets/Assets/scrcpy/scrcpy-server.jar and needs
         dotnet run tools/compress-embedded-assets.cs to generate its zstd frame and manifest row. -->
  </ItemGroup>
</Project>
