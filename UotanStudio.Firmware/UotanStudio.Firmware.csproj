<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>UotanStudio.Firmware</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Payload\Core\Lz4DestinationCodec.LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="licenses/Lz4DestinationCodec.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <!-- 上游 file(1) 可读 magic 文本规则（github.com/file/file 的 magic/Magdir/），作为嵌入式资源 -->
    <EmbeddedResource Include="SharedKernel\Magic\android.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\archive.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\compress.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\elf.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\filesystems.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\linux.magic" />
    <EmbeddedResource Include="SharedKernel\Magic\sun.magic" />
    <!-- 内置精炼 magic 规则（固件相关子集），运行时由 ManagedMagic 加载 -->
    <EmbeddedResource Include="SharedKernel\Magic\firmware.magic" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compression / binary processing (used across formats) -->
    <PackageReference Include="BrotliSharpLib" />
    <PackageReference Include="BsDiff" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="K4os.Compression.LZ4.Legacy" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" />
    <PackageReference Include="LZMA-SDK" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

</Project>
