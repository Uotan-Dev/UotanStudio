<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UotanStudio.Firmware</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 上游 file(1) 可读 magic 文本规则（github.com/file/file 的 magic/Magdir/），作为嵌入式资源 -->
    <EmbeddedResource Include="Common\Magic\android.magic" />
    <EmbeddedResource Include="Common\Magic\archive.magic" />
    <EmbeddedResource Include="Common\Magic\compress.magic" />
    <EmbeddedResource Include="Common\Magic\elf.magic" />
    <EmbeddedResource Include="Common\Magic\filesystems.magic" />
    <EmbeddedResource Include="Common\Magic\linux.magic" />
    <EmbeddedResource Include="Common\Magic\sun.magic" />
    <!-- 内置精炼 magic 规则（固件相关子集），运行时由 ManagedMagic 加载 -->
    <EmbeddedResource Include="Common\Magic\firmware.magic" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compression / binary processing (used across formats) -->
    <PackageReference Include="BrotliSharpLib" />
    <PackageReference Include="BsDiff" />
    <PackageReference Include="Crc32.NET" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="K4os.Compression.LZ4.Legacy" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" />
    <PackageReference Include="LZMA-SDK" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

</Project>
