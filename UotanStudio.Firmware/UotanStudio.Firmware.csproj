<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>UotanStudio.Firmware</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compression / binary processing (used across formats) -->
    <PackageReference Include="Google.Protobuf" />
    <!-- Bounded image decoding/encoding for logo partitions: SimdCodecs owns raster codecs; the
         format domain keeps the container parsing and byte budgets. -->
    <PackageReference Include="Sdcb.SimdCodecs" />
    <PackageReference Include="Sdcb.SimdCodecs.Bmp" />
    <PackageReference Include="Sdcb.SimdCodecs.Png" />
    <PackageReference Include="Sdcb.SimdCodecs.Jpeg" />
    <PackageReference Include="Sdcb.SimdCodecs.Abstractions" />
    <PackageReference Include="LTRData.DiscUtils.ExFat" />
    <PackageReference Include="LTRData.DiscUtils.Fat" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="YamlDotNet" />
    <!-- Value-enumerable LINQ over the per-class/per-inode arrays the Smali and EROFS writers walk. -->
    <PackageReference Include="ZLinq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UotanStudio.Assets\UotanStudio.Assets.csproj" />
    <ProjectReference Include="..\UotanStudio.Compress\UotanStudio.Compress.csproj" />
    <ProjectReference Include="..\UotanStudio.Hash\UotanStudio.Hash.csproj" />
  </ItemGroup>

</Project>
