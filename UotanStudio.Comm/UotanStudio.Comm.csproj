<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" />
    <PackageReference Include="Makaretu.Dns.Multicast" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared AVB signature verification lives in UotanStudio.Firmware (no circular dependency:
         Firmware does not reference Comm). -->
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" PrivateAssets="all" />
  </ItemGroup>

</Project>
