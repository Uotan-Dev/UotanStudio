<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Native content depends on the consuming application's RID. -->
    <IsRidAgnostic>false</IsRidAgnostic>
  </PropertyGroup>

  <!-- Explicit RID wins for cross-publishing; ordinary builds use the SDK host RID.
       Content items propagate through ProjectReference to the application's root. -->
  <PropertyGroup>
    <LibUsbRuntimeIdentifier Condition="'$(LibUsbRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</LibUsbRuntimeIdentifier>
    <LibUsbRuntimeIdentifier Condition="'$(LibUsbRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</LibUsbRuntimeIdentifier>
    <LibUsbRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU'">$([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkRuntimeIdentifier)', '-[^-]+$', '-$(PlatformTarget)'))</LibUsbRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Native\LibUsb\**\*" />
    <Content Include="Native\LibUsb\$(LibUsbRuntimeIdentifier)\*"
             Link="%(Filename)%(Extension)"
             TargetPath="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\LibUsb\COPYING"
             Link="libusb-LICENSE.txt"
             TargetPath="libusb-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateLibUsbRuntime" BeforeTargets="PrepareForBuild">
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)/Native/LibUsb/$(LibUsbRuntimeIdentifier)')"
             Text="No bundled libusb runtime for '$(LibUsbRuntimeIdentifier)'. Supply a compatible system library or configure CommKit.SetLibusbLibraryPath." />
  </Target>

  <ItemGroup>
    <!-- The serverless pairing protocol and the adb smart-socket client are implemented in
         Protocols/Adb; no third-party adb client is referenced. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="LibUsbDotNet" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="Makaretu.Dns.Multicast" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared AVB signature verification lives in UotanStudio.Firmware (no circular dependency:
         Firmware does not reference Comm). -->
    <ProjectReference Include="..\UotanStudio.Firmware\UotanStudio.Firmware.csproj" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>